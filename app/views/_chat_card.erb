<style>
  @media (max-width: 991.98px) {
    #chat {
      display: block !important
    }
  }

  :root {
    --chat-height: 25rem;
  }

  @media (min-width: 992px) {
    #chat-card {
      border: 0;
      margin: 0 !important
    }

    #chat-card-body {
      padding: 0 !important
    }

    #chat-container {
      z-index: 99;
      border-radius: var(--bs-border-radius);
      box-shadow: var(--bs-box-shadow);
      background: var(--bs-white);
      position: fixed;
      width: 27.5em;
      bottom: var(--space-xs);
      right: var(--space-xs);
    }

    #chat {
      height: var(--chat-height);
      overflow: auto;
    }

    /* Closed, the bar is the whole panel, so it takes all four corners */
    #chat-toggle[aria-expanded="false"] {
      border-radius: var(--bs-border-radius) !important;
    }

    /* The chevron points up to open the chat and turns to point down to close it */
    #chat-toggle .bi {
      transition: rotate var(--transition-fast);
    }

    #chat-toggle[aria-expanded="true"] .bi {
      rotate: 180deg;
    }

    /* Room at the foot of the page, so the fixed chat doesn't cover the end of the content */
    #chat-spacer {
      margin-bottom: calc(var(--chat-height) + var(--space-xs));
    }
  }
</style>

<div class="card mt-3" id="chat-card">
  <h3 class="card-header chill d-lg-none"><%= title %></h3>
  <div class="card-body pt-2" id="chat-card-body">
    <div id="chat-container">
      <button type="button" id="chat-toggle" class="d-none d-lg-flex align-items-center gap-2 w-100 p-2 border-0 text-start text-bg-primary rounded-top"
          aria-controls="chat" aria-expanded="<%= show_chat ? 'true' : 'false' %>"
          onclick="const open = $('#chat').toggle().is(':visible'); $(this).attr('aria-expanded', open); $('#chat-spacer').toggleClass('d-lg-block', open)">
        <span class="fw-bold flex-grow-1"><%= title %></span>
        <i class="bi bi-chevron-up" aria-hidden="true"></i>
      </button>
      <div id="chat" <% if !show_chat %> style="display:none"<% end %>>
        <% if defined?(subtitle) && subtitle %>
          <div class="small text-body-secondary px-2 pt-2 pb-2"><%= subtitle %></div>
        <% end %>
        <%= content %>
      </div>
    </div>
  </div>
</div>
<div class="d-none <%= 'd-lg-block' if show_chat %>" id="chat-spacer"></div>
