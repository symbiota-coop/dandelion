<% messages = Message.between(current_account, @account).order('created_at asc') %>
<% message_receipt = MessageReceipt.find_by(messenger: current_account, messengee: @account) %>
<div id="messengee" class="media mb-3">
  <%= partial :'accounts/square', locals: { account: @account, style: 'display: block; width: 64px' } %>
  <div class="media-body ml-3">
    <h4 class="my-0"><a class="text-dark" href="/u/<%= @account.username %>"><%= @account.name %></a></h4>
  </div>
</div>
<div id="thread-scroll" class="thread-scroll-prepin" data-pagelet-stamp="<%= [messages.last&.id, messages.count, message_receipt&.received_at&.to_i].join('-') %>" data-pagelet-pin-bottom>
  <ul class="widget-chat p-1">
    <% messages.each_with_index { |message, i| %>
      <%= partial :'messages/bubble', locals: { message: message, message_receipt: message_receipt, last: i == messages.count - 1 } %>
    <% } %>
  </ul>
</div>
<script>
  $(function () {
    scrollMessageThreadToBottom()
  });
</script>
