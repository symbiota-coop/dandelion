<% if current_account.blocked_from_messaging %>
  <p class="lead">You are not able to send messages. If you think this is a mistake, please <a href="mailto:<%= ENV['CONTACT_EMAIL'] %>">contact us</a>.</p>
<% elsif !current_account.able_to_message %>
  <p class="lead">You must <a href="/accounts/edit">confirm your email address</a> and <a href="/donate">donate to Dandelion</a>, join a gathering or attend an event before messaging.</p>
<% else %>
  <% form_tag "/messages/#{@account.id}/send", id: 'compose', class: 'message-compose mt-3' do %>
    <%= text_area_tag :body, id: 'message-body', placeholder: 'Type a message...', class: 'form-control', rows: 1 %>
    <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-send-fill"></i></button>
  <% end %>
<% end %>

<script>
  $(function () {
    autosize($('#message-body'));

    scrollMessageThreadToBottom()

    $('#message-body').on('autosize:resized', function () {
      scrollMessageThreadToBottom()
    })

    $('#message-body').on('keydown', function (e) {
      if (e.key !== 'Enter' || e.shiftKey) return
      e.preventDefault()
      if (!$.trim(this.value)) return
      $(this).closest('form').submit()
    })

    if ($(window).width() > 992 || <%= request.xhr? ? 'true' : 'false' %>)
      $('#message-body').focus()
  })
</script>
