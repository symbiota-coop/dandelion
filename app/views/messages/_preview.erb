<% account = message.other_party(current_account) %>
<div class="d-flex align-items-start">
  <%= partial :'accounts/square', locals: { account: account, content: (account.last_active ? "Active #{time_ago_in_words account.last_active} ago" : 'Never logged in'), style: 'display: block; width: 32px' } %>
  <div class="flex-grow-1 ms-3">
    <a class="<%= klass if defined?(klass) %> message-preview text-dark <% if account.id == message.messenger_id && Message.unread?(account, current_account) %> unread <% end %> text-decoration-none" href="/messages/<%= account.id %>">
      <h5 class="my-0"><%= account.name %></h5>
      <p class="text-body-secondary mb-1">
        <%= HTML_Truncator.truncate(message.body, 40, length_in_chars: true) %>
      </p>
      <p class="mb-0 me-1 text-end text-body-secondary">
        <small>
          <%= timeago(message.created_at) %>
        </small>
      </p>
    </a>
  </div>
</div>
