<% @edition['articles'].each do |article| %>
  <div class="article">
    <h2 class="article-title"><%= article['title'] %></h2>
    <div class="article-content">
      <%== Sanitize.fragment(md(article['summary'].to_s), Sanitize::Config::DANDELION) %>
    </div>
  </div>
<% end %>

<%# Seeded by the date, so each date keeps its book and film %>
<% random = Random.new(@date.jd) %>
<div class="row">
  <div class="col-md-4 pe-md-5">
    <div class="article single-column">
      <h3>Book of the day</h3>
      <div>
        <% book = library_books.sample(random: random) %>
        <% if book %>
          <a href="/books/<%= book[:slug] %>">
            <img class="mw-100" src="/books/<%= book[:slug] %>.jpg">
          </a>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4 pe-md-5">
    <div class="article single-column">
      <h3>Film of the day</h3>
      <div>
        <% film = library_films.sample(random: random) %>
        <% if film %>
          <a href="<%= film[:url] %>">
            <img class="mw-100" src="/films/<%= film[:slug] %>.jpg">
          </a>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4 pe-md-5">
    <div class="article single-column">
      <h3>Facilitator of the day</h3>
      <div>
        <% account = Account.find(@edition['facilitator_id']) if @edition['facilitator_id'] %>
        <% if account %>
          <a class="text-decoration-none" href="javascript:;" data-account-username="<%= account.username %>">
            <img class="w-100 <%= account.avatar_class %> <%= 'private' if account.private? %>" src="<%= u account.image_thumb_or_gravatar_url %>">
            <h4 class="mt-2">
              <a class="text-body" href="/u/<%= account.username %>"><%= account.name %></a>
            </h4>
            <div class="facilitator-info">
              <%= partial :'accounts/facilitator_info', locals: { account: account } %>
            </div>
          </a>
        <% end %>
      </div>
    </div>
  </div>
</div>
