<% if notifications.empty? %>
  <p class="text-center lead mb-3">Your newsfeed is empty.</p>
<% else %>
  <ul class="list-unstyled">
    <% notifications.each do |notification| %>
    <li>
      <div class="d-flex align-items-start gap-2">
        <%= partial :notification_summary, locals: { notification: notification, full: true, include_circle_name: include_circle_name } %>
      </div>
      <hr class="my-3" style="border-top-color: var(--hairline)">
    </li>
    <% end %>
  </ul>
  <%= will_paginate notifications, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
<% end %>

<% if params[:tour] || (!ENV['SKIP_TOURS'] && request.path == '/' && !current_account.seen_intro_tour) %>
  <%= partial :intro_tour %>
  <% current_account.set(seen_intro_tour: true) %>
<% end %>
