<div class="d-flex flex-wrap gap-2 mb-3">
  <a class="btn btn-sm btn-primary" href="javascript:;" data-bs-toggle="modal" data-bs-target="#add-inventory-item"><i class="bi bi-plus-lg"></i> List item</a>
</div>
<%= partial :'gatherings/form_modal', locals: { id: 'add-inventory-item', title: 'List an item', form: :'inventory/build' } %>
<table class="table">
  <tr>
    <th>Item</th>
    <th>Team</th>
    <th>Listed by</th>
    <th>Responsible person</th>
  </tr>
  <% @gathering.inventory_items(true).sort_by { |inventory_item| inventory_item.team.try(:name) || '' }.each { |inventory_item| %>
  <tr>
    <td>
      <a href="/g/<%= @gathering.slug %>/inventory_items/<%= inventory_item.id %>/edit">
        <%= inventory_item.name %>
      </a>
      <% if inventory_item.description %>
        <br>
        <%= inventory_item.description %>
      <% end %>
    </td>
    <td>
      <% if inventory_item.team %>
        <a href="/g/<%= @gathering.slug %>/teams/<%= inventory_item.team_id %>"><%= inventory_item.team.name %></a>
      <% end %>
    </td>
    <td>
      <% if inventory_item.account %>
        <a href="/u/<%= inventory_item.account.username %>"><%= inventory_item.account.name %></a>
      <% end %>
    </td>
    <td>
      <% form_tag "/g/#{@gathering.slug}/inventory_items/#{inventory_item.id}/provided" do %>
        <%= select_tag :responsible_id, class: 'form-select form-select-sm', 'aria-label': 'Responsible', options: [''] + @gathering.members.order('name asc').map { |account| [account.name, account.id] }, selected: inventory_item.responsible.try(:id), onchange: '$(this.form).submit()' %>
      <% end %>
    </td>
  </tr>
  <% } %>
</table>
