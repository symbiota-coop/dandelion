<table class="table table-hr">
  <% if @organisation.website %>
    <tr>
      <td>Website</td>
      <td>
        <a target="_blank" href="<%= @organisation.website %>"><%= @organisation.website %></a>
      </td>
    </tr>
  <% end %>
  <% if @organisation.location %>
    <tr>
      <td>Location</td>
      <td>
        <a target="_blank" href="https://www.google.com/maps?q=<%= @organisation.location %>"><%= @organisation.location %></a>
      </td>
    </tr>
  <% end %>
  <% if organisation_admin? || @organisation.admins.exists? %>
    <tr>
      <td>Admins</td>
      <td>
        <div data-pagelet-url="/o/<%= @organisation.slug %>/organisationships/admins">
          <%= partial :'organisations/admins_box' %>
        </div>
      </td>
    </tr>
  <% end %>
</table>
