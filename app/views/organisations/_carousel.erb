<% if (organisations = Organisation.and(:id.in =>
  current_account.organisationships.and(:hide_membership => false).pluck(:organisation_id) +
  current_account.organisationships.and(:admin => true).pluck(:organisation_id)
  ).and(:image_uid.ne => nil)).exists? %>

<% organisations = organisations.sort_by { |organisation| created_at = organisation.events.live.publicly_visible.order('created_at desc').first.try(:created_at); created_at ? created_at.to_i : 0 }.reverse.first(12) %>

<% if organisations.exists? %>
  <div class="mb-5">
    <% if defined? title %>
      <h2 class="text-center"><%= title %></h2>
    <% end %>
    <div class="snap-carousel">
      <div class="snap-carousel-track row">
        <% organisations.each { |organisation| %>
        <div class="col-6 col-lg-4 snap-carousel-item">
          <%= partial :'organisations/block', locals: { organisation: organisation, most_recent: (organisation.events.live.publicly_visible.future.exists?) } %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
<% end %>

<% end %>
