<% if @events.empty? %>
  <div class="mt-3">
    <span class="text-body-secondary">No events</span>
  </div>
<% else %>
  <% unless params[:no_listings] %>
    <% if !params[:minimal] || params[:past] || params[:recordings] %>
      <% @events = @events.paginate(page: params[:page], per_page: (params[:per_page] || 20)) %>
      <%= partial :'events/blocks', locals: { events: @events } %>
      <div class="mt-3">
        <%= will_paginate @events, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
      </div>
    <% else %>
      <% events, more_events = capped_events(@events) %>
      <%= partial :'events/blocks', locals: { events: events } %>
      <% if more_events %>
        <div class="mt-3">
          <a href="<%= all_events_url(@organisation) %>" target="<%= params[:minimal] ? '_blank' : '_self' %>">See all events <i class="bi bi-arrow-right"></i></a>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
