<% if params[:tour] || (!ENV['SKIP_TOURS'] && params[:created] && current_account.organisations.count == 1) %>
  <script>
    $(function() {

      if($(window).width() > 992) {

        introJs().setOptions({
          steps: [{
            title: "Nice one!",
            intro: "You've created your first organisation 🎉"
          }, {
            element: $('#content button.dropdown-toggle')[0],
            intro: "Here's the admin dropdown for the organisation"
          }, {
            intro: "To accept payments, now add details for Stripe or another payment processor.",
          }]
        }).start();

      }

    })
  </script>
<% end %>


<%= partial :'organisations/nav', locals: { organisation: @organisation } %>

<% if current_account.organisations.exists? %>
  <p>
    <a target="_blank" href="/docs/organisations">
      <i class="bi bi-question-circle-fill"></i>
      Need support? Check out the docs
    </a>
  </p>
<% end %>

<style>
  #organisation_minimal_head { height: 5em }
  #organisation_terms_and_conditions { height: 5em }
</style>
<script>
  $(function () {

    if (typeof google !== 'undefined') {
      var autocomplete = new google.maps.places.Autocomplete($('#organisation_location')[0]);
      $('#organisation_location').keydown(function (e) {
        if (e.which == 13 && $('.pac-container:visible').length)
          return false;
      })
    }

    autosize($('#organisation_minimal_head')[0])
    autosize($('#organisation_terms_and_conditions')[0])

    $('#organisation-build-nav a[data-toggle="tab"]').on('show.bs.tab', function (e) {
      var form = $('#organisation-build-nav').closest('form')[0]
        if (form.reportValidity()) {
          // continue
        } else {
          e.preventDefault()
          $(window).scrollTop($(form).find(":invalid").first().offset()['top'] - $('#header').height() - 36)
          $(form).find(":invalid").first().focus()
        }
    });

    $('#organisation-build-nav a[data-toggle="tab"]').on('shown.bs.tab', function () {
      window.scrollTo(0, 0)
    })

  })
</script>
<% if @organisation.errors.exists? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @organisation.errors.full_messages.each { |message| %>
      <li><%= message %></li>
      <% } %>
    </ul>
  </div>
<% end %>
<% form_for @organisation, @organisation.new_record? ? '/o/new' : "/o/#{@edit_slug || @organisation.slug}/edit" do  |f| %>
  <% if @organisation.persisted? %>
    <div class="nav-wrapper">
      <ul id="organisation-build-nav" class="nav nav-tabs" role="tablist">
        <li role="presentation" class="nav-item"><a class="nav-link active" href="#tab-basics" role="tab" data-toggle="tab">Basics</a></li>
        <li role="presentation" class="nav-item"><a class="nav-link" href="#tab-payments" role="tab" data-toggle="tab">Payments</a></li>
        <li role="presentation" class="nav-item"><a class="nav-link" href="#tab-emails" role="tab" data-toggle="tab">Emails</a></li>
        <li role="presentation" class="nav-item"><a class="nav-link" href="#tab-mailgun" role="tab" data-toggle="tab">Mailgun</a></li>
        <li role="presentation" class="nav-item"><a class="nav-link" href="#tab-analytics" role="tab" data-toggle="tab">Analytics</a></li>
        <li role="presentation" class="nav-item"><a class="nav-link" href="#tab-everything-else" role="tab" data-toggle="tab">Everything else</a></li>
        <% if Padrino.env == :development || @organisation.experimental? %>
          <li role="presentation" class="nav-item"><a class="nav-link" href="#tab-experimental" role="tab" data-toggle="tab">Experimental</a></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="container">

    <% if @organisation.new_record? && current_account.organisations(true).empty? %>
      <div class="alert alert-success d-flex align-items-start">
        <i class="bi bi-flag-fill mr-3 mt-1" style="font-size: 1.75rem; opacity: 0.85"></i>
        <div>
          <p class="lead mb-2">
            Let's create your first organisation!
          </p>
          <p class="mb-2">
            All events on Dandelion exist under an organisation.
          </p>
          <p class="mb-0">
            Enter the organisation name and customise the URL.
          </p>
        </div>
      </div>
    <% end %>

    <div class="tab-content <%= 'mt-3' if @organisation.persisted? %>">
      <div role="tabpanel" class="tab-pane active" id="tab-basics">
        <%= f.text_block :name %>
        <div class="slugify">
          <%= f.shorturl_block :slug, stem: "#{ENV['BASE_URI']}/o/" %>
        </div>
        <% if @organisation.persisted? %>
          <%= f.wysiwyg_block :intro_text %>
          <%= f.url_block :website %>
          <%= f.text_block :location %>
          <%= f.image_block :image %>
        <% end %>
      </div>
      <% if @organisation.persisted? %>
        <div role="tabpanel" class="tab-pane" id="tab-payments">
          <% if params[:created] %>
            <div class="alert alert-success">
              <p class="m-0">To accept payments, now add details for Stripe or another payment processor.</p>
            </div>
          <% else %>
            <% if !@organisation.payment_method? %>
              <div class="alert alert-warning">
                <p class="m-0"><i class="bi bi-exclamation-triangle-fill"></i> To accept payments, you must add details for at least one payment processor.</p>
              </div>
            <% end %>
          <% end %>
          <%= f.select_block :currency %>
          <%= partial :'organisations/payments/stripe', locals: { f: f } %>
          <%= partial :'organisations/payments/gocardless', locals: { f: f } %>
          <%= partial :'organisations/payments/opencollective', locals: { f: f } %>
          <%= partial :'organisations/payments/mollie', locals: { f: f } %>
          <%= partial :'organisations/payments/paypal', locals: { f: f } %>
          <%= partial :'organisations/payments/evm', locals: { f: f } %>
          <%= partial :'organisations/payments/patreon', locals: { f: f } %>
          <p id="payment-setup-links"></p>
          <script>
            $(function () {
              $('#tab-payments .card[id^="payment-"]').each(function () {
                var card = $(this)
                var filled = card.find('input:not([type=hidden]), textarea, select').filter(function () {
                  return $(this).is(':checkbox') ? this.checked : $(this).val()
                }).length
                if (filled) return
                card.hide()
                $('#payment-setup-links').append(
                  $('<a href="javascript:;" class="d-inline-block mr-3 mb-1">').text('Set up ' + card.find('h4').text()).click(function () {
                    card.show()
                    $(window).scrollTop(card.offset().top - $('#header').height() - 36)
                    $(this).remove()
                  })
                )
              })
              if (!$('#payment-setup-links a').length) $('#payment-setup-links').remove()
            })
          </script>
        </div>
        <div role="tabpanel" class="tab-pane" id="tab-emails">
          <script>
            $(function() {
              $('label[for$="_email_greeting"], label[for$="_email_body"]').hide()
            })
          </script>
          <p>Magic tags: <%== EmailFields::MAGIC_TAGS.map { |t| "<code>[#{t}]</code>" }.join(', ') %></p>
          <%= f.text_block :ticket_email_title %>
          <%= f.wysiwyg_block :ticket_email_greeting %>
          <%= f.text_block :recording_email_title %>
          <%= f.wysiwyg_block :recording_email_greeting %>
          <%= f.text_block :reminder_email_title %>
          <%= f.wysiwyg_block :reminder_email_body %>
          <%= f.text_block :feedback_email_title %>
          <%= f.wysiwyg_block :feedback_email_body %>
          <%= f.wysiwyg_block :extra_info_for_ticket_email %>
          <%= f.text_block :reply_to %>
          <%= f.check_box_block :show_details_table_in_ticket_emails %>
          <%= f.check_box_block :show_ticketholder_link_in_ticket_emails %>
          <%= f.check_box_block :show_sign_in_link_in_ticket_emails %>
          <%= f.check_box_block :send_ticket_emails_from_organisation %>
        </div>
        <div role="tabpanel" class="tab-pane" id="tab-mailgun">
          <% if !@organisation.mailgun_enabled? %>
            <div class="alert alert-warning">
              <p>
                If you'd like to use Dandelion's mailer to email everyone following your organisation,
                or people following your organisation's activities and local groups,
                you'll need to link a <a href="https://www.mailgun.com/pricing/">paid Mailgun account</a>
                (from $15/month for 10,000 emails).
              </p>
              <p class="m-0">
                (We offer a free gift of 1 email per month for up to <%=ENV['MAILGUN_FREE_SUBSCRIBER_LIMIT'].to_i%> subscribers, and you can always email event attendees even without providing these details.)
              </p>
            </div>
          <% end %>
          <%= f.text_block :mailgun_api_key %>
          <%= f.text_block :mailgun_domain %>
          <%= f.select_block :mailgun_region %>
          <%= f.text_block :mailgun_webhook_signing_key %>
        </div>
        <div role="tabpanel" class="tab-pane" id="tab-analytics">
          <%= f.text_block :plausible_analytics_domain %>
          <%= f.text_block :simple_analytics_domain %>
          <%= f.text_block :facebook_pixel_id %>
        </div>
        <div role="tabpanel" class="tab-pane" id="tab-everything-else">
          <%= f.color_block :theme_color %>
          <%= partial :'quick_theme_colors', locals: { input_name: 'organisation[theme_color]' } %>
          <div class="form-group">
            <label for="organisation_affiliate_credit_percentage"><%= Organisation.human_attribute_name(:affiliate_credit_percentage) %></label>
            <div class="input-group">
              <%= f.number_field :affiliate_credit_percentage, class: 'form-control' %>
              <div class="input-group-append">
                <span class="input-group-text">%</span>
              </div>
            </div>
            <small class="form-text text-muted"><%= Organisation.edit_hints[:affiliate_credit_percentage] %></small>
          </div>
          <%= f.wysiwyg_block :event_footer %>
          <%= f.text_block :add_a_donation_to %>
          <%= f.text_block :donation_text %>
          <%= f.text_block :tax_rate_id %>
          <%= f.number_block :event_image_required_width %>
          <%= f.number_block :event_image_required_height %>
          <%= f.url_block :become_a_member_url %>
          <%= f.url_block :terms_and_conditions_url %>
          <%= f.text_area_block :terms_and_conditions %>
          <%= f.check_box_block :terms_and_conditions_check_box %>
          <%= f.check_box_block :collect_location %>
          <%= f.check_box_block :collect_phone %>
          <%= f.check_box_block :restrict_cohosting %>
          <%= f.check_box_block :allow_event_submissions %>
          <%= f.check_box_block :hide_ticket_revenue %>
          <% unless @organisation.no_referrer %>
            <%= f.lookup_block :referrer_id, lookup_url: '/accounts.json', placeholder: 'Search accounts', selected_link: (%(<a class="d-inline-block mt-1" target="_blank" href="/u/#{@organisation.referrer.username}">View account</a>) if @organisation.referrer) %>
          <% end %>
        </div>
        <% if Padrino.env == :development || @organisation.experimental? %>
          <div role="tabpanel" class="tab-pane" id="tab-experimental">
            <%= f.text_block :stripe_pk %>
            <%= f.text_block :stripe_sk %>
            <%= f.text_block :stripe_client_id %>
            <%= f.text_area_block :minimal_head %>
            <%= f.text_area_block :events_banner %>
          </div>
        <% end %>
      <% end %>
    </div>
    <div class="ml-3">
      <%= f.submit_block button_text: (@organisation.persisted? ? 'Update organisation' : 'Save and continue') %>
    </div>
  </div>
<% end %>
