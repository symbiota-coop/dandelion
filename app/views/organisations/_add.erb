<%# The id this box comes back to after adding or removing (back in helpers.rb). Not parameterize: template strings can be ASCII-8BIT, which it refuses %>
<% anchor = "#{role.tr(' ', '-')}s" %>
<div id="<%= anchor %>" class="add-remove-box">
  <% organisations.each { |organisation| %>
  <div class="my-1">
    <% if organisation.image %>
      <a href="/o/<%= organisation.slug %>/events"><img alt="<%= organisation.name %>" src="<%= u organisation.image.thumb('500x500#').url %>" style="width: 3.125rem"></a>
    <% end %>
    <a href="/o/<%= organisation.slug %>/events"><%= organisation.name %></a>
  </div>
  <% } %>
  <% remove &&= organisations.exists? %>
  <% if add || remove %>
    <div>
      <% if add %>
        <a id="add-organisation" href="javascript:;" onclick="$(this).hide().next().show();
            $('#remove-organisation').hide()"><i class="bi bi-plus-square-fill"></i></a>
        <div style="display: none">
          <% form_for new_object, new_url, class: 'add-block bg-white shadow-sm p-3 mt-2 mb-3 rounded' do |f| %>
            <%= hidden_field_tag :_anchor, value: anchor %>
            <%= f.lookup_block :organisation_id, lookup_url: '/organisations/autocomplete.json', placeholder: 'Search organisations' %>
            <%= f.submit_block button_text: "Add #{role}" %>
          <% end %>
        </div>
      <% end %>
      <% if remove %>
        <a id="remove-organisation" href="javascript:;" onclick="$(this).hide().next().show();
          $('#add-organisation').hide()"><i class="bi bi-dash-square-fill"></i></a>
        <div style="display: none">
          <% form_tag destroy_url, class: 'add-block bg-white shadow-sm p-3 mt-2 mb-3 rounded' do |f| %>
            <%= hidden_field_tag :_anchor, value: anchor %>
            <%= select_tag :organisation_id, options: organisations.map { |organisation| ["#{organisation.name} (#{organisation.slug})", organisation.id] }, class: 'form-select mb-1' %>
            <%= submit_tag "Remove #{role}", class: 'btn btn-danger' %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
