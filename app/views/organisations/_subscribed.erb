<% form_tag "/o/#{@organisation.slug}/subscribed/#{organisationship.id}" do %>
  <div class="form-check form-switch">
    <%= check_box_tag :subscribed, id: "organisationship-subscribed-#{organisationship.id}", class: 'form-check-input', 'aria-label': 'Subscribed', checked: !organisationship.unsubscribed, onclick: '$(this.form).submit()' %>
  </div>
<% end %>
