<div class="card mb-3" id="payment-opencollective">
  <h3 class="card-header text-bg-primary">Open Collective</h3>
  <div class="card-body pb-0">
    <p>
      Enter the organisation slug from your
      <a href="https://opencollective.com/">Open Collective</a>
      URL — e.g. if the URL is <code>https://opencollective.com/mystica</code>, the slug is <code>mystica</code>.
      <br />
      Then add the Open Collective event slug on each Dandelion event to show Pay with Open Collective at checkout.
    </p>
    <%= f.text_block :oc_slug %>
  </div>
</div>
