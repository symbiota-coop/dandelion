<div class="card mb-3">
  <div class="card-header text-white bg-primary">
    <h4 class="my-0">Stripe</h4>
  </div>
  <div class="card-body">
    <% if @organisation.stripe_client_id %>
      <big>
        <i class="bi bi-credit-card"></i>
        Using revenue sharing
      </big>
    <% elsif @organisation.stripe_sk %>
      <big>
        <i class="bi bi-credit-card"></i>
        Using Stripe API keys (legacy)
      </big>
    <% elsif @organisation.stripe_connect_json %>
      <big class="d-block mb-1">
        <i class="bi bi-credit-card"></i>
        Connected to <%= @organisation.stripe_account_name ? "#{@organisation.stripe_account_name}'s Stripe account" : 'Stripe' %>
        (id: <%= @organisation.stripe_user_id %>)
      </big>
      <a class="btn btn-danger btn-sm" data-method="post" href="/organisations/stripe_disconnect?organisation_id=<%= @organisation.id %>">Disconnect</a>
    <% else %>
      <a class="btn btn-outline-primary mb-1" href="<%= stripe_connect_oauth_url(organisation: @organisation, client_id: ENV['STRIPE_CLIENT_ID']) %>">Connect Stripe</a>
    <% end %>
  </div>
</div>
