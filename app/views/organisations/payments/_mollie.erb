<div class="card mb-3" id="payment-mollie">
  <h3 class="card-header text-bg-primary">Mollie</h3>
  <div class="card-body">
    <p>
      Go to <code>Developers</code> > <code>API keys</code> in your
      <a href="https://my.mollie.com/dashboard/developers/api-keys">Mollie Dashboard</a>
      and copy the live API key.
      <br />
      Enable the payment methods you want on your
      <a href="https://my.mollie.com/dashboard/settings/profiles">website profile</a>
      — buyers will see Mollie's hosted checkout with those methods.
    </p>
    <%= f.secret_block :mollie_api_key %>
  </div>
</div>
