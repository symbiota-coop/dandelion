<div class="card mb-3" id="payment-patreon">
  <div class="card-header text-white bg-primary">
    <h4 class="my-0">Patreon</h4>
  </div>
  <div class="card-body pb-0">
    <p>
      Go to
      <a href="https://www.patreon.com/portal/registration/register-clients">Clients &amp; API Keys</a>
      in the Patreon developer portal, create a client, and copy the
      <code>Creator's Access Token</code>.
    </p>
    <%= f.text_block :patreon_api_key %>
  </div>
</div>
