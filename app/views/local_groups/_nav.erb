<% if local_group.persisted? && local_group_admin?(local_group) %>
  <% unless defined?(inline) %>
    <%== '<div class="nav-crumbs mb-3">' %>
  <% end %>
  <% if organisation_admin?(local_group.organisation) && !defined?(hide_organisation_nav) %>
    <%= partial :'organisations/nav', locals: { organisation: local_group.organisation, inline: true } %>
  <% end %>
  <%= dropdown_nav [
        ['View local group', local_group.path],
        ['Settings', "#{local_group.path}/edit"],
        [%(Followers <span class="badge text-bg-primary">#{local_group.local_groupships.count}</span>), "#{local_group.path}/followers"],
        ['Discount codes' + (local_group.discount_codes.count.positive? ? " <span class='badge text-bg-primary'>#{local_group.discount_codes.count}</span>" : ''), "#{local_group.path}/discount_codes"],
        ['Event stats', "#{local_group.path}/events/stats"],
        ['Audience stats', "#{local_group.path}/stats"],
        ['Feedback', "#{local_group.path}/feedback"],
        ['Mailer', "#{local_group.path}/pmails"]
      ].compact, button_text: %(#{local_group.name}), container_class: "btn-group mb-1#{' nav-crumbs-sibling' if defined?(beside_activity) && beside_activity}" %>
  <% unless defined?(inline) %>
    <%== '</div>' %>
  <% end %>
<% end %>
