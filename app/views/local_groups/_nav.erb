<% if local_group.persisted? && local_group_admin?(local_group) %>
  <% unless defined?(inline) %>
    <%== '<div class="nav-crumbs mb-3">' %>
  <% end %>
  <% if organisation_admin?(local_group.organisation) && !defined?(hide_organisation_nav) %>
    <%= partial :'organisations/nav', locals: { organisation: local_group.organisation, inline: true } %>
  <% end %>
  <%= dropdown_nav [
        ['View local group', "/o/#{local_group.organisation.slug}/lg/#{local_group.slug}"],
        ['Settings', "/local_groups/#{local_group.id}/edit"],
        [%(Followers <span class="badge text-bg-primary">#{local_group.local_groupships.count}</span>), "/local_groups/#{local_group.id}/followers"],
        ['Discount codes' + (local_group.discount_codes.count.positive? ? " <span class='badge text-bg-primary'>#{local_group.discount_codes.count}</span>" : ''), "/local_groups/#{local_group.id}/discount_codes"],
        ['Event stats', "/local_groups/#{local_group.id}/events/stats"],
        ['Audience stats', "/local_groups/#{local_group.id}/stats"],
        ['Feedback', "/local_groups/#{local_group.id}/feedback"],
        ['Mailer', "/local_groups/#{local_group.id}/pmails"]
      ].compact, button_text: %(#{local_group.name}), container_class: "btn-group mb-1#{' nav-crumbs-sibling' if defined?(beside_activity) && beside_activity}" %>
  <% unless defined?(inline) %>
    <%== '</div>' %>
  <% end %>
<% end %>
