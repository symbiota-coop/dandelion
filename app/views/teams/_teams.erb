<table class="table table-striped">
  <thead>
    <tr>
      <th>Team</th>
      <th>Members</th>
    </tr>
  </thead>
  <% @gathering.teams.includes(teamships: :account).order('name asc').each { |team| %>
  <tr>
    <td>
      <a href="/g/<%= @gathering.slug %>/teams/<%= team.id %>">
        <%= team.name %>
      </a>
      <div class="wysiwyg">
        <%== Sanitize.fragment(team.intro, Sanitize::Config::DANDELION) %>
      </div>
    </td>
    <td>
      <% if team.teamships.exists? %>
        <% y = [] %>
        <% team.teamships.each { |teamship| account = teamship.account; %>
        <% mine = teamship.account_id == current_account.id %>
        <% y << capture do %>
          <%= partial :'gatherings/avatar_menu', locals: {
                account: account, names: params[:view] == 'names',
                remove_url: ("/teamships/#{teamship.id}/destroy" if mine || gathering_admin?),
                remove_confirm: (mine ? "Leave #{team.name}?" : "Remove this person from #{team.name}?")
              } %>
        <% end %>
        <% } %>
        <% if params[:view] == 'names' %>
          <%== y.map(&:strip).join(' &middot; ') %>
        <% else %>
          <div class="image-wall">
            <%== y.map(&:strip).join('') %>
          </div>
        <% end %>
      <% else %>
        n/a
      <% end %>
    </td>
  </tr>
  <% } %>
</table>
