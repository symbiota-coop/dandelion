<td class="text-center">
  <% if event.activity %>
    <% if event.activity.image %>
      <a href="<%= event.activity.path %>">
        <img alt="<%= event.activity.name %>" src="<%= u event.activity.image.thumb('500x500#').url %>" style="width: 3.125rem">
      </a>
      <br>
    <% end %>
    <a href="<%= event.activity.path %>"><%= event.activity.name %></a>
  <% end %>
</td>
