<td nowrap>
  <a data-bs-toggle="tooltip" title="Edit event" class="btn btn-sm btn-primary" href="/e/<%= event.slug %>/edit"><i class="bi bi-pencil-fill"></i></a>
  <%# The link is fetched on click: building the image's url can store a copy of it (dragonfly_config.rb), which takes a second or so %>
  <% if event.image_source(organisation) %>
    <a data-bs-toggle="tooltip" title="Copy linked image" class="btn btn-sm btn-primary" href="javascript:;" data-linked-image-url="/events/<%= event.id %>/linked_image?organisation_id=<%= organisation.id %>" onclick="
        var html = Promise.resolve($.get(this.dataset.linkedImageUrl)).then(function (text) {
          return new Blob([text], { type: 'text/html' });
        });
        navigator.clipboard.write([new ClipboardItem({ 'text/html': html })]).then(function () {
          alert('Linked image copied');
        }, function () {
          alert('The linked image could not be copied');
        });
    "><i class="bi bi-image"></i></a>
  <% end %>
</td>
