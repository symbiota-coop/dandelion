<td>
  <% complete_tickets = event.complete_ticket_rows %>
  <% if (checked_in = complete_tickets.count { |ticket| ticket.checked_in == true }) > 0 %>
    <a href="/e/<%= event.slug %>/tickets">
      <%= checked_in %>/<%= complete_tickets.size %>
    </a>
    <a class="d-block text-decoration-none" href="/e/<%= event.slug %>/tickets">
      <div class="progress" data-bs-toggle="tooltip" title="<%= checked_in %>/<%= complete_tickets.size %> tickets sold">
        <div class="progress-bar" role="progressbar" style="width: <%= "#{((checked_in / complete_tickets.size.to_f) * 100).round}%" %>;"></div>
      </div>
    </a>
  <% end %>
</td>
