<td>
  <% if (feedback_count = event.feedback_count) > 0 %>
    <a href="/e/<%= event.slug %>/feedback"><%= pluralize(feedback_count, 'response') %></a>
    <% if (attendees_count = event.attendees_count) > 0 %>
      (<%= "#{(100 * (feedback_count.to_f / attendees_count)).round}%" %>)
    <% end %>
    <% if (average_rating = event.average_feedback_rating) %>
      <br>
      <span class="fs-5" title="Average rating <%= average_rating %>">
        <%= average_rating %>
      </span>
    <% end %>
  <% end %>
</td>
