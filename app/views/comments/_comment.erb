<% if comment.commentable.respond_to?(:gathering) %>
  <% comment.read_receipts.create account: current_account %>
<% end %>
<div class="d-flex align-items-start m-0 px-2 pt-2">
  <span class="me-2">
    <%= partial :'accounts/square', locals: { account: comment.account, width: '32px' } %>
  </span>
  <div class="flex-grow-1 comment" data-comment-id="<%= comment.id %>">
    <% if comment_admin?(comment) %>
      <span class="float-end">
        <% if !comment.sent_at %>
          <a data-method="post" title="Send comment" href="/comments/<%= comment.id %>/send"><i class="bi bi-envelope-fill"></i></a>
        <% end %>
      </span>
    <% end %>
    <strong><a href="/u/<%= comment.account.username %>"><%= comment.account.name %></a></strong>
    <small class="text-body-secondary">
      <%= timeago(comment.created_at) %>
      <% if admin? or (current_account && comment.account_id == current_account.id) %>
        &middot;
        <%= partial :'comments/edit_button' %>
      <% end %>
    </small>
    <div class="mb-2">
      <%= partial :'comments/body', locals: { comment: comment } %>
    </div>
    <div class="row justify-content-between align-items-center">
      <div data-pagelet-url="/comments/<%= comment.id %>/reactions" class="col-auto">
        <%= partial :'comments/comment_reactions', locals: { comment: comment } %>
      </div>
      <% if comment.commentable.respond_to?(:gathering) %>
        <div data-pagelet-url="/comments/<%= comment.id %>/read_receipts" class="col-auto">
          <%= partial :'comments/read_receipts', locals: { comment: comment } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
