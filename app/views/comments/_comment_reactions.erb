<% if !comment.comment_reactions.find_by(account: current_account) %>
  <a data-bs-toggle="tooltip" title="React" class="btn btn-sm btn-outline-primary" href="javascript:;" onclick="$(this).tooltip('hide').hide().next().css('display', 'inline-flex')">
    <i class="bi bi-heart-fill"></i>
  </a>
  <% form_tag "/comments/#{comment.id}/react", class: 'form-inline', style: 'display: none;' do %>
    <div class="d-flex align-items-center">
      <div>
        <% %w[💚 👍 🙏 👀 🙌 🎉].each { |e| %>
        <a class="btn btn-sm btn-outline-light" href="javascript:;" onclick="$(this).closest('form').find('input').val($(this).html().includes('bi-heart-fill') ? '💚' : $(this).text()).closest('form').submit()">
          <% if e == "💚" %>
            <i class="text-primary bi bi-heart-fill"></i>
          <% else %>
            <%= e %>
          <% end %>
        </a>
        <% } %>
      </div>
      <div class="input-group input-group-sm ms-2" style="width: 8rem">
        <%= text_field_tag :body, class: 'form-control form-control-sm', placeholder: 'word/emoji' %>
        <button class="btn btn-primary" type="submit"><i class="bi bi-send-fill"></i></button>
      </div>
    </div>
  <% end %>
<% end %>
<% if comment.comment_reactions.exists? %>
  <% all_reactions = comment.comment_reactions.includes(:account); reactions_by_body = all_reactions.group_by(&:body) %>
  <% reactions_by_body.each { |body, comment_reactions| %>
  <% c = 'd-inline-block border rounded p-1 text-body text-decoration-none bg-white' %>
  <a data-bs-toggle="tooltip" <% if comment_reactions.find { |r| r.account_id == current_account.id } %> class="pagelet-trigger border-primary <%= c %>" href="/comments/<%= comment.id %>/unreact" onclick="$(this).tooltip('hide')" <% else %> class="<%= c %> border-light" <% end %>>
    <% if body == "💚" %>
      <i class="text-primary bi bi-heart-fill"></i>
<% else %>
  <%= body %>
<% end %>
<%= comment_reactions.count %>
</a>
<span style="display: none">
  <%== comment_reactions.map { |comment_reaction| Sanitize.fragment(comment_reaction.account.name) }.join('<br />') %>
</span>
<% } %>
<% end %>
