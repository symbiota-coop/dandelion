<% commentable.comments.order('created_at asc').each do |comment| %>
  <%= partial :'comments/comment', locals: { comment: comment } %>
<% end %>
<div class="d-flex align-items-start m-0 px-2 pt-2">
  <span class="me-2">
    <%= partial :'accounts/square', locals: { account: current_account, size: :xs } %>
  </span>
  <div class="flex-grow-1">
    <%= partial :'comments/comment_form', locals: { comment: commentable.comments.build, chat: true } %>
  </div>
</div>
<div class="small" style="padding-left: 1em; padding-bottom: 1em">
  <% if (post = commentable.discussion_post) %>
    <% if (subscription = post.subscriptions.find_by(account: current_account)) %>
      <a class="pagelet-trigger" href="/subscriptions/<%= subscription.id %>/unsubscribe">Email notifications on</a>
    <% else %>
      <a class="text-body-secondary pagelet-trigger" data-method="post" href="/subscriptions/create?post_id=<%= post.id %>">Email notifications off</a>
    <% end %>
    <span class="text-body-secondary">&middot; <%= pluralize(post.subscriptions.count, 'person') %> subscribed</span>
  <% elsif commentable.tickets.complete.and(account: current_account).exists? %>
    <%= partial :'events/subscribe_discussion', locals: { event: commentable } %>
  <% end %>
</div>
<script>
  $(function() {
    $('#comment_body').attr('autocomplete', 'off')
    $("#chat").scrollTop($("#chat")[0].scrollHeight);
  })
</script>
