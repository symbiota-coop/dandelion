<% comment = post.comments.order('created_at asc').first %>
<% if comment.commentable.respond_to?(:gathering) %>
  <% comment.read_receipts.create account: current_account %>
<% end %>
<div class="card mb-5" id="post-<%= post.id %>">
  <h3 class="card-header text-bg-primary"><%= post.subject %></h3>
  <div class="card-body p-0">
    <div class="d-flex align-items-start px-2 pt-2">
      <span class="me-2">
        <%= partial :'accounts/square', locals: { account: comment.account, width: '32px' } %>
      </span>
      <div class="flex-grow-1 comment" data-comment-id="<%= comment.id %>">
        <span class="float-end">
          <% if (subscription = comment.post.subscriptions.find_by(account: current_account)) %>
            <a title="Email notifications on; click to turn off" class="pagelet-trigger me-1" href="/subscriptions/<%= subscription.id %>/unsubscribe"><i class="bi bi-eye"></i></a>
          <% else %>
            <a style="opacity: 0.3" title="Email notifications off; click to turn on" class="pagelet-trigger me-1" data-method="post" href="/subscriptions/create?post_id=<%= comment.post_id %>"><i class="bi bi-eye-slash"></i></a>
          <% end %>
          <% if comment_admin?(comment) %>
            <% if !comment.sent_at %>
              <a data-method="post" title="Send comment" href="/comments/<%= comment.id %>/send"><i class="bi bi-envelope-fill"></i></a>
            <% end %>
          <% end %>
        </span>
        <strong><a href="/u/<%= comment.account.username %>"><%= comment.account.name %></a></strong>
        <small class="text-body-secondary">
          <a class="text-body-secondary" href="#post-<%= post.id %>"><%= timeago(comment.created_at) %></a>
          <% if admin? or (current_account && comment.account_id == current_account.id) %>
            &middot;
            <%= partial :'comments/edit_button' %>
          <% end %>
        </small>
        <div class="mb-3">
          <%= partial :'comments/body', locals: { comment: comment } %>
        </div>
        <div class="mb-2">
          <div class="row justify-content-between align-items-center">
            <div data-pagelet-url="/comments/<%= comment.id %>/reactions" class="col-auto">
              <%= partial :'comments/comment_reactions', locals: { comment: comment } %>
            </div>
            <% if comment.commentable.respond_to?(:gathering) %>
              <div data-pagelet-url="/comments/<%= comment.id %>/read_receipts" class="col-auto">
                <%= partial :'comments/read_receipts', locals: { comment: comment } %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="comment-grey" style="background: var(--bs-gray-200)">
      <div data-pagelet-url="/posts/<%= post.id %>/post_replies">
        <%= partial :'comments/replies', locals: { post: post } %>
      </div>
      <div class="d-flex align-items-start m-0 px-2 pt-2">
        <span class="me-2">
          <%= partial :'accounts/square', locals: { account: current_account, width: '32px' } %>
        </span>
        <div class="flex-grow-1">
          <%= partial :'comments/comment_form', locals: { comment: post.comments.build(commentable_type: post.commentable_type, commentable_id: post.commentable_id), reply: true } %>
        </div>
      </div>
    </div>
  </div>
</div>
