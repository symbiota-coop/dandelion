<%# A table's shape while it loads: a heading cell of each width in columns (in em), and rows of lines of random length %>
<div class="table-responsive mb-3" aria-hidden="true">
  <table class="table table-sm placeholder-glow <%= defined?(table_class) ? table_class : nil %>">
    <thead>
      <tr>
        <% columns.each do |width| %>
          <th><span class="placeholder" style="width: <%= width %>em"></span></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.times do %>
        <tr>
          <% columns.each do %>
            <td><span class="placeholder" style="width: <%= rand(40..100) %>%"></span></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
