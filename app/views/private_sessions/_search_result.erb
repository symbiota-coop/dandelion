<div class="search-result-person">
  <div class="search-result-media h-auto me-3">
    <a href="<%= private_session.path %>" data-open-in-modal data-modal-size="lg">
      <% if private_session.image %>
        <img class="d-block w-100" alt="<%= private_session.title %>" src="<%= u private_session.image.thumb('400x400#').url %>">
      <% else %>
        <div class="block-fill ratio ratio-1x1"></div>
      <% end %>
    </a>
  </div>
  <div class="search-result-content search-result-stacked">
    <div class="search-result-header">
      <h2>
        <a class="text-body" href="<%= private_session.path %>" data-open-in-modal data-modal-size="lg"><%= private_session.title %></a>
      </h2>
      <div class="mb-1">
        <%= partial :'private_sessions/badges', locals: { private_session: private_session } %>
      </div>
    </div>
    <div class="search-result-details pt-2">
      <div>
        <%= partial :'accounts/square', locals: { account: private_session.account, size: :xs } %>
        <a href="/u/<%= private_session.account.username %>"><%= private_session.account.name %></a>
      </div>
    </div>
  </div>
</div>
