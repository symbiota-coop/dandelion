<%# A session's badges, description and how to book it: on its page and in #modal %>
<div class="mb-3">
  <%= partial :'private_sessions/badges', locals: { private_session: private_session } %>
</div>
<%# Below 576px, Edit is here, under the badges, rather than beside the title (on its page and in #modal) %>
<% if private_session_admin?(private_session) %>
  <a class="btn btn-sm btn-outline-primary d-sm-none mb-3" href="<%= private_session.path %>/edit" data-open-in-modal data-modal-size="lg"><i class="bi bi-pencil"></i> Edit</a>
<% end %>

<% if private_session.description.present? %>
  <div class="wysiwyg readable mt-3">
    <%== Sanitize.fragment(private_session.description, Sanitize::Config::DANDELION) %>
  </div>
<% end %>

<% if private_session.how_to_book.present? %>
  <div id="how-to-book" class="mt-4">
    <h3 class="heading-rule">How to book</h3>
    <div class="wysiwyg readable"><%== Sanitize.fragment(Rinku.auto_link(private_session.how_to_book), Sanitize::Config::DANDELION) %></div>
  </div>
<% end %>

<%= partial :'private_sessions/vouches', locals: { private_session: private_session } %>
