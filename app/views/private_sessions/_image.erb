<%# The session's image, or without one the picture of the person offering it, or if they have none the lavender wash
    image-less tiles have (.block-fill). fill: as wide as its container (the modal), from a larger thumbnail %>
<% fill = defined?(fill) && fill %>
<% style = fill ? 'width: 100%' : 'width: 400px; max-width: 100%' %>
<% if (image = private_session.image || private_session.account.image) %>
  <img class="<%= klass if defined?(klass) %>" alt="<%= private_session.title_with_name %>" src="<%= u image.thumb(fill ? '800x800#' : '400x400#').url %>" style="<%= style %>">
<% else %>
  <div class="<%= klass if defined?(klass) %> block-fill ratio ratio-1x1" style="<%= style %>"></div>
<% end %>
