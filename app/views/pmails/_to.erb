<% case pmail.recipient_kind
   when 'everyone' %>
  Everyone in <%= pmail.organisation.name %>
<% when 'monthly_donors' %>
  Monthly donors
<% when 'not_monthly_donors' %>
  People who aren't monthly donors
<% when 'facilitators' %>
  Facilitators
<% when 'activity' %>
  Activity: <a href="/o/<%= pmail.mailable.organisation.slug %>/a/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% when 'activity_tag' %>
  Activity tag:
  <span class="text-white label label-primary d-inline-block mb-1"><%= pmail.mailable.name %></span>
<% when 'local_group' %>
  Local group: <a href="/o/<%= pmail.mailable.organisation.slug %>/lg/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% when 'ticket_group' %>
  Ticket group <%= pmail.ticket_group ? pmail.ticket_group.name : '[deleted group]' %> for <a href="/e/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% when 'ticket_type_waitlist' %>
  Ticket type waitlist <%= pmail.ticket_type ? pmail.ticket_type.name : '[deleted ticket type]' %> for <a href="/e/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% when 'all_ticket_type_waitlists' %>
  Ticket type waitlists: <a href="/e/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% when 'waitlist' %>
  Waitlist: <a href="/e/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% when 'event' %>
  Event: <a href="/e/<%= pmail.mailable.slug %>"><%= pmail.mailable.name %></a>
<% end %>
<% if pmail.event_recipients? %>
  <br />
  <small><%= concise_when_details(pmail.mailable) %></small>
<% end %>
