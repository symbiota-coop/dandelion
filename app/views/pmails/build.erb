<%= context_nav %>
<% organisation = @organisation || context_record&.last&.organisation %>

<style>
  #pmail_body { height: 30rem; }
</style>

<script type="text/javascript">
  $(function () {

    if (<%== (params[:preview] ? true : false).to_json %>) {
      window.open(<%== "/pmails/#{@pmail.id}/preview?#{@scope}".to_json %>, null, 'scrollbars=yes,width=800,height=600,left=150,top=150').focus();
    }

    $('#pmail-form').submit(function() {
      if($('#pmail_to_option').val().length == 0) {
        alert('Please set the To field')
        return false
      }
    })

  });
</script>

<% form_for @pmail, @pmail.new_record? ? '/pmails/new' : "/pmails/#{@pmail.id}/edit", id: 'pmail-form', multipart: true do |f| %>
  <% pmail_send_count = @pmail.send_count if @pmail.persisted? %>

  <%= partial :'pmails/header', locals: { f: f, organisation: organisation, send_count: pmail_send_count } %>
  <%= partial :'pmails/clicks', locals: { f: f, organisation: organisation } %>

  <div style="max-width: 45rem; margin: 0 auto;">

    <%= context_id_field %>

    <%= partial :'pmails/to_options', locals: { f: f, organisation: organisation } %>
    <%= partial :'pmails/exclude', locals: { f: f, organisation: organisation } %>

    <% if @pmail.persisted? %>
      <span class="mb-3 badge text-bg-primary"><%= pluralize(pmail_send_count, 'person') %></span>
    <% end %>

    <%= f.text_block :from %>
    <%= f.text_block :subject %>
    <%= f.text_block :preview_text %>

    <% if @pmail.markdown? %>
      <div class="w-100 overflow-hidden" contenteditable="true" id="pastebin" style="opacity: 0.01; height: 1px"></div>
      <%= f.text_area_block :body %>
    <% else %>
      <%= f.wysiwyg_block :body %>
    <% end %>

    <%= f.text_block :link_params %>
    <% if !@pmail.sent_at %>
      <%= f.submit_block destroy_url: "/pmails/#{@pmail.id}/destroy?#{@scope}", button_text: @pmail.new_record? ? 'Save and continue' : 'Save' %>
    <% end %>

    <% if organisation %>
      <%= partial :'pmails/files', locals: { f: f, organisation: organisation } %>
    <% end %>

  </div>

<% end %>
