<% network_notifications = current_account.network_notifications %>

<div class="list-group list-group-flush notification-list">
  <% network_notifications.order('created_at desc').limit(5).each do |notification| %>
    <a class="list-group-item list-group-item-action d-flex align-items-start gap-2" href="<%= notification.link[1] %>">
      <%= partial :notification_summary, locals: { notification: notification } %>
    </a>
  <% end %>
  <a class="list-group-item list-group-item-action text-center" href="/">All notifications <i class="bi bi-arrow-right"></i></a>
</div>
<% if current_account.unread_notifications?(network_notifications) %>
  <script>
    $(function () {
      $('#notifications-a').addClass('with-label')
    })
  </script>
<% end %>
