<% network_notifications = current_account.network_notifications %>

<div class="dropdown-menu dropdown-lg p-0">
  <div class="list-group list-group-flush notification-list">
    <% network_notifications.order('created_at desc').limit(5).each do |notification| %>
      <a class="list-group-item list-group-item-action d-flex gap-2" href="<%= notification.link[1] %>">
        <i class="bi <%= notification.icon %> notification-icon"></i>
        <div class="notification-info">
          <h4 class="notification-title"><%= notification.sentence %></h4>
          <p class="notification-desc">
            <%= notification.circle.name %>
            <span class="notification-time"><%= timeago(notification.created_at) %></span>
          </p>
        </div>
      </a>
    <% end %>
    <a class="list-group-item list-group-item-action text-center" href="/">All notifications <i class="bi bi-arrow-right"></i></a>
  </div>
</div>
<% if current_account.unread_notifications?(network_notifications) %>
  <script>
    $(function () {
      $('#notifications-a').addClass('with-label')
    })
  </script>
<% end %>
