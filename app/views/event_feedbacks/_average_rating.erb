<% if average_rating %>
  <div class="average-rating">
    <%= average_rating %><small class="text-body-secondary">/5
      from <%= pluralize ratings_count, 'rating' %>
      <% if events_count %>
        across <%= pluralize events_count, 'event' %>
      <% end %>
    </small>
    <div class="d-lg-inline">
      <% average_rating.round.times do %><i class="bi bi-star-fill"></i><% end %>
    </div>
  </div>
<% end %>
