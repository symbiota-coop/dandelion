<%= partial :'event_feedbacks/rating_breakdown', locals: { event_feedbacks: event_feedbacks } %>

<% if !params[:minimal] %>

  <% if @activity %>
    <% if @activity.feedback_summary %>
      <div class="ai-well my-3 readable" data-bs-toggle="tooltip" title="AI-generated summary ✨">
        <%= @activity.feedback_summary_html %>
      </div>
    <% end %>
    <% if activity_admin? %>
      <div class="mt-1">
        <% if admin? || (@activity.feedback_summary_last_refreshed_at.nil? || @activity.feedback_summary_last_refreshed_at <= 24.hours.ago) %>
          <% if @activity.feedback_summary_last_refreshed_at.nil? %>
            <a data-method="post" href="/activities/<%= @activity.id %>/feedback_summary">Refresh feedback summary</a>
          <% else %>
            <span class="text-body-secondary">Last updated <%= timeago @activity.feedback_summary_last_refreshed_at %> ·</span> <a data-method="post" href="/activities/<%= @activity.id %>/feedback_summary">Refresh</a>
          <% end %>
        <% else %>
          <span class="text-body-secondary">Refresh again in <%= distance_of_time_in_words(Time.now, @activity.feedback_summary_last_refreshed_at + 24.hours) %></span>
        <% end %>
        <% if @activity.feedback_summary %>
          <span class="text-body-secondary"> · </span><a data-method="post" href="/activities/<%= @activity.id %>/feedback_summary/delete" data-confirm="Are you sure you want to remove this feedback summary?">Remove</a>
        <% end %>
      </div>
    <% end %>
  <% elsif @account %>
    <% if @account.feedback_summary %>
      <div class="ai-well my-3 readable" data-bs-toggle="tooltip" title="AI-generated summary ✨">
        <%= @account.feedback_summary_html %>
      </div>
    <% end %>
    <% if (admin? || (current_account && @account == current_account)) %>
      <div class="mt-1">
        <% if admin? || (@account.feedback_summary_last_refreshed_at.nil? || @account.feedback_summary_last_refreshed_at <= 24.hours.ago) %>
          <% if @account.feedback_summary_last_refreshed_at.nil? %>
            <a data-method="post" href="/accounts/<%= @account.id %>/feedback_summary">Refresh feedback summary</a>
          <% else %>
            <span class="text-body-secondary">Last updated <%= timeago @account.feedback_summary_last_refreshed_at %> ·</span> <a data-method="post" href="/accounts/<%= @account.id %>/feedback_summary">Refresh</a>
          <% end %>
        <% else %>
          <span class="text-body-secondary">Refresh again in <%= distance_of_time_in_words(Time.now, @account.feedback_summary_last_refreshed_at + 24.hours) %></span>
        <% end %>
        <% if @account.feedback_summary %>
          <span class="text-body-secondary"> · </span><a data-method="post" href="/accounts/<%= @account.id %>/feedback_summary/delete" data-confirm="Are you sure you want to remove this feedback summary?">Remove</a>
        <% end %>
      </div>
    <% end %>
  <% elsif @organisation %>
    <% if @organisation.feedback_summary %>
      <div class="ai-well my-3 readable" data-bs-toggle="tooltip" title="AI-generated summary ✨">
        <%= @organisation.feedback_summary_html %>
      </div>
    <% end %>
    <% if organisation_admin? %>
      <div class="mt-1">
        <% if admin? || (@organisation.feedback_summary_last_refreshed_at.nil? || @organisation.feedback_summary_last_refreshed_at <= 24.hours.ago) %>
          <% if @organisation.feedback_summary_last_refreshed_at.nil? %>
            <a data-method="post" href="/organisations/<%= @organisation.id %>/feedback_summary">Refresh feedback summary</a>
          <% else %>
            <span class="text-body-secondary">Last updated <%= timeago @organisation.feedback_summary_last_refreshed_at %> ·</span> <a data-method="post" href="/organisations/<%= @organisation.id %>/feedback_summary">Refresh</a>
          <% end %>
        <% else %>
          <span class="text-body-secondary">Refresh again in <%= distance_of_time_in_words(Time.now, @organisation.feedback_summary_last_refreshed_at + 24.hours) %></span>
        <% end %>
        <% if @organisation.feedback_summary %>
          <span class="text-body-secondary"> · </span><a data-method="post" href="/organisations/<%= @organisation.id %>/feedback_summary/delete" data-confirm="Are you sure you want to remove this feedback summary?">Remove</a>
        <% end %>
      </div>
    <% end %>
  <% end %>

<% end %>

<% event_feedbacks = event_feedbacks.and(:rating.ne => nil).order('created_at desc').paginate(page: params[:page], per_page: 10) %>
<div class="feedback-list mt-3">
  <% event_feedbacks.each { |event_feedback| account = event_feedback.account %>
  <% answers = event_feedback.deleted_at ? [] : (event_feedback.public_answers || []).map { |_q, a| a if a.present? }.compact %>
  <article class="feedback-entry<% if event_feedback.deleted_at %> opacity-50<% end %>">
    <div class="d-flex align-items-center gap-2 mb-2">
      <% if event_feedback.deleted_at %>
        <em>Removed</em>
      <% else %>
        <%= partial :'event_feedbacks/stars', locals: { rating: event_feedback.rating } %>
      <% end %>
      <small class="text-body-secondary"><%= timeago event_feedback.created_at %></small>
    </div>
    <% if answers.any? %>
      <div class="readable mb-2"><%== Sanitize.fragment(answers.join('<br /><br />').gsub("\n", '<br />'), Sanitize::Config::DANDELION) %></div>
    <% end %>
    <div class="small">
      <% if !account || event_feedback.anonymous? %>
        Anonymous
      <% elsif account.publicly_visible? %>
        <a <% if params[:minimal] %>target="_blank"<% end %> href="/u/<%= account.username %>"><%= account.name %></a>
      <% else %>
        <%= account.abbrname %>
      <% end %>
      <% if event_feedback.event %>
        <span class="text-body-secondary">on</span> <a <% if params[:minimal] %>target="_blank"<% end %> href="/e/<%= event_feedback.event.slug %>"><%= event_feedback.event.name %></a>
      <% end %>
    </div>
    <% if answers.any? && event_feedback.response && event_feedback.respondable? %>
      <div class="feedback-reply mt-2">
        <div class="small fw-semibold mb-1"><i class="bi bi-reply-fill"></i> <%= event_feedback.event.organisation.name %> replied</div>
        <div class="readable read-more"><%== Sanitize.fragment(Rinku.auto_link(event_feedback.response.gsub("\n", '<br />')), Sanitize::Config::DANDELION) %></div>
      </div>
    <% end %>
  </article>
  <% } %>
</div>
<%= will_paginate event_feedbacks, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
