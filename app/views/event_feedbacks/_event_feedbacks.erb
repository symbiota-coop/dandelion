<%= partial :'event_feedbacks/rating_breakdown', locals: { event_feedbacks: event_feedbacks } %>

<% if !params[:minimal] %>
  <%= partial :'event_feedbacks/feedback_summary' %>
<% end %>

<% event_feedbacks = event_feedbacks.and(:rating.ne => nil).order('created_at desc').paginate(page: params[:page], per_page: 10) %>
<div class="feedback-list mt-3">
  <% event_feedbacks.each { |event_feedback| account = event_feedback.account %>
  <% answers = event_feedback.deleted_at ? [] : (event_feedback.public_answers || []).map { |_q, a| a if a.present? }.compact %>
  <article class="feedback-entry<% if event_feedback.deleted_at %> opacity-50<% end %>">
    <div class="d-flex align-items-center gap-2 mb-2">
      <% if event_feedback.deleted_at %>
        <em>Removed</em>
      <% else %>
        <%= partial :'event_feedbacks/stars', locals: { rating: event_feedback.rating } %>
      <% end %>
      <small class="text-body-secondary"><%= timeago event_feedback.created_at %></small>
    </div>
    <% if answers.any? %>
      <div class="readable mb-2"><%== Sanitize.fragment(answers.join('<br /><br />').gsub("\n", '<br />'), Sanitize::Config::DANDELION) %></div>
    <% end %>
    <div class="small">
      <% if !account || event_feedback.anonymous? %>
        Anonymous
      <% elsif account.publicly_visible? %>
        <a <% if params[:minimal] %> target="_blank"<% end %> href="/u/<%= account.username %>"><%= account.name %></a>
      <% else %>
        <%= account.abbrname %>
      <% end %>
      <% if event_feedback.event %>
        <span class="text-body-secondary">on</span> <a <% if params[:minimal] %> target="_blank"<% end %> href="/e/<%= event_feedback.event.slug %>"><%= event_feedback.event.name %></a>
      <% end %>
    </div>
    <% if answers.any? && event_feedback.response && event_feedback.respondable? %>
      <div class="feedback-reply mt-2">
        <div class="small fw-semibold mb-1"><i class="bi bi-reply-fill"></i> <%= event_feedback.event.organisation.name %> replied</div>
        <div class="readable read-more"><%== Sanitize.fragment(Rinku.auto_link(event_feedback.response.gsub("\n", '<br />')), Sanitize::Config::DANDELION) %></div>
      </div>
    <% end %>
  </article>
  <% } %>
</div>
<%= will_paginate event_feedbacks, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
