<link rel="stylesheet" href="<%= cachebust('/stylesheets/event_feedbacks.css') %>">

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card my-4">
      <h3 class="card-header chill">Feedback on <%= @event.summary %></h3>
      <div class="card-body p-4">
        <% if @preview %>
          <div class="alert alert-warning">This is a preview of the feedback form. Submission is disabled.</div>
        <% end %>

        <% form_for @event_feedback, "/events/#{@event.id}/give_feedback" do |f| %>
          <% if params[:email] %>
            <%= hidden_field_tag :email, value: params[:email] %>
          <% elsif params[:token] %>
            <%= hidden_field_tag :token, value: params[:token] %>
          <% end %>
          <%# A radio per star, visually hidden, so the rating can be chosen with a click, a tap or the keyboard (Tab, then the arrow keys) %>
          <fieldset class="feedback-rating-panel text-center py-4 px-3 mb-4">
            <legend class="feedback-question-label mb-1">Your star rating</legend>
            <p class="small text-body-secondary mb-3">Your star rating is always public and contributes towards the host's average.</p>
            <div class="feedback-stars">
              <% 1.upto(5) do |i| %>
                <input type="radio" class="visually-hidden" name="event_feedback[rating]" id="event_feedback_rating_<%= i %>" value="<%= i %>" <%= "checked" if @event_feedback.rating == i %>>
                <label for="event_feedback_rating_<%= i %>" class="bi bi-star-fill" data-rating="<%= i %>"><span class="visually-hidden"><%= i %> out of 5 stars</span></label>
              <% end %>
            </div>
          </fieldset>

          <%= partial :'events/feedback_questions' %>

          <div class="border-top pt-4 mt-2">
            <p class="text-body-secondary small fw-bold text-uppercase mb-3" style="letter-spacing: 0.04em;">Privacy</p>
            <%= checkbox 'Allow written answers to be quoted publicly', slug: :publicly_visible, checked: true, form_group_class: 'mb-3' %>
            <%= checkbox 'Anonymise this feedback', slug: :anonymous, form_group_class: 'mb-3' %>
          </div>

          <%= f.submit_block button_text: 'Submit feedback', disabled: @preview %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  $(function() {
    var $stars = $('.feedback-stars label');
    var $radios = $('.feedback-stars input');

    function chosenRating() {
      return parseInt($radios.filter(':checked').val(), 10) || 0;
    }

    // Stars up to count are orange
    function paintStars(count) {
      $stars.each(function(i) {
        $(this).toggleClass('chosen', i < count);
      });
    }

    // Hovering previews a rating
    $stars.on('mouseenter', function() { paintStars($(this).data('rating')); });
    $stars.on('mouseleave', function() { paintStars(chosenRating()); });

    $radios.on('change', function() { paintStars(chosenRating()); });
    paintStars(chosenRating());

    $($radios[0].form).submit(function() {
      if (!chosenRating()) {
        alert('Please provide a star rating');
        return false;
      }
    });
  });
</script>
