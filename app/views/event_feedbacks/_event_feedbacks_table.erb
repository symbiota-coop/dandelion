<% if @event %>
  <div class="row justify-content-end mb-2">
    <div class="col-auto">
      <a class="btn btn-primary" href="/events/<%= @event.id %>/feedback.csv?<%= request.query_string %>"><i class="bi bi-download"></i> CSV</a>
    </div>
  </div>
<% end %>

<script>
  $(function () {
    // On phones the .desktop columns are hidden, and the chevron in a row's first cell shows them in a row below it
    $('#event_feedbacks .feedback-toggle').once('feedback-toggle').on('click', function () {
      const $row = $(this).closest('tr')
      if (!$row.next('.feedback-details').length) {
        const $headers = $('#event_feedbacks thead th')
        const rows = $row.children('.desktop').map(function () {
          const $cell = $(this)
          if (!$cell.text().trim() && !$cell.find('[data-pagelet-url], img, a, button').length) return null
          return '<tr><th>' + $headers.eq($cell.index()).text() + '</th><td>' + $cell.html() + '</td></tr>'
        }).get().join('')
        const $details = $('<tr class="feedback-details"><td colspan="' + $headers.not('.desktop').length + '">' +
          '<table class="table table-sm table-borderless mb-0"><tbody>' + rows + '</tbody></table></td></tr>')
        // Copied pagelets load afresh
        $details.find('[data-pagelet-url]').each(function () {
          const $p = $(this)
          $p.removeAttr('data-pagelet-loaded').empty().load($p.attr('data-pagelet-url'))
        })
        $row.after($details)
      }
      $row.toggleClass('expanded')
      $(this).attr('aria-expanded', $row.hasClass('expanded'))
    })
  })
</script>

<style>
  #event_feedbacks .feedback-details {
    display: none;
  }

  #event_feedbacks .feedback-toggle i {
    display: inline-block;
    transition: rotate var(--transition-fast);
  }

  #event_feedbacks tr.expanded .feedback-toggle i {
    rotate: 90deg;
  }

  #event_feedbacks .feedback-details th {
    width: 1%;
    white-space: nowrap;
    padding-right: 1em;
  }

  @media (min-width: 768px) {
    #event_feedbacks .control {
      display: none;
    }
  }

  /* On phones, the .desktop columns and usernames hide, and the chevron shows them */
  @media (max-width: 767.98px) {
    #event_feedbacks .desktop,
    #event_feedbacks a[data-account-username] {
      display: none;
    }

    #event_feedbacks .control {
      width: 1.875rem;
      padding-left: 0;
      padding-right: 0;
    }

    #event_feedbacks tr.expanded + tr.feedback-details {
      display: table-row;
    }
  }
</style>

<table id="event_feedbacks" class="table">
  <thead>
    <tr>
      <th class="control"></th>
      <th>Name</th>
      <% if defined?(event_name) %>
        <th>Event</th>
      <% end %>
      <% if defined?(activity_name) %>
        <th class="desktop">Activity</th>
      <% end %>
      <th>Rating</th>
      <th class="desktop answers-col">Answers</th>
      <th class="desktop" style="min-width: 20em">Response</th>
      <th>Date</th>
      <th class="desktop"></th>
    </tr>
  </thead>
  <% v = @event ? event_email_viewer? : false
  event_feedbacks = event_feedbacks.order('created_at desc')
  event_feedbacks = event_feedbacks.paginate(page: params[:page], per_page: 10)
  event_feedbacks.each { |event_feedback| account = event_feedback.account %>
  <tr>
    <td class="control">
      <button type="button" class="btn btn-link text-body p-0 feedback-toggle" aria-expanded="false" aria-label="Show details"><i class="bi bi-chevron-right"></i></button>
    </td>
    <td>
      <% if !account || event_feedback.anonymous? %>
        Anonymous
      <% else %>
        <%= partial :'accounts/account', locals: { account: account, show_email: (v || (event_feedback.event ? event_email_viewer?(event_feedback.event) : false)) } %>
      <% end %>
    </td>
    <% if defined?(event_name) %>
      <td>
        <% if event_feedback.event %>
          <a href="/e/<%= event_feedback.event.slug %>"><%= event_feedback.event.name %></a>
          <% if defined?(organisation_name) && event_feedback.event.organisation %>
            <div class="small mt-1"><a href="/o/<%= event_feedback.event.organisation.slug %>"><%= event_feedback.event.organisation.name %></a></div>
          <% end %>
        <% end %>
      </td>
    <% end %>
    <% if defined?(activity_name) %>
      <td class="desktop">
        <% if event_feedback.event && event_feedback.event.activity %>
          <a href="/o/<%= event_feedback.event.activity.organisation.slug %>/a/<%= event_feedback.event.activity.slug %>"><%= event_feedback.event.activity.name %></a>
        <% end %>
      </td>
    <% end %>
    <td class="text-nowrap">
      <a href="/event_feedbacks/<%= event_feedback.id %>">
        <% if event_feedback.rating %>
          <% event_feedback.rating.times do %><i class="bi bi-star-fill"></i><% end %>
        <% else %>
          <%= event_feedback.id %>
        <% end %>
      </a>
    </td>
    <td class="desktop">
      <% event_feedback.answers.each_with_index { |qa,i| q = qa[0]; a = qa[1] %>
      <% if a %>
        <div class="mb-3">
          <strong>
            <%== Sanitize.fragment(Rinku.auto_link(q), Sanitize::Config::DANDELION) %>
          </strong>
          <br>
          <%== Sanitize.fragment(Rinku.auto_link(a.gsub("\n", '<br />')), Sanitize::Config::DANDELION) %>
          <% if event_feedback.publicly_visible? %>
            <div class="my-3">
              <div data-pagelet-url="/event_feedbacks/<%= event_feedback.id %>/public_answers/<%= i %>"></div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% } if event_feedback.answers %>
    </td>
    <td class="desktop">
      <% if event_feedback.event && event_feedback.respondable? %>
        <div data-pagelet-url="/event_feedbacks/<%= event_feedback.id %>/response"></div>
      <% end %>
    </td>
    <td>
      <%= event_feedback.created_at %>
    </td>
    <% if organisation_admin?(event_feedback.event.try(:organisation)) %>
      <td class="desktop">
        <a class="btn btn-danger" href="/event_feedbacks/<%= event_feedback.id %>/destroy" data-confirm="Are you sure you want to delete this feedback? It will disappear from admin pages, but remain visible as Removed on public pages."><i class="bi bi-x-lg"></i></a>
      </td>
    <% else %>
      <td class="desktop">
      </td>
    <% end %>
  </tr>
  <% } %>
</table>
<%= will_paginate event_feedbacks, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
