<% if @event %>
  <div class="row justify-content-end mb-2">
    <div class="col-auto">
      <a class="btn btn-primary" href="/events/<%= @event.id %>/feedback.csv?<%= request.query_string %>"><i class="bi bi-download"></i> CSV</a>
    </div>
  </div>
<% end %>

<script>
  $(function () {
    var $table = $('#event_feedbacks');
    if (!$table.length || $table.hasClass('dataTable') || $(window).width() > 767) return;

    var dateIndex = $table.find('th[data-col-name="date"]').index();
    var table = $table.DataTable({
      info: false,
      paging: false,
      order: dateIndex >= 0 ? [[dateIndex, 'desc']] : [],
      searching: false,
      columnDefs: [{ className: 'control', orderable: false, targets: 0 }],
      responsive: {
        auto: false,
        breakpoints: [
          { name: 'desktop', width: Infinity },
          { name: 'mobile', width: 767 }
        ],
        details: {
          renderer: function (api, rowIdx, columns) {
            var rows = $.map(columns, function (col) {
              if (!col.hidden) return '';
              var $data = $('<div>').html(col.data || '');
              if (!$data.text().trim() && !$data.find('[data-pagelet-url], img, a, button').length) return '';
              return '<tr><td>' + col.title + '</td><td>' + col.data + '</td></tr>';
            }).join('');
            // In a tbody, as Bootstrap 5 styles cells through .table > tbody > tr > td
            return rows ? $('<table class="table table-sm mb-0 dtr-details"><tbody>' + rows + '</tbody></table>') : false;
          }
        }
      }
    });

    table.on('responsive-display.dt', function (e, dt, row, showHide) {
      if (!showHide || !row.child()) return;
      row.child().find('[data-pagelet-url]').each(function () {
        var $p = $(this);
        $p.removeAttr('data-pagelet-loaded').empty().load($p.attr('data-pagelet-url'));
      });
    });
  });
</script>

<style>
  /* DataTables only runs on phones: hide its control column on wider screens, and usernames on phones */
  @media (min-width: 768px) {
    #event_feedbacks:not(.dataTable) th:first-child,
    #event_feedbacks:not(.dataTable) tbody > tr > td:first-child {
      display: none;
    }
  }

  @media (max-width: 767.98px) {
    #event_feedbacks a[data-account-username] {
      display: none;
    }
    #event_feedbacks th.control,
    #event_feedbacks td.control {
      width: 1.875rem;
      min-width: 1.875rem;
      max-width: 1.875rem;
      padding-left: 0;
      padding-right: 0;
    }
  }

  /* Bootstrap chevrons in place of Responsive's expand icon */
  #event_feedbacks.dtr-inline.collapsed > tbody > tr > td.dtr-control:before {
    content: "\f285";
    border: none;
    font-family: "bootstrap-icons";
    font-size: 1.125rem;
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: none;
    box-shadow: none;
    color: var(--bs-emphasis-color);
    margin: 0;
    width: 1.875rem;
    text-align: center;
  }

  #event_feedbacks.dtr-inline.collapsed > tbody > tr.dtr-expanded > td.dtr-control:before {
    content: "\f282";
  }

  /* Expanded rows: borderless, with bold labels */
  #event_feedbacks.collapsed {
    border-right: none;
  }

  #event_feedbacks.dtr-inline.collapsed > tbody > tr.child > td:before {
    content: none !important;
    display: none;
  }

  #event_feedbacks td.child,
  #event_feedbacks td.child .dtr-details,
  #event_feedbacks td.child .dtr-details td {
    border: none;
  }

  #event_feedbacks td.child .dtr-details td:first-child {
    width: 1%;
    white-space: nowrap;
    padding-right: 1em;
    font-weight: bold;
  }

  #event_feedbacks td.child .dtr-details tr {
    background-color: var(--bs-body-bg);
  }
</style>

<table id="event_feedbacks" class="table">
  <thead>
    <tr>
      <th data-orderable="false"></th>
      <th class="all">Name</th>
      <% if defined?(event_name) %>
        <th class="all">Event</th>
      <% end %>
      <% if defined?(activity_name) %>
        <th class="desktop">Activity</th>
      <% end %>
      <th class="all">Rating</th>
      <th class="desktop" style="min-width: 20em">Answers</th>
      <th class="desktop" style="min-width: 20em">Response</th>
      <th class="all" data-col-name="date">Date</th>
      <th class="desktop" data-orderable="false"></th>
    </tr>
  </thead>
  <% v = @event ? event_email_viewer? : false
  event_feedbacks = event_feedbacks.order('created_at desc')
  event_feedbacks = event_feedbacks.paginate(page: params[:page], per_page: 10)
  event_feedbacks.each { |event_feedback| account = event_feedback.account %>
  <tr>
    <td></td>
    <td>
      <% if !account || event_feedback.anonymous? %>
        Anonymous
      <% else %>
        <%= partial :'accounts/account', locals: { account: account, show_email: (v || (event_feedback.event ? event_email_viewer?(event_feedback.event) : false)) } %>
      <% end %>
    </td>
    <% if defined?(event_name) %>
      <td>
        <% if event_feedback.event %>
          <a href="/e/<%= event_feedback.event.slug %>"><%= event_feedback.event.name %></a>
          <% if defined?(organisation_name) && event_feedback.event.organisation %>
            <div class="small"><a href="/o/<%= event_feedback.event.organisation.slug %>"><%= event_feedback.event.organisation.name %></a></div>
          <% end %>
        <% end %>
      </td>
    <% end %>
    <% if defined?(activity_name) %>
      <td>
        <% if event_feedback.event && event_feedback.event.activity %>
          <a href="/o/<%= event_feedback.event.activity.organisation.slug %>/a/<%= event_feedback.event.activity.slug %>"><%= event_feedback.event.activity.name %></a>
        <% end %>
      </td>
    <% end %>
    <td class="text-nowrap">
      <a href="/event_feedbacks/<%= event_feedback.id %>">
        <% if event_feedback.rating %>
          <% event_feedback.rating.times do %><i class="bi bi-star-fill"></i><% end %>
        <% else %>
          <%= event_feedback.id %>
        <% end %>
      </a>
    </td>
    <td>
      <% event_feedback.answers.each_with_index { |qa,i| q = qa[0]; a = qa[1] %>
      <% if a %>
        <div class="mb-3">
          <strong>
            <%== Sanitize.fragment(Rinku.auto_link(q), Sanitize::Config::DANDELION) %>
          </strong>
          <br>
          <%== Sanitize.fragment(Rinku.auto_link(a.gsub("\n", '<br />')), Sanitize::Config::DANDELION) %>
          <% if event_feedback.publicly_visible? %>
            <div class="my-3">
              <div data-pagelet-url="/event_feedbacks/<%= event_feedback.id %>/public_answers/<%= i %>"></div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% } if event_feedback.answers %>
    </td>
    <td>
      <% if event_feedback.event && event_feedback.respondable? %>
        <div data-pagelet-url="/event_feedbacks/<%= event_feedback.id %>/response"></div>
      <% end %>
    </td>
    <td data-sort="<%= event_feedback.created_at.iso8601 %>">
      <%= event_feedback.created_at %>
    </td>
    <% if organisation_admin?(event_feedback.event.try(:organisation)) %>
      <td>
        <a class="btn btn-danger" href="/event_feedbacks/<%= event_feedback.id %>/destroy" data-confirm="Are you sure you want to delete this feedback? It will disappear from admin pages, but remain visible as Removed on public pages."><i class="bi bi-x-lg"></i></a>
      </td>
    <% else %>
      <td>
      </td>
    <% end %>
  </tr>
  <% } %>
</table>
<%= will_paginate event_feedbacks, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
