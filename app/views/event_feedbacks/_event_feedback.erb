<% qas = event_feedback.public_answers ? event_feedback.public_answers.map { |_q, a| a if a.present? }.compact : [] %>

<% if !qas.empty? %>
  <div class="row g-0 <% if defined?(mt_class) %><%= mt_class %><% end %> <% if defined?(mb_class) %><%= mb_class %><% else %>mb-3<% end %>">
    <div class="col-auto me-2"><i class="bi bi-quote"></i></div>
    <div class="col readable">
      <%== qas.map { |a| plain_text_html(a, links: false) }.join('<br><br>') %>
    </div>
  </div>

  <% if event_feedback.response && event_feedback.respondable? %>
    <div class="<% if defined?(mb_class) %><%= mb_class %><% else %>mb-3<% end %> mt-3">
      <em><%= event_feedback.event.organisation.name %> replied</em>
      <p class="mt-1 mb-0 readable read-more">&mdash; <%= plain_text_html(event_feedback.response) %></p>
    </div>
  <% end %>
<% end %>
