<style>
  @media (min-width: 768px) {
    .feedback-columns { columns: 2; column-gap: 0 }
  }
  .feedback-columns-item { break-inside: avoid }
  .feedback-columns-item img { padding: 0.1rem }
</style>
<div class="feedback-columns mt-5">
  <%
  eligible_account_ids = Account.and(
    :has_image => true,
    :has_signed_in => true,
    :hidden => false,
  ).pluck(:id)

  # Find the most recent 5-star feedback from each eligible account
  pipeline = [
    { '$match' => {
      'deleted_at' => nil,
      'anonymous' => false,
      'has_public_answers' => true,
      'rating' => 5,
      'account_id' => { '$in' => eligible_account_ids }
    } },
    { '$sort' => { 'account_id' => 1, 'created_at' => -1 } },
    { '$group' => { '_id' => '$account_id', 'feedback' => { '$first' => '$$ROOT' } } },
    { '$replaceRoot' => { 'newRoot' => '$feedback' } },
    { '$sort' => { 'created_at' => -1 } },
    { '$limit' => 15 } # the script below shows the first 10 whose image isn't a logo
  ]

  EventFeedback.collection.aggregate(pipeline).each { |doc|
  event_feedback = EventFeedback.new(doc.select { |k, _v| EventFeedback.fields.keys.include?(k.to_s) })
  account = event_feedback.account
  next if account.name.include?('_')
  next if !event_feedback.event || event_feedback.event.secret?
  quote = event_feedback.public_answers.map { |q,a| a if a.present? }.compact.join('<br /><br />').gsub("\n", '<br />')
  next if quote.empty? || quote.length > 500
  %>
  <div class="feedback-columns-item" style="display: none">

    <div class="row g-0">
      <div class="col-auto me-2"><i class="bi bi-quote"></i></div>
      <div class="col me-3">
        <div class="row g-0">
          <div class="col-12 col-sm-auto mb-3 mb-sm-0 me-sm-3">
            <%= partial :'accounts/square', locals: { account: account, size: :'2xl', cors: true } %>
          </div>
          <div class="col">
            <a class="home-feedback readable" href="/e/<%= event_feedback.event.slug %>">
              <%== Sanitize.fragment(quote, Sanitize::Config::DANDELION) %>
            </a>

            <div class="my-2 text-nowrap fs-2">
              <% event_feedback.rating.times do %><i class="bi bi-star-fill"></i><% end %>
            </div>

            <p class="mb-5">
              <a href="/u/<%= account.username %>"><%= account.name %></a> on <a href="/e/<%= event_feedback.event.slug %>"><%= event_feedback.event.name %></a>
              <small><%= timeago event_feedback.created_at %></small>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>
<script>
  $(function () {
    // An account image whose edges are nearly all one colour (white, transparent or solid) is probably a logo rather
    // than a photo of the person, so skip that quote. The avatars load with CORS (accounts/square's cors) so their
    // pixels can be read; one that can't be read counts as a photo, and a card whose image fails to load is skipped too
    function looksLikeLogo (img) {
      try {
        const size = 50
        const canvas = document.createElement('canvas')
        canvas.width = canvas.height = size
        const ctx = canvas.getContext('2d')
        ctx.fillStyle = 'white'
        ctx.fillRect(0, 0, size, size)
        ctx.drawImage(img, 0, 0, size, size)
        const data = ctx.getImageData(0, 0, size, size).data
        const edge = []
        for (let i = 0; i < size; i++) {
          edge.push([i, 0], [i, size - 1], [0, i], [size - 1, i])
        }
        const pixels = edge.map(function ([x, y]) {
          const o = (y * size + x) * 4
          return [data[o], data[o + 1], data[o + 2]]
        })
        const mean = [0, 1, 2].map(function (c) { return pixels.reduce(function (sum, p) { return sum + p[c] }, 0) / pixels.length })
        const plain = pixels.filter(function (p) {
          return Math.abs(p[0] - mean[0]) + Math.abs(p[1] - mean[1]) + Math.abs(p[2] - mean[2]) < 40
        }).length
        return plain / pixels.length >= 0.8
      } catch {
        return false
      }
    }

    // Show the first 10 cards that pass, in order, each as soon as it and the cards before it have been checked
    const items = $('.feedback-columns-item').toArray()
    const logos = []
    let next = 0
    let shown = 0
    function showChecked () {
      while (next < items.length && logos[next] !== undefined) {
        if (!logos[next] && shown < 10) {
          $(items[next]).fadeIn(150)
          shown++
        }
        next++
      }
    }
    items.forEach(function (item, i) {
      const img = $(item).find('img')[0]
      function check (logo) {
        logos[i] = logo
        showChecked()
      }
      if (img.complete) {
        check(img.naturalWidth === 0 || looksLikeLogo(img))
      } else {
        img.addEventListener('load', function () { check(looksLikeLogo(img)) })
        img.addEventListener('error', function () { check(true) })
      }
    })
  })
</script>
