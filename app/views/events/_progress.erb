<% tc = event.ticket_count %>
<% slots_taken = event.slots_taken if event.capacity %>
<%# The bar counts places, which differ from tickets when a ticket type takes more than one: then show the ticket count above it too %>
<% bar = event.capacity && event.capacity > 0 %>
<% show_count = !bar || !event.one_place_per_ticket? %>

<% if event.purchase_url %>
  <a target="_blank" href="<%= event.purchase_url %>">
    <span class="badge text-bg-primary"><%= HttpUrl.host(event.purchase_url) %></span>
  </a>
<% elsif (event.live? || tc > 0) %>
  <% if show_count %>
    <a href="/e/<%= event.slug %>/tickets">
      <% if defined?(full_width) %>
        <%= pluralize(tc, 'ticket') %>
      <% else %>
        <%= tc %>
      <% end %>
    </a>
  <% end %>
  <% if bar; w = ((slots_taken/event.capacity.to_f)*100).round %>
    <a class="d-block text-decoration-none" href="/e/<%= event.slug %>/tickets">
      <%# The small bar has room for places filled alone, with the capacity in its tooltip %>
      <% label = defined?(full_width) ? "#{slots_taken}/#{event.capacity}" : slots_taken %>
      <%= partial :progress_bar, locals: { percent: w, label: label, title: "#{slots_taken}/#{event.capacity} places filled" } %>
    </a>
  <% end %>
  <% if event.incomplete_orders? %>
    <i data-bs-toggle="tooltip" title="Someone is in the process of completing an order. If they don't complete it soon, the order will be removed." class="bi bi-spin bi-arrow-repeat"></i>
  <% end %>
  <% if event.sold_out_cache %>
    <div class="<%= defined?(full_width) && !event.capacity ? 'd-inline ms-1' : 'mt-1' %>">
      <span class="badge text-bg-danger">
        <% if event.sold_out_due_to_sales_end_cache %>
          Sales ended
        <% else %>
          Sold out
        <% end %>
      </span>
    </div>
  <% end %>
<% end %>
