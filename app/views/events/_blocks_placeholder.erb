<div class="mb-3">
  <div class="row" id="events">
    <% 5.times do %>
      <div class="col-12">
        <div class="mb-4">
          <div class="row block g-0 align-items-stretch bg-white">
            <div class="col-lg-12 order-lg-1">
              <table class="w-100 h-100">
                <tr>
                  <td class="align-top">
                    <div class="row justify-content-between">
                      <div class="col ms-1 p-lg-3">
                        <h4 class="block-title flicker w-50" style="background: rgba(0,0,0,0.1)">&nbsp;</h4>
                        <div class="fs-6">
                          <% 3.times do %>
                            <div class="flicker mb-1" style="width: 33%; background: rgba(0,0,0,0.1)">&nbsp;</div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
