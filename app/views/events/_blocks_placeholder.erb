<div class="mb-3">
  <div class="row" id="events">
    <% 5.times do %>
      <div class="col-12">
        <div class="mb-4">
          <div class="row block g-0 align-items-stretch bg-white">
            <div class="col-lg-12 order-lg-1">
              <table class="w-100 h-100">
                <tr>
                  <td class="align-top">
                    <div class="row justify-content-between">
                      <div class="col ms-1 p-lg-3">
                        <h4 class="h2 placeholder-glow"><span class="placeholder w-50"></span></h4>
                        <div class="fs-6 placeholder-glow">
                          <% 3.times do %>
                            <span class="placeholder d-block col-4 mb-1"></span>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
