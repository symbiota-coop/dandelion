<% map = defined?(custom_class) && custom_class == 'map-event' %>
<%# The line takes the heading's size, so the star, edit and hide icons match it and the badges centre on it %>
<div class="event-title-line <%= map ? 'fs-4' : 'fs-2' %> mb-2">
  <h4 class="<%= 'h2' unless map %> d-inline me-1">
    <a class="text-body" target="_parent" href="<%= "/e/#{event.slug}#{if @organisation && @organisation != event.organisation; "?cohost=#{@organisation.slug}"; end }"%>">
      <%= event.name %>
    </a>
  </h4>
  <%= partial :'events/event_labels', locals: { event: event } %>
  <% if defined?(skip_pagelets) %>
  <% else %>
    <% if current_account %>
      <div data-with-placeholder class="d-inline" data-pagelet-url="/events/<%=event.id%>/star?block_edit=1"><i class="bi bi-star opacity-0"></i></div>
    <% end %>
    <% if event_admin?(event) %>
      <a class="text-body block-edit" target="_parent" href="<%= "/e/#{event.slug}/edit" %>"><i class="bi bi-pencil-fill"></i></a>
    <% end %>
    <% if admin? %>
      <div data-with-placeholder class="d-inline" data-pagelet-url="/events/<%=event.id%>/hide_from_homepage?block_edit=1"><i class="bi bi-eye-slash-fill opacity-0"></i></div>
    <% end %>
  <% end %>
</div>
<div class="mb-2">
  <%= partial :'events/tag_labels', locals: { event: event, limit: 5 } %>
</div>
<ul class="icon-list text-body <%= defined?(custom_class) ? custom_class : '' %> fs-5">
  <% if (ef = event.event_facilitations.select { |event_facilitation| event.organisation && event_facilitation.account.lastname && event_facilitation.account.name != event.organisation.name }).exists? || (!@organisation && event.organisation) %>
    <li>
      <i data-bs-toggle="tooltip" title="Host/facilitators" class="bi bi-flag-fill"></i>
      <%= partial :'events/facilitators', locals: {event: event, event_facilitators: ef} %>
    </li>
  <% end %>
  <% unless event.evergreen? %>
    <li>
      <i data-bs-toggle="tooltip" title="Dates/times" class="bi bi-calendar-event"></i>
      <%= when_details(event).split(' (UTC')[0] %>
    </li>
  <% end %>
  <li>
    <i data-bs-toggle="tooltip" title="Location" class="bi bi-geo-alt-fill"></i>
    <%= partial :'events/location', locals: {event: event} %>
  </li>
  <% if defined?(skip_final_ul) && skip_final_ul %>

  <% else %>
  </ul>
<% end %>