<%= partial :'events/nav', locals: { event: @event, notes: true } %>

<% if event_admin? %>
  <%= partial :'events/locked' %>
<% else %>
  <style>
    #event-image { margin-top: calc(-1 * var(--content-padding)) }
  </style>
<% end %>

<% if params[:tour] || (!ENV['SKIP_TOURS'] && params[:created] && current_account && current_account.events.count == 1) %>
  <script>
    $(function() {

      if($(window).width() > 992) {

        introJs().setOptions({
          steps: [{
            title: "Nice one!",
            intro: "You've created your first event 🎉"
          }, {
            element: $('#content button.dropdown-toggle').last()[0],
            intro: "Here's the admin dropdown for the event"
          }]
        }).start();

      }
    })
  </script>
<% end %>

<div class="row justify-content-center">
  <div class="col-lg-10">
    <% if @order %>
      <%= partial :'events/success' %>
    <% elsif @pending_order %>
      <div class="card mb-3">
        <h3 class="card-header text-bg-primary">Confirming your payment</h3>
        <div class="card-body readable">
          <p class="mb-0">We're confirming your payment<%= " with #{@pending_order.payment_provider}" if @pending_order.payment_provider %>... <i class="bi bi-spin bi-slash-lg"></i></p>
        </div>
      </div>
      <script>
        $(function () {
          setInterval(function () {
            $.getJSON('/events/<%= @event.id %>/orders/<%= @pending_order.public_id %>/payment_completed', function (data) {
              if (data.payment_completed) { window.location.reload() }
            })
          }, 3 * 1000)
        })
      </script>
    <% elsif @event_image %>
      <a href="/e/<%=@event.slug%><% if params[:cohost] %>?cohost=<%=params[:cohost]%><% end %>"><%= blurred_image_tag(@event_image, width: @event_image_width, height: @event_image_height, full_size: '1920x1920', md_size: '992x992', css_class: 'w-100 mb-3', id: 'event-image') %></a>
    <% end %>
  </div>
</div>

<% unless @order || @pending_order %>
  <% sidebar = false %>
  <% sidebar = true if @event.sold_out? || @event.purchase_url %>
  <% get_tickets_fixed_bottom_style = 'class="fixed-bottom bg-white p-3 w-100 d-md-none" style="z-index: 1019; box-shadow: 0px -2px 4px 0px rgba(var(--bs-black-rgb), 0.3);"' %>
  <% if @event.purchase_url %>
    <div id="get-tickets-fixed-bottom" <%== get_tickets_fixed_bottom_style %>>
      <a target="_blank" href="<%=@event.purchase_url%>" class="btn btn-primary w-100"><%= @event.rsvp_button_text || "Book via #{HttpUrl.host(@event.purchase_url)}" %></a>
    </div>
    <style>
      @media (max-width: 767.98px) { #content { padding-bottom: 5.5rem } }
    </style>
  <% elsif (params[:ticket_type_id] || !@event.sold_out? || @event.ticket_type_waitlists_available?) && @event.ticket_types.exists? %>
    <% sidebar = true %>
    <div id="get-tickets-fixed-bottom" <%== get_tickets_fixed_bottom_style %>>
      <a href="javascript:;" onclick="$(this).parent().hide();
            $(window).scrollTop($('#purchase').offset()['top'] - $('#header').height() - 17)
           " class="btn btn-primary w-100"><%= @event.sold_out? && @event.ticket_type_waitlists_available? ? 'Join waitlist' : 'Get tickets' %></a>
    </div>
    <script>
      $(function () {
        $(window).scroll(function () {
          $('#get-tickets-fixed-bottom').toggle((window.scrollY + window.innerHeight) <= $('#purchase').offset()['top'])
        })
        $(window).scroll()
      })
    </script>
  <% end %>
  <div class="row">
    <div class="<%= sidebar ? 'col-lg-7' : 'col-lg-12' %>">

      <% n = 1; events = [];
      if @event.organisation && !@event.evergreen?
        future_events_scope = @event.organisation.events_including_cohosted.live.publicly_visible.future
        future_events = if @event.match_phrase
          matching_event_ids = Event.search(@event.match_phrase, future_events_scope).pluck(:id)
          future_events_scope.and(:id.in => matching_event_ids, :start_time.ne => @event.start_time)
        else
          future_events_scope.and(:name => @event.name, :location => @event.location, :start_time.ne => @event.start_time)
        end
        events = ([@event] + future_events).uniq
        n = events.count
     end %>

      <div class="row g-0">
        <div class="col">
          <h1 class="ms-2 mb-0">
            <%= @event.name %>
            <% if n > 1 %>
              <span class="badge text-bg-primary"><%= pluralize(n, 'dates') %></span>
            <% end %>
          </h1>
        </div>
        <div class="col-auto">
          <div class="d-inline ms-3 me-2 fs-4" data-pagelet-url="/events/<%=@event.id%>/star">
            <%= partial :'events/star', locals: {event: @event} %>
          </div>
        </div>
      </div>

      <%= partial :'events/details', locals: { n: n, events: events } %>

      <div class="mb-3">
        <%= partial :'events/tag_labels', locals: { event: @event, show_more: true, show_more_limit: 5 } %>
      </div>

      <%= partial :'events/info_table' %>

      <% if @event.description || @event.organisation.event_footer %>
        <div class="wysiwyg readable">
          <% if @event.description %>
            <% d = Rinku.auto_link(
                (@event.description.include?('<p') || @event.description.include?('<br') ? @event.description : "<p>#{@event.description.gsub("\n", '<br />')}</p>")
                .gsub(%r{<a (href=".+?")>\[\[(.+?)\]\]</a>}, '<a \1 class="btn btn-primary">\2</a>')
                .gsub('<table', '<table class="table table-bordered"')) %>
            <% if @event.raw_description %>
              <%== d %>
            <% else # previously only if @event.organisation.allow_iframes? (otherwise Sanitize.fragment(d, Sanitize::Config::DANDELION)) %>
              <%== Sanitize.fragment(d, Sanitize::Config::IFRAMES) %>
            <% end %>
          <% end %>
          <% if !@event.hide_organisation_footer && @event.organisation.event_footer %>
            <%== Sanitize.fragment(Rinku.auto_link(@event.organisation.event_footer), Sanitize::Config::DANDELION) %>
          <% end %>
        </div>
      <% end %>

    </div>
    <% if sidebar %>
      <%= partial :'events/sidebar' %>
    <% end %>
  </div>

  <%= partial :'events/feedback' %>

  <% if !@event.hide_discussion %>
    <% if event_participant? %>
      <%= partial :'events/discussion' %>
    <% end %>
  <% end %>

<% end %>
