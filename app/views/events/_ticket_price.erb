<% if ticket.discounted_price %>
  <a href="javascript:;" onclick="$(this).hide().next().show().find('input').focus()"><%= m ticket.discounted_price, ticket.currency %></a>
  <% form_tag "/tickets/#{ticket.id}/price", style: 'display:none' do %>
    <div class="input-group">
      <span class="input-group-text"><%= money_symbol(ticket.currency) %></span>
      <%= number_field_tag :price, class: 'form-control', style: 'width: 6em', value: ticket.discounted_price, onblur: '$(this.form).submit()' %>
    </div>
  <% end %>
<% end %>
<% if ticket.order %>
  <% if ticket.order.transferred? %>
    <span class="badge text-bg-secondary">Transferred</span>
  <% end %>
  <% if ticket.order.percentage_discount %>
    <span data-bs-toggle="tooltip" class="badge text-bg-secondary me-1" title="<%= "#{ticket.order.percentage_discount}%" %> discount code applied<% if ticket.order.discount_code %>: <%=ticket.order.discount_code.code%><% end %>">
      <%= "#{ticket.order.percentage_discount}%" %>
    </span>
  <% end %>
  <% if ticket.order.percentage_discount_monthly_donor %>
    <span data-bs-toggle="tooltip" class="badge text-bg-secondary me-1" title="<%= "#{ticket.order.percentage_discount_monthly_donor}%" %> monthly donor discount applied">
      <%= "#{ticket.order.percentage_discount_monthly_donor}%" %>
    </span>
  <% end %>
  <%= partial :'events/payment_badge', locals: { record: ticket.order } %>
  <% if ticket.incomplete? %><i data-bs-toggle="tooltip" title="This person is in the process of completing the order. If they don't complete it soon, the order will be removed." class="bi bi-spin bi-arrow-repeat"></i><% end %>
<% end %>
