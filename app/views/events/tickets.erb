<%= partial :'events/nav', locals: { event: @event } %>
<% if @event.questions_a.any? %>
  <div class="alert alert-primary">View answers to booking questions on the <a href="/e/<%= @event.slug %>/orders">Orders</a> page</div>
<% end %>
<div class="row">
  <div class="col">
    <% form_tag '', method: 'get', class: 'submitOnChange searchForm form-inline mb-3', onsubmit: %{
      $('#tickets-table').attr('data-pagelet-url', $('#tickets-table').attr('data-pagelet-url').split('?')[0] + '?' + $(this).serialize());
      $('#tickets-table').load($('#tickets-table').attr('data-pagelet-url'))
      return false
    } do %>
      <div class="form-group">
        <label>Search tickets</label>
        <%= text_field_tag :q, class: 'form-control', value: params[:q], autocomplete: 'off' %>
      </div>
      <%= checkbox 'Complete' %>
      <%= checkbox 'Incomplete' %>
      <%= checkbox 'Discounted' %>
      <% unless @event.hide_deleted_filters? %>
        <%= checkbox 'Deleted' %>
      <% end %>
      <%= hidden_field_tag :search, value: 1 %>
      <%= submit_tag 'Search', class: 'btn btn-primary' %>
    <% end %>
  </div>
  <div class="col-12 mb-3 col-lg-auto mb-lg-0">
    <button type="button" class="btn btn-primary mb-1" data-bs-toggle="modal" data-bs-target="#create-ticket"><i class="bi bi-plus-lg"></i> Create a ticket</button>
  </div>
</div>
<% create_ticket = capture_html do %>
  <% form_for @event.tickets.new, "/e/#{@event.slug}/create_ticket" do |f| %>
    <%= f.text_block :name %>
    <%= f.text_block :email %>
    <%= f.select_block :ticket_type_id, options: @event.ticket_types.map { |ticket_type| [ticket_type.name, ticket_type.id] } %>
    <%= f.currency_block :price, money_symbol: money_symbol(@event.currency) %>
    <%= f.submit_block %>
  <% end %>
<% end %>
<%# Open as the page loads for a link that asks for it (?create_ticket=1) %>
<%= partial :form_modal, locals: { id: 'create-ticket', title: 'Create a ticket', form_html: create_ticket, open_on_load: params[:create_ticket] } %>
<div id="tickets-table" data-pagelet-url="/e/<%= @event.slug %>/tickets">
  <%= partial :'events/tickets_table', locals: { tickets: @tickets } %>
</div>
