<div class="snap-carousel-placeholder mt-5 mb-lg-5">
  <div class="h2 text-center placeholder-glow" aria-hidden="true"><span class="placeholder col-4"></span></div>
  <div class="snap-carousel">
    <div class="snap-carousel-track row">
      <% 3.times do %>
        <div class="col-12 col-sm-6 col-lg-4 snap-carousel-item">
          <div class="position-relative">
            <span>
              <img alt="" class="w-100" src="/images/1920x1080.png">
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
