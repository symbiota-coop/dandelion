<% events = events.to_a %>
<% if events.exists? %>
  <% prefetch_fragments(events.map { |event| event_block_carousel_cache_key(event) }) %>
  <div class="<% unless defined?(skip_margin) %> mt-5 <% end %> mb-lg-5">
    <% if defined? title %>
      <% unless defined?(hide_featured_title) && hide_featured_title && title == 'Featured' %>
        <h2 class="text-center"><%= title %></h2>
      <% end %>
    <% end %>
    <div class="snap-carousel">
      <div class="snap-carousel-track row">
        <% events.each { |event| %>
        <div class="col-12 col-sm-6 col-lg-4 snap-carousel-item">
          <%= cp(:'events/block_carousel', locals: { event: event }, event: event, key: event_block_carousel_cache_key(event)) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
<% end %>
