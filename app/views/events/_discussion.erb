<% content = capture do %>
  <div data-pagelet-url="/chat?commentable_type=Event&commentable_id=<%= @event.id %>">
    <%= partial :'comments/chat', locals: { commentable: @event } %>
  </div>
<% end %>

<%= partial :chat_card, locals: { title: 'Discussion', subtitle: 'Only attendees and facilitators can see this', show_chat: @event.comments.exists?, content: content } %>
