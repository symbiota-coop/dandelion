<%# layouts/_head links /theme.css, so the toasts above the page are themed before they show %>
<% @theme_color = resolved_event_theme_color(event) %>

<% if event_admin? %>
  <div class="nav-crumbs">
    <% if event.organisation %>
      <%= partial :'organisations/nav', locals: { organisation: event.organisation, inline: true } %>
    <% end %>
    <% if event.persisted? %>
      <% if event.activity %>
        <%= partial :'activities/nav', locals: { activity: event.activity, hide_organisation_nav: true, inline: true } %>
      <% end %>
      <% if event.local_group %>
        <%= partial :'local_groups/nav', locals: { local_group: event.local_group, hide_organisation_nav: true, inline: true, beside_activity: event.activity.present? } %>
      <% end %>
      <%# Each count is worked out once, as most items use theirs both to decide whether to show and for the badge %>
      <% has_ticket_types = event.ticket_types.exists? %>
      <% if event.deleted? %>
        <% orders_count = event.orders.deleted.complete.count %>
        <% tickets_count = event.tickets.deleted.complete.count %>
        <% donations_count = event.donations.deleted.complete.count %>
        <%= dropdown_nav [
            ['View deleted event', "/e/#{event.slug}/edit"],
            ([%(Orders <span class="badge text-bg-primary">#{orders_count}</span>), "/e/#{event.slug}/orders"] if orders_count.positive?),
            ([%(Tickets <span class="badge text-bg-primary">#{tickets_count}</span>), "/e/#{event.slug}/tickets"] if has_ticket_types || tickets_count.positive?),
            ([%(Donations <span class="badge text-bg-primary">#{donations_count}</span>), "/e/#{event.slug}/donations"] if donations_count.positive?),
          ].compact, button_text: %(#{event.name}), container_class: 'btn-group mb-1' %>
      <% else %>
        <% discount_codes_count = event.discount_codes.count %>
        <% orders_count = event.orders.count %>
        <% tickets_count = event.tickets.count %>
        <% donations_count = event.donations.count %>
        <% event_boosts_count = event.event_boosts.count %>
        <% waitships_count = event.waitships.count %>
        <% event_feedbacks_count = event.event_feedbacks.count %>
        <%= dropdown_nav [
            ['View event', "/e/#{event.slug}"],
            ['Stats', 'javascript:;', { 'data-stats-sheet' => '#event_stats' }],
            ['Edit event', "/e/#{event.slug}/edit"],
            ['Cancel or delete event', "/e/#{event.slug}/delete"],
            ['Duplicate event', "/e/#{event.slug}/duplicate", { 'data-method' => 'post', 'data-confirm' => 'Are you sure you want to duplicate the event?' }],
            ['Discount codes' + (discount_codes_count.positive? ? " <span class='badge text-bg-primary'>#{discount_codes_count}</span>" : ''), "/e/#{event.slug}/discount_codes"],
            ([%(Orders <span class="badge text-bg-primary">#{orders_count}</span>), "/e/#{event.slug}/orders"] if orders_count.positive?),
            ([%(Tickets <span class="badge text-bg-primary">#{tickets_count}</span>), "/e/#{event.slug}/tickets"] if has_ticket_types || tickets_count.positive?),
            ([%(Donations <span class="badge text-bg-primary">#{donations_count}</span>), "/e/#{event.slug}/donations"] if donations_count.positive?),
            ['Boosts' + (event_boosts_count.positive? ? " <span class='badge text-bg-primary'>#{event_boosts_count}</span>" : ''), "/e/#{event.slug}/boosts"],
            ([%(Payments <span class="badge text-bg-primary">#{event.rpayments.count}</span>), "/e/#{event.slug}/rpayments"] if event.organisation.stripe_client_id),
            ([%(Waitlist <span class="badge text-bg-primary">#{waitships_count}</span>), "/e/#{event.slug}/waitlist"] if waitships_count.positive?),
            (if event.allow_ticket_type_waitlists?
                 ticket_type_waitship_count = TicketTypeWaitship.and(:ticket_type_id.in => event.ticket_type_ids).count
                 [%(Ticket type waitlists <span class="badge text-bg-primary">#{ticket_type_waitship_count}</span>), "/e/#{event.slug}/ticket_type_waitlists"] if ticket_type_waitship_count.positive?
             end),
            ([%(Feedback <span class="badge text-bg-primary">#{event_feedbacks_count}</span>), "/e/#{event.slug}/feedback"] if event_feedbacks_count.positive?),
            (['Ticket type photos', "/e/#{event.slug}/ticket_types"] if has_ticket_types),
            (['Co-host settings', "/e/#{event.slug}/cohosts"] if event.cohostships.exists?),
            (['Preview confirmation email', "/e/#{event.slug}/ticket_email"] if has_ticket_types),
            (['Preview reminder email', "/e/#{event.slug}/reminder_email"] if has_ticket_types && !event.evergreen?),
            (['Preview feedback request email', "/e/#{event.slug}/feedback_request_email"] if has_ticket_types && !event.evergreen?),
            (['Stripe report', "/e/#{event.slug}/stripe_report"] if event_revenue_admin? && !event.organisation.stripe_client_id && event.organisation.stripe_connect_json),
            ['Audience stats', "/e/#{event.slug}/stats"],
            ([%(Check-in scanner), "/e/#{event.slug}/check_in"] if has_ticket_types || tickets_count.positive?),
            ['Mailer', "/e/#{event.slug}/pmails"]
          ].compact, button_text: %(#{event.name}), container_class: 'btn-group mb-1' %>
      <% end %>
    <% end %>
  </div>
  <% if defined?(notes) && notes %>
    <div data-pagelet-url="/e/<%= event.slug %>/notes" class="mb-3">
      <%= partial :'events/notes' %>
    </div>
  <% end %>
  <% if event.persisted? %>
    <div class="d-none d-md-block">
      <%= partial :'events/event_stats', locals: { events: [event], organisation: (params[:cohost] && Organisation.find_by(slug: params[:cohost])) || event.organisation } %>
    </div>
  <% end %>
<% end %>
