<% event_tags = event.event_tags %>
<% tags_to_display = defined?(limit) ? event_tags.sample(limit) : event_tags.shuffle %>

<span class="tag-container">
  <% tags_to_display.each_with_index do |event_tag, index| %>
    <span class="tag-item"<% if defined?(show_more) && index >= show_more_limit %> style="display: none"<% end %>>
      <a <% if event.ai_tagged? %> data-bs-toggle="tooltip" title="AI generated"<% end %> href="<%= @organisation ? "/o/#{@organisation.slug}/events" : '/events' %>?event_tag_id=<%= event_tag.id %><%= '&minimal=1' if params[:minimal] %>" class="badge text-bg-primary mb-1"><% if event.ai_tagged? %><i class="bi bi-stars"></i> <% end %><%== Sanitize.fragment(event_tag.name) %></a>
    </span>
  <% end %>

  <% if defined?(show_more) && event_tags.count > show_more_limit %>
    <a href="javascript:;" onclick="$(this).closest('.tag-container').find('.tag-item').show(); $(this).remove();">
      <i class="bi bi-three-dots"></i>
    </a>
  <% end %>
</span>

<% if defined?(plus_more) && event_tags.count > limit %>
  <span class="text-nowrap">
    + <%= event_tags.count - limit %>
  </span>
<% end %>