<%= partial :'events/fullcalendar' %>
<div
  id="calendar"
  data-events-url="<%= "/o/#{@organisation.slug}/events.json" %>"
  data-view="<%= params[:list] ? 'listMonth' : 'dayGridMonth' %>"
  data-date="<%= params[:date] %>"
  <% if params[:minimal] %>
    data-embed="true"
    data-event-color="<%= @organisation.theme_color %>"
  <% end %>>
</div>
