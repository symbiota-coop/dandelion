<% if @organisation %>
  <%= partial :'organisations/nav', locals: { organisation: @organisation } %>
  <% event_tags = @organisation.event_tags %>
  <% coordinators = Account.and(:id.in => @organisation.events_including_cohosted.pluck(:coordinator_id)) %>
  <% organisation = @organisation %>
<% elsif @activity %>
  <%= partial :'activities/nav', locals: { activity: @activity } %>
  <% event_tags = @activity.event_tags %>
  <% coordinators = Account.and(:id.in => @activity.events.pluck(:coordinator_id)) %>
  <% organisation = @activity.organisation %>
<% elsif @local_group %>
  <%= partial :'local_groups/nav', locals: { local_group: @local_group } %>
  <% event_tags = @local_group.event_tags %>
  <% coordinators = Account.and(:id.in => @local_group.events.pluck(:coordinator_id)) %>
  <% organisation = @local_group.organisation %>
<% end %>
<%# The dropdowns' names and ids, plucked, as loading whole documents (local groups' polygons) is slow %>
<% event_tag_options = event_tags.order('name asc').pluck(:name, :id) %>
<% coordinator_options = coordinators.order('name asc').pluck(:name, :id) %>
<% if @organisation %>
  <% local_group_options = @organisation.local_groups.order('name asc').pluck(:name, :id) %>
  <% activity_options = @organisation.activities.order('name asc').pluck(:name, :id) %>
  <% carousel_options = params[:deleted] ? [] : @organisation.carousels.order('o asc').pluck(:name, :id) %>
  <% cohost_options = @organisation.cohosts.order('name asc').pluck(:name, :id) %>
<% end %>

<div class="search border rounded p-3 pb-lg-0 mb-3">

  <% form_tag '', method: 'get', class: 'searchForm mb-0 mb-lg-3' do %>
    <div class="row gx-2 align-items-end">
      <div class="form-group col-12 col-sm-auto">
        <label>Events between</label>
        <%= text_field_tag :from, class: 'form-control datepicker mx-1', value: (@from.to_fs(:db_local) if @from) %>
      </div>
      <div class="form-group col-12 col-sm-auto">
        <label>and</label>
        <%= text_field_tag :to, class: 'form-control datepicker mx-1', value: (@to.to_fs(:db_local) if @to) %>
      </div>
      <div class="form-group col-12 col-sm-auto">
        <label>start/end date</label>
        <%= select_tag :start_or_end, options: {'start date' => 'start', 'end date' => 'end'}, value: @start_or_end, class: 'form-select mx-1' %>
      </div>
      <div class="form-group col-12 col-sm-auto">
        <label>containing the word</label>
        <%= text_field_tag :q, class: 'form-control mx-1', value: params[:q] %>
      </div>
      <% if event_tag_options.any? %>
        <div class="form-group col-12 col-sm-auto">
          <label>tagged</label>
          <%= select_tag :event_tag_id, options: [''] + event_tag_options, selected: params[:event_tag_id], class: 'form-select' %>
        </div>
      <% end %>
      <div class="form-group col-12 col-sm-auto">
        <label>Coordinator</label>
        <%= select_tag :coordinator_id, options: [''] + coordinator_options, selected: params[:coordinator_id], class: 'form-select mx-1' %>
      </div>

      <% if @organisation %>
        <% if local_group_options.any? %>
          <div class="form-group col-12 col-sm-auto">
            <label>Local group</label>
            <%= select_tag :local_group_id, options: [''] + local_group_options, selected: params[:local_group_id], class: 'form-select mx-1' %>
          </div>
        <% end %>
        <% if activity_options.any? %>
          <div class="form-group col-12 col-sm-auto">
            <label>Activity</label>
            <%= select_tag :activity_id, options: [''] + activity_options, selected: params[:activity_id], class: 'form-select mx-1' %>
          </div>
        <% end %>
        <% if carousel_options.any? %>
          <div class="form-group col-12 col-sm-auto">
            <label>Carousel</label>
            <%= select_tag :carousel_id, options: ['', ['Featured', 'featured']] + carousel_options, selected: params[:carousel_id], class: 'form-select mx-1' %>
          </div>
        <% end %>
        <% if cohost_options.any? %>
          <div class="form-group col-12 col-sm-auto">
            <label>Co-host</label>
            <%= select_tag :cohost_id, options: [''] + cohost_options, selected: params[:cohost_id], class: 'form-select mx-1' %>
          </div>
        <% end %>
      <% end %>

    </div>

    <div class="row gx-2 align-items-end mt-1">
      <%= checkbox 'Online', form_group_class: 'col-auto col-sm-auto' %>
      <%= checkbox 'In person', form_group_class: 'col-auto col-sm-auto' %>
      <%= checkbox 'No coordinator', form_group_class: 'col-auto col-sm-auto' %>
      <%= checkbox 'No facilitators', form_group_class: 'col-auto col-sm-auto' %>
      <%= checkbox 'Evergreen', form_group_class: 'col-auto col-sm-auto' %>
      <% if @organisation %>
        <%= checkbox 'Exclude co-hosted', form_group_class: 'col-auto col-sm-auto' %>
        <% if @organisation.stripe_client_id %>
          <%= checkbox 'Discrepancy', form_group_class: 'col-auto col-sm-auto' %>
        <% end %>
        <%= checkbox 'Deleted', form_group_class: 'col-auto col-sm-auto' %>
      <% end %>
      <div class="form-group col-12 col-sm-auto">
        <%= submit_tag 'Search', class: 'btn btn-primary mb-0' %>
      </div>
    </div>
    <%= hidden_field_tag :search, value: 1 %>
  <% end %>

</div>

<div class="row justify-content-between">
  <div class="col">
    <span class="badge text-bg-primary"><%= pluralize @events.count, 'event' %></span>
  </div>
  <div class="col-auto">
    <% if @organisation %>
      <a class="btn btn-primary" href="/o/<%= organisation.slug %>/events/stats.csv?<%= request.query_string %>"><i class="bi bi-download"></i> CSV</a>
    <% end %>
  </div>
</div>
<%# The table loads in a request of its own (this page with table=1), so the page shows before its rows are worked out %>
<div data-pagelet-url="<%= request.path %>?<%= request.query_string.empty? ? 'table=1' : "#{request.query_string}&table=1" %>"></div>
