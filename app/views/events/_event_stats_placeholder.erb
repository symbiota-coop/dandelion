<%# Shown while the stats table loads (events/event_stats): a row for each event, up to 10, with the name column wider %>
<div class="table-responsive mb-3" aria-hidden="true">
  <table class="table table-striped table-sm small placeholder-glow">
    <thead>
      <tr>
        <% column_widths = [14, 8, 7, 7, 6, 6, 6, 5, 5, 5] %>
        <% column_widths.each do |width| %>
          <th><span class="placeholder" style="width: <%= width %>em"></span></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.times do %>
        <tr>
          <% column_widths.each do %>
            <td><span class="placeholder" style="width: <%= rand(40..100) %>%"></span></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
