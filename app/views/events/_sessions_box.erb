<%# An event's sessions and the forms to add and remove them, a pagelet (/e/:slug/event_sessions) that reloads after either %>
<% if @event.event_sessions.exists? %>
  <div class="my-2">
    <span class="badge text-bg-primary"><%= pluralize @event.event_sessions.count, 'session' %></span>
  </div>
<% end %>
<div class="my-1">
  <%= partial :'events/add_event_session', locals: {
        event_sessions: @event.event_sessions.order('start_time asc'),
        add_and_remove: event_admin?,
        new_object: EventSession.new,
        new_url: "/e/#{@event.slug}/event_sessions/new",
        destroy_url: "/e/#{@event.slug}/event_sessions/destroy"
      } %>
</div>
