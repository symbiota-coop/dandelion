<% if params[:duplicated] %>
  <div class="alert alert-primary">
    <p class="mb-0">
      The event was duplicated, and you're now editing the duplicate.
    </p>
  </div>
<% end %>
<% if @event.locked? || (@event.organisation && !@event.organisation.payment_method? && @event.paid_tickets?) %>
  <div class="alert alert-warning">
    <% locked_error = @event.locked_error if @event.locked? && event_lock_admin? %>
    <% if locked_error %>
      <p class="mb-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        This event is currently locked and visible to event admins only.
      </p>
      <p class="mb-2">
        It was locked after an error<%= " from #{@event.locked_error_provider}" if @event.locked_error_provider %> when someone tried to buy tickets:
        <em><%= locked_error %></em>
      </p>
    <% end %>
    <p class="mb-0">
      <% if locked_error %>
        <% if @event.locked_error_provider %>
          Log into your <%= @event.locked_error_provider %> account and resolve any warnings or notifications you see there.
        <% end %>
      <% else %>
        <i class="bi bi-exclamation-triangle-fill"></i>
        <% if @event.locked? && event_lock_admin? %>
          This event is currently locked and visible to event admins only.
        <% end %>
      <% end %>
      <% if @event.organisation && !@event.organisation.payment_method? && @event.paid_tickets? %>
        You must <a href="/o/<%= @event.organisation.slug %>/edit">add details for Stripe or another payment processor in the Payments tab of your organisation</a> to take payments.
      <% elsif @event.locked? %>
        <% if event_lock_admin? %>
          <% if request.path.include?('/edit') %>
            Uncheck the Locked checkbox and save to unlock it.
          <% else %>
            <a href="/events/<%= @event.id %>/edit">Edit the event</a>, uncheck the Locked checkbox and save to unlock it.
          <% end %>
        <% else %>
          The event has been submitted for review. It's currently locked and visible to event admins only.
        <% end %>
      <% end %>
    </p>
  </div>
<% end %>
