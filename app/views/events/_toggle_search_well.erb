<script>
  // The search options slide open or shut under their header like the sidebar's groups, and the chevron turns to point up while they're open
  function toggleAdvancedSearch () {
    var open = $('#toggle-search').attr('aria-expanded') !== 'true'
    $('#toggle-search').attr('aria-expanded', open)
    $('.search-body').stop(true)[open ? 'slideDown' : 'slideUp'](175, function () {
      window.dispatchEvent(new Event('resize'))
    })
  }
</script>
<button type="button" id="toggle-search" class="search-toggle" aria-expanded="<%= search_open ? 'true' : 'false' %>" onclick="toggleAdvancedSearch()"><span><i class="bi bi-funnel me-1"></i> Filter</span> <i class="bi bi-chevron-down caret"></i></button>
