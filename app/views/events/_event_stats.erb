<script>
  function eventStatsZeroColumns() {
    return $("#event_stats thead th[data-hide-if-zero]").toArray().map(function(th) {
      return $(th).index()
    }).filter(function(index) {
      return !$('#event_stats tbody tr').toArray().some(function(tr) {
        return $(tr).children().eq(index).is('[data-nonzero]')
      })
    })
  }

  $(function() {
    // Hide the sidebar as soon as the table's first column reaches it when scrolling sideways
    var sidebarHidden = false;

    $(window).scroll(function() {
      var $table = $('#event_stats');
      if (!$table.length) return;
      // Below md the sidebar is an offcanvas for the mobile nav, so leave it alone
      var desktop = window.matchMedia('(min-width: 768px)').matches;
      var hide = desktop && $table.offset().left - $(window).scrollLeft() < $('#sidebar').outerWidth();
      if (hide === sidebarHidden) return;
      sidebarHidden = hide;
      var $sidebar = $('#sidebar').stop(true, true);
      if (hide) $sidebar.fadeOut(150);
      // Clear fadeIn's inline display, which would otherwise hold the mobile offcanvas open
      else if (desktop) $sidebar.fadeIn(150, function() { $sidebar.css('display', '') });
      else $sidebar.css('display', '');
    });
  });
</script>

<% if !@event  %>
  <style>
    #event_stats th:first-child, #event_stats td:first-child { position: sticky; left: 0; width: 15em; min-width: 15em; max-width: 15em; z-index: 999 }
    #event_stats td:first-child { border-right: 1px solid black }

    #event_stats thead, #event_stats th { background: white }
    #event_stats tr:nth-child(even) td:first-child { background-color: white }
    #event_stats tr:nth-child(odd) td:first-child { background-color: var(--grey-93) }
  </style>
  <script>
    $(function () {

      var dateIndex = $("#event_stats th").toArray().indexOf($("th[data-col-name='date']")[0])

      $(document).ajaxStop(function() {
        if (!$('#event_stats').hasClass('dataTable')) {
          var table = $('#event_stats').DataTable({
            info: false,
            paging: false,
            order: [[dateIndex, "asc"]],
            searching: false
          })
          table.on('draw.dt', function() {
            $("#event_stats th[data-sum], #event_stats th[data-money]").each(function() {
              var index = $("#event_stats th").index(this);
              var sum = 0
              $('#event_stats tbody tr').each(function() {
                var f = parseFloat($('td:eq('+index+')', this).attr('data-sort'))
                if (isNaN(f))
                  f = 0
                sum += f
              })
              if ($(this).is('[data-money]'))
                $('tfoot th').eq(index).html('<%= money_symbol(organisation.currency) %>' + sum.toLocaleString());
              else
                $('tfoot th').eq(index).html(sum);
            });
            // Resize the floating header's columns to match the redrawn table
            $(window).trigger('resize.stickyTableHeaders')
          })
          table.columns(eventStatsZeroColumns()).visible(false)
          // Float the header only now, so its copy of the header has the same columns as the table
          if ($(window).width() > 992)
            $('#event_stats').stickyTableHeaders({zIndex: 9999})
          table.draw();
        }
      })

    })
  </script>
<% else %>
  <script>
    $(function () {
      eventStatsZeroColumns().forEach(function(index) {
        $('#event_stats tr').each(function() { $(this).children().eq(index).hide() })
      })
    })
  </script>
<% end %>

<% if @event %>
  <%== '<div class="table-responsive mb-3">' %>
<% end %>
<table id="event_stats" class="table <% if @event %> mb-0 <% else %> table-striped table-hover <% end %> table-sm fs-sm">
  <thead>
    <tr>
      <th>Name</th>
      <th data-orderable="false"></th>
      <th style="min-width: 12.5em" data-col-name="date">Date</th>
      <th>Coordinator</th>
      <% if organisation.stripe_client_id %>
        <th>Organiser</th>
      <% end %>
      <th>Facilitators</th>
      <th>Tags</th>
      <th>Activity</th>
      <th>Local group</th>
      <th>Facebook event</th>
      <th>30d views</th>
      <th data-sum>Tickets sold</th>
      <th>Checked in</th>
      <th data-money>Ticket revenue</th>
      <th data-money>Donations</th>
      <% if organisation.stripe_client_id %>
        <th data-money>Ticket revenue to revenue sharer</th>
        <th data-money>Ticket revenue to organisation</th>
        <th data-money>Revenue reported by Dandelion</th>
        <th data-money>Revenue reported by Stripe</th>
        <th data-money>Stripe fees</th>
        <th data-money>Profit</th>
        <th data-money>Profit less donations, before allocations</th>
        <% Event.profit_share_roles.each do |role| %>
          <th data-money<% if %w[category_steward social_media].include?(role) %> data-hide-if-zero<% end %>>Allocated to <%= role.gsub('_',' ') %></th>
        <% end %>
        <th data-money>Profit less donations, after allocations</th>
        <th data-money>Profit including donations, after allocations</th>
        <th data-money>Remaining to be paid</th>
      <% end %>
      <th>Feedback</th>
    </tr>
  </thead>
  <% events.each { |event| %>
  <tr data-pagelet-url="/events/<%= event.id %>/stats_row<%= "?timezone=#{event.start_time&.strftime('%Z')}&organisation_id=#{organisation.id}&event_revenue_admin=#{event_revenue_admin?(event) ? 1 : 0}" %>"><% if @event %><%= cp(:'events/event_stats_row', locals: { event: @event, organisation: organisation, event_revenue_admin: event_revenue_admin? }, event: @event, key: "/events/#{@event.id}/stats_row?timezone=#{@event.start_time&.strftime('%Z')}&organisation_id=#{organisation.id}&event_revenue_admin=#{event_revenue_admin? ? 1 : 0}") %><% end %></tr>
  <% } %>
  <% unless @event %>
    <tfoot>
      <tr>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <% if organisation.stripe_client_id %>
          <th></th>
        <% end %>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <% if organisation.stripe_client_id %>
          <% 14.times do %>
            <th></th>
          <% end %>
        <% end %>
        <th></th>
      </tr>
    </tfoot>
  <% end %>
</table>
<% if @event %>
  <%== '</div>' %>
<% end %>
