<script>
  function eventStatsZeroColumns() {
    return $("#event_stats thead th[data-hide-if-zero]").toArray().map(function(th) {
      return $(th).index()
    }).filter(function(index) {
      return !$('#event_stats tbody tr').toArray().some(function(tr) {
        return $(tr).children().eq(index).is('[data-nonzero]')
      })
    })
  }
</script>

<% if !@event %>
  <script>
    $(function () {

      var dateIndex = $("#event_stats th").toArray().indexOf($("th[data-col-name='date']")[0])

      var table = $('#event_stats').DataTable({
        info: false,
        paging: false,
        order: [[dateIndex, "asc"]],
        searching: false
      })
      table.on('draw.dt', function() {
        $("#event_stats th[data-sum], #event_stats th[data-money]").each(function() {
          var index = $("#event_stats th").index(this);
          var sum = 0
          $('#event_stats tbody tr').each(function() {
            var f = parseFloat($('td:eq('+index+')', this).attr('data-sort'))
            if (isNaN(f))
              f = 0
            sum += f
          })
          if ($(this).is('[data-money]'))
            $('tfoot th').eq(index).text(<%== money_symbol(organisation.currency).to_json %> + sum.toLocaleString());
          else
            $('tfoot th').eq(index).html(sum);
        });
      })
      table.columns(eventStatsZeroColumns()).visible(false)
      table.draw();

    })
  </script>
<% else %>
  <script>
    $(function () {
      eventStatsZeroColumns().forEach(function(index) {
        $('#event_stats tr').each(function() { $(this).children().eq(index).hide() })
      })
    })
  </script>
<% end %>

<% if @event %>
  <%== '<div class="table-responsive mb-3">' %>
<% end %>
<table id="event_stats" class="table <% if @event %> mb-0 <% else %> table-striped table-hover table-sticky <% end %> table-sm small">
  <thead>
    <tr>
      <th>Name</th>
      <th data-orderable="false"></th>
      <th style="min-width: 12.5em" data-col-name="date">Date</th>
      <th>Coordinator</th>
      <% if organisation.stripe_client_id %>
        <th>Organiser</th>
      <% end %>
      <th>Facilitators</th>
      <th>Tags</th>
      <th>Activity</th>
      <th>Local group</th>
      <th>Facebook event</th>
      <th>Views</th>
      <th data-sum>Tickets sold</th>
      <th>Checked in</th>
      <th data-money>Ticket revenue</th>
      <th data-money>Donations</th>
      <% if organisation.stripe_client_id %>
        <th data-money>Ticket revenue to revenue sharer</th>
        <th data-money>Ticket revenue to organisation</th>
        <th data-money>Revenue reported by Dandelion</th>
        <th data-money>Revenue reported by Stripe</th>
        <th data-money>Stripe fees</th>
        <th data-money>Profit</th>
        <th data-money>Profit less donations, before allocations</th>
        <% Event.profit_share_roles.each do |role| %>
          <% if %w[category_steward social_media].include?(role) %>
            <th data-money data-hide-if-zero>Allocated to <%= role.gsub('_',' ') %></th>
          <% else %>
            <th data-money>Allocated to <%= role.gsub('_',' ') %></th>
          <% end %>
        <% end %>
        <th data-money>Profit less donations, after allocations</th>
        <th data-money>Profit including donations, after allocations</th>
        <th data-money>Remaining to be paid</th>
      <% end %>
      <th>Feedback</th>
    </tr>
  </thead>
  <% event_stats_rows(events, organisation).each do |row| %>
    <tr><%= row %></tr>
  <% end %>
  <% unless @event %>
    <tfoot>
      <tr>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <% if organisation.stripe_client_id %>
          <th></th>
        <% end %>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <% if organisation.stripe_client_id %>
          <% 14.times do %>
            <th></th>
          <% end %>
        <% end %>
        <th></th>
      </tr>
    </tfoot>
  <% end %>
</table>
<% if @event %>
  <%== '</div>' %>
<% end %>
