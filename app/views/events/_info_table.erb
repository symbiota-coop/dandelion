<table class="table table-hr">
  <tr>
    <td>
      <% if @event.purchase_url || (@event.organiser && @event.organisation && @event.organisation.stripe_client_id) || @event.revenue_sharer %>
        Promoted by
      <% else %>
        Hosted by
      <% end %>
    </td>
    <td>
      <div class="d-flex align-items-center gap-2">
        <% if @event.organisation.image %>
          <a class="flex-shrink-0" href="/o/<%= @event.organisation.slug %>/events"><img alt="<%= @event.organisation.name %>" src="<%= u @event.organisation.image.thumb('500x500#').url %>" style="width: 3.125rem"></a>
        <% end %>
        <a href="/o/<%= @event.organisation.slug %>/events"><%= @event.organisation.name %></a>
      </div>
      <% if event_admin? && @event.revenue_sharer && !@event.organisation.organisationships.find_by(:account => @event.revenue_sharer, :stripe_connect_json.ne => nil) %>
        <span class="badge text-bg-danger">
          <i class="bi bi-exclamation-triangle-fill"></i> Revenue sharer not connect to this organisation
        </span>
      <% end %>
      <div data-pagelet-url="/e/<%= @event.slug %>/cohostships">
        <%= partial :'events/cohosts_box' %>
      </div>
    </td>
  </tr>
  <% if @event.activity && !@event.activity.locked? && @event.activity.name != @event.organisation.name %>
    <tr>
      <td>Activity</td>
      <td>
        <a href="<%= @event.activity.path %>"><%= @event.activity.name %></a>
      </td>
    </tr>
  <% end %>
  <% if @event.local_group %>
    <tr>
      <td>Local group</td>
      <td>
        <a href="<%= @event.local_group.path %>"><%= @event.local_group.name %></a>
      </td>
    </tr>
  <% end %>
  <% if event_admin? || (@event.event_facilitations.exists? && @event.event_facilitations.any? { |event_facilitation| event_facilitation.account.publicly_visible? }) %>
    <tr>
      <td>Facilitators</td>
      <td>
        <div data-pagelet-url="/e/<%= @event.slug %>/event_facilitations">
          <%= partial :'events/facilitators_box' %>
        </div>
      </td>
    </tr>
  <% end %>
  <% if @event.facebook_event_url %>
    <tr>
      <td>Facebook event</td>
      <td>
        <a target="_blank" href="<%= @event.facebook_event_url %>"><i class="bi bi-facebook"></i></a>
      </td>
    </tr>
  <% end %>
  <% if @event.email %>
    <tr>
      <td>Enquiries to</td>
      <td>
        <a target="_blank" href="mailto:<%= @event.email %>"><%= @event.email %></a>
      </td>
    </tr>
  <% end %>
  <% unless @event.evergreen? %>
    <tr>
      <td>
        Add to calendar
      </td>
      <td>
        <%= partial :'events/add_to_calendar', locals: { event: @event } %>
      </td>
    </tr>
  <% end %>
  <% unless @event.secret? %>
    <tr>
      <td>QR code</td>
      <td>
        <a target="_blank" href="/qr.png?url=<%= "#{ENV['BASE_URI']}/e/#{@event.slug}" %>"><img alt="QR code" src="/qr.png?url=<%= "#{ENV['BASE_URI']}/e/#{@event.slug}" %>" style="width: 3.125rem"></a>
      </td>
    </tr>
  <% end %>
</table>
