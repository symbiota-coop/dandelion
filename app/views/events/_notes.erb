<% unless @event.notes %>
  <a href="javascript:;" onclick="$(this).next().show().find('textarea').focus(); $(this).remove()"><i class="bi bi-plus-lg"></i> Private note</a>
<% end %>
<% form_tag "/events/#{@event.id}/notes", style: ('display: none' unless @event.notes) do %>
  <div class="ask-box">
    <label class="visually-hidden" for="event-notes">Private notes</label>
    <%= text_area_tag :notes, id: 'event-notes', rows: 1, placeholder: 'Private notes (visible to event admins only)', class: 'autosize form-control', onchange: '$(this.form).submit()', value: @event.notes %>
    <div class="ask-box-actions">
      <button type="submit" class="btn btn-primary btn-sm" aria-label="Save notes">
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </button>
    </div>
  </div>
<% end %>
