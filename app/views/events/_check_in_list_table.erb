<% @tickets = @tickets.order('created_at desc')
   @tickets = @tickets.paginate(page: params[:page], per_page: 50) %>

<p><%== pagination_details @tickets, model: 'Ticket' %></p>
<script>
  $(function () {

    var colIndex = $("#tickets th").toArray().indexOf($("th[data-col-name='created-at']")[0])

    $(document).ajaxStop(function() {
      if (!$('#tickets').hasClass('dataTable')) {
        $('#tickets').DataTable({info: false, paging: false, searching: false, order: [[colIndex, "desc"]]});
      }
    })
  })
</script>
<table class="table" id="tickets">
  <thead>
    <tr>
      <th>Name</th>
      <th>Ticket type</th>
      <th>Ticket ID</th>
      <th data-col-name="created-at">Created at</th>
      <th>Checked in</th>
    </tr>
  </thead>
  <% @tickets.each { |ticket| %>
  <tr>
    <td>
      <%= partial :'events/ticket_holder', locals: { ticket: ticket } %>
    </td>
    <td>
      <%= ticket.ticket_type.try(:name) %>
    </td>
    <td nowrap>
      <abbr title="<%= ticket.public_id %>" data-bs-toggle="tooltip">
        <%= ticket.public_id[0..3] %>&hellip;<%= ticket.public_id[-4..-1] %>
      </abbr>
    </td>
    <td data-sort="<%= ticket.created_at.iso8601 %>">
      <%= ticket.created_at %>
    </td>
    <td>
      <div data-pagelet-url="/e/<%= @event.slug %>/check_in_toggle/<%= ticket.public_id %>">
        <%= partial :'events/check_in_toggle', locals: { ticket: ticket } %>
      </div>
    </td>
  </tr>
  <% } %>
</table>
<%= will_paginate @tickets, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
