<div class="text-center">
  <h1>Oops, your secret is wrong</h1>
  <p>Enter the correct check-in secret for the event</p>
  <% form_tag '', method: 'get' do %>
    <div class="input-group d-inline-flex w-auto">
      <%= text_field_tag :secret, value: params[:secret], class: 'form-control', 'aria-label': 'Check-in secret' %>
      <%= submit_tag 'Submit', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
