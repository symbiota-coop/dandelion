<% image = tactivity.image %>
<div class="tactivity<%= ' tactivity-image' if image %> mb-2" data-attendances-count="<%= tactivity.attendances.count %>" data-tactivity-id="<%= tactivity.id %>"<% if image %> style="--tactivity-image: url('<%= image.thumb('400x400').url %>')"<% end %>>
  <div class="position-absolute" style="bottom: .5rem; left: .5rem">
    <h3 class="mt-0 mb-0 position-relative" data-bs-toggle="tooltip">
      <a href="/g/<%= @gathering.slug %>/tactivities/<%= tactivity.id %>"><%= tactivity.name %></a>
    </h3>
    <span style="display: none"><%= tactivity.description.truncate(150) if tactivity.description %></span>
    <span>
      by
      <a href="/u/<%= tactivity.account.username %>"><%= tactivity.account.name %></a>
    </span>
    <div>
      <div style="display: inline-block" data-pagelet-url="/tactivities/<%= tactivity.id %>/attendees"></div>
    </div>
  </div>
  <div style="right: .5rem; bottom: .5rem" class="position-absolute">
    <% if tactivity.comments.exists? %>
      <a data-bs-toggle="tooltip" title="<%= pluralize(tactivity.comments.count, 'comment') %>" href="/g/<%= @gathering.slug %>/tactivities/<%= tactivity.id %>"><i class="bi bi-chat-left-text"></i> <%= tactivity.comments.count %></a>
      &middot;
    <% end %>
    <% if tactivity.space_id and (@membership.admin? or tactivity.timetable.scheduling_by_all) %>
      <a class="pagelet-trigger" data-confirm="Are you sure you want to unschedule this activity?" title="Unschedule" data-method="post" href="/tactivities/<%= tactivity.id %>/unschedule"><i class="bi bi-calendar-minus"></i></a>
      &middot;
    <% end %>
    <a title="Edit" href="/tactivities/<%= tactivity.id %>/edit"><i class="bi bi-pencil-fill"></i></a>
  </div>
</div>
