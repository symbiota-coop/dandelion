<% form_for @tactivity ||= Tactivity.new, @tactivity.new_record? ? "/g/#{@gathering.slug}/tactivities/create?timetable_id=#{timetable.id}" : "/g/#{@gathering.slug}/tactivities/#{@tactivity.id}/edit" do |f| %>

  <% if @tactivity.errors.exists? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @tactivity.errors.full_messages.each { |message| %>
        <li><%= message %></li>
        <% } %>
      </ul>
    </div>
  <% end %>

  <%= f.text_block :name %>
  <%= f.text_area_block :description, rows: 3, autosize: true %>
  <%= f.image_block :image %>
  <% if @tactivity.persisted? && (gathering_admin? || @tactivity.timetable.scheduling_by_all) %>
    <%= f.select_block :space_id, options: @tactivity.space_ids %>
    <%= f.select_block :tslot_id, options: @tactivity.tslot_ids %>
  <% end %>
  <%= f.submit_block button_text: @tactivity.new_record? ? 'Create activity' : 'Update activity', destroy_url: ("/g/#{@gathering.slug}/tactivities/#{@tactivity.id}/destroy" if gathering_admin?) %>
<% end %>
