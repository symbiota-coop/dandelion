<script>
  $(function () {

    var points = [];
    <% if defined?(points) %>
      <% points.each_with_index { |point, n| %>
        points.push({
          model_name: <%== point.class.to_s.to_json %>,
          id: <%== encrypt_map_id(point.class.to_s, point.id.to_s).to_json %>,
          lat: <%== point.lat.to_json %>,
          lng: <%== point.lng.to_json %>,
          n: <%== n.to_json %>
        });
      <% } %>
    <% end %>

    var polygonPaths = [];
    <% if defined?(polygonables) %>
      <% polygonables.each { |polygonable| %>
        <% polygonable.polygons.each { |polygon| %>
          <% next unless polygon.coordinates.is_a?(Array) && polygon.coordinates[0].is_a?(Array) %>
          polygonPaths.push([
            <% polygon.coordinates.each { |ring| %>
              <% next unless ring.is_a?(Array) %>
              [
                <% ring.each { |coordinate| %>
                  {lat: <%== coordinate[1].to_json %>, lng: <%== coordinate[0].to_json %>},
                <% } %>
              ],
            <% } %>
          ]);
        <% } %>
      <% } %>
    <% end %>

    // Map configuration
    var config = {
      points: points,
      polygonPaths: polygonPaths,
      fillScreen: <%== (defined?(fill_screen) && fill_screen ? true : false).to_json %>,
      url: <%== (binding.local_variable_defined?(:url) ? url : nil).to_json %>,
      boundingBox: <%== (defined?(bounding_box) ? bounding_box : nil).to_json %>,
      pointsLimit: <%== MAP_POINTS_LIMIT.to_json %>,
      mapId: <%== (ENV['GOOGLE_MAPS_MAP_ID'] || 'DEMO_MAP_ID').to_json %>
    };

    // Initialize the map
    DandelionMap.initializeMap(config);
  });
</script>
<style>
  #map-canvas > div { background-color: transparent !important; }
</style>
<div class="position-relative" id="map-container">
  <div id="map-canvas" style="height: 50vh"></div>
  <div id="points-warning" style="left: 1.25rem; right: 1.25rem; margin: auto; display: none" class="mt-3 alert alert-warning position-absolute top-0">There are too many points to display, please zoom in</div>
</div>
