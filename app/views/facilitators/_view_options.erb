<% if params[:minimal] %>
  <%== '<div class="container-fluid my-3">' %>
<% end %>

<%
  view_options = [
    { key: 'list', label: 'List', icon: 'bi-list-task', active: !params[:display].in?(%w[map calendar]) },
    { key: 'map', label: 'Map', icon: 'bi-geo-alt-fill', active: params[:display] == 'map' }
  ]
%>
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
  <%= partial :view_as, locals: { view_options: view_options, path: (path if defined?(path)) } %>
</div>

<% if params[:minimal] %>
  <%== '</div>' %>
<% end %>
