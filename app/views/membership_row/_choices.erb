<td>
  <% membership.optionships.each { |optionship| %>
  <% if !gathering_admin? && optionship.option.hide_members? %>
    <a href="/g/<%= @gathering.slug %>/options" class="badge text-bg-secondary">
      <i class="bi <%= optionship.option.icon %>"></i> <%= optionship.option.type %>
    </a>
  <% else %>
    <a title="<%= optionship.option.type %>" href="/g/<%= @gathering.slug %>/options" class="badge text-bg-primary">
      <i class="bi <%= optionship.option.icon %>"></i> <%= optionship.option.name %> (<%= m optionship.option.cost_per_person, @gathering.currency %>)
    </a>
  <% end %>
  <% } %>
</td>
