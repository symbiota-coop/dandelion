<td>
  <% mapplication = membership.mapplication; if gathering_admin? && mapplication && mapplication.answers %>
  <a href="javascript:;" onclick="$('#modal .modal-content').load(<%= "/g/#{@gathering.slug}/mapplications/#{mapplication.id}".to_json %>, function () {
          $('#modal').modal('show')
        });">
    <%= membership.created_at %>
  </a>
<% elsif membership.answers %>
  <a href="javascript:;" onclick="$('#modal .modal-content').load(<%= "/g/#{@gathering.slug}/memberships/#{membership.id}".to_json %>, function () {
          $('#modal').modal('show')
        });">
    <%= membership.created_at %>
  </a>
<% else %>
  <%= membership.created_at %>
<% end %>
<% if mapplication %>
  <span title="Accepted at <%= membership.vouchers_count %> <%= @gathering.vouchers %>" class="badge text-bg-primary mb-1"><%= membership.vouchers_count %></span>
<% end %>
</td>
