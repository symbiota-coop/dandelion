<% if activity.persisted? && activity_admin?(activity) %>
  <% unless defined?(inline) %>
    <%== '<div class="nav-crumbs mb-3">' %>
  <% end %>
  <% if organisation_admin?(activity.organisation) && !defined?(hide_organisation_nav) %>
    <%= partial :'organisations/nav', locals: { organisation: activity.organisation, inline: true } %>
  <% end %>
  <%= dropdown_nav [
        ['View activity', activity.path],
        ['Settings', "#{activity.path}/edit"],
        (['Preview application form', "#{activity.path}/apply"] if activity.privacy == 'closed'),
        ([%(Applications <span class="badge text-bg-primary">#{activity.activity_applications.outstanding.count}</span>), "#{activity.path}/applications"] if activity.privacy == 'closed'),
        [%(Followers <span class="badge text-bg-primary">#{activity.activityships.count}</span>), "#{activity.path}/followers"],
        ['Discount codes' + (activity.discount_codes.count.positive? ? " <span class='badge text-bg-primary'>#{activity.discount_codes.count}</span>" : ''), "#{activity.path}/discount_codes"],
        ['Event stats', "#{activity.path}/events/stats"],
        ['Audience stats', "#{activity.path}/stats"],
        ['Feedback', "#{activity.path}/feedback"],
        ['Mailer', "#{activity.path}/pmails"]
      ].compact, button_text: %(#{activity.name}), container_class: 'btn-group mb-1' %>
  <% unless defined?(inline) %>
    <%== '</div>' %>
  <% end %>
<% end %>
