<%= partial :block, locals: {
      title: activity.name,
      icon: ('<i class="bi bi-lock"></i>' if activity.locked?),
      image: activity.image,
      view_url: "/o/#{activity.organisation.slug}/a/#{activity.slug}",
      edit_url: "/activities/#{activity.id}/edit",
      admin: activity_admin?(activity),
      bottom_text: (activity.organisation.name unless @organisation),
      bottom_url: ("/o/#{activity.organisation.slug}" unless @organisation)

    } %>
