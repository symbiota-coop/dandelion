<% case status; when 'Accepted' %>
<span class="badge text-bg-primary">Accepted</span>
<% when 'Rejected, contacted' %>
<span class="badge text-bg-danger">Rejected, contacted</span>
<% when 'Rejected, to contact' %>
<span class="badge text-bg-danger">Rejected, to contact</span>
<% when 'To interview' %>
<span class="badge text-bg-primary">To interview</span>
<% when 'On hold' %>
<span class="badge text-bg-warning">On hold</span>
<% else %>
  <span class="badge text-bg-primary">Pending</span>
<% end %>
