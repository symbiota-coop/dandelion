<div class="main">
  <p>Hi %recipient.firstname%,</p>
  <p>
    Your RSVP to <a href="<%= ENV['BASE_URI'] %>/e/<%= event.slug %>"><%= event.name %></a> has been cancelled.
  </p>
  <p>
    If this was a mistake, you can RSVP again from the event page.
  </p>
  <p class="action">
    <a href="<%= ENV['BASE_URI'] %>/e/<%= event.slug %>">View event</a>
  </p>
</div>
<div class="footer">
  <a href="<%= ENV['BASE_URI'] %>">
    <img class="footer-logo" src="<%= ENV['BASE_URI'] %>/images/logos/logo-text.png">
  </a>
</div>
