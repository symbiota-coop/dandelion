<div class="main">
  <p>Hi %recipient.firstname%,</p>
  <p>
    We received an error<%= " from #{provider}" if provider %> when <%= account.name %> (<a href="mailto:<%=account.email%>"><%=account.email%></a>) attempted to purchase ticket(s) for the event <a href="<%= ENV['BASE_URI'] %>/e/<%=event.slug%>"><%= event.name %></a>:
  </p>
  <blockquote>
    <%== Rinku.auto_link(h(error.message)) %>
  </blockquote>
  <% unless help == false %>
    <% if event.locked? %>
      <p>
        We've locked the event on Dandelion to prevent further errors.
      </p>
    <% end %>
    <p>
      <% if provider %>
        Please log into your <%= provider %> account and resolve any warnings or notifications you see there.<% if help.is_a?(String) %> <%= help %><% end %>
      <% end %>
      <% if event.locked? %>
        Once you've done that, you can <a href="<%= ENV['BASE_URI'] %>/e/<%=event.slug%>/edit">edit the event</a> to uncheck the Locked checkbox and save to allow purchases again.
      <% end %>
    </p>
  <% end %>
</div>
