<div class="main">
  <p>
    <%= organisationship.account.name %> (<a href="mailto:<%=organisationship.account.email%>"><%=organisationship.account.email%></a>)
    is now donating
    <%= Money.new(organisationship.monthly_donation_amount * 100, organisationship.monthly_donation_currency).format(no_cents_if_whole: true) %> per month
    to <%= organisation.name %>
    via <%= organisationship.monthly_donation_method %><% if organisationship.monthly_donation_annual %>, paid annually<% end %>.
  </p>
</div>
