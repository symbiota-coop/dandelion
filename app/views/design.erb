<link rel="stylesheet" href="<%= cachebust('/stylesheets/design.css') %>">
<%# For the marketing pages' rose and magenta %>
<link rel="stylesheet" href="<%= cachebust('/stylesheets/marketing.css') %>">
<%# For the chat bubbles %>
<link rel="stylesheet" href="<%= cachebust('/stylesheets/messages.css') %>">
<%# For the feedback form's stars %>
<link rel="stylesheet" href="<%= cachebust('/stylesheets/event_feedbacks.css') %>">

<%# Swatch values are read from the live stylesheet by the script at the bottom %>
<%# Themed panels run through clamp_color as /theme.css does, so a colour too light for white text is darkened %>
<% themed_colors = %w[#1a73e8 #ffc107].map { |color| [color, clamp_color(color)] }

   flashes = [['primary', 'Your ticket is booked.', 'View order'], ['warning', 'Only 3 tickets left.', 'Book now'], ['danger', 'Payment failed.', 'Try again']] %>

<%# Captured so the nav, built from the sections and subsections as they render, can come before it %>
<% guide = capture_html do %>
<div class="design-guide d-flex flex-column gap-5">

  <header class="d-flex flex-column gap-3" style="max-width: 45rem">
    <h1 class="m-0">Design guide</h1>
    <p class="m-0 readable">The visual language of dandelion.events as it exists in code today. This page is rendered with the site's own <code>app.css</code> and <code>bootstrap5.css</code>, so swatches, type and components are the real thing. The site is Bootstrap 5.3.8, restyled through its variables.</p>
    <p class="m-0 small text-body-secondary">The root font size is 17px (19px from 1680px, 21px from 1920px), so rem values scale with the viewport. Sizes are in rem (or em, to follow the text); px is kept for 1–2px hairlines, shadows and the focus ring, for breakpoints and the container max-widths that fit inside them, and for overrides that must line up with Google Maps. Avatars take a size class (<code>.avatar-xs</code> to <code>.avatar-2xl</code>), not a width. Colour values, radii, type sizes and the spacing scale are measured live; other sizes are copied from the stylesheets.</p>
    <nav class="d-flex flex-wrap gap-2 d-lg-none">
      <% design_sections.each do |id, (title, _)| %>
        <a class="btn btn-outline-primary btn-sm" href="#<%= id %>"><%= title %></a>
      <% end %>
    </nav>
  </header>

  <!-- COLOUR -->
  <% design_section 'colour' do %>
    <% design_subsection 'Theme', 'A ramp generated from one value with <code>oklch()</code>. Components use the 500 for fills, 600 for hover, 100 for alert, toast and badge backgrounds, and 800 for text on those tints. Organisations and events set <code>--theme-500</code> only (through <code>/theme.css</code>). Tints (50–200) sit at fixed lightness, so they look equally light across hues; shades (400–800) are relative to the 500, with 800 capped dark enough for text on tints. The 400 is .06 lighter than the 500, or half way to the 200 when the 500 is too light for that, and the 300 is halfway between the 200 and 400, so the steps stay in order however light the colour. Every theme colour is a solid step of this ramp; the only translucent ones are the focus ring, .badge-overlay (the 500 at 70%, over images) and chart projections (the 500 at 50%, and in the contributions chart a 30% fill with a 50% border), so they read as estimates.'.html_safe do %>
      <%= partial :'design/ramp', locals: {
            prefix: '--theme',
            label: '--theme-*',
            label_note: "Primary and success · follows each organisation's theme",
            notes: {
              '50' => 'crumbs, newsfeed icons, date tile months, docs transcripts, themed AI well',
              '100' => 'alert, toast and badge background, crumb hover, unread messages',
              '200' => 'progress tracks, blockquote and transcript borders',
              '300' => nil,
              '400' => 'themed AI well end, Stripe Connect fees in the contributions chart',
              '500' => nil,
              '600' => 'hover',
              '800' => 'text on tints'
            }
          } %>
      <div class="small text-body-secondary">Bootstrap's <code>rgba(var(--bs-*-rgb))</code> colours need an rgb triplet, so <code>/theme.css</code> also sets <code>--theme-500-rgb</code>.</div>
    <% end %>

    <% design_subsection 'Lavender', "The default site's AI well and <code>.lavender-wash</code> backgrounds. Its steps come from --color-lavender-500, the default green turned to hue 300 at the same lightness and chroma, with the theme ramp's formulas.".html_safe do %>
      <%= partial :'design/ramp', locals: {
            prefix: '--color-lavender',
            notes: {
              '50' => '.lavender-wash, AI well background, features page section wash',
              '100' => 'not used yet',
              '200' => 'not used yet',
              '300' => 'not used yet',
              '400' => 'AI well gradient end',
              '500' => 'not used yet',
              '600' => 'features and Luma pages: purple divider end, call-to-action glow',
              '800' => 'not used yet'
            }
          } %>
    <% end %>

    <% design_subsection 'Yellow', "For highlighted or rewarded things, through <code>text-bg-yellow</code>: Featured, Co-host, rota points, PATCH routes. Its steps come from --color-yellow-500 with the theme ramp's formulas. Yellow's 500 is the lightest (see Warning and danger), so its 200 to 500 sit close together, set apart more by saturation than lightness.".html_safe do %>
      <%= partial :'design/ramp', locals: {
            prefix: '--color-yellow',
            notes: {
              '50' => 'not used yet',
              '100' => 'badge background',
              '200' => 'not used yet',
              '300' => 'not used yet',
              '400' => 'not used yet',
              '500' => 'contributions chart line and fill; text-bg-yellow on anything but a badge (not used yet)',
              '600' => 'not used yet',
              '800' => 'badge text'
            }
          } %>
    <% end %>

    <% design_subsection 'Warning and danger', "Two families, used the same way as the theme ramp: each variant class (alert-warning, toast-warning, table-warning, btn-warning, text-bg-warning and the danger ones) sets the steps it uses as <code>--variant-*</code>, and each component maps those to its roles once. The 500 is also Bootstrap's <code>$warning</code> and <code>$danger</code> in bootstrap5.scss, so text-danger, form errors and the like match. The lavender, yellow, orange and red 500s share the default green's oklch chroma, .169, so they are equally saturated; only lightness varies by hue, so each reads true: red .63, green and lavender .661, orange .76, yellow .86.".html_safe do %>
      <% roles = {
           '50' => 'row background',
           '100' => 'alert, toast and badge background',
           '200' => 'row border',
           '300' => 'not used yet',
           '400' => 'not used yet',
           '500' => 'fill: buttons, card headers and other text-bg-* elements that aren\'t badges',
           '600' => 'button hover',
           '800' => 'text and links on tints, badge text'
         }
         other_uses = {
           'orange' => {
             '50' => 'features page section washes',
             '500' => 'ASN stats: bot % of 30 and over',
             '400' => 'star icons, feedback stars, map areas, features page',
             '200' => 'features page divider end'
           },
           'red' => {
             '500' => 'ASN stats: bot % of 60 and over; check-in QR scan line',
             '400' => 'map: event and organisation markers'
           }
         } %>
      <% [%w[Warning orange warning], %w[Danger red danger]].each do |title, colour, variant| %>
        <%= partial :'design/ramp', locals: {
              prefix: "--color-#{colour}",
              label: title,
              label_note: "--color-#{colour}-*",
              notes: roles.merge(other_uses[colour]) { |_, role, uses| role == 'not used yet' ? uses.upcase_first : "#{role}. Also: #{uses}" }
            } %>
      <% end %>
      <div class="small text-body-secondary">Danger badges take the 200, as red's 100 reads pink. table-warning and table-danger rows mix 30% of the way from the 50 to the 200 for hover, stripes and active rows.</div>
    <% end %>

    <% design_subsection 'Greys, black and white', "Bootstrap's own variables, set in bootstrap5.scss to near-neutral greys: Bootstrap's lightness steps with a trace of warmth (designed at oklch hue 75, chroma .00225–.003, then rounded to hex). Usage: 100 (<code>--bs-tertiary-bg</code>) body.canvas pages, wells and hovered dropdown, autocomplete and list items, and table stripes · 200 (<code>--bs-secondary-bg</code>) hovered nav links, table rows and secondary buttons, secondary badges and input add-ons · 300 (<code>--bs-border-color</code>) table and secondary button borders · 400 input borders and hr · 500 sidebar sub-menu links and grey borders (comment boxes, the editor) · 600 secondary text · 700 input add-on text · 800 search bar · 900 header and sidebar. Body text (<code>--bs-body-color</code>) and emphasis text (<code>--bs-emphasis-color</code>, set to 900 in bootstrap5.scss in place of Bootstrap's black) are the same as 900. Black and white with transparency use <code>rgba(var(--bs-black-rgb), a)</code> and <code>rgba(var(--bs-white-rgb), a)</code>, e.g. shadows and image overlays. Hairlines (card, dropdown, autocomplete and cookie banner borders, date tiles, the .chill card header's divider, marketing cards) use <code>--hairline</code>, black at 10%: Bootstrap's <code>--bs-border-color-translucent</code>, set in bootstrap5.scss, so its cards and dropdowns share it.".html_safe do %>
      <div class="row g-3">
        <% %w[--bs-white --bs-gray-100 --bs-gray-200 --bs-gray-300 --bs-gray-400 --bs-gray-500 --bs-gray-600 --bs-gray-700 --bs-gray-800 --bs-gray-900 --bs-black].each do |name| %>
          <%= partial :'design/swatch', locals: { vars: [name], col: 'col-6 col-md-3 col-xl' } %>
        <% end %>
      </div>
    <% end %>

    <% design_subsection 'Accents and surfaces', 'Single colours with one role each.' do %>
      <div class="row g-3 row-cols-2 row-cols-md-3">
        <% [
             [%w[--color-paper], '.lavender-wash end'],
             [%w[--color-highlight], 'mark, .highlight'],
             [%w[--color-midnight], 'header sunset; root of the marketing pages\' purple']
           ].each do |vars, note| %>
          <%= partial :'design/swatch', locals: { vars: vars, note: note } %>
        <% end %>
      </div>
    <% end %>

    <% design_subsection 'Other gradients', 'The dark header and sidebar are a sunset: near-black fading to --color-midnight, with the orange-to-yellow --gradient-active as the sun on the active sidebar item, the notification dot and the load bar. Light content marks active states with the theme colour, so each surface has one active colour. --gradient-rainbow is only for .gradient-text headlines on marketing pages and the signed-out home.' do %>
      <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-xl-4">
        <% [
             { box_class: 'lavender-wash', title: '.lavender-wash', note: 'Lavender to paper. body.lavender-wash on the sign-in pages (email, code, Ethereum), sign-up and auth failure; a .lavender-wash div, which also fades to white at the bottom, behind the hero on the marketing pages and the signed-out home.' },
             { fills: ['var(--gradient-active)'], title: '--gradient-active', note: 'Sidebar active item, notification dot, page-load bar.' },
             { fills: ['var(--gradient-rainbow)'], title: '--gradient-rainbow', note: '.gradient-text only.' },
             { fills: ['var(--gradient-header)'], title: '--gradient-header', note: 'The header: 45°, --bs-gray-900 to 66%, then midnight.' }
           ].each do |swatch| %>
          <%= partial :'design/swatch', locals: swatch %>
        <% end %>
      </div>
    <% end %>

    <% design_subsection 'Marketing pages', 'The features and comparison pages. Their purple gradient and the five reason colours on the Luma page are derived from <code>--color-midnight</code> and <code>--color-magenta-500</code>. Rose and magenta are only used here, so they are defined in <code>marketing.css</code>, which only these pages and this guide load.'.html_safe do %>
      <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-xl-4">
        <% [
             { vars: %w[--color-orange-50 --color-rose-50 --color-magenta-50 --color-lavender-50], title: 'Section washes', note: 'section backgrounds: the 50 step of orange, rose, magenta and lavender' },
             { vars: %w[--color-rose-500 --color-rose-200], note: 'section divider: 500 to 200' },
             { vars: %w[--color-magenta-500 --color-magenta-200], note: 'section divider: 500 to 200' },
             { fills: 0.step(100, 25).map { |pct| "color-mix(in srgb, var(--color-magenta-500), var(--color-midnight) #{pct}%)" }, title: 'Magenta to midnight', note: 'color-mix, 0–100%' }
           ].each do |swatch| %>
          <%= partial :'design/swatch', locals: swatch %>
        <% end %>
      </div>
    <% end %>

    <% design_subsection 'Third-party brands', 'Only for buttons and labels that stand for these services.' do %>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--color-evm], 'EVM'],
             [%w[--color-stripe], 'Stripe · text-bg-stripe'],
             [%w[--color-opencollective], 'Open Collective'],
             [%w[--color-coinbase], 'Coinbase'],
             [%w[--color-signal --color-signal-dark], 'Signal · btn-signal'],
             [%w[--color-paypal], 'PayPal'],
             [%w[--color-gocardless --color-gocardless-text], 'GoCardless'],
             [%w[--color-mollie], 'Mollie']
           ].each do |vars, note| %>
          <%= partial :'design/swatch', locals: { vars: vars, fills: ["var(#{vars.first})"], title: vars.first, note: note } %>
        <% end %>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="small text-body-secondary">Payment badges, from <code>badge-payment-&lt;method&gt;</code>:</span>
        <% [%w[coinbase Coinbase], %w[mollie Mollie], %w[paypal PayPal], ['gocardless-instant', 'GoCardless'], ['gocardless-instalment', 'GoCardless instalments'], ['opencollective', 'OC: …'], ['evm', 'EVM: …']].each do |name, text| %>
          <span class="badge badge-payment-<%= name %>"><%= text %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <!-- TYPE -->
  <% design_section 'type' do %>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="spec fw-bold">HEADINGS · --header-font-family</div>
          <div class="header-font display-5 fw-bold lh-1">Hanken Grotesk</div>
          <div class="small text-body-secondary">Variable 100–900, used at bold. Letter-spacing −0.02em. Also <code>.strapline</code> and <code>.header-font</code>.</div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="spec fw-bold">BODY · --body-font-family</div>
          <div class="display-5 lh-1">Plus Jakarta Sans</div>
          <div class="small text-body-secondary">Default weight 500, labels 700, bold for <code>b</code>/<code>strong</code>. Line height 1.5.</div>
        </div>
      </div>
    </div>

    <% design_subsection 'Scale' do %>
      <div class="border-bottom">
        <% [
             ['h1 · .fs-1', '--font-size-3xl · 2rem', '<h1 data-sample class="m-0">Gatherings near you</h1>'],
             ['h2 · .fs-2', '--font-size-2xl · 1.66rem', '<h2 data-sample class="m-0">Gatherings near you</h2>'],
             ['h3 · .fs-3', '--font-size-xl · 1.4rem', '<h3 data-sample class="m-0">Your upcoming events</h3>'],
             ['h4 · .fs-4', '--font-size-lg · 1.125rem', '<h4 data-sample class="m-0">Upcoming birthdays</h4>'],
             ['h5 · .fs-5', '--font-size-sm · .875rem', '<h5 data-sample class="m-0">Ticket types</h5>'],
             ['.lead', '--font-size-lg · 1.125rem', '<p data-sample class="lead m-0">An introductory line, like a sold-out card&#39;s</p>'],
             ['.readable', '--font-size-base · 1rem', '<div data-sample class="readable">Long-form copy such as event descriptions sets at 1rem.</div>'],
             ['body · nav · .btn', '--font-size-sm · .875rem', '<div data-sample>Body text, inputs, tables, buttons (btn-sm too), nav links, tabs, dropdown items and tooltips</div>'],
             ['.small', '.875em of its context', '<span data-sample class="small">Secondary details: a location, a description</span>'],
             ['.badge', '.9375em of its context', '<span data-sample class="badge text-bg-secondary">Badges</span>'],
             ['.breadcrumb', '--font-size-xs · .75rem', '<ol data-sample class="breadcrumb m-0"><li class="breadcrumb-item">Organisations</li><li class="breadcrumb-item">Breadcrumbs</li></ol>']
           ].each do |name, size, sample| %>
          <div data-spec-row class="py-3 border-top">
            <div class="row align-items-baseline">
              <code class="col-md-2 spec"><%= name %></code>
              <div class="col-md-7"><%== sample %></div>
              <code class="col-md-3 spec"><%= size %> · <span data-px></span></code>
            </div>
          </div>
        <% end %>
      </div>
      <div class="small text-body-secondary"><code>.h1</code>–<code>.h5</code> give any element a heading's style, e.g. <code>&lt;h4 class="h2"&gt;</code> for block titles. h5 is the smallest heading we use; h6 is the same size, so it's left to user-written descriptions. The heading sizes are set in bootstrap5.scss (<code>$h1-font-size</code>…), so <code>.fs-1</code>–<code>.fs-5</code> make text a heading's size without its weight or font. <code>.small</code> is Bootstrap's class for smaller text without the meaning of <code>&lt;small&gt;</code>, which is for small print. Secondary text is <code>--bs-secondary-color</code> (--bs-gray-600), set with <code>.text-body-secondary</code>; form-text takes it too. <code>.subtle</code> is for links in it, which turn the theme colour on hover. <code>.underline-dotted</code> is for quiet links that read as part of a sentence (a rota's edit links) and text to copy.</div>
    <% end %>
  <% end %>

  <!-- SHAPE -->
  <% design_section 'shape' do %>

    <% design_subsection 'Radius', "Bootstrap's radius variables, set to one scale in <code>bootstrap5.scss</code>: controls on the base, surfaces on lg, sheets on xl. Inputs and buttons share a radius at every size (sm, base, lg), so they match side by side. Square corners (0) where an element sits flush against another; 50% for circles.".html_safe do %>
      <div class="row g-3">
        <% [
             ['--bs-border-radius-sm', 'form-control-sm and btn-sm, Select2 tags'],
             ['--bs-border-radius', 'Inputs, buttons, button groups, alerts, toasts, pagination, tooltips, sidebar pills; the bottom corners of menus that hang from their input (autocomplete, Select2)'],
             ['--bs-border-radius-lg', 'Cards, modals, menus and panels: dropdowns, cookie banner, AI well, ask box. Also form-control-lg and btn-lg'],
             ['--bs-border-radius-xl', 'Mobile bottom sheet (top corners), marketing cards, chat bubbles'],
             ['--bs-border-radius-pill', 'Badges, nav crumbs, the header avatar, round buttons and dots']
           ].each do |name, note| %>
          <div class="col-6 col-md">
            <div class="bg-body-secondary border mb-2" style="height: 4.5rem; border-radius: var(<%= name %>)"></div>
            <div class="fw-bold text-break"><%= name %></div>
            <div class="spec"><span data-css-value="<%= name %>"></span></div>
            <div class="small text-body-secondary"><%= note %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% design_subsection 'Elevation', "Bootstrap's three shadows, set in <code>bootstrap5.scss</code> and used through its variables or the <code>shadow-sm</code>, <code>shadow</code> and <code>shadow-lg</code> classes. Soft, in px like hairlines: sm is a tight contact shadow (1px) alone, and the base and lg add a wide, faint one under it. Floating menus and panels (dropdowns, autocomplete, the cookie banner) also have a --hairline border, so the shadow can stay light; toasts and the chat panel have the shadow alone.".html_safe do %>
      <div class="bg-body-tertiary rounded p-4">
        <div class="row g-4">
          <% [
               ['--bs-box-shadow-sm', 'Resting surfaces: header, search, cards (all of them, from app.css), the editor toolbar while stuck'],
               ['--bs-box-shadow', 'Floating: dropdowns, autocomplete, toasts, cookie banner, chat, hover lift'],
               ['--bs-box-shadow-lg', 'Not used yet']
             ].each do |name, note| %>
            <div class="col-md-4">
              <div class="bg-white rounded p-3 small h-100" style="box-shadow: var(<%= name %>)"><b><%= name %></b><br><%= note %></div>
            </div>
          <% end %>
        </div>
      </div>
      <div class="small text-body-secondary">The mobile event page's fixed tickets bar keeps its own upward shadow.</div>
    <% end %>

    <% design_subsection 'Spacing', "One scale for padding, margins and gaps, as <code>--space-*</code> in app.css. Bootstrap's spacing utilities are the same scale without sm and xl, so in markup use the utility and in CSS the token. In app.css, values off the scale mostly size a control to match another (.375rem, btn-sm's padding, the nav crumbs' .625rem), line up with a fixed layout dimension (the header, the sidebar, search results' image column) or are px hairlines. The page-specific stylesheets are on the scale too, except for the same kinds of value: the docs select's room for its caret and the search icon's inset, and marketing sections' 3.5rem and 5rem, which are layout rather than spacing.".html_safe do %>
      <div class="border-bottom">
        <% [
             ['--space-2xs', '1', 'Label to field, dropdown and autocomplete items, sidebar sub-menu, badges in a row (mb-1, gap-1)'],
             ['--space-xs', '2', 'Nav links, dropdown headers, search tabs, filter form fields, cookie banner buttons'],
             ['--space-sm', nil, 'Grid gutter, table cells, card headers, alerts down, notification items, mobile sidebar links'],
             ['--space-base', '3', 'Between fields (mb-3), mobile --content-padding, dropdown and list items across, alerts across'],
             ['--space-lg', '4', '--content-padding, below a carousel'],
             ['--space-xl', nil, 'Dandelion Daily: between article columns and articles · docs h2s above · comparison cards (marketing) · message bubbles from the far side'],
             ['--space-2xl', '5', 'Between page sections (mt-5, mb-5)']
           ].each do |name, utility, note| %>
          <div data-spec-row class="py-3 border-top">
            <div class="row align-items-center g-3">
              <code class="col-6 col-md-2 spec"><%= name %></code>
              <div class="col-6 col-md-2"><div data-space-sample class="rounded-1" style="width: var(<%= name %>); height: var(<%= name %>); min-width: 1px; background: var(--theme-500)"></div></div>
              <code class="col-6 col-md-2 spec"><span data-css-value="<%= name %>"></span> · <span data-space-px></span></code>
              <code class="col-6 col-md-1 spec"><%= utility ? "*-#{utility}" : '—' %></code>
              <div class="col-md-5 small text-body-secondary"><%= note %></div>
            </div>
          </div>
        <% end %>
      </div>
      <div class="row gx-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        <% [
             ['Content padding · --content-padding', 'lg · mobile base'],
             ['Grid gutter', 'sm'],
             ['Container padding', 'base each side'],
             ['Card body', 'base'],
             ['Card header', 'sm base'],
             ['Field spacing', 'mb-3 · base'],
             ['Table cells', 'sm · table-sm xs'],
             ['Containers', '540 / 720 / 960 / 1140']
           ].each do |title, value| %>
          <div class="col">
            <div class="d-flex justify-content-between gap-3 py-2 border-bottom"><span><%= title %></span><code class="text-body-secondary"><%= value %></code></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% design_subsection 'Motion', "State changes fade rather than snap: hover, focus, active and open states change over <code>--transition-fast</code> (.15s ease-in-out, Bootstrap's own timing for nav links and buttons). Only colours, shadows and masks move, plus two slides: sidebar submenus and the teams, activities and local groups in the cards on /accounts/subscriptions open and shut with jQuery's slide over 175ms. Nothing else slides, and nothing scales, turns or bounces, bar a few older exceptions: on mobile the sidebar slides in and the menu button's bars turn into a cross, the quick theme colours grow 10% and the feedback stars 8% on hover, and the marketing pages' cards lift. Toasts, dropdowns and tab panes appear at once; chevrons that open something (sidebar groups, the cards on /accounts/subscriptions) point down whether it's open or closed. Under <code>prefers-reduced-motion</code> the token is 0s, so all of it stops, and the tab scroller's chevrons jump rather than scroll smoothly.".html_safe do %>
      <div class="row gx-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        <% [
             ['Links, nav links, tabs', 'colour, underline'],
             ['Dropdown items, message previews', 'background'],
             ['Tiles', 'shadow, photo lightens'],
             ['Date and icon tiles', 'fill'],
             ['Tab and crumb scrollers', 'edge fades, chevron colour']
           ].each do |title, value| %>
          <div class="col">
            <div class="d-flex justify-content-between gap-3 py-2 border-bottom"><span><%= title %></span><code class="text-body-secondary"><%= value %></code></div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <!-- LAYOUT -->
  <% design_section 'layout', 'Fixed dark header (--header-height, 2.8125rem) and a fixed sidebar (--sidebar-width, 14.375rem, minified to --sidebar-width-minified, 3.75rem). Sticky panels (.sticky-under-header) sit at --sticky-top, just below the header. Below 768px the sidebar becomes a full-width offcanvas and header icons spread across a second row.' do %>
    <div class="border rounded-3 overflow-hidden shadow">
      <div class="d-flex align-items-center px-3 text-white" style="height: var(--header-height); font-size: 1.125rem; background: var(--gradient-header)">
        <img class="position-relative" style="max-height: 1.75rem; top: -0.25rem" src="/images/logos/white-on-transparent.png" alt="">
        <div class="ms-auto d-flex align-items-center">
          <span class="px-3"><i class="bi bi-search"></i></span>
          <span class="px-3 position-relative"><i class="bi bi-bell"></i><span class="position-absolute top-0 rounded-circle" style="right: .75rem; width: .5rem; height: .5rem; background: var(--gradient-active)"></span></span>
          <span class="px-3"><i class="bi bi-chat-left"></i></span>
          <span class="px-2 d-flex align-items-center gap-2"><img class="d-block rounded-circle" src="/images/samples/maya.jpg" alt="" style="width: 1.75rem; height: 1.75rem; object-fit: cover"><span class="d-none d-md-inline" style="font-size: var(--font-size-sm)">Maya <i class="bi bi-chevron-down"></i></span></span>
        </div>
      </div>
      <div class="d-flex" style="min-height: 26.25rem">
        <div class="d-none d-md-block flex-shrink-0 p-2" style="width: var(--sidebar-width); background: var(--bs-gray-900)">
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded" style="background: var(--gradient-active)"><i class="bi bi-house fs-4"></i><span>Home</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded"><i class="bi bi-newspaper fs-4" style="opacity: .35"></i><span>Dandelion Daily</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded bg-black"><i class="bi bi-calendar-event fs-4" style="opacity: .35"></i><span>Events</span><span class="ms-auto small opacity-50">hover</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded"><i class="bi bi-flag-fill fs-4" style="opacity: .35"></i><span class="flex-grow-1">Organisations</span><i class="bi bi-chevron-down small"></i></div>
          <div class="d-flex flex-column py-1 text-white" style="margin-left: 2.5625rem">
            <span class="py-1">Symbiota</span>
            <span class="py-1 opacity-50">All organisations</span>
          </div>
        </div>
        <div class="flex-grow-1 p-4 d-flex flex-column gap-3">
          <div class="spec">#content · padding --content-padding</div>
          <div class="row g-3 flex-grow-1">
            <% [['col-8', 'col-lg-8 · newsfeed'], ['col-4', 'col-lg-4 · sticky']].each do |col, label| %>
              <div class="<%= col %>">
                <div class="h-100 border rounded shadow-sm d-flex align-items-center justify-content-center text-center spec" style="background: repeating-linear-gradient(135deg, var(--bs-gray-100) 0 .625rem, #fff .625rem 1.25rem)"><%= label %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- COMPONENTS -->
  <% design_section 'components' do %>

    <% design_subsection 'Buttons', 'Primary and danger are flat: their variant\'s 500 over a transparent border, and the 600 on hover. Other fills (progress bars, text-bg-* elements other than badges, like card headers, and p.action) are the same flat 500. btn-warning is styled the same but not used yet. Secondary is quiet: white with a --bs-border-color border and body text, --bs-secondary-bg on hover. It\'s for dismissive actions like Cancel, Not now and Disconnect. btn-outline-secondary is only for buttons joined to an input (Apply, Remove, Copy) and the donation toggle group. Brand buttons like btn-signal stay flat.'.html_safe do %>
      <div class="border rounded p-4 d-flex flex-wrap gap-3 align-items-center">
        <a class="btn btn-primary" href="#components">Book tickets</a>
        <a class="btn btn-outline-primary" href="#components">Outline primary</a>
        <a class="btn btn-secondary" href="#components">Secondary</a>
        <a class="btn btn-danger" href="#components">Delete</a>
        <a class="btn btn-signal" href="#components"><i class="bi bi-signal"></i> Signal</a>
      </div>
      <div class="d-flex flex-wrap gap-3 align-items-center px-4">
        <a class="btn btn-primary btn-sm" href="#components">btn-sm</a>
        <a class="btn btn-primary" href="#components">btn</a>
        <a class="btn btn-primary btn-lg" href="#components">btn-lg</a>
      </div>
      <div class="spec">.btn · .875rem · weight 600 · padding .5rem 1rem (sm .375rem .75rem), the same height as an input · radius .5rem (--bs-border-radius), as inputs</div>
    <% end %>

    <% design_subsection 'Badges', "Bootstrap's <code>.badge</code> with a <code>text-bg-*</code> colour, for counts, statuses, tags and amounts. Sized in em, so a badge scales with the text around it: small in a nav, bigger beside an h4, and at body size (1rem) beside an h1, h2 or h3, where it would otherwise be nearly heading-sized. Pick the colour by what it means.".html_safe do %>
      <div class="border rounded p-4 d-flex flex-column gap-3">
        <h4 class="m-0">Full moon gathering <span class="badge text-bg-yellow">Featured</span> <span class="badge text-bg-secondary">Locked</span></h4>
        <div>Followers <span class="badge text-bg-primary">128</span> · Tagged <a class="badge text-bg-primary" href="#components">breathwork</a> in <span class="badge text-primary border border-primary">Weekend pass</span> · Paid <span class="badge text-bg-secondary">£5 discount applied</span></div>
        <div class="spec">.badge · .9375em (1rem in h1–h3) · .4em .85em · pill · weight 600 · primary, secondary, warning, danger and yellow are soft: their variant's 100 behind its 800, so they show on grey as well as white (danger: the 200, as red's 100 reads pink; secondary: --bs-gray-200 and 800); dark, stripe and payment badges are filled · in a selected menu item, sheet item or pill, a primary or secondary badge turns to its 800 with white text, so it sits in the selection · .badge-overlay, for labels over images (the carousel), is filled with its variant's 500 at 70%, white text, square</div>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead>
            <tr><th>Class</th><th>Means</th><th>As used</th></tr>
          </thead>
          <tbody>
            <% [
                 ['text-bg-primary', 'Good, or the main count', ['128', '6/6', 'breathwork', 'Kitchen shift']],
                 ['text-bg-secondary', 'Neutral detail', ['Locked', 'Secret', '£5 discount applied']],
                 ['text-bg-warning', 'Needs attention, not yet a problem', ['On hold']],
                 ['text-bg-danger', 'A problem or a hard limit', ['Sold out', 'Sales ended', 'Full', 'Rejected, to contact']],
                 ['text-bg-yellow', 'Highlighted or rewarded', ['Featured', 'Co-host', '<i class="bi bi-hand-index"></i> 2']],
                 ['text-bg-dark', 'Counts in a gathering\'s nav', ['3', '12/20']],
                 ['text-primary border border-primary', 'Outline: a group label, or an unselected choice', ['Available', 'Weekend pass', 'London']],
                 ['text-bg-stripe', 'Reported by Stripe', ['£1,240']]
               ].each do |klass, meaning, texts| %>
              <tr>
                <td><code><%= klass %></code></td>
                <td class="text-body-secondary"><%= meaning %></td>
                <td><div class="d-flex flex-wrap gap-1"><% texts.each do |text| %><span class="badge <%= klass %>"><%== text %></span><% end %></div></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="small text-body-secondary"><code>text-bg-yellow</code> and <code>text-bg-stripe</code> are ours, written like Bootstrap's. Payment badges (<code>badge-payment-&lt;method&gt;</code>) are under Third-party brands. A badge with no colour class has no background, so always give it one (or an inline background, as the hashed organisation and gathering badges do).</div>
    <% end %>

    <div class="row g-5">
      <% design_subsection 'Alerts', col: 'col-lg-6' do %>
        <div>
          <% flashes.each do |variant, message, link| %>
            <div class="alert alert-<%= variant %> alert-dismissible"><%= message %> <a href="#components"><%= link %></a><button type="button" class="btn-close" aria-label="Close"></button></div>
          <% end %>
          <div class="spec">Inline, in the page. Padding .75rem 1rem (sm base, like card headers), no border. Links bold and underlined in the alert's link colour. Flashes are toasts, except on the few pages that set @hide_alert (sign in, sign up, subscriptions, the mailer header), which render them inline as alerts with no close button.</div>
        </div>
      <% end %>

      <% design_subsection 'Toasts', col: 'col-lg-6' do %>
        <div class="d-flex flex-column align-items-start gap-2">
          <% flashes.each do |variant, message, _link| %>
            <div class="toast toast-<%= variant %> show w-auto">
              <div class="d-flex">
                <div class="toast-body"><%= message %></div>
                <button type="button" class="btn-close me-2 m-auto" aria-label="Close"></button>
              </div>
            </div>
          <% end %>
          <div class="spec">Flash messages, fixed at the top centre (_alert.erb). The same flat tints as alerts, with no border, plus a --bs-box-shadow. Notices fade after 3s, errors and warnings after 6s.</div>
        </div>
      <% end %>
    </div>

    <div class="row g-5">
      <% design_subsection 'Forms', col: 'col-lg-6' do %>
        <div class="border rounded p-4">
          <div class="mb-3">
            <label for="dg-event-name">Event name</label>
            <input type="text" class="form-control" id="dg-event-name" autocomplete="off" value="Full moon gathering">
          </div>
          <div class="mb-3">
            <label for="dg-email">Email <span class="fw-normal text-body-secondary">· error</span></label>
            <input type="text" class="form-control is-invalid" id="dg-email" autocomplete="off" value="maya@example">
            <div class="invalid-feedback">Email is invalid</div>
          </div>
          <div class="mb-3">
            <label for="dg-location">Location <span class="fw-normal text-body-secondary">· focused</span></label>
            <input type="text" class="form-control" id="dg-location" autocomplete="off" placeholder="Search for a place" style="border-color: var(--theme-500); box-shadow: var(--focus-ring)">
            <div class="form-text">Form text is --bs-secondary-color. Every focused control gets the same ring, --focus-ring: --bs-focus-ring-width (2px) of --bs-focus-ring-color (the theme at 60%). Danger buttons ring in red, btn-signal in its blue, and colour swatches add a white gap. Nav links have none.</div>
          </div>
          <div class="d-flex flex-wrap gap-4 align-items-center mb-3">
            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="dg-checked" checked><label class="form-check-label" for="dg-checked">Checked</label></div>
            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="dg-unchecked"><label class="form-check-label" for="dg-unchecked">Unchecked</label></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="dg-on" checked><label class="form-check-label" for="dg-on">On</label></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="dg-off"><label class="form-check-label" for="dg-off">Off</label></div>
          </div>
          <div class="mb-3">
            <label for="dg-range" class="form-label">Pay what you can</label>
            <input type="range" class="form-range" id="dg-range" autocomplete="off" min="5" max="50" value="20">
          </div>
          <div class="spec">input .875rem with .5rem vertical padding, the same height as a button (about 2.4rem) · border --bs-gray-400 · labels 700 · errors: lib/form_builder.rb adds is-invalid and an .invalid-feedback message in --bs-danger, the field name first · .field-note, for a note or link under a field (a preview link, a resend link), pulls it up into the field's mb-3 so it reads as the field's own</div>
        </div>
      <% end %>

      <% design_subsection 'Navigation crumbs and dropdown', col: 'col-lg-6' do %>
        <div class="border rounded p-4 d-flex flex-column gap-4 flex-grow-1">
          <div class="nav-crumbs mb-0">
            <% crumb_items = [['<i class="bi bi-pencil"></i> Edit', '#components'], ['<i class="bi bi-people"></i> Members', '#components'], ['<i class="bi bi-ticket"></i> Orders', '#components']] %>
            <%= dropdown_nav crumb_items, button_text: 'Symbiota', container_class: 'btn-group mb-1' %>
            <%= dropdown_nav crumb_items, button_text: 'Breathwork', container_class: 'btn-group mb-1' %>
            <%= dropdown_nav crumb_items, button_text: 'London', container_class: 'btn-group mb-1 nav-crumbs-sibling' %>
          </div>
          <div class="dropdown-menu show position-relative align-self-start">
            <a class="dropdown-item" href="#components"><i class="bi bi-pencil"></i> Edit</a>
            <a class="dropdown-item" href="#components" style="background: var(--bs-dropdown-link-hover-bg)"><i class="bi bi-people"></i> Members</a>
            <a class="dropdown-item active" href="#components"><i class="bi bi-ticket"></i> Orders</a>
            <a class="dropdown-item" href="#components"><i class="bi bi-bar-chart"></i> Stats</a>
          </div>
        </div>
      <% end %>
    </div>

    <% design_subsection 'Gathering nav', 'The nav at the top of a gathering\'s pages from 768px (gatherings/_nav.erb): Bootstrap\'s .nav-pills on a dark bar, the gathering\'s name first. Teams, timetables and shifts open dropdowns. Below 768px it\'s a crumb that opens a sheet, as for organisations and events.' do %>
      <div class="border rounded p-4">
        <div id="gathering-nav" class="bg-dark p-1 rounded">
          <ul class="nav nav-pills">
            <li class="nav-item"><a class="nav-link text-white d-flex align-items-center gap-1" href="#components"><span class="fw-semibold">Summer Gathering</span></a></li>
            <li class="nav-item"><a class="nav-link text-white d-flex align-items-center gap-1" href="#components">Settings</a></li>
            <li class="nav-item"><a class="active nav-link text-white d-flex align-items-center gap-1" href="#components">Members <span class="badge text-bg-dark">48/60</span></a></li>
            <li class="nav-item"><a class="nav-link text-white d-flex align-items-center gap-1" href="#components">Applications <span class="badge text-bg-dark">3</span></a></li>
            <li class="nav-item"><a class="nav-link text-white d-flex align-items-center gap-1" href="#components">Choose &amp; Pay <span class="badge text-bg-dark">£40/£120</span></a></li>
              <li class="nav-item dropdown">
                <a data-bs-toggle="dropdown" class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="javascript:;">Teams<i class="bi bi-chevron-down caret"></i></a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="#components">Overview</a></li>
                  <li><a class="dropdown-item" href="#components">Create a team</a></li>
                  <li><a class="dropdown-item" href="#components">#&nbsp;Kitchen</a></li>
                  <li><a class="dropdown-item" href="#components">#&nbsp;Sound</a></li>
                </ul>
              </li>
              <li class="nav-item dropdown">
                <a data-bs-toggle="dropdown" class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="javascript:;">Timetables<i class="bi bi-chevron-down caret"></i></a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="#components">Main stage</a></li>
                  <li><a class="dropdown-item" href="#components">Create a timetable</a></li>
                </ul>
              </li>
              <li class="nav-item dropdown">
                <a data-bs-toggle="dropdown" class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="javascript:;">Shifts<i class="bi bi-chevron-down caret"></i></a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="#components">Overview</a></li>
                  <li><a class="dropdown-item" href="#components">Setup</a></li>
                  <li><a class="dropdown-item" href="#components">Create a rota</a></li>
                </ul>
              </li>
            <li class="nav-item"><a class="nav-link text-white d-flex align-items-center gap-1" href="#components">Inventory</a></li>
            <li class="nav-item"><a class="nav-link text-white d-flex align-items-center gap-1" href="#components">Budget</a></li>
          </ul>
        </div>
      </div>
      <div class="spec">bg-dark bar, p-1 and rounded · links --font-size-xs (.75rem) in white, padding .5rem .75rem · hover, focus and the active page --bs-black · counts and amounts text-bg-dark badges · wraps onto a second line when a gathering has most features on</div>
    <% end %>

    <div class="row g-5">
      <% design_subsection 'Input groups', col: 'col-lg-6' do %>
        <div class="border rounded p-4">
          <div class="mb-3">
            <label for="dg-amount">Amount</label>
            <div class="input-group">
              <span class="input-group-text">£</span>
              <input type="number" class="form-control" id="dg-amount" autocomplete="off" value="10">
            </div>
          </div>
          <div class="mb-3">
            <label for="dg-code">Sign-in code</label>
            <div class="input-group">
              <input type="text" class="form-control" id="dg-code" autocomplete="off" placeholder="Email">
              <button class="btn btn-primary" type="button">Get code</button>
            </div>
          </div>
          <div class="mb-3">
            <div class="input-group input-group-sm d-inline-flex w-auto">
              <label class="input-group-text" for="dg-capacity">Capacity</label>
              <input type="number" class="form-control form-control-sm" id="dg-capacity" autocomplete="off" value="80" style="width: 5em">
            </div>
          </div>
          <div class="spec">input-group-text for currency symbols (money_symbol) and inline labels · a button on the end for one-field forms (sign in, search, reactions, deleting an account), so the two stay together on phones · d-inline-flex w-auto when the field is narrow · input-group-sm with form-control-sm</div>
        </div>
      <% end %>

      <% design_subsection 'File and image inputs', col: 'col-lg-6' do %>
        <div class="border rounded p-4">
          <div class="mb-3">
            <label for="dg-file">Image</label>
            <div style="margin-bottom: 1em"><img style="max-height: 12.5rem" src="/images/dandelions/3.jpeg" alt="" class="mw-100"></div>
            <input type="file" class="form-control" id="dg-file">
          </div>
          <div class="spec">file_block and image_block (lib/form_builder.rb): a plain form-control file input, with the current file above it once saved: a download link, or for images the image at up to 12.5rem high, then a Remove checkbox (and Rotate by for images) · app.js rejects files over 10MB before upload</div>
        </div>
      <% end %>
    </div>

    <div class="row g-5">
      <% design_subsection 'Select2', col: 'col-lg-6' do %>
        <div class="border rounded p-4">
          <div class="mb-3">
            <label for="dg-select2-single">Send to</label>
            <select class="form-select" id="dg-select2-single">
              <option>Everyone</option>
              <option>Followers</option>
              <option>Ticket holders</option>
              <option>Waitlist</option>
            </select>
          </div>
          <%= partial :tags_select, locals: { object: design_sample_event, tag_class: EventTag } %>
          <script>
            $(function () {
              $('#dg-select2-single').select2({ theme: 'bootstrap-5', width: '100%' })
            })
          </script>
          <div class="spec">select2.css overrides select2-bootstrap-5-theme: as tall as .form-control, --bs-gray-400 border, .form-control's font and radius · focused or open: --theme-500 border and --focus-ring, the box and dropdown glowing as one shape · selected option --theme-500 · tags (_tags_select.erb) sit on the typing row, radius sm</div>
        </div>
      <% end %>

      <% design_subsection 'Flatpickr', col: 'col-lg-6' do %>
        <div class="border rounded p-4">
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label for="dg-date">Date</label>
              <input type="text" class="form-control datepicker" id="dg-date" autocomplete="off" value="<%= Date.today.iso8601 %>">
            </div>
            <div class="col-sm-6">
              <label for="dg-datetime">Start time</label>
              <input type="text" class="form-control datetimepicker" id="dg-datetime" autocomplete="off" value="<%= Date.today.iso8601 %> 19:30">
            </div>
          </div>
          <div id="dg-flatpickr-inline" class="mb-3"></div>
          <script>
            $(function () {
              var today = new Date()
              var el = document.getElementById('dg-flatpickr-inline')
              // appendTo puts the calendar inside el, so it gets el's margin; inline would otherwise put it after el
              flatpickr(el, { inline: true, appendTo: el, mode: 'range', defaultDate: [today, new Date(today.getTime() + 2 * 864e5)] })
            })
          </script>
          <div class="spec">app.js wires up .datepicker (altFormat Y-m-d) and .datetimepicker (J F Y, H:i, 24-hour; data-flatpickr-min-date, -max-date and -linked-end) · selected days and range ends --theme-500 · on phones, a native input (.flatpickr-mobile) at full width</div>
        </div>
      <% end %>
    </div>

    <% design_subsection 'Rich text editor', 'CKEditor 5, from our own build (symbiota-coop/ckeditor5-dandelion). <code>wysiwyg_block</code> renders a textarea.wysiwyg, and app.js swaps in the editor. ckeditor.css styles it and the rich text it produces; the build adds two paragraph styles, Lead and Small.'.html_safe do %>
      <div class="border rounded p-4">
        <label for="dg-wysiwyg">Description</label>
        <textarea class="form-control wysiwyg" id="dg-wysiwyg" rows="5"><p>An evening of <strong>breathwork</strong> and sound, for all levels.</p><ul><li>Bring a mat and a blanket</li><li>Doors at 7pm</li></ul></textarea>
      </div>
    <% end %>

    <% design_subsection 'Filter forms', 'The search forms above lists and tables: orders, donations, members, applications. Bootstrap 5 dropped <code>.form-inline</code> and <code>.form-group</code>, so app.css keeps them for these: .form-inline lays the form out in a row from 576px, and each .form-group is a label and its field side by side. <code>.searchForm</code> spaces them and caps fields at 12em; <code>.submitOnChange</code> submits when a select, date, checkbox or month field changes.'.html_safe do %>
      <div class="border rounded p-4">
        <form class="searchForm form-inline mb-3" onsubmit="return false">
          <div class="form-group">
            <label for="dg-filter-from">Search orders between</label>
            <input type="text" class="form-control datepicker mx-1" id="dg-filter-from" autocomplete="off" value="<%= (Date.today - 30).iso8601 %>">
          </div>
          <div class="form-group">
            <label for="dg-filter-to">and</label>
            <input type="text" class="form-control datepicker mx-1" id="dg-filter-to" autocomplete="off" value="<%= Date.today.iso8601 %>">
          </div>
          <div class="form-group">
            <label for="dg-filter-q">containing the word</label>
            <input type="text" class="form-control mx-1" id="dg-filter-q" autocomplete="off">
          </div>
          <%= checkbox 'Deleted', slug: 'dg_deleted' %>
          <input type="submit" class="btn btn-primary" value="Search">
        </form>
        <div class="search rounded p-3 mb-3">
          <form class="searchForm" onsubmit="return false">
            <div class="row gx-2 align-items-end">
              <div class="form-group col-12 col-sm-auto">
                <label for="dg-filter-near">near</label>
                <input type="text" class="form-control" id="dg-filter-near" autocomplete="off" value="London">
              </div>
              <div class="form-group col-12 col-sm-auto">
                <label for="dg-filter-type">Type</label>
                <select class="form-select select-placeholder" id="dg-filter-type">
                  <option value="" selected disabled>Event type</option>
                  <option>Workshop</option>
                  <option>Retreat</option>
                </select>
              </div>
            </div>
            <div class="row gx-2 align-items-end mt-1">
              <%= checkbox 'Online', slug: 'dg_online', form_group_class: 'col-auto col-sm-auto either-or' %>
              <%= checkbox 'In person', slug: 'dg_in_person', form_group_class: 'col-auto col-sm-auto either-or' %>
              <div class="form-group col-12 col-sm-auto">
                <input type="submit" class="btn btn-primary" value="Search">
              </div>
            </div>
          </form>
