<%
  # Drawn like the site's icon tiles (.event-detail in app.css and event_details.css), for emails, where they're PNGs:
  # white with a hairline border and a soft shadow, around a 1.5em icon in black at 50%.
  # The tile is 144 units (2.5em on the site, so 1em is 57.6), inset 8 so the shadow fits in the 160 canvas.
  svg_size = 160
  inset = 8
  tile_size = 144
  em = tile_size / 2.5

  corner_radius = (0.3 * em).round(2) # .3em
  border_width = (tile_size / 41.0).round(2) # 1px of a 41px tile

  # Bootstrap Icons are drawn on a 16 grid
  icon_size = 1.5 * em
  icon_scale = icon_size / 16
  icon_offset = (svg_size - icon_size) / 2

  # Dynamically embed svg icon
  icon_path = Padrino.root('app', 'assets', 'images', 'icons', "#{image}.svg")
  icon_content = File.read(icon_path)
%>
<svg width="<%= svg_size %>" height="<%= svg_size %>" viewBox="0 0 <%= svg_size %> <%= svg_size %>" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="<%= border_width %>" stdDeviation="<%= border_width %>" flood-color="#000000" flood-opacity="0.06"/>
    </filter>
  </defs>

  <!-- Tile, with its shadow -->
  <rect x="<%= inset %>" y="<%= inset %>" width="<%= tile_size %>" height="<%= tile_size %>" rx="<%= corner_radius %>" ry="<%= corner_radius %>"
        fill="#ffffff" filter="url(#shadow)"/>

  <!-- Hairline border (black at 10%), inside the tile's edge -->
  <rect x="<%= (inset + (border_width / 2)).round(2) %>" y="<%= (inset + (border_width / 2)).round(2) %>" width="<%= (tile_size - border_width).round(2) %>" height="<%= (tile_size - border_width).round(2) %>"
        rx="<%= (corner_radius - (border_width / 2)).round(2) %>" ry="<%= (corner_radius - (border_width / 2)).round(2) %>"
        fill="none" stroke="#000000" stroke-opacity="0.1" stroke-width="<%= border_width %>"/>

  <!-- Icon -->
  <g transform="translate(<%= icon_offset.round(2) %>, <%= icon_offset.round(2) %>) scale(<%= icon_scale.round(3) %>)" fill="#000000" opacity="0.5">
    <%= icon_content.gsub(/<svg[^>]*>/, '').gsub(%r{</svg>}, '').html_safe %>
  </g>
</svg>
