<div class="card shadow-sm mb-3">
  <h3 class="card-header chill">Give us feedback on Dandelion</h3>
  <div class="card-body">
    <% if @sent %>
      <div class="alert alert-success">Thank you for your feedback!</div>
    <% else %>
      <% form_tag '/feedback' do %>
        <div class="ask-box">
          <label class="sr-only" for="feedback-textarea">Give us feedback on Dandelion</label>
          <%= text_area_tag :feedback, id: 'feedback-textarea', class: 'form-control autosize', rows: 1, placeholder: 'Send your thoughts, praise, suggestions or report an issue', required: true %>
          <div class="ask-box-actions">
            <button type="submit" class="btn btn-primary btn-sm" aria-label="Send feedback">
              <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
