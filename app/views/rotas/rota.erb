<%= partial :'gatherings/nav', locals: { gathering: @gathering, membership: @membership } %>
<h2>
  <%= @rota.name %>
</h2>
<% if gathering_admin? %>
  <a class="underline-dotted" href="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>/edit">
    Edit rota
  </a> &middot;
  <a class="underline-dotted" href="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>/create_shift">
    Add someone to a shift
  </a> &middot;
<% end %>
<a class="underline-dotted" href="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>.csv">
  Export as CSV
</a>
&middot;
<%# Switches the grid below between pictures and names, reloading it in place %>
<a class="underline-dotted" href="javascript:;" data-base-url="<%= "/g/#{@gathering.slug}/rotas/#{@rota.id}" %>" onclick="const grid = $('#rota-grid'); const names = !grid.attr('data-pagelet-url').includes('view=names'); grid.attr('data-pagelet-url', $(this).attr('data-base-url') + (names ? '?view=names' : '')); grid.load(grid.attr('data-pagelet-url')); $(this).text(names ? 'Show pictures' : 'Show names')">Show names</a>
<% if gathering_admin? %>
  &middot;
  <a class="underline-dotted" href="javascript:;" onclick="$('#reorder').toggle()">
    Reorder
  </a>
  <script src="<%= cachebust('/javascripts/ext/jquery-ui-interactions.min.js') %>" defer></script>
  <%= partial :reorder, locals: {
        grid: 'rota-grid',
        lists: [
          { title: 'Roles', url: '/roles/order', owner: { rota_id: @rota.id.to_s }, ids_param: 'role_ids', items: @rota.roles.order('o asc').map { |role| [role.id, role.name] } },
          { title: 'Slots', url: '/rslots/order', owner: { rota_id: @rota.id.to_s }, ids_param: 'rslot_ids', items: @rota.rslots.order('o asc').map { |rslot| [rslot.id, rslot.name] } }
        ]
      } %>
<% end %>

<% if @rota.description %>
  <div class="my-3">
    <div class="wysiwyg">
      <%== Sanitize.fragment(@rota.description, Sanitize::Config::DANDELION) %>
    </div>
  </div>
<% end %>

<div id="rota-grid" data-pagelet-url="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>">
  <%= partial :'rotas/rota', locals: { rota: @rota } %>
</div>
