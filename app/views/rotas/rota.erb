<%= partial :'gatherings/nav', locals: { gathering: @gathering, membership: @membership } %>
<h2>
  <%= @rota.name %>
</h2>
<div class="d-flex flex-wrap gap-2 mb-3">
  <% if gathering_admin? %>
    <a class="btn btn-sm btn-primary" href="javascript:;" data-bs-toggle="modal" data-bs-target="#add-shift"><i class="bi bi-person-plus"></i> Add someone to a shift</a>
    <a class="btn btn-sm btn-outline-primary" href="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>/edit"><i class="bi bi-pencil"></i> Edit rota</a>
    <a class="btn btn-sm btn-outline-primary" href="javascript:;" onclick="$('#reorder').toggle()"><i class="bi bi-arrow-down-up"></i> Reorder</a>
  <% end %>
  <%= partial :'gatherings/names_toggle', locals: { grid: 'rota-grid', url: "/g/#{@gathering.slug}/rotas/#{@rota.id}" } %>
  <a class="btn btn-sm btn-outline-primary" href="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>.csv"><i class="bi bi-download"></i> Export as CSV</a>
</div>
<% if gathering_admin? %>
  <%= partial :'gatherings/form_modal', locals: { id: 'add-shift', title: 'Add someone to a shift', form: :'rotas/create_shift' } %>
  <script src="<%= cachebust('/javascripts/ext/jquery-ui-interactions.min.js') %>" defer></script>
  <%= partial :reorder, locals: {
        grid: 'rota-grid',
        lists: [
          { title: 'Roles', url: '/roles/order', owner: { rota_id: @rota.id.to_s }, ids_param: 'role_ids', items: @rota.roles.order('o asc').map { |role| [role.id, role.name] } },
          { title: 'Slots', url: '/rslots/order', owner: { rota_id: @rota.id.to_s }, ids_param: 'rslot_ids', items: @rota.rslots.order('o asc').map { |rslot| [rslot.id, rslot.name] } }
        ]
      } %>
<% end %>

<% if @rota.description %>
  <div class="my-3">
    <div class="wysiwyg">
      <%== Sanitize.fragment(@rota.description, Sanitize::Config::DANDELION) %>
    </div>
  </div>
<% end %>

<div id="rota-grid" data-pagelet-url="/g/<%= @gathering.slug %>/rotas/<%= @rota.id %>">
  <%= partial :'rotas/rota', locals: { rota: @rota } %>
</div>
