<%= partial :'gatherings/nav', locals: { gathering: @gathering, membership: @membership } %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h2><%= @rota.new_record? ? 'Create a rota' : @rota.name_was %></h2>
    <%= partial :'gatherings/back', locals: { to: (@rota.new_record? ? 'shifts' : 'rota'), path: (@rota.new_record? ? "/g/#{@gathering.slug}/rotas" : "/g/#{@gathering.slug}/rotas/#{@rota.id}") } %>
    <% form_for @rota ||= Rota.new, @rota.new_record? ? "/g/#{@gathering.slug}/rotas/new" : "/g/#{@gathering.slug}/rotas/#{@rota.id}/edit" do |f| %>
      <%= f.text_block :name %>
      <%= f.wysiwyg_block :description %>
      <%= f.submit_block destroy_url: ("/g/#{@gathering.slug}/rotas/#{@rota.id}/destroy" if gathering_admin?) %>
    <% end %>
  </div>
</div>
