<% form_for @shift, "/g/#{@gathering.slug}/shifts/#{@shift.id}/edit" do |f| %>

  <% if @shift.account %>
    <div class="mb-3">
      <%= partial :'accounts/account', locals: { account: @shift.account } %>
    </div>
  <% end %>

  <% if @shift.errors.exists? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @shift.errors.full_messages.each { |message| %>
        <li><%= message %></li>
        <% } %>
      </ul>
    </div>
  <% end %>

  <%= f.select_block :rslot_id, options: @shift.rslot_ids %>
  <%= f.select_block :role_id, options: @shift.role_ids %>
  <%= f.submit_block button_text: 'Update shift', destroy_url: "/g/#{@gathering.slug}/shifts/#{@shift.id}/destroy" %>

<% end %>
