<%= partial :'rotas/progress', locals: {rota: @rota} %>

<% if @membership %>
  <div class="my-3">
    <%= partial :'rotas/shift_summary', locals: {membership: @membership, rota: @rota, show_title: true} %>
  </div>
<% end %>

<% shifts_by_rslot_role = rota.shifts.includes(:account).index_by { |s| [s.rslot_id, s.role_id] } %>
<table class="table table-striped mt-3">
  <tr>
    <td></td>
    <% rota.roles.order('o asc').each { |role| %>
    <td>
      <strong>
        <% if gathering_admin? %>
          <a href="/g/<%= @gathering.slug %>/roles/<%= role.id %>/edit" data-open-in-modal>
            <%= role.name %>
          </a>
        <% else %>
          <%= role.name %>
        <% end %>
        <% if @gathering.enable_shift_worth %>
          <br>
          <span data-bs-toggle="tooltip" title="<%= pluralize sprintf('%g', role.worth), 'point' %>" class="badge text-bg-secondary mb-1"><%= sprintf('%g', role.worth) %></span>
        <% end %>
      </strong>
    </td>
    <% } %>
    <% if gathering_admin? %>
      <td>
        <% form_tag "/g/#{@gathering.slug}/roles/create?rota_id=#{rota.id}", class: 'form-inline', style: 'display: inline' do %>
          <%= text_field_tag :name, class: 'form-control', style: 'width: 10em', placeholder: 'New role' %>
        <% end %>
      </td>
    <% end %>
  </tr>
  <% rota.rslots.order('o asc').each { |rslot| %>
  <tr>
    <td>
      <strong>
        <% if gathering_admin? %>
          <a href="/g/<%= @gathering.slug %>/rslots/<%= rslot.id %>/edit" data-open-in-modal>
            <%= rslot.name %>
          </a>
        <% else %>
          <%= rslot.name %>
        <% end %>
        <% if @gathering.enable_shift_worth %>
          <br>
          <span data-bs-toggle="tooltip" title="<%= pluralize sprintf('%g', rslot.worth), 'point' %>" class="badge text-bg-secondary mb-1"><%= sprintf('%g', rslot.worth) %></span>
        <% end %>
      </strong>
    </td>
    <% rota.roles.order('o asc').each { |role| %>
    <td>
      <%= partial :'rotas/rota_rslot_role', locals: { rota: rota, rslot: rslot, role: role, shift: shifts_by_rslot_role[[rslot.id, role.id]] } %>
    </td>
    <% } %>
    <% if gathering_admin? %>
      <td></td>
    <% end %>
  </tr>
  <% } %>
  <% if gathering_admin? %>
    <tr>
      <td>
        <% form_tag "/g/#{@gathering.slug}/rslots/create?rota_id=#{rota.id}", class: 'form-inline', style: 'display: inline' do %>
          <%= text_field_tag :name, class: 'form-control', style: 'width: 10em', placeholder: 'New slot' %>
        <% end %>
      </td>
      <%# The rest of the row, its roles' columns and New role's, so the stripe runs the width of the table %>
      <td colspan="<%= rota.roles.count + 1 %>"></td>
    </tr>
  <% end %>
</table>
