<% shifts = defined?(rota) ? membership.shifts.and(rota: rota) : membership.shifts %>
<% if defined?(show_title) && show_title && shifts.exists? %>
  <h3>Your shifts</h3>
<% end %>
<%# On one line, wrapping where they don't fit, each shift's badges kept together %>
<div class="d-flex flex-wrap column-gap-3">
  <% shifts.each { |shift| %>
    <span class="text-nowrap">
      <% points = capture do %>
        <% if @gathering.enable_shift_worth %>
          <span class="badge text-bg-secondary mb-1"><%= pluralize sprintf('%g', shift.worth), 'point' %></span>
        <% end %>
      <% end %>
      <% if defined?(show_title) && show_title %>
        <a class="badge text-bg-primary mb-1" href="/shifts/<%= shift.id %>/edit"><%= shift.description %></a>
        <%= points %>
        <a data-method="post" data-confirm="<% if shift.account_id == current_account.id %>Resign from this shift?<% else %>Remove this person from this shift?<% end %>" class="pagelet-trigger badge text-bg-danger mb-1" href="/shifts/<%= shift.id %>/destroy">
          <i class="bi bi-x-lg"></i>
        </a>
      <% else %>
        <a href="/g/<%= @gathering.slug %>/rotas/<%= shift.rota_id %>" class="badge text-bg-primary mb-1"><%= shift.description %></a>
        <%= points %>
      <% end %>
    </span>
  <% } %>
</div>
