<% shifts = defined?(rota) ? membership.shifts.and(rota: rota) : membership.shifts %>
<% if defined?(show_title) && show_title && shifts.exists? %>
  <h3>Your shifts</h3>
<% end %>
<% shifts.each { |shift| %>
<div>
  <% if defined?(show_title) && show_title %>
    <a class="badge text-bg-primary d-inline-block mb-1<% if @gathering.enable_shift_worth %> rounded-end-0<% end %>" href="/shifts/<%= shift.id %>/edit">
      <%= shift.description %>
    </a><% if @gathering.enable_shift_worth %><%= partial :'rotas/shift_worth', locals: {shift: shift, klass: 'rounded-start-0'} %>
    <% end %>
    <a data-confirm="<% if shift.account_id == current_account.id %>Resign from this shift?<% else %>Remove this person from this shift?<% end %>" class="pagelet-trigger badge text-bg-danger d-inline-block mb-1" href="/shifts/<%= shift.id %>/destroy">
      <i class="bi bi-x-lg"></i>
    </a>
  <% else %>
    <a href="/g/<%= @gathering.slug %>/rotas/<%= shift.rota_id %>" class="badge text-bg-primary d-inline-block mb-1<% if @gathering.enable_shift_worth %> rounded-end-0<% end %>">
      <%= shift.description %>
    </a><% if @gathering.enable_shift_worth %><%= partial :'rotas/shift_worth', locals: {shift: shift, klass: 'rounded-start-0'} %><% end %>
  <% end %>
</div>
<% } %>
