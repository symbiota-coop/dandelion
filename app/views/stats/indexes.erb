<% human_size = ->(bytes) { ActiveSupport::NumberHelper.number_to_human_size(bytes) } %>
<h2>Indexes</h2>
<p class="text-body-secondary">
  Every index, with how many times queries have used it since the server last restarted (<code>$indexStats</code>, counted on the node that answers). An index no query has used costs space and slows writes, but check it over a long enough time before dropping it, from the console: a unique index refuses duplicates on write, which doesn't count as a use, and those marked to keep would break queries without them. TTL indexes are used by MongoDB's TTL monitor rather than by queries, so they never count as unused.
</p>

<% form_tag '', method: 'get', class: 'submitOnChange searchForm form-inline mb-3' do %>
  <% if params[:collection] %><%= hidden_field_tag :collection, value: params[:collection] %><% end %>
  <%= checkbox 'Unused only', slug: 'unused' %>
  <%= checkbox 'TTL only', slug: 'ttl' %>
<% end %>

<% unused = @indexes.select { |index| index[:unused] } %>
<p>
  <% if params[:collection] %><span class="badge text-bg-dark"><code class="text-reset"><%= params[:collection] %></code> <a class="text-reset" href="/stats/indexes">×</a></span><% end %>
  <span class="badge text-bg-dark"><%= pluralize(@indexes.size, 'index') %></span>
  <span class="badge <%= unused.empty? ? 'text-bg-primary' : 'text-bg-danger' %>"><%= unused.empty? ? 'None unused' : "#{pluralize(unused.size, 'unused index')}, #{human_size.(unused.sum { |index| index[:size] })}" %></span>
</p>

<table id="indexes-table" class="table table-hr small">
  <thead>
    <tr>
      <th>Collection</th>
      <th>Index</th>
      <th>Key</th>
      <th>Options</th>
      <th class="text-end">Size</th>
      <th class="text-end">Uses</th>
      <th>Since</th>
      <th>Keep</th>
    </tr>
  </thead>
  <tbody>
    <% @indexes.each do |index| %>
      <tr>
        <td><code><%= index[:collection] %></code></td>
        <td>
          <code><%= index[:name] %></code>
          <% if index[:unused] %><span class="badge text-bg-danger">Unused</span><% end %>
        </td>
        <td><code><%= index[:key].to_json %></code></td>
        <td>
          <% if index[:unique] %><span class="badge text-bg-secondary">Unique</span><% end %>
          <% if index[:ttl] %><span class="badge text-bg-secondary">TTL: <%= ttl_duration(index[:ttl]) %></span><% end %>
          <% if index[:partial] %><code><%= index[:partial].to_json %></code><% end %>
        </td>
        <td class="text-end" data-order="<%= index[:size] %>"><%= human_size.(index[:size]) %></td>
        <td class="text-end" data-order="<%= index[:ops] %>"><%= ActiveSupport::NumberHelper.number_to_delimited(index[:ops]) %></td>
        <td><%= index[:since]&.strftime('%Y-%m-%d %H:%M') %></td>
        <td><% if index[:keep] %><span class="badge text-bg-secondary"><%= index[:keep] %></span><% end %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<script>
  $(function () {
    $('#indexes-table').DataTable({ paging: false, order: [[0, 'asc'], [1, 'asc']] })
  })
</script>
