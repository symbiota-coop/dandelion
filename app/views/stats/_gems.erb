<div class="table-responsive">
  <table id="gems-table" class="table table-hover">
    <thead>
      <tr>
        <th>Gem</th>
        <th>Version</th>
        <th>Major</th>
        <th>Minor</th>
        <th>Patch</th>
        <th>Release date</th>
        <th>Latest release date</th>
        <th class="text-end">Downloads</th>
        <th>Description</th>
        <th>Links</th>
      </tr>
    </thead>
    <tbody>
      <% @packages.each do |gem| %>
        <tr>
          <td>
            <a href="<%= gem[:url] || "https://rubygems.org/gems/#{gem[:name]}" %>" target="_blank"><%= gem[:name] %></a>
          </td>
          <td>
            <code><%= gem[:version] %></code>
            <% if gem[:gemfile_version] && gem[:gemfile_version] != gem[:version] %>
              <span class="badge text-bg-danger ms-1" data-bs-toggle="tooltip" title="The Gemfile asks for <%= gem[:gemfile_version] %>">Gemfile: <%= gem[:gemfile_version] %></span>
            <% end %>
          </td>
          <%= partial 'stats/version_bump_cells', locals: { cells: gem[:version_bump_cells] } %>
          <%= partial 'stats/release_date_cells', locals: { package: gem } %>
          <%= partial 'stats/downloads_cell', locals: { package: gem } %>
          <%= partial 'stats/package_info_cells', locals: { package: gem } %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
  $(function() {
    $('#gems-table').DataTable({
      paging: false,
      searching: false,
      info: false,
      order: [[6, 'desc']],
    });
  });
</script>
