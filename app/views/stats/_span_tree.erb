<%# A span tree (see Trace.span_tree and Trace#span_tree, span_tree.js and traces.css): rows that open and shut, headers that sort, and bars on a timeline of total_ms or longer. per_request adds a column for how often each span runs (for a merged tree); sort and sort_dir say how the rows are ordered. On phones only the span and its time show %>
<% total_ms = [total_ms, *rows.map { |row| row[:offset_ms] + row[:ms] }, 1].max %>
<div class="table-responsive">
  <%# Headers have DataTables' markup and classes (dataTable, dt-orderable-*, dt-ordering-*), so they get its sort icons %>
  <table class="span-tree dataTable table table-sm table-hover" data-sort="<%= sort %>" data-sort-dir="<%= sort_dir %>">
    <thead>
      <tr>
        <% [
             ['name', 'Span', nil, nil],
             (['per', 'Per request', 'text-end d-none d-md-table-cell', 'How many times the span runs in an average request'] if per_request),
             ['ms', 'Time', 'text-end', nil],
             ['self', 'Self time', 'text-end d-none d-md-table-cell', "The span's time less its children's"],
             ['start', 'Start', 'w-25 d-none d-md-table-cell', nil]
           ].compact.each do |key, title, th_class, tooltip| %>
          <th class="<%= th_class %> dt-orderable-asc dt-orderable-desc" data-sort="<%= key %>">
            <div class="dt-column-header">
              <div class="dt-column-title" data-bs-toggle="<%= 'tooltip' if tooltip %>" title="<%= tooltip %>"><%= title %></div>
              <div class="dt-column-order" role="button" tabindex="0"></div>
            </div>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr class="<%= 'collapsed' if row[:children].positive? %>" style="<%= 'display: none' if row[:depth].positive? %>" data-id="<%= row[:id] %>" data-parent="<%= row[:parent_id] %>" data-name="<%= "#{row[:op]} #{row[:description]}" %>" data-per="<%= row[:per_trace] %>" data-ms="<%= row[:ms] %>" data-self="<%= row[:self_ms] %>" data-start="<%= row[:offset_ms] %>">
          <td class="py-0">
            <div class="span-tree-label">
              <% row[:depth].times do %><span class="span-tree-guide"></span><% end %>
              <% if row[:children].positive? %>
                <a href="javascript:;" class="span-tree-toggle"><span class="span-tree-count"><%= row[:children] %><i class="bi bi-chevron-down"></i></span></a>
              <% else %>
                <span class="span-tree-leaf"></span>
              <% end %>
              <span class="span-tree-text">
                <code><%= row[:op] %></code>
                <span class="small" data-bs-toggle="<%= 'tooltip' if row[:data] %>" title="<%= row[:data]&.map { |k, v| "#{k}: #{v}" }&.join("\n") %>"><%= wrap_at_separators(row[:description]) %></span>
                <% if row[:status] && row[:status] != 'ok' %>
                  <span class="badge text-bg-danger ms-1"><%= row[:status] %></span>
                <% end %>
              </span>
            </div>
          </td>
          <% if per_request %>
            <td class="text-end d-none d-md-table-cell"><%= format('%.2f', row[:per_trace]) %></td>
          <% end %>
          <td class="text-end text-nowrap"><%= row[:ms].round(1) %> ms</td>
          <td class="text-end text-nowrap d-none d-md-table-cell"><%= row[:self_ms].round(1) %> ms</td>
          <td class="align-middle d-none d-md-table-cell">
            <div class="progress position-relative" role="presentation">
              <div class="progress-bar position-absolute h-100 <%= 'bg-secondary' if row[:op].to_s.start_with?('db.') %>" style="inset-inline-start: <%= (100.0 * row[:offset_ms] / total_ms).round(2) %>%; width: <%= [100.0 * row[:ms] / total_ms, 0.3].max.round(2) %>%"></div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
