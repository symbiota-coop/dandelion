<%# A table of durations: a section of transactions (linking to their traces), or of searches by pipeline.
    Each Total is a percentage of the section's most (its first row, as the summaries come most total time first),
    with a bar to match (and the time itself in a tooltip) %>
<div class="table-responsive mt-4">
  <table class="transactions-table table table-hover">
    <thead>
      <tr>
        <%# The section names the first column, so it reads as the table's heading %>
        <th>
          <%= title %>
          <% if summaries.size > 10 %><small class="fw-normal text-body-secondary ms-1">10 of <%= summaries.size %></small><% end %>
        </th>
        <%# On phones, of the percentiles only the one filtered by %>
        <% %w[p50 p99 p100].each do |percentile| %>
          <th class="text-end <%= 'd-none d-md-table-cell' unless percentile == @percentile %>"><%= percentile %></th>
        <% end %>
        <th class="text-end">Count</th>
        <th class="text-end">Total</th>
      </tr>
    </thead>
    <tbody>
      <% max_total_ms = summaries.first[:total_ms].to_f %>
      <% summaries.first(10).each do |summary| %>
        <tr>
          <td>
            <% if link %>
              <a href="/stats/traces?<%= transaction_query(summary[:name], summary[:xhr]) %>"><code><%= wrap_at_separators(summary[:name]) %></code></a>
              <%# Outside the XHR section, say which rows are, as Search has GET /search both ways %>
              <% if summary[:xhr] && title != 'XHR' %><span class="badge text-bg-dark ms-1">XHR</span><% end %>
            <% else %>
              <%= summary[:name] %>
            <% end %>
          </td>
          <%# p100 is a single trace, the slowest, and so is p99 when it matches p100 (always, under 100 traces) %>
          <% %w[p50 p99 p100].each do |percentile| %>
            <td class="text-end text-nowrap <%= 'd-none d-md-table-cell' unless percentile == @percentile %>" data-order="<%= summary[:"#{percentile}_ms"] %>">
              <% if link && percentile != 'p50' && summary[:"#{percentile}_ms"] == summary[:p100_ms] %>
                <a href="/stats/traces/slowest?<%= transaction_query(summary[:name], summary[:xhr]) %>"><%= format_duration(summary[:"#{percentile}_ms"]) %></a>
              <% else %>
                <%= format_duration(summary[:"#{percentile}_ms"]) %>
              <% end %>
            </td>
          <% end %>
          <td class="text-end"><%= summary[:count] %></td>
          <% share = max_total_ms.positive? ? 100.0 * summary[:total_ms] / max_total_ms : 0 %>
          <td class="text-end text-nowrap" data-order="<%= summary[:total_ms] %>">
            <span data-bs-toggle="tooltip" title="<%= format_duration(summary[:total_ms]) %>"><% if share < 0.05 %>&lt;0.1<% elsif share < 10 %><%= share.round(1) %><% else %><%= share.round %><% end %>%</span>
            <div class="progress mt-1" role="presentation">
              <div class="progress-bar" style="width: <%= share.round(2) %>%"></div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
