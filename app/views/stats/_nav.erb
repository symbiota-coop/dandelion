<li><hr class="my-2"></li>
<li class="nav-item" id="git-badge">
  <a class="nav-link" target="_blank" href="https://github.com/symbiota-coop/dandelion/actions">
    <img src="https://github.com/symbiota-coop/dandelion/actions/workflows/ruby.yml/badge.svg">
  </a>
</li>
<% if (commit = ENV['RENDER_GIT_COMMIT']) %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2" target="_blank" href="https://github.com/symbiota-coop/dandelion/commit/<%= commit %>" data-bs-toggle="tooltip" title="Running commit <%= commit[0..6] %>" data-bs-placement="right">
      <i class="bi bi-git"></i>
      <span><span class="badge badge-secondary" style="background: var(--grey-27)"><%= commit[0..6] %></span></span>
    </a>
  </li>
<% end %>
<% [
  ['Orders', 'orders', 'cart-fill'],
  ['Feedback', 'feedback', 'chat-left-quote'],
  ['Comments', 'comments', 'chat-left-text'],
  ['Messages', 'messages', 'chat-left'],
  ['Accounts', 'accounts', 'person-fill'],
  ['Organisations', 'organisations', 'flag-fill'],
  ['Referrals', 'referrals', 'people-fill'],
  ['Contributions', 'contributions', 'coin'],
  ['Charts', 'charts', 'bar-chart-line-fill'],
  ['Routes', 'routes', 'diagram-3'],
  ['Files', 'files', 'file-earmark'],
  ['Spans', 'sentry_spans', 'activity'],
  ['Icons', 'icons', 'back'],
  ['Design', 'design', 'palette'],
  ['Gems', 'gems', 'gem'],
  ['Frontend', 'frontend_dependencies', 'box-seam'],
  ['ASNs', 'asns', 'shield-check'],
  ['Delivery', 'delivery', 'envelope-check'],
  ['OpenRouter', 'openrouter', 'robot']
].each do |title, path, icon| %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == "/stats/#{path}" %>" href="/stats/<%= path %>" data-bs-toggle="tooltip" title="<%= title %>" data-bs-placement="right">
      <i class="bi bi-<%= icon %>"></i>
      <span><%= title %></span>
    </a>
  </li>
<% end %>
<li class="nav-item">
  <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path.start_with?('/dadmin') %>" href="/dadmin" data-bs-toggle="tooltip" title="Admin" data-bs-placement="right">
    <i class="bi bi-database-gear"></i>
    <span>Admin</span>
  </a>
</li>
<% [
  ['Sentry', ENV['NAV_SENTRY_URL'], 'lightning-fill'],
  ['MongoDB', ENV['NAV_MONGODB_URL'], 'database'],
  ['Cloudflare', ENV['NAV_CLOUDFLARE_URL'], 'cloud'],
  ['Mailgun', 'https://app.eu.mailgun.com/mg/sending/domains', 'envelope-fill']
].each do |title, url, icon| %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2" href="<%= url %>" target="_blank" data-bs-toggle="tooltip" title="<%= title %>" data-bs-placement="right">
      <i class="bi bi-<%= icon %>"></i>
      <span><%= title %></span>
    </a>
  </li>
<% end %>
