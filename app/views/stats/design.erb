<%# Swatch values are read from the live stylesheet by the script at the bottom %>
<% css_var = ->(name) { %(<span data-css-var="#{name}"></span>) }
   css_var_raw = ->(name) { %(<span data-css-value="#{name}"></span>) }
   css_vars = ->(*names) { names.map { |name| css_var.call(name) }.join(' · ') }

   # Run through clamp_color as /theme.css does, so a colour too light for white text is darkened
   themed_colors = %w[#1a73e8 #ffc107].map { |color| [color, clamp_color(color)] } %>

<%# scroll-margin-top keeps anchored headings clear of the fixed header %>
<div class="d-flex flex-column gap-5" style="max-width: 1080px">

  <header class="d-flex flex-column gap-3" style="max-width: 720px">
    <div class="font-monospace small text-body-secondary text-uppercase fw-bold">Design guide · v1 · October 2026</div>
    <h1 class="m-0">Dandelion</h1>
    <p class="m-0 readable">The visual language of dandelion.events as it exists in code today. This page is rendered with the site's own <code>app.css</code> and <code>bootstrap5.css</code>, so swatches, type and components are the real thing. The site is Bootstrap 5.3.8, restyled through its variables.</p>
    <p class="m-0 small text-body-secondary">The root font size is 17px (19px from 1680px, 21px from 1920px), so rem values scale with the viewport. Sizes are in rem (or em, to follow the text); px is kept for 1–2px hairlines, the containers' 15px side padding (<code>$container-padding-x</code>) and overrides that must line up with Google Maps. Colour values, radii and type sizes are measured live; other sizes are copied from the stylesheets.</p>
    <nav class="d-flex flex-wrap gap-2">
      <% [%w[colour Colour], %w[type Type], %w[shape Shape], %w[layout Layout], %w[components Components], %w[theming Theming]].each do |id, title| %>
        <a class="btn btn-outline-primary btn-sm" href="#<%= id %>"><%= title %></a>
      <% end %>
    </nav>
  </header>

  <!-- COLOUR -->
  <section id="colour" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">01</div>
      <h2 class="m-0">Colour</h2>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Theme</h3>
        <span class="text-body-secondary">A ramp generated from one value with <code>oklch()</code>. Components use the 500, 400 as the gradient end, 600 for hover, 50 to 200 for alert and toast backgrounds, and 800 for text on those tints. Organisations and events set <code>--theme-500</code> only (through <code>/theme.css</code>). Tints (50–200) sit at fixed lightness, so they look equally light across hues; shades (400–800) are relative to the 500, with 800 capped dark enough for text on tints.</span>
      </div>
      <div>
        <div class="mb-1"><span class="fw-bold">--theme-*</span> <span class="text-body-secondary">· Primary and success · follows each organisation's theme</span></div>
        <div class="row g-2">
          <% {
               '50' => 'alert and toast background',
               '100' => 'not used yet',
               '200' => 'alert and toast gradient end',
               '400' => 'button gradient end',
               '500' => nil,
               '600' => 'hover',
               '700' => 'not used yet',
               '800' => 'text on tints'
             }.each do |step, note| %>
            <div class="col-3 col-md">
              <div class="rounded mb-1 d-flex align-items-end p-2 small fw-bold" style="height: 72px; background: var(--theme-<%= step %>); color: <%= step.to_i >= 500 ? '#fff' : 'var(--bs-gray-800)' %>"><%= step %></div>
              <div class="font-monospace small text-body-secondary text-break"><%== css_var.call("--theme-#{step}") %></div>
              <% if note %><div class="small text-body-secondary"><%= note %></div><% end %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="row g-3 row-cols-1 row-cols-sm-2">
        <div class="col">
          <div class="rounded border mb-1" style="height: 64px; background: linear-gradient(135deg, var(--theme-50) 0%, var(--theme-50) 50%, var(--theme-200) 100%)"></div>
          <div class="fw-bold">Primary alerts and toasts</div>
          <div class="small text-body-secondary">--theme-50 to --theme-200, the same pattern as warning and danger</div>
          <div class="font-monospace small text-body-secondary"><%== css_vars.call('--theme-50', '--theme-200') %></div>
        </div>
      </div>
      <div class="small text-body-secondary">Bootstrap's <code>rgba(var(--bs-*-rgb))</code> colours need an rgb triplet, so <code>/theme.css</code> also sets <code>--theme-500-rgb</code>.</div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Warning and danger</h3>
        <span class="text-body-secondary">Two families, used the same way. The fill is also Bootstrap's <code>$warning</code> and <code>$danger</code> in bootstrap5.scss, so text-danger, form errors and the like match. There are no warning buttons yet, so --color-orange-hover is unused.</span>
      </div>
      <% [%w[Warning orange], %w[Danger red]].each do |title, colour| %>
        <div>
          <div class="mb-1"><span class="fw-bold"><%= title %></span> <span class="text-body-secondary">· --color-<%= colour %>-*</span></div>
          <div class="row g-2">
            <% [
                 ['', 'fill: badges, buttons'],
                 ['-light', 'gradient end'],
                 ['-hover', 'button hover'],
                 ['-text', 'text and border on tints'],
                 ['-tint', 'alert, toast and row background'],
                 ['-tint-strong', 'tint gradient end, row border']
               ].each do |suffix, note| %>
              <% name = "--color-#{colour}#{suffix}" %>
              <% other_uses = {
                   '--color-orange' => 'ASN stats: bot % of 30 and over',
                   '--color-red' => 'ASN stats: bot % of 60 and over; check-in QR scan line',
                   '--color-red-light' => 'map: event and organisation markers'
                 }[name] %>
              <div class="col-4 col-md-2">
                <div class="rounded border mb-1" style="height: 64px; background: var(<%= name %>)"></div>
                <div class="fw-bold small text-break"><%= suffix.empty? ? 'fill' : suffix.delete_prefix('-') %></div>
                <div class="font-monospace small text-body-secondary"><%== css_var.call(name) %></div>
                <div class="small text-body-secondary"><%= note %></div>
                <% if other_uses %><div class="small text-body-secondary">Also: <%= other_uses %></div><% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="small text-body-secondary">Alerts and toasts: 135°, flat tint to 50%, then to the stronger tint. table-warning and table-danger rows: flat tint, the stronger tint for borders, and a mix 30% of the way to it on hover.</div>
      <div class="row g-3 row-cols-1 row-cols-sm-2">
        <% [
             %w[Warning --color-orange-tint --color-orange-tint-strong],
             %w[Danger --color-red-tint --color-red-tint-strong]
           ].each do |title, from, to| %>
          <div class="col">
            <div class="rounded border mb-1" style="height: 64px; background: linear-gradient(135deg, var(<%= from %>) 0%, var(<%= from %>) 50%, var(<%= to %>) 100%)"></div>
            <div class="fw-bold"><%= title %></div>
            <div class="small text-body-secondary"><%= from %> to <%= to %></div>
            <div class="font-monospace small text-body-secondary"><%== css_vars.call(from, to) %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Greys, black and white</h3>
        <span class="text-body-secondary">Bootstrap's own variables, set in bootstrap5.scss to warm greys: Bootstrap's lightness steps at a slight warm hue (oklch hue 75, chroma .006–.008). The cool --color-canvas behind them on body.canvas pages is deliberate. Usage: 100 wells and hovered dropdown and list items · 200 hovered nav links, autocomplete items and table rows, and stripes · 300 table borders · 400 input borders and hr · 600 secondary text · 700 input add-ons · 800 search bar · 900 header and sidebar. Body text is <code>--bs-body-color</code>, the same as 900. Black and white with transparency use <code>rgba(var(--bs-black-rgb), a)</code> and <code>rgba(var(--bs-white-rgb), a)</code>, e.g. shadows, hairlines and image overlays.</span>
      </div>
      <div class="row g-3">
        <% %w[--bs-white --bs-gray-100 --bs-gray-200 --bs-gray-300 --bs-gray-400 --bs-gray-500 --bs-gray-600 --bs-gray-700 --bs-gray-800 --bs-gray-900 --bs-black].each do |name| %>
          <div class="col-6 col-md-3 col-xl">
            <div class="rounded border mb-1" style="height: 64px; background: var(<%= name %>)"></div>
            <div class="fw-bold text-break small"><%= name %></div>
            <div class="font-monospace small text-body-secondary"><%== css_var.call(name) %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <h3 class="m-0">Accents and surfaces</h3>
      <p class="m-0 text-body-secondary" style="max-width: 680px">Each accent has one role. The dark header and sidebar are a sunset: near-black fading to --color-midnight, with the orange-to-yellow --gradient-active as the sun on the active sidebar item, the notification dot and the load bar. Light content marks active states with the theme colour, so there is one active colour per surface. On the default site purple also marks AI and calendar events; themed pages switch those to the theme. --gradient-rainbow is only for .gradient-text headlines on marketing pages and the signed-out home.</p>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--color-paper], '.gradient end'],
             [%w[--color-canvas], 'body.canvas'],
             [%w[--color-highlight], 'mark'],
             [%w[--color-lavender-2 --color-lavender-1 --color-lavender-3], 'AI well gradient (1 to 2), .gradient (3)', 'lavender-2/1/3'],
             [%w[--color-yellow --color-yellow-light], 'text-bg-yellow: Featured, Co-host, rota points'],
             [%w[--color-amber --color-amber-light --color-amber-dark], 'star icons, feedback stars, map areas, features page'],
             [%w[--color-midnight], 'header sunset; AI and calendar events on the default site']
           ].each do |names, note, title| %>
          <div class="col">
            <% if names.length > 1 %>
              <div class="rounded overflow-hidden mb-1" style="height: 64px">
                <div class="row g-0 h-100">
                  <% names.each do |name| %>
                    <div class="col" style="background: var(<%= name %>)"></div>
                  <% end %>
                </div>
              </div>
              <div class="fw-bold text-break"><%= title || "#{names.first}, …" %></div>
            <% else %>
              <div class="rounded mb-1 <%= 'border' if %w[--color-paper --color-canvas].include?(names.first) %>" style="height: 64px; background: var(<%= names.first %>)"></div>
              <div class="fw-bold text-break"><%= names.first %></div>
            <% end %>
            <div class="font-monospace small text-body-secondary"><%== css_vars.call(*names) %><%= " · #{note}" if note %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <h3 class="m-0">Other gradients</h3>
      <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-xl-3">
        <% [
             ['linear-gradient(135deg, var(--theme-500) 0%, var(--theme-500) 50%, var(--theme-400) 100%)', 'Fill pattern', '135°, flat to 50%, then to a lighter end (--theme-400, --color-red-light). Primary, secondary and danger buttons, badges, progress, text-bg-primary.'],
             ['var(--gradient-active)', '--gradient-active', 'Sidebar active item, notification dot, page-load bar.'],
             ['linear-gradient(45deg, var(--bs-gray-900) 0%, var(--bs-gray-900) 66%, var(--color-midnight) 100%)', 'Header', '45°, --bs-gray-900 to 66%, then midnight.'],
             ['var(--gradient-rainbow)', '--gradient-rainbow', '.gradient-text only.'],
             ['linear-gradient(135deg, var(--color-lavender-3) 0%, var(--color-paper) 50%)', '.gradient', 'Lavender to paper. body.gradient on the sign-in, sign-up and auth failure pages; a .gradient div, which also fades to white at the bottom, behind the hero on the marketing pages and the signed-out home.']
           ].each do |background, title, note| %>
          <div class="col">
            <div class="rounded border mb-1" style="height: 64px; background: <%= background %>"></div>
            <div class="fw-bold"><%= title %></div>
            <div class="small text-body-secondary"><%= note %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Marketing pages</h3>
        <span class="text-body-secondary">The features and comparison pages. Their purple gradient and the five reason colours on the Luma page are derived from <code>--color-midnight</code> and <code>--color-magenta</code>.</span>
      </div>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--wash-amber --wash-rose --wash-magenta --wash-purple], 'section backgrounds'],
             [%w[--color-rose --color-rose-light], nil],
             [%w[--color-violet], 'purple divider end'],
             [%w[--color-magenta --color-magenta-light], nil],
             :magenta_to_highlight
           ].each do |names, note| %>
          <div class="col">
            <% if names == :magenta_to_highlight %>
              <div class="rounded overflow-hidden mb-1" style="height: 64px">
                <div class="row g-0 h-100">
                  <% 0.step(100, 25) do |pct| %>
                    <div class="col" style="background: color-mix(in srgb, var(--color-magenta), var(--color-midnight) <%= pct %>%)"></div>
                  <% end %>
                </div>
              </div>
              <div class="fw-bold">Magenta to midnight</div>
              <div class="small text-body-secondary">color-mix, 0–100%</div>
            <% else %>
              <div class="rounded overflow-hidden border mb-1" style="height: 64px">
                <div class="row g-0 h-100">
                  <% names.each do |name| %>
                    <div class="col" style="background: var(<%= name %>)"></div>
                  <% end %>
                </div>
              </div>
              <div class="fw-bold text-break"><%= names.first %><%= ', …' if names.length > 1 %></div>
              <div class="font-monospace small text-body-secondary"><%== css_vars.call(*names) %><%= " · #{note}" if note %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Third-party brands</h3>
        <span class="text-body-secondary">Only for buttons and labels that stand for these services.</span>
      </div>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--color-evm], 'EVM'],
             [%w[--color-stripe], 'Stripe · text-bg-stripe'],
             [%w[--color-opencollective], 'Open Collective'],
             [%w[--color-coinbase], 'Coinbase'],
             [%w[--color-signal --color-signal-dark], 'Signal · btn-signal'],
             [%w[--color-paypal], 'PayPal'],
             [%w[--color-gocardless --color-gocardless-text], 'GoCardless'],
             [%w[--color-mollie], 'Mollie']
           ].each do |names, note| %>
          <div class="col">
            <div class="rounded mb-1" style="height: 64px; background: var(<%= names.first %>)"></div>
            <div class="fw-bold text-break"><%= names.first %></div>
            <div class="font-monospace small text-body-secondary"><%== css_vars.call(*names) %> · <%= note %></div>
          </div>
        <% end %>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="small text-body-secondary">Payment badges, from <code>badge-payment-&lt;method&gt;</code>:</span>
        <% [%w[coinbase Coinbase], %w[mollie Mollie], %w[paypal PayPal], ['gocardless-instant', 'GoCardless'], ['gocardless-instalment', 'GoCardless instalments'], ['opencollective', 'OC: …'], ['evm', 'EVM: …']].each do |name, text| %>
          <span class="badge badge-payment-<%= name %>"><%= text %></span>
        <% end %>
      </div>
    </div>
  </section>

  <!-- TYPE -->
  <section id="type" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">02</div>
      <h2 class="m-0">Typography</h2>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary fw-bold">HEADINGS · --header-font-family</div>
          <div class="header-font display-5 fw-bold lh-1">Hanken Grotesk</div>
          <div class="small text-body-secondary">Variable 100–900, used at bold. Letter-spacing −0.02em. Also <code>.strapline</code> and <code>.header-font</code>.</div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary fw-bold">BODY · --body-font-family</div>
          <div class="display-5 lh-1">Plus Jakarta Sans</div>
          <div class="small text-body-secondary">Default weight 500, labels 700, bold for <code>b</code>/<code>strong</code>. Line height 1.45.</div>
        </div>
      </div>
    </div>

    <div>
      <h3 class="mb-3">Scale</h3>
      <div class="border-bottom">
        <% [
             ['h1', '--font-size-3xl · 2rem', '<h1 data-sample class="m-0">Gatherings near you</h1>'],
             ['h2', '--font-size-2xl · 1.66rem', '<h2 data-sample class="m-0">Gatherings near you</h2>'],
             ['h3', '--font-size-xl · 1.4rem', '<h3 data-sample class="m-0">Your upcoming events</h3>'],
             ['h4', '--font-size-lg · 1.125rem', '<h4 data-sample class="m-0">Upcoming birthdays</h4>'],
             ['h5', '--font-size-md · .875rem', '<h5 data-sample class="m-0">Ticket types</h5>'],
             ['.readable', '--font-size-base · 1rem', '<div data-sample class="readable">Long-form copy such as event descriptions sets at 1rem.</div>'],
             ['nav · .btn', '--font-size-md · .875rem', '<span data-sample class="btn btn-outline-primary">Buttons, nav links and tabs</span>'],
             ['body · h6', '--font-size-sm · .825rem', '<div data-sample>Body text, inputs, tables, dropdown items</div>'],
             ['.badge', '.875em of its context', '<span data-sample class="badge text-bg-secondary">Badges</span>'],
             ['.breadcrumb', '--font-size-xs · .75rem', '<ol data-sample class="breadcrumb m-0"><li class="breadcrumb-item">Breadcrumbs</li><li class="breadcrumb-item">and carets</li></ol>']
           ].each do |name, size, sample| %>
          <div data-spec-row class="py-3 border-top">
            <div class="row align-items-baseline">
              <code class="col-md-2 font-monospace small text-body-secondary"><%= name %></code>
              <div class="col-md-7"><%== sample %></div>
              <code class="col-md-3 font-monospace small text-body-secondary"><%= size %> · <span data-px></span></code>
            </div>
          </div>
        <% end %>
      </div>
      <div class="small text-body-secondary mt-3"><code>.h1</code>–<code>.h6</code> give any element a heading's style, e.g. <code>&lt;h4 class="h2"&gt;</code> for block titles. Relative helpers, also as <code>--fs-*</code> tokens for CSS: <code>.fs-xs</code> .75em · <code>.fs-sm</code> .875em · <code>.fs-lg</code> 1.2em · <code>.fs-xl</code> 1.5em · <code>.fs-xxl</code> 2em. Secondary text is --bs-gray-600 (<code>.subtle</code>, form-text).</div>
    </div>
  </section>

  <!-- SHAPE -->
  <section id="shape" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">03</div>
      <h2 class="m-0">Radius, elevation, spacing</h2>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Radius</h3>
        <span class="text-body-secondary">Bootstrap's radius variables, set to four steps in <code>bootstrap5.scss</code>. Square corners (0) where an element sits flush against another; 50% for circles.</span>
      </div>
      <div class="row g-3">
        <% [
             ['--bs-border-radius', 'Buttons, inputs, cards, badges, labels, pagination, sidebar pills. -sm is the same'],
             ['--bs-border-radius-lg', 'Menus and panels: dropdowns, autocomplete, cookie banner, AI well, ask box'],
             ['--bs-border-radius-xl', 'Mobile bottom sheet (top corners), marketing cards'],
             ['--bs-border-radius-pill', 'Nav crumbs, avatars, round buttons and dots']
           ].each do |name, note| %>
          <div class="col-6 col-md-3">
            <div class="bg-body-secondary border mb-2" style="height: 72px; border-radius: var(<%= name %>)"></div>
            <div class="fw-bold text-break"><%= name %></div>
            <div class="font-monospace small text-body-secondary"><%== css_var_raw.call(name) %></div>
            <div class="small text-body-secondary"><%= note %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Elevation</h3>
        <span class="text-body-secondary">Bootstrap's three shadows, used through its variables or the <code>shadow-sm</code>, <code>shadow</code> and <code>shadow-lg</code> classes.</span>
      </div>
      <div class="bg-body-tertiary rounded p-4">
        <div class="row g-4">
          <% [
               ['--bs-box-shadow-sm', 'Resting surfaces: header, search, cards, editor toolbar'],
               ['--bs-box-shadow', 'Floating: dropdowns, autocomplete, cookie banner, chat, hover lift'],
               ['--bs-box-shadow-lg', 'Not used yet']
             ].each do |name, note| %>
            <div class="col-md-4">
              <div class="bg-white rounded p-3 small h-100" style="box-shadow: var(<%= name %>)"><b><%= name %></b><br><%= note %></div>
            </div>
          <% end %>
        </div>
      </div>
      <div class="small text-body-secondary">The mobile event page's fixed tickets bar keeps its own upward shadow.</div>
    </div>

    <div class="d-flex flex-column gap-2">
      <h3 class="m-0">Spacing</h3>
      <div class="row gx-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        <% [
             ['Content padding', '1.5625rem · mobile .9375rem'],
             ['Grid gutter', '.75rem'],
             ['Container padding', '15px each side'],
             ['Card body', '1.25rem'],
             ['Card header', '.75rem 1.25rem'],
             ['Field spacing', 'mb-3'],
             ['Table cells', '.5rem (sm too)'],
             ['Containers', '540 / 720 / 960 / 1140']
           ].each do |title, value| %>
          <div class="col">
            <div class="d-flex justify-content-between gap-3 py-2 border-bottom"><span><%= title %></span><code class="text-body-secondary"><%= value %></code></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- LAYOUT -->
  <section id="layout" class="d-flex flex-column gap-4" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">04</div>
      <h2 class="m-0">Page shell</h2>
      <p class="m-0 text-body-secondary" style="max-width: 680px">Fixed dark header (2.8125rem) and a fixed sidebar (14.375rem, minified to 3.75rem). Below 768px the sidebar becomes a full-width offcanvas and header icons spread across a second row.</p>
    </div>
    <div class="border rounded-3 overflow-hidden shadow">
      <div class="d-flex align-items-center px-3 text-white" style="height: 2.8125rem; font-size: 1.125rem; background: linear-gradient(45deg, var(--bs-gray-900) 0%, var(--bs-gray-900) 66%, var(--color-midnight) 100%)">
        <img class="position-relative" style="max-height: 1.75rem; top: -0.25rem" src="/images/logos/white-on-transparent.png" alt="">
        <div class="ms-auto d-flex align-items-center">
          <span class="px-3"><i class="bi bi-search"></i></span>
          <span class="px-3 position-relative"><i class="bi bi-bell"></i><span class="position-absolute top-0 rounded-circle" style="right: .75rem; width: .5rem; height: .5rem; background: var(--gradient-active)"></span></span>
          <span class="px-3"><i class="bi bi-chat-left"></i></span>
          <span class="px-2"><span class="d-block rounded-circle" style="width: 1.75rem; height: 1.75rem; background: var(--bs-gray-600)"></span></span>
        </div>
      </div>
      <div class="d-flex" style="min-height: 420px">
        <div class="d-none d-md-block flex-shrink-0 p-2" style="width: 14.375rem; background: var(--bs-gray-900)">
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded" style="background: var(--gradient-active)"><i class="bi bi-house fs-5"></i><span>Home</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded"><i class="bi bi-newspaper fs-5" style="opacity: .35"></i><span>Dandelion Daily</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded bg-black"><i class="bi bi-calendar-event fs-5" style="opacity: .35"></i><span>Events</span><span class="ms-auto small opacity-50">hover</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded"><i class="bi bi-flag-fill fs-5" style="opacity: .35"></i><span class="flex-grow-1">Organisations</span><i class="bi bi-chevron-down small"></i></div>
          <div class="d-flex flex-column py-1 text-white" style="margin-left: 2.5625rem">
            <span class="py-1">Symbiota</span>
            <span class="py-1 opacity-50">All organisations</span>
          </div>
        </div>
        <div class="flex-grow-1 p-4 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary">#content · padding 1.5625rem</div>
          <div class="row g-3 flex-grow-1">
            <% [['col-8', 'col-lg-8 · newsfeed'], ['col-4', 'col-lg-4 · sticky']].each do |col, label| %>
              <div class="<%= col %>">
                <div class="h-100 border rounded shadow-sm d-flex align-items-center justify-content-center text-center font-monospace small text-body-secondary" style="background: repeating-linear-gradient(135deg, var(--color-canvas) 0 10px, #fff 10px 20px)"><%= label %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENTS -->
  <section id="components" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">05</div>
      <h2 class="m-0">Components</h2>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Buttons</h3>
        <span class="text-body-secondary">.875rem, padding .375rem .75rem, radius .25rem. Primary, secondary and danger are gradients over a transparent border (btn-warning is styled the same but not used yet); brand buttons like btn-signal stay flat.</span>
      </div>
      <div class="border rounded p-4 d-flex flex-wrap gap-3 align-items-center">
        <a class="btn btn-primary" href="#components">Book tickets</a>
        <a class="btn btn-primary" href="#components" style="--bs-btn-bg: var(--theme-600); --btn-gradient-end: var(--theme-500)">Hover</a>
        <a class="btn btn-outline-primary" href="#components">Outline primary</a>
        <a class="btn btn-secondary" href="#components">Secondary</a>
        <a class="btn btn-danger" href="#components">Delete</a>
        <a class="btn btn-signal" href="#components"><i class="bi bi-signal"></i> Signal</a>
      </div>
      <div class="d-flex flex-wrap gap-3 align-items-center px-4">
        <a class="btn btn-primary btn-sm" href="#components">btn-sm</a>
        <a class="btn btn-primary" href="#components">btn</a>
        <a class="btn btn-primary btn-lg" href="#components">btn-lg</a>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Badges</h3>
        <span class="text-body-secondary">Bootstrap's <code>.badge</code> with a <code>text-bg-*</code> colour, for counts, statuses, tags and amounts. Sized in em, so a badge scales with the text around it: small in a nav, bigger beside a heading. Pick the colour by what it means.</span>
      </div>
      <div class="border rounded p-4 d-flex flex-column gap-3">
        <h4 class="m-0">Full moon gathering <span class="badge text-bg-yellow">Featured</span> <span class="badge text-bg-secondary">Locked</span></h4>
        <div>Followers <span class="badge text-bg-primary">128</span> · Tagged <a class="badge text-bg-primary" href="#components">breathwork</a> in <span class="badge text-primary border border-primary">Weekend pass</span> · Paid <span class="badge text-bg-secondary">£5 discount applied</span></div>
        <div class="font-monospace small text-body-secondary">.badge · .875em · .25em .6em · inline-block, baseline · primary, secondary, warning, danger and yellow fills are gradients, like buttons; dark, stripe and payment badges are flat</div>
      </div>
      <table class="table table-sm mb-0">
        <thead>
          <tr><th>Class</th><th>Means</th><th>As used</th></tr>
        </thead>
        <tbody>
          <% [
               ['text-bg-primary', 'Good, or the main count', ['128', '6/6 points', 'breathwork', 'Kitchen shift']],
               ['text-bg-secondary', 'Neutral detail', ['Locked', 'Secret', '£5 discount applied']],
               ['text-bg-warning', 'Needs attention, not yet a problem', ['On hold']],
               ['text-bg-danger', 'A problem or a hard limit', ['Full', 'Rejected, to contact', 'Resign']],
               ['text-bg-yellow', 'Highlighted or rewarded', ['Featured', 'Co-host', '2 points']],
               ['text-bg-dark', 'Counts in a gathering\'s nav', ['3', '12/20']],
               ['text-primary border border-primary', 'Outline: an unselected choice', ['Available', 'Weekend pass', 'London']],
               ['text-bg-stripe', 'Reported by Stripe', ['£1,240']]
             ].each do |klass, meaning, texts| %>
            <tr>
              <td><code><%= klass %></code></td>
              <td class="text-body-secondary"><%= meaning %></td>
              <td><% texts.each do |text| %><span class="badge <%= klass %> me-1"><%= text %></span><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="small text-body-secondary"><code>text-bg-yellow</code> and <code>text-bg-stripe</code> are ours, written like Bootstrap's. Payment badges (<code>badge-payment-&lt;method&gt;</code>) are under Third-party brands. A badge with no colour class has no background, so always give it one (or an inline background, as the hashed organisation and gathering badges do).</div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Alerts</h3>
        <div>
          <div class="alert fade show alert-primary alert-dismissible">Your ticket is booked. <a href="#components">View order</a><button type="button" class="btn-close" aria-label="Close"></button></div>
          <div class="alert alert-warning">Only 3 tickets left. <a href="#components">Book now</a></div>
          <div class="alert alert-danger">Payment failed. <a href="#components">Try again</a></div>
          <div class="font-monospace small text-body-secondary">Inline, in the page. Padding .625rem, no border. Links bold and underlined in the alert's link colour. Flashes render as alerts only on pages that set @hide_alert.</div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Toasts</h3>
        <div class="d-flex flex-column align-items-start gap-2">
          <% [['primary', 'Your ticket is booked.'], ['warning', 'Only 3 tickets left.'], ['danger', 'Payment failed.']].each do |variant, message| %>
            <div class="toast toast-<%= variant %> show w-auto">
              <div class="d-flex">
                <div class="toast-body"><%= message %></div>
                <button type="button" class="btn-close me-2 m-auto" aria-label="Close"></button>
              </div>
            </div>
          <% end %>
          <div class="font-monospace small text-body-secondary">Flash messages, fixed at the top centre (_alert.erb). Same tint gradients as alerts, plus a 1px border in the text colour. Notices fade after 3s, errors and warnings after 6s.</div>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Forms</h3>
        <div class="border rounded p-4">
          <div class="mb-3">
            <label for="dg-event-name">Event name</label>
            <input type="text" class="form-control" id="dg-event-name" autocomplete="off" value="Full moon gathering">
          </div>
          <div class="mb-3">
            <label for="dg-location">Location <span class="fw-normal subtle">· focused</span></label>
            <input type="text" class="form-control" id="dg-location" autocomplete="off" placeholder="Search for a place" style="border-color: var(--theme-500); box-shadow: 0 0 0 var(--bs-focus-ring-width) var(--bs-focus-ring-color)">
            <div class="form-text">Form text is --bs-gray-600. Every focused control gets the same ring: --bs-focus-ring-width (2px) of --bs-focus-ring-color (the theme at 60%). Danger buttons ring in red, btn-signal in its blue, and colour swatches add a white gap. Nav links have none.</div>
          </div>
          <div class="d-flex flex-wrap gap-4 align-items-center mb-3">
            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="dg-checked" checked><label class="form-check-label" for="dg-checked">Checked</label></div>
            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="dg-unchecked"><label class="form-check-label" for="dg-unchecked">Unchecked</label></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="dg-on" checked><label class="form-check-label" for="dg-on">On</label></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="dg-off"><label class="form-check-label" for="dg-off">Off</label></div>
          </div>
          <div class="mb-3">
            <label for="dg-range" class="form-label">Pay what you can</label>
            <input type="range" class="form-range" id="dg-range" autocomplete="off" min="5" max="50" value="20">
          </div>
          <div class="font-monospace small text-body-secondary">input 2.125rem tall · .825rem · border --bs-gray-400 · labels 700</div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Navigation crumbs and dropdown</h3>
        <div class="border rounded p-4 d-flex flex-column gap-4 flex-grow-1">
          <div class="nav-crumbs mb-0">
            <% crumb_items = [['<i class="bi bi-pencil"></i> Edit', '#components'], ['<i class="bi bi-people"></i> Members', '#components'], ['<i class="bi bi-ticket"></i> Orders', '#components']] %>
            <%= dropdown_nav crumb_items, button_text: 'Symbiota', container_class: 'btn-group mb-1' %>
            <%= dropdown_nav crumb_items, button_text: 'Breathwork', container_class: 'btn-group mb-1' %>
            <%= dropdown_nav crumb_items, button_text: 'London', container_class: 'btn-group mb-1 nav-crumbs-sibling' %>
          </div>
          <div class="dropdown-menu show position-relative align-self-start">
            <a class="dropdown-item" href="#components"><i class="bi bi-pencil"></i> Edit</a>
            <a class="dropdown-item" href="#components" style="background: var(--bs-dropdown-link-hover-bg)"><i class="bi bi-people"></i> Members</a>
            <a class="dropdown-item active" href="#components"><i class="bi bi-ticket"></i> Orders</a>
            <a class="dropdown-item" href="#components"><i class="bi bi-bar-chart"></i> Stats</a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Card with .chill header</h3>
        <div class="card shadow-sm">
          <h3 class="card-header chill">Your upcoming events</h3>
          <div class="card-body">
            <div class="d-flex gap-3 align-items-start mb-3">
              <span class="newsfeed-icon d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle"><i class="bi bi-ticket-detailed-fill"></i></span>
              <div><div class="mb-1"><b>Ecstatic dance</b> on Sat 4 Oct</div><div class="subtle small">2 hours ago</div></div>
            </div>
            <div class="d-flex gap-3 align-items-start mb-3">
              <span class="newsfeed-icon d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle"><i class="bi bi-person-fill-add"></i></span>
              <div><div class="mb-1"><b>Ruby</b> followed you</div><div class="subtle small">Yesterday</div></div>
            </div>
            <a href="#components">All events →</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Table and pagination</h3>
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Ticket type</th><th>Sold</th><th class="text-end">Price</th></tr>
          </thead>
          <tbody>
            <tr class="table-danger"><td>Early bird</td><td>40/40</td><td class="text-end">£15</td></tr>
            <tr><td>Standard</td><td>23/80</td><td class="text-end">£22</td></tr>
            <tr class="table-warning"><td>Solidarity</td><td>9/10</td><td class="text-end">£8</td></tr>
          </tbody>
        </table>
        <div class="font-monospace small text-body-secondary">Row colours: table-warning flags a row to look at (low delivery rate), table-danger a problem (blocked ASN). Both use the alert tints</div>
        <ul class="pagination justify-content-center mb-0">
          <li class="page-item disabled"><a class="page-link" href="#components">‹</a></li>
          <li class="page-item active"><a class="page-link" href="#components">1</a></li>
          <li class="page-item"><a class="page-link" href="#components">2</a></li>
          <li class="page-item"><a class="page-link" href="#components">3</a></li>
          <li class="page-item"><a class="page-link" href="#components">›</a></li>
        </ul>
        <div class="font-monospace small text-body-secondary text-center">Active: grey border · Hover: light border</div>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Charts</h3>
        <span class="text-body-secondary">Chart.js, with white bold value labels from chartjs-plugin-datalabels.</span>
      </div>
      <div class="row g-5">
        <div class="col-lg-7 d-flex flex-column gap-3">
          <%= partial :chart, locals: { data: { 'May' => 12, 'June' => 19, 'July' => 15, 'August' => 27, 'September' => 31, 'October' => 24 }, projection: 10 } %>
          <div class="font-monospace small text-body-secondary">Bar (_chart.erb): monthly counts in --theme-500, with the current month's projection stacked on top at 50% (make_projection estimates it from the days so far; here it's fixed)</div>
        </div>
        <div class="col-lg-5 d-flex flex-column gap-3">
          <canvas id="dg-doughnut"></canvas>
          <script>
            $(function () {
              new Chart(document.getElementById('dg-doughnut').getContext('2d'), {
                type: 'doughnut',
                data: {
                  labels: ['10s', '20s', '30s', '40s', '50s', '60s'],
                  datasets: [{ data: [3, 21, 34, 22, 12, 8], backgroundColor: <%== chart_colors(6).to_json %>.map(cssColor) }]
                },
                options: { responsive: true }
              })
            })
          </script>
          <div class="font-monospace small text-body-secondary">Doughnut (_stats.erb): chart_colors turns the theme's hue evenly round the wheel at oklch lightness .71, chroma .11, so every segment has the same weight</div>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Tabs and pills</h3>
        <div class="border rounded p-4 d-flex flex-column gap-4">
          <div class="nav-wrapper">
            <ul class="nav nav-tabs">
              <li class="nav-item"><a class="nav-link active" href="#components">Details</a></li>
              <li class="nav-item"><a class="nav-link" href="#components">Tickets</a></li>
              <li class="nav-item"><a class="nav-link" href="#components">Emails</a></li>
            </ul>
          </div>
          <ul class="nav nav-pills">
            <li class="nav-item"><a class="nav-link active" href="#components">Upcoming</a></li>
            <li class="nav-item"><a class="nav-link" href="#components">Past</a></li>
            <li class="nav-item"><a class="nav-link" href="#components">Drafts</a></li>
          </ul>
          <div class="font-monospace small text-body-secondary">.nav · .875rem · hover and focus: dark text on --bs-secondary-bg, no focus ring · active pill --theme-500 · .tab-content padding .9375rem · in .nav-wrapper, tabs scroll sideways on mobile</div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Modal</h3>
        <div class="bg-body-tertiary rounded p-4">
          <div class="modal position-static d-block h-auto overflow-visible" style="z-index: auto">
            <div class="modal-dialog my-0" style="width: auto"><%# shrink to the column; real modals are 37.5rem %>
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Add a ticket type</h5>
                  <button type="button" class="btn-close" aria-label="Close"></button>
                </div>
                <div class="modal-body">Name, price and quantity go here.</div>
                <div class="modal-footer">
                  <a class="btn btn-secondary" href="#components">Cancel</a>
                  <a class="btn btn-primary" href="#components">Save</a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="font-monospace small text-body-secondary">37.5rem wide from 768px · no border or shadow</div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Header search and autocomplete</h3>
        <div class="rounded overflow-hidden" style="background: var(--bs-gray-800)">
          <div class="header-search-bar position-relative" style="padding: 0 2.75rem">
            <form onsubmit="return false">
              <span class="left-icon"><i class="bi bi-search"></i></span>
              <label class="visually-hidden" for="dg-search">Search</label>
              <input type="text" class="form-control" id="dg-search" autocomplete="off" value="breath">
              <span class="right-icon"><i class="bi bi-x-lg"></i></span>
            </form>
          </div>
        </div>
        <ul class="ui-autocomplete ui-menu ui-widget ui-widget-content list-unstyled bg-white align-self-start" style="position: static; display: block; min-width: 16rem">
          <li class="ui-menu-item"><div class="ui-menu-item-wrapper ui-state-active">Breathwork Collective</div></li>
          <li class="ui-menu-item"><div class="ui-menu-item-wrapper">Breath and sound journey</div></li>
          <li class="ui-menu-item"><div class="ui-menu-item-wrapper">Holotropic breathwork</div></li>
        </ul>
        <div class="font-monospace small text-body-secondary">Search: offcanvas-top, 2.8125rem, --bs-gray-800, backdrop at .9 · autocomplete: radius-lg, --bs-box-shadow, items .3125rem .9375rem, hover --bs-secondary-bg</div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Notifications and messages dropdowns</h3>
        <div class="dropdown-menu show position-relative align-self-start p-0" style="width: 22rem; max-width: 100%">
          <div class="list-group list-group-flush notification-list">
            <% [['bi-person-fill-add', '<b>Ruby</b> followed you', '2 hours ago'], ['bi-ticket-detailed-fill', '<b>Sam</b> booked tickets to <b>Ecstatic dance</b>', 'Yesterday']].each do |icon, sentence, time| %>
              <a class="list-group-item list-group-item-action d-flex align-items-start gap-2" href="#components">
                <span class="newsfeed-icon d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle"><i class="bi <%= icon %>"></i></span>
                <div class="notification-info flex-grow-1">
                  <div class="notification-title"><%== sentence %></div>
                  <div class="notification-time subtle"><%= time %></div>
                </div>
              </a>
            <% end %>
            <a class="message-preview unread p-2 d-block text-dark text-decoration-none" href="#components"><b>Alex</b> · See you there! <span class="subtle small">unread</span></a>
            <a class="message-preview p-2 d-block text-dark text-decoration-none" href="#components"><b>Jo</b> · Thanks <span class="subtle small">read</span></a>
            <a class="list-group-item list-group-item-action text-center" href="#components">All notifications <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
        <div class="font-monospace small text-body-secondary">.notification-list: list-group-flush, items .625rem .9375rem, smaller newsfeed icons · .message-preview: unread --theme-500 at 15%, hover --bs-gray-400 at 30%</div>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">p.action</h3>
        <span class="text-body-secondary">A centred call to action for docs and email previews, where a .btn class can't be added. Drawn like btn-primary; emails use their own in email.css.</span>
      </div>
      <div class="border rounded p-4">
        <p class="action m-0"><a href="#components">Confirm your email</a></p>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <h3 class="m-0">AI well and ask box</h3>
      <div class="row g-4 align-items-start">
        <div class="col-lg-6">
          <div class="ai-well"><b>Suggested description</b><br>A gentle evening of breathwork and sound for all levels.</div>
        </div>
        <div class="col-lg-6">
          <div class="ask-box">
            <label class="visually-hidden" for="dg-ask">Ask a question</label>
            <textarea class="form-control autosize" id="dg-ask" rows="1" placeholder="Ask a question…"></textarea>
            <div class="ask-box-actions">
              <button type="button" class="btn btn-primary btn-sm" aria-label="Ask"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THEMING -->
  <section id="theming" class="d-flex flex-column gap-4" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">06</div>
      <h2 class="m-0">Theming</h2>
      <p class="m-0 text-body-secondary" style="max-width: 680px">Organisations and events set one colour. <code>theme_css_variables</code> sets <code>--theme-500</code>, app.css derives the ramp from it, and every primary button, link, focus ring, crumb, check, progress bar and stats chart follows. Alerts and toasts use the ramp's tints with --theme-800 text on every page; on themed pages the AI well and calendar events also switch to the theme colour. That is deliberate: the default site keeps them --color-midnight, as its own accent. The .event-detail tiles (date and icons) follow the theme through theme.css too, as event_details.css is inlined into emails and hard-codes the default green.</p>
    </div>
    <div class="row g-3">
      <div class="col-md-6 col-xxl-4">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary fw-bold">DEFAULT · <%== css_var.call('--theme-500') %></div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <a class="btn btn-primary" href="#theming">Book</a>
            <div class="nav-crumbs mb-0">
              <%= dropdown_nav [['Edit', '#theming']], button_text: 'Crumb' %>
            </div>
          </div>
          <div class="alert alert-primary mb-0">Saved. Text is --theme-800</div>
          <div class="ai-well">AI well: purple</div>
        </div>
      </div>
      <% themed_colors.each do |color, clamped| %>
        <div class="col-md-6 col-xxl-4">
          <div class="theme-scope border rounded p-4 h-100 d-flex flex-column gap-3" style="<%= theme_css_variables(clamped)[/\{(.*)\}/m, 1].squish %>">
            <div class="font-monospace small text-body-secondary fw-bold">THEMED · <%= color %><%= " → #{clamped} (clamped)" if clamped != color %></div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <a class="btn btn-primary" href="#theming">Book</a>
              <div class="nav-crumbs mb-0">
                <%= dropdown_nav [['Edit', '#theming']], button_text: 'Crumb' %>
              </div>
            </div>
            <div class="alert alert-primary mb-0">Saved. Text is --theme-800</div>
            <div class="ai-well">AI well: theme tint</div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="small text-body-secondary">Each themed panel sets <code>--theme-500</code> from <code>theme_css_variables(clamp_color(colour))</code> on itself, as <code>/theme.css</code> does, and has the <code>theme-scope</code> class so the ramp is recomputed from it. theme.css itself only loads on themed pages, so its rules are applied here inside <code>@scope (.theme-scope)</code>.</div>
    <%# theme.css's rules without its comment and :root block, which the panels set themselves %>
    <style>
      @scope (.theme-scope) {
        <%== File.read(Padrino.root('app/assets/stylesheets/theme.css')).sub(%r{/\*.*?\*/}m, '').sub(/:root \{.*?\}/m, '').strip %>
      }
    </style>
  </section>

</div>

<script>
  $(function () {
    // Custom properties come back as written (e.g. oklch(from ...)), so paint each one to resolve it to hex
    var ctx = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
    var probe = $('<span>').hide().appendTo('body')[0];
    $('[data-css-var]').each(function () {
      probe.style.color = 'var(' + $(this).attr('data-css-var') + ')';
      ctx.clearRect(0, 0, 1, 1);
      ctx.fillStyle = getComputedStyle(probe).color;
      ctx.fillRect(0, 0, 1, 1);
      var d = ctx.getImageData(0, 0, 1, 1).data;
      var hex = '#' + [0, 1, 2].map(function (i) { return d[i].toString(16).padStart(2, '0'); }).join('');
      $(this).text(d[3] < 255 ? hex + ' / ' + Math.round(d[3] / 2.55) + '%' : hex);
    });
    $('[data-css-value]').each(function () {
      $(this).text(getComputedStyle(document.documentElement).getPropertyValue($(this).attr('data-css-value')).trim());
    });
    $('[data-spec-row]').each(function () {
      var px = parseFloat(getComputedStyle($(this).find('[data-sample]')[0]).fontSize);
      $(this).find('[data-px]').text(Math.round(px * 10) / 10 + 'px');
    });
  });
</script>
