<%# Swatch values are read from the live stylesheet by the script at the bottom %>
<% css_var = ->(name) { %(<span data-css-var="#{name}"></span>) }
   css_vars = ->(*names) { names.map { |name| css_var.call(name) }.join(' · ') }
   flag_class = 'badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle'
   flags = ->(*numbers) { numbers.map { |n| %(<a href="#i-#{n}" class="#{flag_class}">I-#{n}</a>) }.join }

   severity_classes = { 'High' => 'text-danger', 'Medium' => 'text-warning-emphasis', 'Low' => 'text-body-secondary' }
   issues = [
     [3, 'Medium', 'Default and themed pages diverge with the same colour', 'theme.css restyles .ai-well and calendar events: the AI well is purple by default and a theme tint when themed; calendar events are purple by default and theme-coloured when themed. (Alerts and toasts no longer differ: their tints come from the ramp.)', 'Move the remaining theme.css rules into app.css so there is one behaviour, or document that the purple is intentional only for the unthemed site.', 'theme.css · app.css .ai-well, #calendar a.fc-event'],
     [7, 'Medium', 'Too many accent colours and active states', 'Besides the theme colour there is purple #4400B9 (header, AI), an orange-to-yellow gradient (sidebar active, notification dot, load bar), a rainbow gradient, signal blue and Stripe purple. The sidebar active item uses the orange gradient while every other active state (pills, list groups, dropdown items, checks) uses the theme colour.', 'Decide which accent marks "active" and use it everywhere; restrict purple to AI features.', 'app.css .sidebar .nav-link.active, #header, --gradient-*'],
     [8, 'Medium', 'Type scale has no clear steps', 'Small sizes include .693, .75, .8, .825, .85, .875 and .9rem plus 82.5%, 85% and 90%. h1 (34px) and h2 (31.9px) differ by 2px; .block-title (1.66rem) sits between h2 and h3. h6 equals body size. small.form-text is .85rem, larger than the body text it supports.', 'Reduce to a 6–7 step scale (for example .75, .825, .875, 1, 1.125, 1.4, 2rem) and alias .block-title to one of them.', 'app.css Base section'],
     [11, 'Low', 'Radius values', 'Ten values in use: 0, .2rem, .25rem, .25em, .3rem, 5px, .375rem, .5rem, .75rem, 999px. 5px and .25rem are near-duplicates. Dropdowns are .5rem but the jQuery UI autocomplete, also a menu, has radius 0.', 'Settle on sm/md/lg/pill (.25, .5, .75rem, 999px) and give the autocomplete the dropdown treatment.', 'bootstrap5.scss · app.css .ui-autocomplete, .sidebar .nav'],
     [12, 'Low', 'No elevation scale', 'Five unrelated shadows. The autocomplete shadow is three times darker than the dropdown shadow.', 'Define two or three shadow tokens and reuse them.', 'app.css .dropdown-menu, .ui-autocomplete, .cookie-consent, .header.navbar'],
     [13, 'Low', 'Three focus ring styles', 'Inputs: 2px at 60%. Checks, pagination, accordion, close: .25rem at 25%. btn-signal: .2rem with its own colour. Nav links have none.', 'Use one ring (e.g. 2px at 60%) via --bs-focus-ring-*.', 'bootstrap5.scss $input-focus-box-shadow · app.css'],
     [14, 'Low', 'Badges and labels are parallel systems', '.label is a legacy Bootstrap 3 component with different size and padding (85%, .2em .6em) and only some variants (no label-warning).', 'Migrate .label usages to .badge and remove .label.', 'app.css Labels section'],
     [15, 'Low', 'Button treatments vary', 'Primary and danger are gradients; secondary and warning are flat. btn-signal forces its hover with !important. p.action a is a separate CTA style (10px padding, 5px radius).', 'Apply the gradient pattern to all solid variants or none; express btn-signal through --bs-btn-* variables.', 'app.css Buttons, p.action'],
     [17, 'Low', 'Mixed px and rem', 'The file converts most values to rem, but 5px radii, 15px insets, 7.5px slick padding, 16px newsfeed icons, 20–22px map icons and 36/40px controls remain. Because the root scales to 19 and 21px, these shrink relative to everything else on large screens.', 'Convert remaining px to rem.', 'app.css']
   ]

   # Run through clamp_color as /theme.css does, so a colour too light for white text is darkened
   themed_colors = %w[#1a73e8 #ffc107].map { |color| [color, clamp_color(color)] } %>

<%# scroll-margin-top keeps anchored headings clear of the fixed header %>
<div class="d-flex flex-column gap-5" style="max-width: 1080px">

  <header class="d-flex flex-column gap-3" style="max-width: 720px">
    <div class="font-monospace small text-body-secondary text-uppercase fw-bold">Design guide · v1 · October 2026</div>
    <h1 class="m-0">Dandelion</h1>
    <p class="m-0 readable">The visual language of dandelion.events as it exists in code today. This page is rendered with the site's own <code>app.css</code> and <code>bootstrap5.css</code>, so swatches, type and components are the real thing. The site is Bootstrap 5.3.8, restyled through its variables.</p>
    <p class="m-0 small text-body-secondary">The root font size is 17px (19px from 1680px, 21px from 1920px), so rem values scale with the viewport. Colour values and pixel sizes are measured live. Items marked with an orange tag are inconsistencies, listed in full at the <a href="#issues">end</a>.</p>
    <nav class="d-flex flex-wrap gap-2">
      <% [%w[colour Colour], %w[type Type], %w[shape Shape], %w[layout Layout], %w[components Components], %w[theming Theming]].each do |id, title| %>
        <a class="btn btn-outline-primary btn-sm" href="#<%= id %>"><%= title %></a>
      <% end %>
      <a class="btn btn-sm text-white" style="background: var(--gradient-active)" href="#issues">Inconsistencies</a>
    </nav>
  </header>

  <!-- COLOUR -->
  <section id="colour" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">01</div>
      <h2 class="m-0">Colour</h2>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Theme and status</h3>
        <span class="text-body-secondary">Three ramps, each generated from one value with <code>oklch()</code>. Components use the 500, 400 as the gradient end, 600 for hover, 50 to 200 for alert and toast backgrounds, and 800 for text on those tints. Organisations and events set <code>--theme-500</code> only (through <code>/theme.css</code>). Tints (50–200) sit at fixed lightness, so they look equally light across hues; shades (400–800) are relative to the 500, with 800 capped dark enough for text on tints.</span>
      </div>
      <% [
           ['theme', 'Primary and success · follows each organisation\'s theme', %w[50 100 200 400 500 600 700 800], { '50' => 'alert and toast background', '200' => 'gradient end', '400' => 'button gradient end', '600' => 'hover', '800' => 'text on tints' }],
           ['orange', 'Warning', %w[50 100 200 400 500 600 700 800], { '800' => 'warning text' }],
           ['red', 'Danger', %w[50 100 200 400 500 600 700 800], { '800' => 'danger text' }]
         ].each do |name, role, steps, notes| %>
        <div>
          <div class="mb-1"><span class="fw-bold">--<%= name %>-*</span> <span class="text-body-secondary">· <%= role %></span></div>
          <div class="row g-2">
            <% steps.each do |step| %>
              <div class="col-3 col-md">
                <div class="rounded mb-1 d-flex align-items-end p-2 small fw-bold" style="height: 72px; background: var(--<%= name %>-<%= step %>); color: <%= step.to_i >= 500 ? '#fff' : 'var(--bs-gray-800)' %>"><%= step %></div>
                <div class="font-monospace small text-body-secondary text-break"><%== css_var.call("--#{name}-#{step}") %></div>
                <% if notes[step] %><div class="small text-body-secondary"><%= notes[step] %></div><% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="rounded px-3 py-2 fw-bold" style="background: var(--theme-500); color: var(--theme-on-500)">--theme-on-500</span>
        <span class="small text-body-secondary">Black or white, whichever reads better on the 500: <code>oklch(from var(--theme-500) clamp(0, (0.65 - l) * 1000, 1) 0 0)</code>. Not yet used; buttons still get white text, so <code>/theme.css</code> darkens light theme colours with <code>clamp_color</code>.</span>
      </div>
      <div class="small text-body-secondary">Bootstrap's <code>rgba(var(--bs-*-rgb))</code> colours need an rgb triplet, so <code>/theme.css</code> also sets <code>--theme-500-rgb</code>.</div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Accents and surfaces</h3>
        <%== flags.call(7) %>
      </div>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--color-highlight-1], 'header, AI'],
             [%w[--color-highlight-1-light-2 --color-highlight-1-light-1 --color-highlight-1-light-3], nil],
             [%w[--color-star], nil],
             [%w[--color-chart], 'chart segments rotate its hue'],
             [%w[--color-yellow --color-yellow-light], 'badge-yellow: Featured, Co-host, rota points'],
             [%w[--color-amber --color-amber-light --color-amber-dark], 'map areas, features page'],
             [%w[--color-search-highlight], 'mark'],
             [%w[--color-paper], nil],
             [%w[--color-superlight], 'body.greyed']
           ].each do |names, note| %>
          <div class="col">
            <% if names.length == 3 %>
              <div class="rounded overflow-hidden mb-1" style="height: 64px">
                <div class="row g-0 h-100">
                  <% names.each do |name| %>
                    <div class="col-4" style="background: var(<%= name %>)"></div>
                  <% end %>
                </div>
              </div>
              <div class="fw-bold text-break"><%= names.first.start_with?('--color-highlight-1') ? 'highlight-1-light-2/1/3' : "#{names.first}, -light, -dark" %></div>
            <% else %>
              <div class="rounded mb-1 <%= 'border' if %w[--color-paper --color-superlight].include?(names.first) %>" style="height: 64px; background: var(<%= names.first %>)"></div>
              <div class="fw-bold text-break"><%= names.first %></div>
            <% end %>
            <div class="font-monospace small text-body-secondary"><%== css_vars.call(*names) %><%= " · #{note}" if note %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Third-party brands</h3>
        <span class="text-body-secondary">Only for buttons and labels that stand for these services.</span>
      </div>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--color-signal --color-signal-dark], 'Signal · btn-signal'],
             [%w[--color-stripe], 'Stripe · label-stripe'],
             [%w[--color-coinbase], 'Coinbase'],
             [%w[--color-mollie], 'Mollie'],
             [%w[--color-paypal], 'PayPal'],
             [%w[--color-gocardless --color-gocardless-text], 'GoCardless'],
             [%w[--color-opencollective], 'Open Collective'],
             [%w[--color-evm], 'EVM']
           ].each do |names, note| %>
          <div class="col">
            <div class="rounded mb-1" style="height: 64px; background: var(<%= names.first %>)"></div>
            <div class="fw-bold text-break"><%= names.first %></div>
            <div class="font-monospace small text-body-secondary"><%== css_vars.call(*names) %> · <%= note %></div>
          </div>
        <% end %>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="small text-body-secondary">Payment badges, from <code>badge-payment-&lt;method&gt;</code>:</span>
        <% [%w[coinbase Coinbase], %w[mollie Mollie], %w[paypal PayPal], ['gocardless-instant', 'GoCardless'], ['gocardless-instalment', 'GoCardless instalments'], ['opencollective', 'OC: …'], ['evm', 'EVM: …']].each do |name, text| %>
          <span class="badge badge-payment-<%= name %>"><%= text %></span>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Greys, black and white</h3>
        <span class="text-body-secondary">Bootstrap's own variables. Usage: 900 header and sidebar · 800 search bar · 700 input add-ons · 600 secondary text · 400 input borders and hr · 300 table borders · 200 hovers and stripes · 100 wells. Body text is <code>--bs-body-color</code>, the same as 900. Black and white with transparency use <code>rgba(var(--bs-black-rgb), a)</code> and <code>rgba(var(--bs-white-rgb), a)</code>, e.g. shadows, hairlines and image overlays.</span>
      </div>
      <div class="row g-3">
        <% %w[--bs-black --bs-gray-900 --bs-gray-800 --bs-gray-700 --bs-gray-600 --bs-gray-500 --bs-gray-400 --bs-gray-300 --bs-gray-200 --bs-gray-100 --bs-white].each do |name| %>
          <div class="col-6 col-md-3 col-xl">
            <div class="rounded border mb-1" style="height: 64px; background: var(<%= name %>)"></div>
            <div class="fw-bold text-break small"><%= name %></div>
            <div class="font-monospace small text-body-secondary"><%== css_var.call(name) %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Marketing pages</h3>
        <span class="text-body-secondary">The features and comparison pages. Their purple gradient and the five reason colours on the Luma page are derived from <code>--color-highlight-1</code> and <code>--color-magenta</code>.</span>
      </div>
      <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-xl-5">
        <% [
             [%w[--color-magenta --color-magenta-light], nil],
             [%w[--color-rose --color-rose-light], nil],
             [%w[--color-violet], 'purple divider end'],
             [%w[--wash-amber --wash-rose --wash-magenta --wash-purple], 'section backgrounds']
           ].each do |names, note| %>
          <div class="col">
            <div class="rounded overflow-hidden border mb-1" style="height: 64px">
              <div class="row g-0 h-100">
                <% names.each do |name| %>
                  <div class="col" style="background: var(<%= name %>)"></div>
                <% end %>
              </div>
            </div>
            <div class="fw-bold text-break"><%= names.first %><%= ', …' if names.length > 1 %></div>
            <div class="font-monospace small text-body-secondary"><%== css_vars.call(*names) %><%= " · #{note}" if note %></div>
          </div>
        <% end %>
        <div class="col">
          <div class="rounded overflow-hidden mb-1" style="height: 64px">
            <div class="row g-0 h-100">
              <% 0.step(100, 25) do |pct| %>
                <div class="col" style="background: color-mix(in srgb, var(--color-magenta), var(--color-highlight-1) <%= pct %>%)"></div>
              <% end %>
            </div>
          </div>
          <div class="fw-bold">Magenta to highlight-1</div>
          <div class="small text-body-secondary">color-mix, 0–100%</div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <h3 class="m-0">Gradients</h3>
      <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-xl-3">
        <% [
             ['linear-gradient(135deg, var(--theme-500) 0%, var(--theme-500) 50%, var(--theme-400) 100%)', 'Fill pattern', '135°, flat to 50%, then to -light. Primary/danger buttons, badges, progress, text-bg-primary.'],
             ['linear-gradient(135deg, var(--theme-50) 0%, var(--theme-50) 50%, var(--theme-200) 100%)', 'Tint pattern', 'Same geometry, tint to tint-strong. Alerts and toasts.'],
             ['var(--gradient-active)', '--gradient-active', 'Sidebar active item, notification dot, page-load bar.'],
             ['linear-gradient(45deg, var(--bs-gray-900) 0%, var(--bs-gray-900) 66%, var(--color-highlight-1) 100%)', 'Header', '45°, --bs-gray-900 to 66%, then highlight-1.'],
             ['var(--gradient-rainbow)', '--gradient-rainbow', '.gradient-text only.'],
             ['linear-gradient(135deg, var(--color-highlight-1-light-3) 0%, var(--color-paper) 50%)', 'body.gradient', 'Lilac to paper. Marketing pages.']
           ].each do |background, title, note| %>
          <div class="col">
            <div class="rounded border mb-1" style="height: 64px; background: <%= background %>"></div>
            <div class="fw-bold"><%= title %></div>
            <div class="small text-body-secondary"><%= note %></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- TYPE -->
  <section id="type" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">02</div>
      <h2 class="m-0">Typography</h2>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary fw-bold">HEADINGS · --header-font-family</div>
          <div class="header-font display-5 fw-bold lh-1">Hanken Grotesk</div>
          <div class="small text-body-secondary">Variable 100–900, used at bold. Letter-spacing −0.02em. Also <code>.strapline</code> and <code>.header-font</code>.</div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary fw-bold">BODY · --body-font-family</div>
          <div class="display-5 lh-1">Plus Jakarta Sans</div>
          <div class="small text-body-secondary">Default weight 500, labels 700, bold for <code>b</code>/<code>strong</code>. Line height 1.45.</div>
        </div>
      </div>
    </div>

    <div>
      <div class="d-flex align-items-baseline flex-wrap gap-2 mb-3">
        <h3 class="m-0">Scale</h3>
        <%== flags.call(8) %>
      </div>
      <% [
           ['h1', '2rem', '<h1 data-sample class="m-0">Gatherings near you</h1>'],
           ['h2', '1.875rem', '<h2 data-sample class="m-0">Gatherings near you</h2>'],
           ['.block-title', '1.66rem', '<h4 data-sample class="block-title m-0">Gatherings near you</h4>'],
           ['h3', '1.4rem', '<h3 data-sample class="m-0">Your upcoming events</h3>'],
           ['h4', '1.125rem', '<h4 data-sample class="m-0">Upcoming birthdays</h4>'],
           ['h5', '.875rem', '<h5 data-sample class="m-0">Ticket types</h5>'],
           ['.readable', '1rem', '<div data-sample class="readable">Long-form copy such as event descriptions sets at 1rem.</div>'],
           ['nav · .btn', '.875rem', '<span data-sample class="btn btn-outline-primary">Buttons, nav links and tabs</span>'],
           ['body · h6', '.825rem', '<div data-sample>Body text, inputs, tables, dropdown items</div>'],
           ['.badge', '.75rem', '<span data-sample class="badge badge-default">Badges</span>'],
           ['.breadcrumb', '.693rem', '<ol data-sample class="breadcrumb m-0"><li class="breadcrumb-item">Breadcrumbs</li><li class="breadcrumb-item">and carets</li></ol>']
         ].each_with_index do |(name, size, sample), i| %>
        <div data-spec-row class="py-3 border-top <%= 'border-bottom' if i == 10 %>">
          <div class="row align-items-baseline">
            <code class="col-md-2 font-monospace small text-body-secondary"><%= name %></code>
            <div class="col-md-7"><%== sample %></div>
            <code class="col-md-3 font-monospace small text-body-secondary"><%= size %> · <span data-px></span></code>
          </div>
        </div>
      <% end %>
      <div class="small text-body-secondary mt-3">Relative helpers: <code>.fs-xs</code> .75em · <code>.fs-sm</code> .875em · <code>.fs-lg</code> 1.2em · <code>.fs-xl</code> 1.5em · <code>.fs-xxl</code> 2em. Secondary text is --bs-gray-600 (<code>.subtle</code>, form-text).</div>
    </div>
  </section>

  <!-- SHAPE -->
  <section id="shape" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">03</div>
      <h2 class="m-0">Radius, elevation, spacing</h2>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Radius</h3>
        <%== flags.call(11) %>
      </div>
      <div class="row g-3">
        <% [
             ['0', '0', 'Autocomplete, sidebar dropdown, minify button'],
             ['.25rem', '.25rem · base', 'Buttons, inputs, cards, badges, alerts. sm .2rem, lg .3rem'],
             ['5px', '5px', 'Sidebar pills, cookie banner, email CTA'],
             ['.375rem', '.375rem', 'Pagination'],
             ['.5rem', '.5rem', 'Dropdowns, AI well, ask box'],
             ['.75rem .75rem 0 0', '.75rem top', 'Mobile bottom sheet'],
             ['999px', '999px', 'Nav crumbs, avatars']
           ].each do |radius, title, note| %>
          <div class="col-6 col-md-3 col-xl">
            <div class="bg-body-secondary border mb-2" style="height: 72px; border-radius: <%= radius %>"></div>
            <div class="fw-bold"><%= title %></div>
            <div class="small text-body-secondary"><%= note %></div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Elevation</h3>
        <%== flags.call(12) %>
      </div>
      <div class="bg-body-tertiary rounded p-4">
        <div class="row g-4">
          <% [
               ['shadow-sm', 'Cards, newsfeed, search', 'rounded shadow-sm', nil],
               ['Dropdown', '0 .125rem .375rem 1px / .1', '', 'border-radius: .5rem; border: 1px solid rgba(0, 0, 0, .05); box-shadow: 0 .125rem .375rem 1px rgba(0, 0, 0, .1)'],
               ['Autocomplete', '0 .125rem .375rem / .3', '', 'box-shadow: 0 .125rem .375rem rgba(0, 0, 0, .3)'],
               ['Cookie banner', '0 .5rem 1.5rem / .16', 'border', 'border-radius: 5px; box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .16)'],
               ['Header', '0 .125rem 2.5rem / .08', '', 'box-shadow: 0 .125rem 2.5rem rgba(0, 0, 0, .08)']
             ].each do |title, note, classes, style| %>
            <div class="col-6 col-md-4 col-xl">
              <div class="bg-white p-3 small h-100 <%= classes %>" style="<%= style %>"><b><%= title %></b><br><%= note %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column gap-2">
      <h3 class="m-0">Spacing</h3>
      <div class="row gx-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        <% [
             ['Content padding', '1.5625rem · mobile .9375rem'],
             ['Grid gutter', '.75rem'],
             ['Container padding', '15px each side'],
             ['Card body', '1.25rem'],
             ['Card header', '.75rem 1.25rem'],
             ['Field spacing', 'mb-3'],
             ['Table cells', '.5rem (sm too)'],
             ['Containers', '540 / 720 / 960 / 1140']
           ].each do |title, value| %>
          <div class="col">
            <div class="d-flex justify-content-between gap-3 py-2 border-bottom"><span><%= title %></span><code class="text-body-secondary"><%= value %></code></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- LAYOUT -->
  <section id="layout" class="d-flex flex-column gap-4" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">04</div>
      <h2 class="m-0">Page shell</h2>
      <p class="m-0 text-body-secondary" style="max-width: 680px">Fixed dark header (2.8125rem) and a fixed sidebar (14.375rem, minified to 3.75rem). Below 768px the sidebar becomes a full-width offcanvas and header icons spread across a second row.</p>
    </div>
    <div class="border rounded-3 overflow-hidden shadow">
      <div class="d-flex align-items-center px-3 text-white fs-5" style="height: 48px; background: linear-gradient(45deg, var(--bs-gray-900) 0%, var(--bs-gray-900) 66%, var(--color-highlight-1) 100%)">
        <img class="position-relative" style="max-height: 1.75rem; top: -0.25rem" src="/images/logos/white-on-transparent.png" alt="">
        <div class="ms-auto d-flex align-items-center">
          <span class="px-3"><i class="bi bi-search"></i></span>
          <span class="px-3 position-relative"><i class="bi bi-bell"></i><span class="position-absolute top-0 rounded-circle" style="right: .75rem; width: 8px; height: 8px; background: var(--gradient-active)"></span></span>
          <span class="px-3"><i class="bi bi-chat-left-text"></i></span>
          <span class="px-2"><span class="d-block rounded-circle" style="width: 28px; height: 28px; background: var(--bs-gray-600)"></span></span>
        </div>
      </div>
      <div class="d-flex" style="min-height: 420px">
        <div class="d-none d-md-block flex-shrink-0 p-2" style="width: 244px; background: var(--bs-gray-900)">
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded" style="background: var(--gradient-active)"><i class="bi bi-house fs-5"></i><span>Home</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded"><i class="bi bi-newspaper fs-5 opacity-50"></i><span>Dandelion Daily</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded bg-black"><i class="bi bi-calendar-event fs-5 opacity-50"></i><span>Events</span><span class="ms-auto small opacity-50">hover</span></div>
          <div class="d-flex align-items-center gap-2 py-2 px-3 text-white rounded"><i class="bi bi-flag-fill fs-5 opacity-50"></i><span class="flex-grow-1">Organisations</span><i class="bi bi-chevron-down small"></i></div>
          <div class="d-flex flex-column py-1 text-white" style="margin-left: 2.75rem">
            <span class="py-1">Symbiota</span>
            <span class="py-1 opacity-50">All organisations</span>
          </div>
        </div>
        <div class="flex-grow-1 p-4 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary">#content · padding 1.5625rem</div>
          <div class="row g-3 flex-grow-1">
            <% [['col-8', 'col-lg-8 · newsfeed'], ['col-4', 'col-lg-4 · sticky']].each do |col, label| %>
              <div class="<%= col %>">
                <div class="h-100 border rounded shadow-sm d-flex align-items-center justify-content-center text-center font-monospace small text-body-secondary" style="background: repeating-linear-gradient(135deg, var(--color-superlight) 0 10px, #fff 10px 20px)"><%= label %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENTS -->
  <section id="components" class="d-flex flex-column gap-5" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">05</div>
      <h2 class="m-0">Components</h2>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Buttons</h3>
        <span class="text-body-secondary">.875rem, padding .375rem .75rem, radius .25rem. Primary and danger are borderless gradients.</span>
        <%== flags.call(15) %>
      </div>
      <div class="border rounded p-4 d-flex flex-wrap gap-3 align-items-center">
        <a class="btn btn-primary" href="#components">Book tickets</a>
        <a class="btn btn-primary" href="#components" style="--bs-btn-bg: var(--theme-600); --btn-gradient-end: var(--theme-500)">Hover</a>
        <a class="btn btn-outline-primary" href="#components">Outline primary</a>
        <a class="btn btn-secondary" href="#components">Secondary</a>
        <a class="btn btn-danger" href="#components">Delete</a>
        <a class="btn btn-signal" href="#components"><i class="bi bi-signal"></i> Signal</a>
      </div>
      <div class="d-flex flex-wrap gap-3 align-items-center px-4">
        <a class="btn btn-primary btn-sm" href="#components">btn-sm</a>
        <a class="btn btn-primary" href="#components">btn</a>
        <a class="btn btn-primary btn-lg" href="#components">btn-lg</a>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="d-flex align-items-baseline flex-wrap gap-2">
        <h3 class="m-0">Badges and labels</h3>
        <%== flags.call(14) %>
      </div>
      <div class="border rounded p-4 d-flex flex-column gap-3">
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <% %w[primary warning danger yellow inverse default outline-primary].each do |variant| %>
            <span class="badge badge-<%= variant %>"><%= variant %></span>
          <% end %>
        </div>
        <div class="font-monospace small text-body-secondary">.badge · .75rem · .1875rem .4375rem</div>
        <div class="d-flex flex-wrap gap-2 align-items-baseline">
          <span>Text with</span>
          <% %w[primary danger stripe].each do |variant| %>
            <span class="label label-<%= variant %>">label-<%= variant %></span>
          <% end %>
        </div>
        <div class="font-monospace small text-body-secondary">.label · 85% · .2em .6em .3em (legacy)</div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <div class="d-flex align-items-baseline flex-wrap gap-2">
          <h3 class="m-0">Alerts</h3>
          <%== flags.call(3) %>
        </div>
        <div>
          <div class="alert fade show alert-primary alert-dismissible">Your ticket is booked. <a href="#components">View order</a><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
          <div class="alert alert-warning">Only 3 tickets left. <a href="#components">Book now</a></div>
          <div class="alert alert-danger">Payment failed. <a href="#components">Try again</a></div>
          <div class="font-monospace small text-body-secondary">Inline, in the page. Padding .625rem, no border. Links bold and underlined in the alert's link colour. Flashes render as alerts only on pages that set @hide_alert.</div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <div class="d-flex align-items-baseline flex-wrap gap-2">
          <h3 class="m-0">Toasts</h3>
          <%== flags.call(3) %>
        </div>
        <div class="d-flex flex-column align-items-start gap-2">
          <% [['primary', 'Your ticket is booked.'], ['warning', 'Only 3 tickets left.'], ['danger', 'Payment failed.']].each do |variant, message| %>
            <div class="toast toast-<%= variant %> show w-auto">
              <div class="d-flex">
                <div class="toast-body"><%= message %></div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
              </div>
            </div>
          <% end %>
          <div class="font-monospace small text-body-secondary">Flash messages, fixed at the top centre (_alert.erb). Same tint gradients as alerts, plus a 1px border in the text colour. Notices fade after 3s, errors and warnings after 6s.</div>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <div class="d-flex align-items-baseline flex-wrap gap-2">
          <h3 class="m-0">Forms</h3>
          <%== flags.call(13) %>
        </div>
        <div class="border rounded p-4">
          <div class="mb-3">
            <label for="dg-event-name">Event name</label>
            <input type="text" class="form-control" id="dg-event-name" autocomplete="off" value="Full moon gathering">
          </div>
          <div class="mb-3">
            <label for="dg-location">Location <span class="fw-normal subtle">· focused</span></label>
            <input type="text" class="form-control" id="dg-location" autocomplete="off" placeholder="Search for a place" style="border-color: var(--theme-500); box-shadow: 0 0 0 2px oklch(from var(--theme-500) l c h / .6)">
            <div class="form-text">Form text is --bs-gray-600.</div>
          </div>
          <div class="d-flex flex-wrap gap-4 align-items-center mb-3">
            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="dg-checked" checked><label class="form-check-label" for="dg-checked">Checked</label></div>
            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="dg-unchecked"><label class="form-check-label" for="dg-unchecked">Unchecked</label></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="dg-on" checked><label class="form-check-label" for="dg-on">On</label></div>
            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" id="dg-off"><label class="form-check-label" for="dg-off">Off</label></div>
          </div>
          <div class="font-monospace small text-body-secondary">input 2.125rem tall · .825rem · border --bs-gray-400 · labels 700</div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Navigation crumbs and dropdown</h3>
        <div class="border rounded p-4 d-flex flex-column gap-4 flex-grow-1">
          <div class="nav-crumbs mb-0">
            <% crumb_items = [['<i class="bi bi-pencil"></i> Edit', '#components'], ['<i class="bi bi-people"></i> Members', '#components'], ['<i class="bi bi-ticket"></i> Orders', '#components']] %>
            <%= dropdown_nav crumb_items, button_text: 'Symbiota', container_class: 'btn-group mb-1' %>
            <%= dropdown_nav crumb_items, button_text: 'Breathwork', container_class: 'btn-group mb-1' %>
            <%= dropdown_nav crumb_items, button_text: 'London', container_class: 'btn-group mb-1 nav-crumbs-sibling' %>
          </div>
          <div class="dropdown-menu show position-relative align-self-start">
            <a class="dropdown-item" href="#components"><i class="bi bi-pencil"></i> Edit</a>
            <a class="dropdown-item" href="#components" style="background: var(--bs-dropdown-link-hover-bg)"><i class="bi bi-people"></i> Members</a>
            <a class="dropdown-item active" href="#components"><i class="bi bi-ticket"></i> Orders</a>
            <a class="dropdown-item" href="#components"><i class="bi bi-bar-chart"></i> Stats</a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Card with .chill header</h3>
        <div class="card shadow-sm">
          <h3 class="card-header chill">Your upcoming events</h3>
          <div class="card-body">
            <div class="d-flex gap-3 align-items-start mb-3">
              <span class="newsfeed-icon d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle"><i class="bi bi-ticket-detailed-fill"></i></span>
              <div><div class="mb-1"><b>Ecstatic dance</b> on Sat 4 Oct</div><div class="subtle small">2 hours ago</div></div>
            </div>
            <div class="d-flex gap-3 align-items-start mb-3">
              <span class="newsfeed-icon d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle"><i class="bi bi-person-fill-add"></i></span>
              <div><div class="mb-1"><b>Ruby</b> followed you</div><div class="subtle small">Yesterday</div></div>
            </div>
            <a href="#components">All events →</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <h3 class="m-0">Table and pagination</h3>
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Ticket type</th><th>Sold</th><th class="text-end">Price</th></tr>
          </thead>
          <tbody>
            <tr><td>Early bird</td><td>40/40</td><td class="text-end">£15</td></tr>
            <tr><td>Standard</td><td>23/80</td><td class="text-end">£22</td></tr>
            <tr><td>Solidarity</td><td>6/10</td><td class="text-end">£8</td></tr>
          </tbody>
        </table>
        <ul class="pagination justify-content-center mb-0">
          <li class="page-item disabled"><a class="page-link" href="#components">‹</a></li>
          <li class="page-item active"><a class="page-link" href="#components">1</a></li>
          <li class="page-item"><a class="page-link" href="#components">2</a></li>
          <li class="page-item"><a class="page-link" href="#components">3</a></li>
          <li class="page-item"><a class="page-link" href="#components">›</a></li>
        </ul>
        <div class="font-monospace small text-body-secondary text-center">Active: grey border · Hover: light border</div>
      </div>
    </div>

    <div class="d-flex flex-column gap-3">
      <h3 class="m-0">AI well and ask box</h3>
      <div class="row g-4 align-items-start">
        <div class="col-lg-6">
          <div class="ai-well"><b>Suggested description</b><br>A gentle evening of breathwork and sound for all levels.</div>
        </div>
        <div class="col-lg-6">
          <div class="ask-box">
            <label class="visually-hidden" for="dg-ask">Ask a question</label>
            <textarea class="form-control autosize" id="dg-ask" rows="1" placeholder="Ask a question…"></textarea>
            <div class="ask-box-actions">
              <button type="button" class="btn btn-primary btn-sm" aria-label="Ask"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THEMING -->
  <section id="theming" class="d-flex flex-column gap-4" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">06</div>
      <h2 class="m-0">Theming</h2>
      <p class="m-0 text-body-secondary" style="max-width: 680px">Organisations and events set one colour. <code>theme_css_variables</code> sets <code>--theme-500</code>, app.css derives the ramp from it, and every primary button, link, focus ring, crumb, check and progress bar follows. Alerts and toasts use the ramp's tints with --theme-800 text on every page; on themed pages the AI well and calendar events also switch to the theme colour.</p>
    </div>
    <div class="row g-3">
      <div class="col-md-6 col-xxl-4">
        <div class="border rounded p-4 h-100 d-flex flex-column gap-3">
          <div class="font-monospace small text-body-secondary fw-bold">DEFAULT · <%== css_var.call('--theme-500') %></div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <a class="btn btn-primary" href="#theming">Book</a>
            <div class="nav-crumbs mb-0">
              <%= dropdown_nav [['Edit', '#theming']], button_text: 'Crumb' %>
            </div>
          </div>
          <div class="alert alert-primary mb-0">Saved. Text is --theme-800</div>
          <div class="ai-well">AI well: purple</div>
        </div>
      </div>
      <% themed_colors.each do |color, clamped| %>
        <div class="col-md-6 col-xxl-4">
          <div class="theme-scope border rounded p-4 h-100 d-flex flex-column gap-3" style="<%= theme_css_variables(clamped)[/\{(.*)\}/m, 1].squish %>">
            <div class="font-monospace small text-body-secondary fw-bold">THEMED · <%= color %><%= " → #{clamped} (clamped)" if clamped != color %></div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <a class="btn btn-primary" href="#theming">Book</a>
              <div class="nav-crumbs mb-0">
                <%= dropdown_nav [['Edit', '#theming']], button_text: 'Crumb' %>
              </div>
            </div>
            <div class="alert alert-primary mb-0">Saved. Text is --theme-800</div>
            <div class="p-3 rounded-3" style="background: linear-gradient(135deg, oklch(from var(--theme-500) l c h / .175) 0%, oklch(from var(--theme-500) l c h / .175) 50%, oklch(from var(--theme-500) l c h / .325) 100%)">AI well: theme tint</div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="small text-body-secondary">Each themed panel sets <code>--theme-500</code> from <code>theme_css_variables(clamp_color(colour))</code> on itself, as <code>/theme.css</code> does, and has the <code>theme-scope</code> class so the ramp is recomputed from it. Their AI wells copy theme.css's rule, which only loads on themed pages.</div>
  </section>

  <!-- ISSUES -->
  <section id="issues" class="d-flex flex-column gap-4" style="scroll-margin-top: 4rem">
    <div class="d-flex flex-column gap-1 border-top border-2 border-dark pt-3">
      <div class="font-monospace small text-body-secondary fw-bold">07</div>
      <h2 class="m-0">Inconsistencies</h2>
      <p class="m-0 text-body-secondary" style="max-width: 680px">Found while reading the stylesheets and layouts. Each has a suggested fix.</p>
    </div>

    <div>
      <% issues.each do |number, severity, title, body, fix, where| %>
        <div class="d-flex gap-3 py-3 border-top" id="i-<%= number %>" style="scroll-margin-top: 4rem">
          <div class="flex-shrink-0 d-flex flex-column gap-1 align-items-start" style="width: 3.5rem">
            <span class="<%= flag_class %>">I-<%= number %></span>
            <span class="fw-bold small <%= severity_classes[severity] %>"><%= severity %></span>
          </div>
          <div class="d-flex flex-column gap-1">
            <div class="fw-bold"><%= title %></div>
            <div><%= body %></div>
            <div style="color: var(--theme-800)"><b>Fix:</b> <%= fix %></div>
            <code class="font-monospace small text-body-secondary"><%= where %></code>
          </div>
        </div>
      <% end %>
    </div>
  </section>

</div>

<script>
  $(function () {
    // Custom properties come back as written (e.g. oklch(from ...)), so paint each one to resolve it to hex
    var ctx = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
    var probe = $('<span>').hide().appendTo('body')[0];
    $('[data-css-var]').each(function () {
      probe.style.color = 'var(' + $(this).attr('data-css-var') + ')';
      ctx.clearRect(0, 0, 1, 1);
      ctx.fillStyle = getComputedStyle(probe).color;
      ctx.fillRect(0, 0, 1, 1);
      var d = ctx.getImageData(0, 0, 1, 1).data;
      var hex = '#' + [0, 1, 2].map(function (i) { return d[i].toString(16).padStart(2, '0'); }).join('');
      $(this).text(d[3] < 255 ? hex + ' / ' + Math.round(d[3] / 2.55) + '%' : hex);
    });
    $('[data-spec-row]').each(function () {
      var px = parseFloat(getComputedStyle($(this).find('[data-sample]')[0]).fontSize);
      $(this).find('[data-px]').text(Math.round(px * 10) / 10 + 'px');
    });
  });
</script>
