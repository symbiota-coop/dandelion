            <label for="dg-location">Location <span class="fw-normal subtle">· focused</span></label>
            <input type="text" class="form-control" id="dg-location" autocomplete="off" placeholder="Search for a place" style="border-color: var(--theme-500); box-shadow: 0 0 0 var(--bs-focus-ring-width) var(--bs-focus-ring-color)">
            <div class="form-text">Form text is --bs-gray-600. Every focused control gets the same ring: --bs-focus-ring-width (2px) of --bs-focus-ring-color (the theme at 60%). Danger buttons ring in red, btn-signal in its blue, and colour swatches add a white gap. Nav links have none.</div>
          </div>
