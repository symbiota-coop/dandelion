          <% end %>
          <div class="spec">Inline, in the page. Padding .625rem, no border. Links bold and underlined in the alert's link colour. Flashes render as alerts only on pages that set @hide_alert.</div>
        </div>
      </div>

      <div class="col-lg-6 d-flex flex-column gap-3">
        <%== subhead.call('Toasts') %>
        <div class="d-flex flex-column align-items-start gap-2">
          <% flashes.each do |variant, message, _link| %>
            <div class="toast toast-<%= variant %> show w-auto">
              <div class="d-flex">
                <div class="toast-body"><%= message %></div>
                <button type="button" class="btn-close me-2 m-auto" aria-label="Close"></button>
              </div>
            </div>
          <% end %>
          <div class="spec">Flash messages, fixed at the top centre (_alert.erb). Same tint gradients as alerts, plus a 1px border in the text colour. Notices fade after 3s, errors and warnings after 6s.</div>
        </div>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 d-flex flex-column gap-3">
        <%== subhead.call('Forms') %>
