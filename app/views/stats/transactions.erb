<link rel="stylesheet" href="<%= cachebust('/stylesheets/traces.css') %>">

<h2>Transactions</h2>
<p class="text-body-secondary">Durations of the saved traces, by transaction (other than the /stats pages), most total time first.</p>

<%# A flex row rather than .form-inline, which stacks its fields on phones: this one is short enough to fit %>
<% form_tag '', method: 'get', class: 'submitOnChange d-flex flex-wrap align-items-center gap-2 mb-3' do %>
  <%= select_tag :percentile, options: %w[p50 p99 p100], selected: @percentile, class: 'form-select w-auto' %>
  <div class="d-flex align-items-center gap-1">
    <label for="min_s" class="mb-0">over</label>
    <%= number_field_tag :min_s, id: 'min_s', class: 'form-control', style: 'width: 4rem', value: @min_s.to_s.delete_suffix('.0'), step: 'any', min: 0, autocomplete: 'off' %>
    <label for="min_s" class="mb-0">seconds</label>
  </div>
  <%= submit_tag 'Filter', class: 'btn btn-primary' %>
<% end %>

<% if @summaries.empty? %>
  <p class="text-body-secondary">No transactions with a <%= @percentile %> over <%= @min_s.to_s.delete_suffix('.0') %> seconds</p>
<% else %>
  <% sections = { 'GET' => [], 'POST' => [], 'XHR' => [], 'Jobs' => [], 'Other HTTP' => [] } %>
  <% @summaries.each { |summary| sections[transaction_section(summary)] << summary } %>
  <% sections.each do |title, summaries| %>
    <% next if summaries.empty? %>
    <%= partial :'stats/transactions_table', locals: { title: title, summaries: summaries, link: true } %>
  <% end %>
<% end %>

<%# Every search, whatever the filter: searches are a part of a request, and rarely slow enough to pass it %>
<% if @search_summaries.any? %>
  <%= partial :'stats/transactions_table', locals: { title: 'Search', summaries: @search_summaries, link: false } %>
<% end %>

<script>
  $(function () {
    $('.transactions-table').DataTable({ paging: false, searching: false, info: false, autoWidth: false, order: [[4, 'desc']] })
  })
</script>
