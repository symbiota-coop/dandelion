<link rel="stylesheet" href="<%= cachebust('/stylesheets/traces.css') %>">

<h2>Traces</h2>
<p class="text-body-secondary">Transactions and their spans, saved by Sentry's <code>before_send_transaction</code>.</p>

<% form_tag '', method: 'get', class: 'submitOnChange searchForm form-inline mb-3' do %>
  <div class="form-group">
    <label>Transaction</label>
    <%= select_tag :name, options: [['All', '']] + Trace.distinct(:name).sort, selected: params[:name], class: 'form-select', id: 'trace-name' %>
  </div>
  <div class="form-group">
    <label>XHR</label>
    <%= select_tag :xhr, options: [['All', ''], ['Yes', '1'], ['No', '0']], selected: params[:xhr], class: 'form-select' %>
  </div>
  <div class="form-group">
    <label>At least (ms)</label>
    <%= number_field_tag :min_ms, class: 'form-control', value: params[:min_ms], autocomplete: 'off' %>
  </div>
  <%= hidden_field_tag :sort, value: @sort %>
  <%= hidden_field_tag :dir, value: @sort_dir %>
  <%= submit_tag 'Search', class: 'btn btn-primary' %>
<% end %>

<script>
  $(function () {
    $('#trace-name').select2({ theme: 'bootstrap-5', width: '20rem' })
    $('#traces-table').on('click', 'th[data-href]', function () { window.location = $(this).data('href') })
  })
</script>

<% if @traces.empty? %>
  <p class="text-body-secondary">No traces saved yet</p>
<% else %>
  <div class="table-responsive">
    <%# Sortable headers have DataTables' markup and classes, for its sort icons; clicking one reloads the page sorted by it %>
    <table id="traces-table" class="dataTable table table-hover">
      <thead>
        <tr>
          <% [[:time, 'Time', nil], [nil, 'Transaction', nil], [:duration, 'Duration', 'text-end'], [:spans, 'Spans', 'text-end d-none d-md-table-cell']].each do |key, title, th_class| %>
            <% if key %>
              <% sorted = @sort == key.to_s %>
              <th class="<%= th_class %> dt-orderable-asc dt-orderable-desc <%= "dt-ordering-#{@sort_dir}" if sorted %>" data-href="?<%= Rack::Utils.build_query(params.slice('name', 'xhr', 'min_ms').merge('sort' => key.to_s, 'dir' => sorted && @sort_dir == 'desc' ? 'asc' : 'desc')) %>">
                <div class="dt-column-header">
                  <div class="dt-column-title"><%= title %></div>
                  <div class="dt-column-order" role="button" tabindex="0"></div>
                </div>
              </th>
            <% else %>
              <th><%= title %></th>
            <% end %>
          <% end %>
          <th class="d-none d-md-table-cell">Commit</th>
        </tr>
      </thead>
      <tbody>
        <% @traces.each do |trace| %>
          <tr>
            <td class="text-nowrap"><%= trace.started_at.strftime('%b %d %H:%M:%S') %></td>
            <td>
              <a href="/stats/traces/<%= trace.id %>"><code><%= wrap_at_separators(trace.name) %></code></a>
              <% if trace.xhr %>
                <span class="badge text-bg-secondary ms-1">XHR</span>
              <% end %>
              <%= partial :'stats/trace_status', locals: { trace: trace } %>
            </td>
            <td class="text-end text-nowrap"><%= trace.duration_ms.round %> ms</td>
            <td class="text-end d-none d-md-table-cell"><%= trace.span_count %></td>
            <td class="d-none d-md-table-cell">
              <%= commit_link(trace.release) if trace.release %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= will_paginate @traces, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
<% end %>

<%# Every release but the oldest has traces before it to delete %>
<% if @releases.size > 1 %>
  <% form_tag '/stats/traces/delete_before', method: 'post', class: 'form-inline mt-5' do %>
    <div class="form-group">
      <label>Delete traces from commits before</label>
      <%= select_tag :release, options: @releases[0..-2].map { |release, time| ["#{release[0..6]} (#{time.strftime('%b %d %H:%M')})", release] }, class: 'form-select' %>
    </div>
    <%= submit_tag 'Delete', class: 'btn btn-danger', 'data-confirm' => 'Delete every trace saved by an earlier commit?' %>
  <% end %>
<% end %>
