<% if cells %>
  <% cells.each do |cell| %>
    <td>
      <% if cell == :check %>
        <i class="bi bi-check-lg"></i>
      <% elsif cell %>
        <code><%= cell %></code>
      <% end %>
    </td>
  <% end %>
<% else %>
  <% 3.times do %>
    <td><i class="bi bi-question-lg"></i></td>
  <% end %>
<% end %>
