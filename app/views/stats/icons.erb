<%
# Hash to store occurrences
bi_counts = Hash.new(0)

# Dir.glob skips hidden files. Only text files, as app/assets has videos and images that aren't valid UTF-8
Dir.glob('{app,models,lib}/**/*.{rb,erb,js,css,md,html}').each do |path|
  next if !File.file?(path) || path.include?('fonts')

  File.readlines(path).each do |line|
    # Find all matches of 'bi-*' and count them
    line.scan(/\bbi-[-\w]+/).each do |match|
      bi_counts[match] += 1
    end
  end
end

# Sort the hash by occurrence count
sorted_bi_counts = bi_counts.sort_by { |_key, value| -value }
%>

<script>
  $(function() {
    $('#icons').DataTable({
      paging: false,
      searching: false,
      info: false,
      order: [[0, 'asc']]
    });
  });
</script>
<table id="icons" class="table w-auto">
  <thead>
    <tr>
      <th>Pattern</th>
      <th>Icon</th>
      <th>Count</th>
    </tr>
  </thead>
  <% sorted_bi_counts.each do |key, value| %>
    <tr>
      <td class="align-middle"><%= key %></td>
      <td class="align-middle fs-2">
        <i class="bi <%= key %>"></i>
      </td>
      <td class="align-middle"><%= value %></td>
    </tr>
  <% end %>
</table>
