<div style="font-size: 120%">
  <h2 class="mb-3">Contact us</h2>
  <div class="row">
    <div class="col-12 col-lg-7">
      <p>
        Dandelion is a platform that hosts events and gatherings from many different organisations.
      </p>
      <p>
        <strong><mark>If your question relates to a specific event</mark></strong>, please contact the event organiser.<br>
        <strong><mark>If your question relates to a specific organisation</mark></strong>, please contact the organisation.<br>
        <strong><mark>For example, if your question relates to the Psychedelic Society</mark></strong>, please contact <a href="mailto:enquiries@psychedelicsociety.org.uk">enquiries@psychedelicsociety.org.uk</a><br>
      </p>
      <p>
        If you have a question related to the Dandelion platform itself (for example, you require technical assistance):
      </p>
      <h3>Explore our docs</h3>
      <p>
        We have <a href="/docs">searchable docs</a> covering events, organisations, gatherings and more.
      </p>
      <%= partial :'docs/support' %>

      <hr>

      <p class="contact-socials" style="font-size: 1.5rem">
        <% [
          ['https://bsky.app/profile/dandelion.events', 'bluesky', 'Bluesky'],
          ['https://www.youtube.com/@dandelion.events.321', 'youtube', 'YouTube'],
          ['https://open.spotify.com/show/3pHYC5Zgh8jTFBBfd69LN7', 'spotify', 'Spotify'],
          ['https://dandeliondotevents.substack.com/', 'substack', 'Substack'],
          ['https://www.instagram.com/dandelion.events_/', 'instagram', 'Instagram'],
          ['https://github.com/symbiota-coop/dandelion', 'github', 'Github']
        ].each do |url, icon, label| %>
          <a href="<%= url %>" target="_blank" class="mr-3" data-toggle="tooltip" title="<%= label %>" aria-label="<%= label %>">
            <i class="bi bi-<%= icon %>"></i>
          </a>
        <% end %>
      </p>
      <p>
        <a href="/terms">Read our terms and conditions</a>
        <br />
        <a href="/privacy">Read our privacy policy</a>
        <br />
        <a href="/cookies">Read our cookie policy</a>
        <br />
        <a href="javascript:;" class="cookie-consent-preferences">Cookie preferences</a>
      </p>

    </div>
    <div class="col-12 col-lg-5">
      <a target="_blank" href="https://symbiota.coop"><img class="w-100" src="/images/team.jpg"></a>
      <p style="font-size: 85%" class="mt-1">
        <em>
          Made with</em> 💗 <em>by <a href="https://symbiota.coop">Symbiota</a>, a not-for-profit worker co-op, in Totnes, Devon, UK and Stockholm, Sweden          
        </em>
        🇬🇧 🇸🇪      
      </p>
    </div>
  </div>

</div>
