<div id="cookie-consent" class="cookie-consent" style="display: none" role="dialog" aria-live="polite" aria-label="Cookie preferences" data-marketing-cookies='<%= AnalyticsProvider.expire_cookies_for(:marketing).to_json %>'>
  <div class="cookie-consent__copy">
    <h2>Cookies on Dandelion</h2>
    <p>Dandelion requires a few necessary cookies. We only use other cookies if you allow them.</p>
    <p>
      <a href="/cookies">Cookie policy</a>
      <span aria-hidden="true">&middot;</span>
      <a href="/privacy">Privacy policy</a>
    </p>
  </div>
  <div class="cookie-consent__settings" style="display: none">
    <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="cookie-consent-necessary" checked disabled><label class="form-check-label" for="cookie-consent-necessary">Necessary</label></div>
    <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="cookie-consent-analytics" data-cookie-choice="analytics"><label class="form-check-label" for="cookie-consent-analytics">Analytics</label></div>
    <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="cookie-consent-marketing" data-cookie-choice="marketing"><label class="form-check-label" for="cookie-consent-marketing">Marketing</label></div>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" class="btn btn-outline-primary" data-cookie-action="reject">Necessary only</button>
    <button type="button" class="btn btn-outline-primary" data-cookie-action="customize">Customise</button>
    <button type="button" class="btn btn-outline-primary" data-cookie-action="save">Save choices</button>
    <button type="button" class="btn btn-primary" data-cookie-action="accept">Accept all</button>
  </div>
</div>
