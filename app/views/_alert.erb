<% if !@hide_alert && (flash[:error] || flash[:warning] || flash[:notice]) %>
  <div class="toast-container flash-toasts position-fixed top-0 start-50 translate-middle-x p-3">
    <% { error: 'danger', warning: 'warning', notice: 'primary' }.each { |k,v| %>
      <% if flash[k] %>
        <div class="toast toast-<%= v %> fade show" role="<%= k == :notice ? 'status' : 'alert' %>" aria-live="<%= k == :notice ? 'polite' : 'assertive' %>" aria-atomic="true" data-bs-delay="<%= k == :notice ? 3000 : 6000 %>">
          <div class="d-flex">
            <div class="toast-body">
              <%== Sanitize.fragment(flash[k], Sanitize::Config::DANDELION) %>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      <% end %>
    <% } %>
  </div>
  <script>
    // Toasts are rendered already shown, as Bootstrap only loads after the other deferred scripts
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.flash-toasts .toast').forEach(function (el) {
        var toast = bootstrap.Toast.getOrCreateInstance(el)
        setTimeout(function () { toast.hide() }, el.dataset.bsDelay)
      })
    })
  </script>
<% end %>
