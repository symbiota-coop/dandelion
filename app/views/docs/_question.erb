<% if @sent %>
  <div class="alert alert-success">Thanks for your message. We'll get back to you as soon as possible.</div>
<% else %>
  <% form_tag '/docs/question' do %>
    <div class="ask-box">
      <label class="sr-only" for="question-textarea">How can we help?</label>
      <%= text_area_tag :question, id: 'question-textarea', class: 'form-control autosize', rows: 1, placeholder: 'How can we help?', required: true %>
      <div class="ask-box-actions">
        <button type="submit" class="btn btn-primary btn-sm" aria-label="Send">
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  <% end %>
<% end %>
