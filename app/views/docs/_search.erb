<label class="sr-only" for="<%= input_id %>">Search the docs</label>
<div class="doc-search">
  <i class="bi bi-search" aria-hidden="true"></i>
  <input
    id="<%= input_id %>"
    type="search"
    class="form-control<%= ' form-control-sm' if defined?(compact) && compact %> doc-search-input"
    placeholder="Search the docs"
    autocomplete="off"
    autocorrect="off"
    spellcheck="false"
    enterkeyhint="search"
  >
</div>
