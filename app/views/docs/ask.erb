<div class="docs-main docs-ask">
  <% if @question %>
    <h1><%= @question %></h1>

    <div
      id="deepwiki-answer"
      data-deepwiki-question="<%= @question %>"
      data-deepwiki-mcp="https://mcp.deepwiki.com/mcp"
    >
      <div class="docs-ask-status text-muted" role="status" aria-live="polite" aria-busy="true">
        <span class="sr-only">Finding an answer</span>
        <span class="docs-ask-status-word" aria-hidden="true">Thinking...</span>
      </div>
    </div>
    <noscript>
      <div class="alert alert-warning">
        JavaScript is needed to answer here.
        <a target="_blank" rel="noopener noreferrer" href="https://deepwiki.com/symbiota-coop/dandelion">Ask on DeepWiki</a>.
      </div>
    </noscript>

    <div class="docs-deepwiki-source d-none" id="deepwiki-source">
      <p>
        <a target="_blank" rel="noopener noreferrer" href="https://deepwiki.com/symbiota-coop/dandelion">
          View this answer on DeepWiki
        </a>
      </p>
      <hr>
    </div>

    <div class="d-none" id="deepwiki-ask">
      <p>
        Ask another question. Answers come from
        <a target="_blank" rel="noopener noreferrer" href="https://deepwiki.com/symbiota-coop/dandelion">our DeepWiki</a>.
      </p>
      <%= partial :'docs/deepwiki' %>
      <%= partial :'docs/support', locals: { skip_ai: true } %>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.2.6/purify.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/15.0.7/marked.min.js"></script>
    <script src="/javascripts/docs_ask.js?<%= @cachebuster %>"></script>
  <% else %>
    <%= partial :'docs/support' %>
  <% end %>
</div>
