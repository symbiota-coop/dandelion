<div class="docs-deepwiki mb-3">
  <% form_tag '/docs/deepwiki', class: 'no-trigger' do %>
    <% if @doc_page %>
      <%= hidden_field_tag :wiki, value: @doc_page[:slug] %>
    <% end %>
    <div class="ask-box">
      <label class="sr-only" for="deepwiki-question">Ask a question about Dandelion</label>
      <%= text_area_tag :q, id: 'deepwiki-question', class: 'form-control autosize', rows: 2, placeholder: 'How do I boost an event?', required: true %>
      <div class="ask-box-actions">
        <button type="submit" class="btn btn-primary btn-sm" aria-label="Ask a question about Dandelion">
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  <% end %>
</div>
