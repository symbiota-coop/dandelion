<div class="docs-deepwiki mb-3">
  <% form_tag '/docs/ask', method: :get, class: 'no-trigger' do %>
    <div class="ask-box">
      <label class="visually-hidden" for="deepwiki-question">Ask a question about Dandelion</label>
      <%= text_area_tag :q, id: 'deepwiki-question', class: 'form-control autosize', rows: 1, placeholder: 'How do I boost an event?', required: true, maxlength: 2000 %>
      <div class="ask-box-actions">
        <button type="submit" class="btn btn-primary btn-sm" aria-label="Ask a question about Dandelion">
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  <% end %>
</div>
<script>
  // Enter asks, Shift+Enter adds a line
  $('#deepwiki-question').on('keydown', function (e) {
    if (e.key !== 'Enter' || e.shiftKey) return
    e.preventDefault()
    if (!$.trim(this.value)) return
    $(this.form).submit()
  })
</script>
