<link rel="stylesheet" href="<%= cachebust('/stylesheets/docs.css') %>">
<script type="application/json" id="doc-search-index">
  <%== @doc_search_index.to_json %>
</script>

<div class="row" id="docs-layout">
  <div class="col-lg-3 d-none d-lg-block">
    <div class="me-lg-3" id="sticky-index">
      <%= partial :'docs/search', locals: { compact: true, input_id: 'doc-search-desktop' } %>
      <%= partial :'docs/select', locals: { compact: true } %>
      <%= partial :'docs/index' %>
    </div>
  </div>
  <div class="col-lg-9">
    <div class="docs-main">
      <div class="d-lg-none docs-header">
        <%= partial :'docs/select' %>
        <%= partial :'docs/search', locals: { input_id: 'doc-search-mobile' } %>
      </div>

      <div id="doc-search-results" class="doc-search-results"></div>

      <div id="doc-body">
        <h1 id="<%= @doc_page[:slug] %>"><%= @doc_page[:name] %></h1>
        <% if @doc_page[:headings].any? %>
          <details class="doc-toc-mobile d-lg-none">
            <summary>On this page</summary>
            <%= partial :'docs/index' %>
          </details>
        <% end %>
        <%== @doc_page[:html_body] %>
      </div>

      <div class="card mt-5 docs-question">
        <h2 class="card-header chill">Still need support?</h2>
        <div class="card-body">
          <%= partial :'docs/support' %>
        </div>
      </div>
    </div>
  </div>
</div>
<%= cdn_tag '@highlightjs/cdn-assets', 'styles/atom-one-dark.min.css' %>
<%= cdn_tag '@highlightjs/cdn-assets', 'highlight.min.js' %>
<script src="<%= cachebust('/javascripts/docs.js') %>"></script>
