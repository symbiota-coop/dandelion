<script type="application/json" id="doc-search-index"><%== @doc_search_index.to_json %></script>

<div class="row" id="docs-layout">
  <div class="col-lg-3 d-none d-lg-block">
    <div class="mr-lg-3" id="sticky-index">
      <%= partial :'docs/search', locals: { compact: true, input_id: 'doc-search-desktop' } %>
      <%= partial :'docs/select', locals: { compact: true } %>
      <%= partial :'docs/index' %>
    </div>
  </div>
  <div class="col-lg-9">
    <div class="docs-main">
      <div class="d-lg-none docs-header">
        <%= partial :'docs/search', locals: { input_id: 'doc-search-mobile' } %>
        <div class="docs-header-select">
          <%= partial :'docs/select' %>
        </div>
      </div>

      <div id="doc-search-results" class="doc-search-results"></div>

      <% if @doc_page[:headings].any? %>
        <details class="doc-toc-mobile d-lg-none">
          <summary>On this page</summary>
          <%= partial :'docs/index' %>
        </details>
      <% end %>

      <div id="doc-body">
        <h1 class="d-none d-lg-block" id="<%= @doc_page[:slug] %>"><%= @doc_page[:name] %></h1>
        <%== @doc_page[:html_body] %>
      </div>

      <% if current_account %>
        <div class="mt-4 docs-question" data-pagelet-url="/docs/question">
          <%= partial :'docs/question' %>
        </div>
      <% else %>
        <p class="lead mt-4 docs-question">
          Still need support? <a href="mailto:<%=ENV['CONTACT_EMAIL']%>">Get in touch via email</a>
        </p>
      <% end %>
    </div>
  </div>
</div>
<script src="/javascripts/docs.js?<%= @cachebuster %>"></script>
