<style>
  #content { padding-left: 0; padding-right: 0; padding-top: 0; }

  .features-section { padding-top: 3.5rem; padding-bottom: 3.5rem; }
  @media (min-width: 992px) { .features-section { padding-top: 5rem; padding-bottom: 5rem; } }

  .features-hero { padding-top: 0; }

  .features-gradient-text {
    background-size: 100% 100%;
  }


  .features-strapline-bottom {
  font-size: 4.7vw;
  line-height: 130%
  }

  @media (min-width: 768px) {
  .features-strapline-bottom {
    font-size: 4.2vw;
  }
  }

  @media (min-width: 992px) {
  .features-strapline-bottom {
    font-size: 2.9vw;
  }
  }

  .feature-card {
    background: var(--bs-white);
    border: 1px solid rgba(var(--bs-black-rgb), 0.08);
    border-radius: var(--bs-border-radius-xl);
    padding: 1.75rem;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--bs-box-shadow);
  }

  .feature-icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--bs-border-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }
  .feature-icon.yellow { background: oklch(from var(--color-amber) l c h / 0.15); color: var(--color-amber-dark); }
  .feature-icon.rose { background: oklch(from var(--color-rose) l c h / 0.12); color: var(--color-rose); }
  .feature-icon.magenta { background: oklch(from var(--color-magenta) l c h / 0.1); color: var(--color-magenta); }
  .feature-icon.purple { background: oklch(from var(--color-purple) l c h / 0.1); color: var(--color-purple); }

  .section-heading { font-size: var(--font-size-xl); font-weight: 700; margin-bottom: 0.5rem; }
  @media (min-width: 992px) { .section-heading { font-size: 2vw; } }
  .section-divider { width: 3rem; height: 3px; border-radius: var(--bs-border-radius-pill); margin-bottom: 1.5rem; }
  .section-divider.yellow { background: linear-gradient(90deg, var(--color-amber), var(--color-amber-light)); }
  .section-divider.rose { background: linear-gradient(90deg, var(--color-rose), var(--color-rose-light)); }
  .section-divider.magenta { background: linear-gradient(90deg, var(--color-magenta), var(--color-magenta-light)); }
  .section-divider.purple { background: linear-gradient(90deg, var(--color-purple), var(--color-violet)); }

  .events-section {
    background: linear-gradient(to bottom, var(--bs-white) 30%, var(--wash-amber));
  }

  .gatherings-section {
    background: linear-gradient(to bottom, var(--wash-amber), var(--wash-rose) 30%);
  }

  .orgs-section {
    background: linear-gradient(to bottom, var(--wash-rose), var(--wash-magenta) 30%);
  }

  .values-section {
    background: linear-gradient(to bottom, var(--wash-magenta), var(--wash-purple) 30%);
  }

  .cta-section {
    background:
      radial-gradient(ellipse at 15% 80%, oklch(from var(--color-purple) l c h / 0.5) 0%, transparent 50%),
      radial-gradient(ellipse at 85% 20%, oklch(from var(--color-magenta) l c h / 0.4) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 50%, oklch(from var(--color-violet) l c h / 0.3) 0%, transparent 60%),
      linear-gradient(to bottom, oklch(from var(--color-purple) calc(l + 0.08) c h), oklch(from var(--color-purple) calc(l + 0.03) c h) 30%, var(--color-purple) 60%, oklch(from var(--color-purple) calc(l - 0.05) c h) 100%);
    color: var(--bs-white);
  }
  .cta-section .btn-light:focus { color: var(--bs-body-color); }
  .cta-section .btn-outline-light:hover { background: var(--bs-white); color: var(--color-purple); }
</style>

<!-- Hero -->
<div class="gradient content-padding-x features-section features-hero text-lg-center">
  <div class="row justify-content-center mx-0 py-5">
    <div class="col-lg-9 col-xl-8">
      <p class="features-strapline strapline mb-3">The platform for <strong class="gradient-text features-gradient-text">events that matter</strong></p>
      <p class="readable mb-3">Run by a not-for-profit worker co-op.<br class="d-lg-none" />
        No platform fees.</p>
      <a class="btn btn-primary btn-lg" href="/events/new">List an event</a>
      <a class="btn btn-outline-primary btn-lg ms-1" href="/events">Explore events</a>
      <p class="readable mb-0 mt-3"><a href="/dandelion-vs-luma">Compare Dandelion vs Luma</a></p>
    </div>
  </div>
</div>

<!-- Events & Ticketing -->
<div class="features-section events-section content-padding-x">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-heading">Events &amp; Ticketing</h2>
      <div class="section-divider yellow mx-auto"></div>
      <p class="text-body-secondary">Everything you need to list, manage and sell tickets for your events.</p>
    </div>
    <div class="row">
      <% [
        ['bi-calendar-event', 'Event listings', 'Create beautiful event pages with images, descriptions, locations and all the details attendees need.'],
        ['bi-ticket-detailed', 'Flexible ticketing', 'Offer free, paid, donation-based or pay-what-you-feel tickets with capacity limits, waitlists and discount codes.'],
        ['bi-credit-card', 'Multiple payment options', 'Accept payments via Stripe, Mollie, PayPal, GoCardless, Open Collective or crypto.'],
        ['bi-qr-code-scan', 'Check-in scanner', 'Check people in with a mobile scanner. Share a check-in link with assistants without giving them full admin access.'],
        ['bi-star', 'Feedback & ratings', 'Collect post-event feedback with AI-powered summaries to build your reputation and improve future events.'],
        ['bi-people', 'Smart recommendations', 'Get personalised suggestions for events and people based on your attendance history and community connections.'],
      ].each do |icon, title, desc| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="feature-card">
            <div class="feature-icon yellow"><i class="bi <%= icon %>"></i></div>
            <h5><%= title %></h5>
            <p class="text-body-secondary mb-0"><%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Co-created Gatherings -->
<div class="features-section gatherings-section content-padding-x">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-heading">Co-created Gatherings</h2>
      <div class="section-divider rose mx-auto"></div>
      <p class="text-body-secondary">Tools for participatory events where everyone contributes.</p>
    </div>
    <div class="row">
      <% [
        ['bi-moon', 'Gathering spaces', 'Create dedicated spaces with open, application-based or invitation-only access modes.'],
        ['bi-calendar3', 'Timetables', 'Co-create unconference-style timetables that participants can contribute sessions to.'],
        ['bi-clock-history', 'Shift rotas', 'Organise volunteer shifts so the work of running your gathering is shared fairly.'],
        ['bi-people', 'Teams', 'Create channels to organise different aspects of the gathering, from logistics to programming.'],
        ['bi-wallet2', 'Choose & Pay', 'Set up contribution tiers so participants can choose their level and pay towards shared costs.'],
        ['bi-box-seam', 'Inventory & budget', 'Track shared resources, equipment and budgets transparently with all organisers.'],
      ].each do |icon, title, desc| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="feature-card">
            <div class="feature-icon rose"><i class="bi <%= icon %>"></i></div>
            <h5><%= title %></h5>
            <p class="text-body-secondary mb-0"><%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Organisations & Community -->
<div class="features-section orgs-section content-padding-x">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-heading">Organisations &amp; Community</h2>
      <div class="section-divider magenta mx-auto"></div>
      <p class="text-body-secondary">Grow your community and keep everyone in the loop.</p>
    </div>
    <div class="row">
      <% [
        ['bi-flag', 'Organisation profiles', 'Create a public profile for your organisation with events, members and a custom landing page.'],
        ['bi-collection', 'Activities', 'Bundle families of similar events together. Gate access with application forms to curate your audience.'],
        ['bi-map', 'Local groups', 'Tap into local community groups to reach attendees near your events.'],        
        ['bi-envelope-paper', 'Email campaigns', 'Send targeted emails to your attendees and community members directly from the platform.'],
        ['bi-graph-up', 'Analytics & stats', 'Track ticket sales, revenue, attendance and other key metrics at a glance.'],
        ['bi-code-square', 'Embeddable widgets', 'Embed event listings or ticket forms on your own website with auto-resizing iframes.'],
      ].each do |icon, title, desc| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="feature-card">
            <div class="feature-icon magenta"><i class="bi <%= icon %>"></i></div>
            <h5><%= title %></h5>
            <p class="text-body-secondary mb-0"><%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Values -->
<div class="features-section values-section content-padding-x">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-heading">Built on values, not venture capital</h2>
      <div class="section-divider purple mx-auto"></div>
    </div>
    <div class="row justify-content-center mb-5">
      <% [
        ['/images/gift.png', '339/385', 'No platform fees', 'We don\'t take a cut from ticket sales. You only pay the payment processor.'],
        ['/images/coop.png', '115/116', 'Run by a worker co-op', 'We\'re owned and run by the people who build and maintain the platform.'],
        ['/images/opendata.png', '570/569', 'Fair source & open data', 'Our code is fair source, and events are cross-posted to ATProto.'],
      ].each do |img, aspect, title, desc| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="feature-card text-center">
            <div class="mx-auto mb-3" style="width: 5rem;"><img src="<%= img %>" class="w-100" style="aspect-ratio: <%= aspect %>;"></div>
            <h5><%= title %></h5>
            <p class="text-body-secondary mb-0"><%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="features-section cta-section content-padding-x text-lg-center pb-3">
  <div class="row justify-content-center mx-0">
    <div class="col-lg-9 col-xl-8">
      <p class="features-strapline-bottom strapline mb-3">What will you bring people together for?</p>
      <p class="readable mb-4" style="opacity: 0.9;">Join a growing community of organisers creating soulful, participatory and regenerative events.</p>
      <a class="btn btn-light btn-lg" href="/events/new">List an event</a>
      <a class="btn btn-outline-light btn-lg ms-1" href="/events">Explore events</a>
      <div class="ratio ratio-16x9 mt-4 mb-3">
        <iframe src="https://player.vimeo.com/video/1030013082?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write" title="How to create an event on Dandelion" allowfullscreen="">
        </iframe>
      </div>
      <script src="https://player.vimeo.com/api/player.js"></script>
    </div>
  </div>
</div>
