<%# A notification's icon, sentence and time, shared by the newsfeed and the notifications dropdown.
    full: the newsfeed's version, which links the sentence and adds badges, ratings and the comment or feedback itself.
    The dropdown leaves these out, since its whole row is already a link. %>
<% full_view = defined?(full) && full %>
<% show_circle = !defined?(include_circle_name) || include_circle_name %>
<span class="newsfeed-icon"><i class="bi <%= notification.icon %>"></i></span>
<div class="notification-info flex-grow-1">
  <div class="notification-title">
    <% if full_view %><a class="text-dark" href="<%= notification.link[1] %>"><% end %>
    <%= notification.sentence %>
    <% if show_circle && notification.circle.is_a?(Gathering) %>
      in <strong><%= notification.circle.name %></strong>
    <% end %>
    <% if full_view %></a><% end %>
    <% if notification.type.to_sym == :applied; mapplication = notification.notifiable %>
      <span class="float-end badge text-bg-<%= mapplication.label %>"><%= mapplication.status.capitalize %></span>
    <% end %>
    <% if full_view && notification.type.to_sym == :left_feedback && (event_feedback = notification.notifiable).event %>
      <a href="/e/<%= event_feedback.event.slug %>" class="float-md-end">
        <br class="d-md-none">
        <% if event_feedback.rating %>
          <% event_feedback.rating.times do %><i class="bi bi-star-fill"></i><% end %>
        <% end %>
      </a>
    <% end %>
  </div>
  <div class="notification-time text-body-secondary"><%= timeago(notification.created_at) %></div>
  <% if full_view %>
    <% if notification.type == 'commented'; comment = notification.notifiable %>
      <div class="d-flex align-items-start ms-2 my-2">
        <%= partial :'accounts/square', locals: { account: comment.account, style: 'display: block; width: 32px' } %>
        <div class="flex-grow-1 ms-2">
          <%= partial :'comments/body', locals: { comment: comment } %>
          <div data-pagelet-url="/comments/<%= comment.id %>/reactions" class="mt-3">
            <%= partial :'comments/comment_reactions', locals: { comment: comment } %>
          </div>
        </div>
      </div>
    <% elsif notification.type == 'left_feedback'; event_feedback = notification.notifiable %>
      <%= partial :'event_feedbacks/event_feedback', locals: { event_feedback: event_feedback, mt_class: 'mt-3', mb_class: 'mb-0' } %>
    <% end %>
  <% end %>
</div>
