<script>
  $(function () {

    // Only when the sidebar is minified
    $('#sidebar ul.nav li a[data-bs-toggle="tooltip"]').tooltip($('#page-container').hasClass('page-sidebar-minified') ? 'enable' : 'disable')

    if ($(window).width() < 992)
      $('#sidebar ul.nav li a[data-bs-toggle="tooltip"]').tooltip('disable')
  })
</script>
<ul class="nav nav-pills flex-column">
  <% if current_account %>
    <li class="nav-item has-sub d-md-none">
      <a class="nav-link d-flex align-items-center gap-2" href="#sidebar-account" data-bs-toggle="collapse" role="button" aria-expanded="false">
        <i class="bi bi-person-fill"></i>
        <span class="flex-grow-1"><%= current_account.name %></span>
        <i class="bi bi-chevron-down caret"></i>
      </a>
      <%= partial :nav_profile, locals: { ul_class: 'sub-menu list-unstyled collapse', ul_id: 'sidebar-account' } %>
    </li>
  <% end %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/' %>" href="/" data-bs-toggle="tooltip" title="Home" data-bs-placement="right">
      <i class="bi bi-house"></i>
      <span>Home</span>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/daily' %>" href="/daily" data-bs-toggle="tooltip" title="Dandelion Daily" data-bs-placement="right">
      <i class="bi bi-newspaper"></i>
      <span>Dandelion Daily</span>
    </a>
  </li>
  <% if !current_account %>
    <li class="nav-item d-lg-none">
      <a class="nav-link d-flex align-items-center gap-2" href="/accounts/new" data-bs-toggle="tooltip" title="Sign up" data-bs-placement="right">
        <i class="bi bi-person-fill-add"></i>
        <span>Sign up</span>
      </a>
    </li>
    <li class="nav-item d-lg-none">
      <a class="nav-link d-flex align-items-center gap-2" href="/accounts/sign_in" data-bs-toggle="tooltip" title="Sign in" data-bs-placement="right">
        <i class="bi bi-box-arrow-in-right"></i>
        <span>Sign in</span>
      </a>
    </li>
  <% end %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if ['/events', '/e/'].any? { |path| request.path.starts_with?(path) } %>" href="/events" data-bs-toggle="tooltip" title="Events" data-bs-placement="right">
      <i class="bi bi-calendar-event"></i>
      <span>Events</span>
    </a>
  </li>
  <% if !current_account || current_account.organisationships.count > 20 %>
    <li class="nav-item">
      <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/organisations' %>" href="/organisations" data-bs-toggle="tooltip" title="Organisations" data-bs-placement="right">
        <i class="bi bi-flag-fill"></i>
        <span>Organisations</span>
      </a>
    </li>
  <% else %>
    <% active = ['/organisations', '/o/'].any? { |path| request.path.starts_with?(path) } %>
    <li class="nav-item has-sub">
      <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if active %>" href="#sidebar-organisations" data-bs-toggle="collapse" role="button" aria-expanded="<%= active %>">
        <i class="bi bi-flag-fill"></i>
        <span class="flex-grow-1">Organisations</span>
        <i class="bi bi-chevron-down caret"></i>
      </a>
      <%= ul_nav ([
            ['Create an organisation', '/o/new'],
            ['All organisations', '/organisations']
          ] +
        Organisation.and(:id.in => current_account.organisationships.pluck(:organisation_id) + (@organisation && @organisation.persisted? ? [@organisation.id] : [])).sort_by(&:name).map { |organisation| [organisation.name, "/o/#{organisation.slug}"] }
                 ),
                 ul_class: "sub-menu list-unstyled collapse #{'show' if active}",
                 ul_id: 'sidebar-organisations',
                 li_class: '',
                 li_active_class: 'active',
                 a_class: '',
                 a_active_class: '' %>
    </li>
  <% end %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/facilitators' %>" href="/facilitators" data-bs-toggle="tooltip" title="Facilitators" data-bs-placement="right">
      <i class="bi bi-person-circle"></i>
      <span>Facilitators</span>
    </a>
  </li>
  <% if !current_account %>
    <li class="nav-item">
      <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if ['/gatherings', '/g/'].any? { |path| request.path.starts_with?(path) } %>" href="/gatherings" data-bs-toggle="tooltip" title="Gatherings" data-bs-placement="right">
        <i class="bi bi-moon-fill"></i>
        <span>Gatherings</span>
      </a>
    </li>
  <% else %>
    <% active = ['/gatherings', '/g/'].any? { |path| request.path.starts_with?(path) } %>
    <li class="nav-item has-sub">
      <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if active %>" href="#sidebar-gatherings" data-bs-toggle="collapse" role="button" aria-expanded="<%= active %>">
        <i class="bi bi-moon-fill"></i>
        <span class="flex-grow-1">Gatherings</span>
        <i class="bi bi-chevron-down caret"></i>
      </a>
      <%= ul_nav ([
            ['Create a gathering', '/g/new'],
            ['All gatherings', '/gatherings']
          ] +
        current_account.memberships.includes(:gathering).select { |membership| membership.gathering == @gathering or !membership.hide_from_sidebar }.sort_by { |membership| membership.gathering.name }.map { |membership| [membership.gathering.name, "/g/#{membership.gathering.slug}"] }),
                 ul_class: "sub-menu list-unstyled collapse #{'show' if active}",
                 ul_id: 'sidebar-gatherings',
                 li_class: '',
                 li_active_class: 'active',
                 a_class: '',
                 a_active_class: '' %>
    </li>
  <% end %>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/books' || request.path == '/films' %>" href="/books" data-bs-toggle="tooltip" title="Library" data-bs-placement="right">
      <i class="bi bi-book"></i>
      <span>Library</span>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path.starts_with?('/docs') %>" href="/docs" data-bs-toggle="tooltip" title="How to use Dandelion" data-bs-placement="right">
      <i class="bi bi-question-circle-fill"></i>
      <span>How to use Dandelion</span>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/contact' %>" href="/contact" data-bs-toggle="tooltip" title="Contact us" data-bs-placement="right">
      <i class="bi bi-envelope-fill"></i>
      <span>Contact us</span>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/code' %>" href="/code" data-bs-toggle="tooltip" title="Updates" data-bs-placement="right">
      <i class="bi bi-code-slash"></i>
      <span>Updates</span>
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link d-flex align-items-center gap-2 <%= 'active' if request.path == '/donate' %>" href="/donate" data-bs-toggle="tooltip" title="Donate" data-bs-placement="right">
      <i class="bi bi-cash-coin"></i>
      <span>Donate</span>
    </a>
  </li>
  <% if admin? %>
    <%= partial :'stats/nav' %>
  <% end %>
</ul>
