<link rel="stylesheet" href="<%= cachebust('/stylesheets/daily.css') %>">
<div class="newspaper">
  <h1 class="newspaper-title">The Dandelion Daily</h1>
  <div class="date-navigation">
    <a href="/daily?date=<%= (@date - 1).strftime('%Y-%m-%d') %>" class="nav-arrow">
      <i class="bi bi-arrow-left"></i>
    </a>
    <span><%= @date.strftime("%A, %B %-d, %Y") %></span>
    <% if @date < Date.today %>
      <a href="/daily?date=<%= (@date + 1).strftime('%Y-%m-%d') %>" class="nav-arrow">
        <i class="bi bi-arrow-right"></i>
      </a>
    <% else %>
      <span class="nav-arrow disabled">
        <i class="bi bi-arrow-right"></i>
      </span>
    <% end %>
  </div>

  <% if @edition %>
    <%= partial :daily %>
  <% elsif @date >= Date.today %>
    <p class="text-body-secondary">This edition isn't out yet, check back soon</p>
  <% else %>
    <p class="text-body-secondary">This edition isn't available</p>
  <% end %>
</div>
