<div class="newspaper">
  <h1 class="newspaper-title">The Dandelion Daily</h1>
  <div class="date-navigation">
    <a href="/daily?date=<%= (@date - 1).strftime('%Y-%m-%d') %>" class="nav-arrow">
      <i class="bi bi-arrow-left"></i>
    </a>
    <span><%= @date.strftime("%A, %B %-d, %Y") %></span>
    <% if @date < Date.today %>
      <a href="/daily?date=<%= (@date + 1).strftime('%Y-%m-%d') %>" class="nav-arrow">
        <i class="bi bi-arrow-right"></i>
      </a>
    <% else %>
      <span class="nav-arrow disabled">
        <i class="bi bi-arrow-right"></i>
      </span>
    <% end %>
  </div>

  <div data-with-placeholder data-pagelet-url="/daily?date=<%= @date.strftime('%Y-%m-%d') %>">
    <% 
      headers = File.read(Padrino.root('app', 'views', '_daily.erb'))
                   .scan(/render_article\("([^"]+)"/).flatten
    %>

    <% headers.each do |header| %>
      <div class="article">
        <h2 class="article-title"><%= header %></h2>
        <div class="article-content placeholder-glow">
          <% 10.times do %>
            <span class="placeholder d-block mb-3" style="width: <%= rand(10..90) %>%"></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
  .newspaper {
    max-width: 1140px; /* the xl container width, in px like the containers */
    margin: 0 auto;
  }

  .newspaper-title {
    font-family: "UnifrakturMaguntia", "Times New Roman", Times, serif;
    text-align: center;
    font-size: min(3rem, 9vw);
    margin-bottom: var(--space-xs);
    letter-spacing: 0.125rem;
    white-space: nowrap;
  }

  .date-navigation {
    text-align: center;
    border-top: double 0.25rem var(--bs-black);
    border-bottom: 1px solid var(--bs-black);
    margin-bottom: var(--space-base);
    padding: var(--space-xs) 0;
  }

  .nav-arrow {
    color: var(--bs-body-color);
    padding: 0 var(--space-xs);
    text-decoration: none;
  }

  .nav-arrow:hover {
    color: var(--bs-gray-600);
    text-decoration: none;
  }

  .nav-arrow.disabled {
    color: var(--bs-gray-400);
    cursor: not-allowed;
  }

  .article {
    column-count: 2;
    column-gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .article.single-column {
    column-count: 1 !important;
  }

  @media (max-width: 767.98px) {
    .article {
      column-count: 1;
    }
  }

  .article-title {
    column-span: all;
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-base);
  }

  .article-content {
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--bs-body-color);
  }

  @media (min-width: 768px) {
    .article-content {
      text-align: justify;
    }
  }

  .facilitator-info .bi.bi-star-fill {
    display: none;
  }

  .average-rating {
    font-size: var(--font-size-lg);
  }
</style>