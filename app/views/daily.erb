<link rel="stylesheet" href="<%= cachebust('/stylesheets/daily.css') %>">
<div class="newspaper">
  <header class="newspaper-masthead">
    <%# A location edition's title links to the main Daily for the date %>
    <% date = @date.strftime('%Y-%m-%d') %>
    <h1 class="newspaper-title">
      <% if @location %>
        <a href="/daily<%= "?date=#{date}" if Daily.edition(@date) %>">The Dandelion Daily</a>
      <% else %>
        The Dandelion Daily
      <% end %>
    </h1>
    <%# Under the title, the location editions out on the date, this one unlinked, or with none, the motto %>
    <% locations = Daily.locations_with_edition(@date) %>
    <% locations << @location if @location && !locations.include?(@location) %>
    <% if locations.any? %>
      <nav class="newspaper-motto newspaper-editions">
        Editions:
        <% locations.each_with_index do |location, index| %>
          <%= '·' if index.positive? %>
          <% if location == @location %>
            <span class="newspaper-edition-current"><%= location.name %></span>
          <% else %>
            <a href="/locations/<%= location.name %>/daily?date=<%= date %>"><%= location.name %></a>
          <% end %>
        <% end %>
      </nav>
    <% else %>
      <p class="newspaper-motto">Printed by a co-op, given as a gift</p>
    <% end %>
    <div class="newspaper-dateline">
      <span class="newspaper-dateline-side">
        <% if @edition && !@location && (number = Daily.number(@date)) %>
          No. <%= number %>
        <% end %>
      </span>
      <span class="newspaper-dateline-date">
        <% if (previous_date = Daily.previous_date(@date, location: @location)) %>
          <a href="<%= @daily_path %>?date=<%= previous_date.strftime('%Y-%m-%d') %>" class="nav-arrow" title="Previous edition" data-bs-toggle="tooltip">
            <i class="bi bi-arrow-left"></i>
          </a>
        <% else %>
          <span class="nav-arrow disabled">
            <i class="bi bi-arrow-left"></i>
          </span>
        <% end %>
        <span><%= @date.strftime('%A, %B %-d, %Y') %></span>
        <% if (next_date = Daily.next_date(@date, location: @location)) %>
          <a href="<%= @daily_path %>?date=<%= next_date.strftime('%Y-%m-%d') %>" class="nav-arrow" title="Next edition" data-bs-toggle="tooltip">
            <i class="bi bi-arrow-right"></i>
          </a>
        <% else %>
          <span class="nav-arrow disabled">
            <i class="bi bi-arrow-right"></i>
          </span>
        <% end %>
      </span>
      <span class="newspaper-dateline-side text-end">Price: free</span>
    </div>
  </header>

  <% if @edition %>
    <%= partial :daily %>
  <% else %>
    <% out_soon = @date >= Date.today %>
    <div class="empty-notice">
      <div class="empty-notice-icon">
        <i class="bi <%= out_soon ? 'bi-printer' : 'bi-newspaper' %>"></i>
      </div>
      <h2 class="empty-notice-title"><%= out_soon ? 'Still at the printers' : 'Not available' %></h2>
      <p class="text-body-secondary">
        <% if out_soon %>
          <% if @location %>
            This edition of the Daily isn't out yet. <%= @location.name %> gets one on days with news, so check back soon!
          <% else %>
            This edition of the Daily isn't out yet. Check back soon!
          <% end %>
        <% else %>
          There's no Daily for this day.
        <% end %>
      </p>
      <% if Daily.latest_date(location: @location) %>
        <a class="btn btn-outline-primary" href="<%= @daily_path %>">Read the latest Daily</a>
      <% end %>
    </div>
  <% end %>
</div>
