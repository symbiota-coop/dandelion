<link rel="stylesheet" href="<%= cachebust('/stylesheets/daily.css') %>">
<div class="newspaper">
  <h1 class="newspaper-title">The Dandelion Daily</h1>
  <div class="date-navigation">
    <a href="/daily?date=<%= (@date - 1).strftime('%Y-%m-%d') %>" class="nav-arrow">
      <i class="bi bi-arrow-left"></i>
    </a>
    <span><%= @date.strftime("%A, %B %-d, %Y") %></span>
    <% if @date < Date.today %>
      <a href="/daily?date=<%= (@date + 1).strftime('%Y-%m-%d') %>" class="nav-arrow">
        <i class="bi bi-arrow-right"></i>
      </a>
    <% else %>
      <span class="nav-arrow disabled">
        <i class="bi bi-arrow-right"></i>
      </span>
    <% end %>
  </div>

  <% if @edition %>
    <%= partial :daily %>
  <% else %>
    <% out_soon = @date >= Date.today %>
    <div class="daily-notice">
      <div class="daily-notice-icon">
        <i class="bi <%= out_soon ? 'bi-printer' : 'bi-newspaper' %>"></i>
      </div>
      <h2 class="daily-notice-title"><%= out_soon ? 'Still at the printers' : 'Not available' %></h2>
      <p class="text-body-secondary">
        <% if out_soon %>
          This edition of the Daily isn't out yet. Check back soon!
        <% else %>
          There's no Daily for this day.
        <% end %>
      </p>
      <% if Daily.latest_date %>
        <a class="btn btn-outline-primary" href="/daily">Read the latest Daily</a>
      <% end %>
    </div>
  <% end %>
</div>
