<link rel="stylesheet" href="<%= cachebust('/stylesheets/daily.css') %>">
<div class="newspaper">
  <header class="newspaper-masthead">
    <h1 class="newspaper-title">The Dandelion Daily</h1>
    <p class="newspaper-motto">Printed by a co-op, given as a gift</p>
    <div class="newspaper-dateline">
      <span class="newspaper-dateline-side">
        <% if @edition %>
          No. <%= Daily.number(@date) %>
        <% end %>
      </span>
      <span class="newspaper-dateline-date">
        <% if (previous_date = Daily.previous_date(@date)) %>
          <a href="/daily?date=<%= previous_date.strftime('%Y-%m-%d') %>" class="nav-arrow" title="Previous edition" data-bs-toggle="tooltip">
            <i class="bi bi-arrow-left"></i>
          </a>
        <% else %>
          <span class="nav-arrow disabled">
            <i class="bi bi-arrow-left"></i>
          </span>
        <% end %>
        <span><%= @date.strftime('%A, %B %-d, %Y') %></span>
        <% if (next_date = Daily.next_date(@date)) %>
          <a href="/daily?date=<%= next_date.strftime('%Y-%m-%d') %>" class="nav-arrow" title="Next edition" data-bs-toggle="tooltip">
            <i class="bi bi-arrow-right"></i>
          </a>
        <% else %>
          <span class="nav-arrow disabled">
            <i class="bi bi-arrow-right"></i>
          </span>
        <% end %>
      </span>
      <span class="newspaper-dateline-side text-end">Price: free</span>
    </div>
  </header>

  <% if @edition %>
    <%= partial :daily %>
  <% else %>
    <% out_soon = @date >= Date.today %>
    <div class="empty-notice">
      <div class="empty-notice-icon">
        <i class="bi <%= out_soon ? 'bi-printer' : 'bi-newspaper' %>"></i>
      </div>
      <h2 class="empty-notice-title"><%= out_soon ? 'Still at the printers' : 'Not available' %></h2>
      <p class="text-body-secondary">
        <% if out_soon %>
          This edition of the Daily isn't out yet. Check back soon!
        <% else %>
          There's no Daily for this day.
        <% end %>
      </p>
      <% if Daily.latest_date %>
        <a class="btn btn-outline-primary" href="/daily">Read the latest Daily</a>
      <% end %>
    </div>
  <% end %>
</div>
