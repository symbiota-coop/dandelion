<script type="text/plain" data-cookie-category="marketing">
  !function (f, b, e, v, n, t, s)
  {
    if (f.fbq)
      return;
    n = f.fbq = function () {
      n.callMethod ?
              n.callMethod.apply(n, arguments) : n.queue.push(arguments)
    };
    if (!f._fbq)
      f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = '2.0';
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s)
  }(window, document, 'script',
          'https://connect.facebook.net/en_US/fbevents.js');
  <%== facebook_pixel_ids.to_json %>.forEach(function (pixelId) {
    fbq('init', pixelId);
  });

  fbq('track', 'PageView');

  (function (viewContent) {
    if (viewContent) fbq('track', 'ViewContent', viewContent);
  })(<%== (facebook_pixel_view_content_params if @event && !track_purchase?).to_json %>);

  (function (purchase) {
    if (!purchase) return;
    var orderId = purchase.order_id;
    var storageKey = 'fbq_purchase_' + orderId;
    try {
      if (window.sessionStorage && sessionStorage.getItem(storageKey)) return;
      if (window.sessionStorage) sessionStorage.setItem(storageKey, '1');
    } catch (e) {}
    fbq('track', 'Purchase', purchase.params, {eventID: orderId});
  })(<%== ({ order_id: purchase_analytics[:order_id], params: facebook_pixel_purchase_params } if track_purchase?).to_json %>);
</script>
