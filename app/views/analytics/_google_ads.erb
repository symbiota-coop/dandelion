<% conversions = google_ads_conversions %>
<% if (first = conversions.first) %>
<% first_id = first[:id] %>
<script type="text/plain" data-cookie-category="marketing" async src="https://www.googletagmanager.com/gtag/js?id=AW-<%= first_id %>"></script>
<% gtag_purchase = if track_purchase?
                     user_data = google_ads_user_data if google_ads_enhanced_conversions?
                     {
                       order_id: purchase_analytics[:order_id],
                       user_data: (user_data if user_data&.any?),
                       params: google_ads_purchase_params,
                       send_to: conversions.select { |conversion| conversion[:label] }.map { |conversion| "AW-#{conversion[:id]}/#{conversion[:label]}" }
                     }
                   end %>
<script type="text/plain" data-cookie-category="marketing">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  <%== conversions.map { |conversion| { id: "AW-#{conversion[:id]}", enhanced: conversion[:enhanced] ? true : false } }.to_json %>.forEach(function (config) {
    if (config.enhanced) {
      gtag('config', config.id, {allow_enhanced_conversions: true});
    } else {
      gtag('config', config.id);
    }
  });

  (function (purchase) {
    if (!purchase) return;
    var orderId = purchase.order_id;
    var storageKey = 'gtag_purchase_' + orderId;
    try {
      if (window.sessionStorage && sessionStorage.getItem(storageKey)) return;
      if (window.sessionStorage) sessionStorage.setItem(storageKey, '1');
    } catch (e) {}
    if (purchase.user_data) gtag('set', 'user_data', purchase.user_data);
    purchase.send_to.forEach(function (sendTo) {
      gtag('event', 'conversion', Object.assign({}, purchase.params, {send_to: sendTo}));
    });
  })(<%== gtag_purchase.to_json %>);
</script>
<% end %>
