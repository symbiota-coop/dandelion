<style>
  /* Laid out by its own width (container queries), not the window's: a list with the icon beside the text when
     narrow (as on /donate), three centred columns when there's room */
  .principles-container { container-type: inline-size; }
  .principles { display: grid; gap: var(--space-lg); }
  .principle { display: flex; align-items: center; gap: var(--space-base); }
  .principle-icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    background: var(--bs-white);
    border: 1px solid var(--hairline);
    box-shadow: var(--bs-box-shadow-sm);
  }
  .principle-icon img { width: 100%; height: 100%; padding: var(--space-sm); object-fit: contain; }
  .principle p { margin-bottom: 0; text-wrap: balance; }
  /* Line breaks for the centred columns only: in the list the text runs on beside the icon */
  .principle-break { display: none; }
  @container (min-width: 36rem) {
    .principles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .principle { flex-direction: column; text-align: center; }
    .principle-break { display: inline; }
  }
  /* columns: true keeps the three columns however narrow (as in the donation modal), the circles shrinking to fit */
  .principles-columns .principles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-base); }
  .principles-columns .principle { flex-direction: column; text-align: center; }
  .principles-columns .principle p { font-size: var(--font-size-xs); }
  .principles-columns .principle-icon { width: 100%; max-width: 7rem; height: auto; aspect-ratio: 1; }
</style>

<div class="principles-container<% if defined?(columns) && columns %> principles-columns<% end %>">
  <div class="principles">
    <div class="principle">
      <div class="principle-icon"><img src="/images/gift-cycle.png" alt=""></div>
      <p>
        <a target="_blank" href="/docs/events#fees-and-payouts">No platform fees</a>:
        we seek to inspire a culture of gifting
      </p>
    </div>
    <div class="principle">
      <div class="principle-icon"><img src="/images/coop.png" alt="Co-operatives UK certified member"></div>
      <p>
        Run by a <a target="_blank" href="https://symbiota.coop/">not-for-profit<br class="principle-break">
          worker&nbsp;co-operative</a>
      </p>
    </div>
    <div class="principle">
      <div class="principle-icon"><img src="/images/opendata.png" alt=""></div>
      <p>
        <a target="_blank" href="https://github.com/symbiota-coop/dandelion">Fair&nbsp;source</a>
        and
        <a target="_blank" href="https://overreacted.io/open-social/">open&nbsp;data</a> on&nbsp;ATProto
      </p>
    </div>
  </div>
</div>
