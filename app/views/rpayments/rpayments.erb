<%= partial :'events/nav', locals: { event: @event } %>

<div class="mb-3">
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-payment"><i class="bi bi-plus-lg"></i> Add payment</button>
</div>
<%# Open as the page loads from an event's stats, whose link to a role's remaining amount fills in the form (?create=1) %>
<%= partial :form_modal, locals: { id: 'add-payment', title: 'Add payment', form: :'rpayments/build', open_on_load: params[:create] } %>

<table class="table">
  <thead>
    <tr>
      <th>Role</th>
      <th>Amount</th>
      <th>Notes</th>
      <th>Logged</th>
      <th></th>
    </tr>
  </thead>
    <% @rpayments.each { |rpayment| %>
    <tr>
      <td><%= rpayment.role.gsub('_',' ') %></td>
      <td><%= m rpayment.amount, rpayment.currency %></td>
      <td>
        <% if rpayment.notes %>
          <%== Sanitize.fragment(rpayment.notes.gsub("\n",'<br />'), Sanitize::Config::DANDELION) %>
        <% end %>
      </td>
      <td><%= rpayment.created_at %><% if rpayment.account %> by <a href="/u/<%= rpayment.account.username %>"><%= rpayment.account.name %></a><% end %></td>
      <td>
        <a href="/e/<%= @event.slug %>/rpayments/<%= rpayment.id %>/edit" class="btn btn-primary"><i class="bi bi-pencil-fill"></i></a>
        <a data-method="post" href="/e/<%= @event.slug %>/rpayments/<%= rpayment.id %>/destroy" class="btn btn-danger"><i class="bi bi-x-lg"></i></a>
      </td>
    </tr>
    <% } %>
  </table>
