<% is_preview = defined?(preview) && preview %>

<% Questions.parse(questions).each { |field| %>
<% i = field[:index] %>
<% unless is_preview %>
  <%= hidden_field_tag "questions[#{i}]", value: field[:question] %>
<% end %>
<div class="mb-3 links-blank">
  <% case field[:type] %>
  <% when 'heading' %>
    <h4><%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %></h4>
  <% when 'info' %>
    <p><%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %></p>
  <% when 'select' %>
    <%# Select field: Question text <option1, option2, option3> or Question text <option1, option2, option3>* %>
    <div class="mb-3">
      <label><%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %></label>
      <%= select_tag "answers[#{i}]", options: [''] + field[:options], selected: (params[:answers][i.to_s] if params[:answers]), required: field[:required], class: 'form-select', disabled: is_preview %>
    </div>
  <% when 'checkboxes' %>
    <%# Multiple checkboxes: Question text [option1, option2, option3] or Question text [option1, option2, option3]* %>
    <div class="mb-3 checkbox-group-<%= i %>" data-required="<%= field[:required] %>">
      <label><%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %></label>
      <% field[:options].each_with_index do |option, index| %>
        <div class="form-check">
          <%= check_box_tag "answers[#{i}][#{index}]", value: option, id: "answers-#{i}-#{index}", class: "form-check-input checkbox-group-item-#{i}", checked: ((params[:answers] && params[:answers][i.to_s] && params[:answers][i.to_s][index.to_s] == 'true') if params[:answers]), disabled: is_preview %>
          <label class="form-check-label fw-bold" for="answers-<%= i %>-<%= index %>">
            <%== Sanitize.fragment(Rinku.auto_link(option), Sanitize::Config::DANDELION) %>
          </label>
        </div>
      <% end %>
    </div>
  <% when 'checkbox' %>
    <%# Checkbox: [Question text] %>
    <div class="form-check">
      <%= check_box_tag "answers[#{i}]", id: "answers-#{i}", class: 'form-check-input', checked: ((params[:answers][i.to_s] == 'true') if params[:answers]), 'data-required': field[:required], disabled: is_preview %>
      <label class="form-check-label fw-bold" for="answers-<%= i %>">
        <%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %>
      </label>
    </div>
  <% when 'date' %>
    <label><%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %></label>
    <%= date_field_tag "answers[#{i}]", required: field[:required], class: 'form-control', value: (params[:answers][i.to_s] if params[:answers]), disabled: is_preview %>
  <% else %>
    <label><%== Sanitize.fragment(Rinku.auto_link(field[:text]), Sanitize::Config::DANDELION) %></label>
    <div>
      <%= text_area_tag "answers[#{i}]", required: field[:required], class: 'autosize form-control', value: (params[:answers][i.to_s] if params[:answers]), disabled: is_preview %>
    </div>
  <% end %>
</div>
<% } %>
