<td>
  <%= partial :'accounts/account', locals: { account: (account = mapplication.account), show_email: (gathering_admin? || viewable?(account, :email)) } %>
</td>
<td>
  <a href="javascript:;" onclick="$('#modal .modal-content').load(<%= "/g/#{@gathering.slug}/mapplications/#{mapplication.id}".to_json %>, function () {
        $('#modal').modal('show')
      });">
    <%= mapplication.created_at %>
    <% if mapplication.comments.exists? %>
      &middot;
      <i class="bi bi-chat-left-text"></i> <%= mapplication.comments.count %>
    <% end %>
  </a>
</td>
<td>
  <% if mapplication.status == 'accepted' %>
    Accepted!
  <% else %>
    <%= partial :'mapplications/verdicts', locals: { mapplication: mapplication } %>
  <% end %>
</td>
<td>
  <% if mapplication.status != 'accepted' %>
    <% if mapplication.status == 'paused' %>
      Paused by <%= mapplication.processed_by.name %>
      <% if gathering_admin? %> &middot; <% end %>
    <% end %>
    <% if gathering_admin? %>
      <% if mapplication.acceptable? %>
        <a class="btn mb-1 btn-primary" data-method="post" href="/g/<%= @gathering.slug %>/mapplications/<%= mapplication.id %>/process?status=accepted">Accept</a>
      <% end %>
      <% if mapplication.status == 'paused' %>
        <a class="btn mb-1 btn-secondary" data-method="post" href="/g/<%= @gathering.slug %>/mapplications/<%= mapplication.id %>/process?status=pending">Unpause</a>
      <% else %>
        <a class="btn mb-1 btn-secondary" data-method="post" href="/g/<%= @gathering.slug %>/mapplications/<%= mapplication.id %>/process?status=paused">Pause</a>
      <% end %>
      <a data-method="post" class="btn mb-1 btn-danger" href="/g/<%= @gathering.slug %>/mapplications/<%= mapplication.id %>/destroy" data-confirm="Are you sure you want to delete this application?">Delete</a>
    <% end %>
  <% end %>
</td>
