<h4 class="mt-0"><a target="_parent" href="<%= private_session.path %>"><%= private_session.title %></a></h4>
<div class="mb-2">
  <%= partial :'private_sessions/badges', locals: { private_session: private_session, target: '_parent' } %>
</div>
<%# A bare <img>: accounts/square opens the profile in #modal, which the popup doesn't have %>
<p class="mb-0">
  <img class="avatar avatar-xs <%= private_session.account.avatar_class %>" alt="<%= private_session.account.name %>" src="<%= u private_session.account.image_thumb_or_gravatar_url %>">
  <%= private_session.account.name %>
</p>
