<%= cp :'locations/header', key: "/locations/#{@location.name}/header", locals: { location: @location, events: @events } %>

<% if @location.summary %>
  <div data-bs-toggle="tooltip" title="AI-generated summary ✨" class="readable">
    <%== md(@location.summary) %>
  </div>
<% end %>

<% if Daily.latest_date(location: @location) %>
  <a href="/locations/<%= @location.name %>/daily" class="btn btn-outline-primary mb-3"><i class="bi bi-newspaper"></i> Read the <%= @location.name %> Daily</a>
<% end %>

<% if @location.signal_group_link %>
  <a href="<%= @location.signal_group_link %>" target="_blank" class="btn btn-signal mb-3"><i class="bi bi-signal"></i> Join the Signal group</a>
<% end %>

<%= partial :'events/search_form', locals: { path: '/events' } %>

<div data-with-placeholder data-pagelet-url="/events?online=<%= 1 if @location.online? %>&near=<%= CGI.escape(@location.query) if @location.query %>">
  <%= partial :'events/blocks_placeholder' %>
</div>
