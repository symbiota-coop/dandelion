<% unless ENV['CREATE_VIDEO'] %>
  <%
  s = Ticket.home_page_stats
  currency = visitor_currency
  worth = Money.new(s[:worth_gbp_integer] * 100, 'GBP').exchange_to(currency)
  worth_integer = Float('%.3g' % worth).to_i
%>
  <script>
    $(function() {
      countUp('ticket-count', <%= s[:ticket_count] %>);
      countUp('worth-count', <%= worth_integer %>);
    })
  </script>
<% end %>
<img src="/images/tickets.png" style="height: 50px">
<span class="d-sm-none">
  <br />
</span>
<span id="ticket-count" style="text-decoration: underline"><%= ENV['CREATE_VIDEO'] ? '146,196' : s[:ticket_count] %></span> tickets
<span class="d-sm-none">
  <br />
</span>
worth
<%= ENV['CREATE_VIDEO'] ? '£' : money_symbol(currency) %><span id="worth-count" style="text-decoration: underline"><%= ENV['CREATE_VIDEO'] ? '5,330,000' : worth_integer %></span>+
sold
