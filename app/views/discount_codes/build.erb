<%= context_nav %>
<div class="container-fluid">
  <% form_for @discount_code, @discount_code.new_record? ? '/discount_codes/new' : "/discount_codes/#{@discount_code.id}/edit", multipart: true do |f| %>
    <%= context_id_field %>
    <%= f.text_block :code %>
    <%= f.text_block :description %>
    <%= f.number_block :maximum_uses, min: 1, step: 1, placeholder: 'Unlimited' %>
    <%= f.text_block :filter %>
    <%= f.percentage_block :percentage_discount %>

    <p>
      &mdash; or &mdash;
    </p>
    <%= f.currency_block :fixed_discount_amount, money_symbol: money_symbol(@discount_code.fixed_discount_currency) %>

    <script>
      $(function () {
        $('#discount_code_fixed_discount_currency').change(function() {
          $('.money-symbol').text($.currencySymbol($(this).val()))
        })
        $('#discount_code_fixed_discount_currency').change()
      })
    </script>
    <%= f.select_block :fixed_discount_currency %>
    <%= f.submit_block destroy_url: "/discount_codes/#{@discount_code.id}/destroy?#{@scope}" %>
  <% end %>
</div>
