<%= partial :'accounts/nav' %>
<div class="container">

  <p>To completely remove your account, type your email address (<%= @account.email %>) into the box below and click 'Delete account'.</p>
  <% form_tag '/accounts/destroy' do %>
    <div class="input-group d-inline-flex w-auto">
      <%= email_field_tag :email, class: 'form-control', 'aria-label': 'Email' %>
      <button type="submit" class="btn btn-danger">Delete account</button>
    </div>
  <% end %>

</div>