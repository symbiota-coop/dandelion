<a href="/u/<%= account.username %>">
  <%= partial :'accounts/square', locals: { account: account, klass: 'd-block', size: :xl } %>
</a>
<strong><%= account.name %></strong>
<% if defined?(membership) && membership.admin? %>
  <i data-bs-toggle="tooltip" title="Admin" class="bi bi-key-fill"></i>
<% end %>
<% if defined?(show_email) && show_email %>
  <div class="small">
    <%= account.email %>
  </div>
<% end %>
