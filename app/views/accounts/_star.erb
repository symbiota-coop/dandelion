<div class="d-block d-lg-inline-block w-100">
  <% if !follow.starred %>
    <a class="pagelet-trigger d-block d-lg-inline-block w-100 w-lg-auto mb-1 text-nowrap btn btn-outline-primary <%= btn_class if defined?(btn_class) %>" data-method="post" href="/follow/star/<%= follow.id %>"><i class="bi bi-star"></i> Star</a>
  <% else %>
    <a class="pagelet-trigger d-block d-lg-inline-block w-100 w-lg-auto mb-1 text-nowrap btn btn-primary <%= btn_class if defined?(btn_class) %>" data-method="post" href="/follow/unstar/<%= follow.id %>"><i class="bi bi-star-fill"></i> Starred</a>
  <% end %>
</div>
