<div class="row justify-content-center">
  <div class="col col-lg-6">
    <%= @hide_alert = true; partial :flash %>
    <div class="card" id="sign_in">
      <div class="card-header text-bg-primary">
        <h2 class="text-center my-0">Sign in</h2>
      </div>
      <div class="card-body">
        <div id="t1">
          <div class="row g-2 mb-3">
            <% if !Provider.all.empty? %>
              <% Provider.all.each { |provider| %>
                <% if provider.omniauth_name == 'atproto' %>
                  <div class="col-12 col-lg"><a class="btn btn-primary w-100" id="atproto-btn" href="javascript:;" onclick="$('#atproto-form').show().find('input[type=text]').focus();$(this).parent().hide()"><i class="<%= provider.icon %>"></i> <span class="visually-hidden">Sign in with </span><%= provider.display_name %></a></div>
                <% else %>
                  <div class="col-12 col-lg"><a class="btn btn-primary w-100" href="/auth/<%= provider.omniauth_name %>"><i class="<%= provider.icon %>"></i> <span class="visually-hidden">Sign in with </span><%= provider.display_name %></a></div>
                <% end %>
              <% } %>
            <% end %>
            <%= partial :'accounts/atproto_form', locals: { id: 'atproto-form', wrapper_class: 'col-12', form_class: 'd-flex justify-content-center', button_text: 'Sign in' } %>
          </div>

          <% form_tag '/auth/account/callback', class: 'mb-3' do %>
            <div class="mb-1">
              <label class="visually-hidden" for="email">Email</label>
              <%= email_field_tag :email, id: 'email', class: 'form-control', placeholder: 'Email' %>
            </div>
            <div class="mb-3">
              <label class="visually-hidden" for="password">Password</label>
              <%= password_field_tag :password, id: 'password', class: 'form-control', placeholder: 'Password' %>
            </div>
            <div class="d-grid">
              <button class="btn btn-primary" type="submit">Sign in</button>
            </div>
          <% end %>

          <p class="mb-0">
            Forgot your password, or no password?
            <br class="d-block d-lg-none" />
            <a href="javascript:;" onclick="$('#t1').hide();$('#t2').show().find('input').focus()">Get a sign in code to your email</a>
            <br class="d-block d-lg-none" />
            <br />
            <a href="/accounts/new">
              Not yet registered? Sign up here
            </a>
          </p>

        </div>
        <div id="t2" style="display: none">
          <% form_tag '/accounts/sign_in_code' do %>
            <div class="input-group">
              <%= email_field_tag :email, id: 'sign-in-code-email', class: 'form-control', placeholder: 'Email', 'aria-label': 'Email' %>
              <button class="btn btn-primary" type="submit">Get code</button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
