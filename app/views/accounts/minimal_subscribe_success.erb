<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<script>
  window.iFrameResizer = {
    onReady: function () {
      if (window.parentIFrame && window.parentIFrame.sendMessage) {
        window.parentIFrame.sendMessage('subscribed');
      }
    }
  };
</script>
<%= cdn_tag 'https://cdn.jsdelivr.net/npm/iframe-resizer@4.4.5/js/iframeResizer.contentWindow.min.js' %>
</head>
<body></body>
</html>
