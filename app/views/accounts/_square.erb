<a class="text-decoration-none" href="javascript:;" data-account-username="<%= account.username %>">
  <img class="avatar avatar-<%= defined?(size) && size ? size : :sm %> <%= klass if defined?(klass) %> <%= 'private' if account.private? %>" data-bs-toggle="tooltip" title="<%= account.name %><% if defined?(content) && content %>: <%= content %><% end %>" src="<%= u account.image_thumb_or_gravatar_url %>">
</a>
