<%= partial :'accounts/nav' %>
<div class="container">
  <p>Changing your password signs out your other browsers.</p>
  <% form_tag '/accounts/password' do %>
    <%# For password managers, so they save the new password under this account %>
    <input type="email" autocomplete="username" value="<%= @account.email %>" style="display: none" aria-hidden="true">
    <div class="mb-3">
      <label class="form-label" for="password">New password</label>
      <%= password_field_tag :password, id: 'password', class: 'form-control', autocomplete: 'new-password', required: true, minlength: 8 %>
    </div>
    <div class="mb-3">
      <label class="form-label" for="password_confirmation">Confirm new password</label>
      <%= password_field_tag :password_confirmation, id: 'password_confirmation', class: 'form-control', autocomplete: 'new-password', required: true, minlength: 8 %>
    </div>
    <button type="submit" class="btn btn-primary">Change password</button>
  <% end %>
</div>
