<div id="<%= id %>" style="display: none"<%= " class=\"#{wrapper_class}\"" if defined?(wrapper_class) && wrapper_class %>>
  <% form_tag '/auth/atproto', method: 'get', class: form_class do %>
    <div class="input-group" style="max-width: 20rem">
      <%= text_field_tag :handle, class: 'form-control', placeholder: 'handle.bsky.social', 'aria-label': 'Bluesky handle', required: true %>
      <%= submit_tag button_text, class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
