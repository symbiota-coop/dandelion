<div class="modal-header">
  <h3 class="modal-title">
    <a class="text-body" href="/u/<%= @account.username %>"><%= @account.name %></a>
    <small class="text-body-secondary">@<%= @account.username %></small>
  </h3>
  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
  <%= partial :'accounts/top', locals: { account: @account, modal: true } %>
</div>
