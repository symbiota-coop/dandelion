<% unless env['omniauth.auth'] %>
  <div class="text-center">
    <div class="mb-3">
      <a href="/accounts/sign_in">Already a member? Sign in</a>
    </div>
    <% if !Provider.all.empty? %>
      <div class="row g-2 mb-3">
        <% Provider.all.each do |provider| %>
          <% if provider.omniauth_name == 'atproto' %>
            <div class="col-12 col-lg"><a class="btn btn-primary w-100" href="javascript:;" onclick="$('#atproto-signup-form').show().find('input[type=text]').focus();$(this).parent().hide()"><i class="<%= provider.icon %>"></i> <span class="visually-hidden">Sign up with </span><%= provider.display_name %></a></div>
          <% else %>
            <div class="col-12 col-lg"><a class="btn btn-primary w-100" href="/auth/<%= provider.omniauth_name %>"><i class="<%= provider.icon %>"></i> <span class="visually-hidden">Sign up with </span><%= provider.display_name %></a></div>
          <% end %>
        <% end %>
      </div>
      <%= partial :'accounts/atproto_form', locals: { id: 'atproto-signup-form', form_class: 'd-flex justify-content-center', button_text: 'Sign up' } %>
    <% end %>
  </div>
<% end %>
<% form_for @account, '/accounts/new', class: 'mt-3', id: 'new-account-form', multipart: true do |f| %>
  <% if params[:list_an_event] %>
    <%= hidden_field_tag :list_an_event, value: true %>
  <% end %>
  <% if env['omniauth.auth'] || (request.post? && session['omniauth.auth']) %>
    <%= hidden_field_tag :omniauth_signup, value: '1' %>
  <% end %>
  <% %w{organisation activity local_group event}.each { |r| if instance_variable_get("@#{r}") %>
  <%= hidden_field_tag :"#{r}_id", value: instance_variable_get("@#{r}").id %>
<% end; } %>
<script>
  $(function () {

  $('#new-account-form').submit(function() {
    if(!grecaptcha || grecaptcha.getResponse().length == 0) {
        alert('Please confirm you are not a robot');
        return false
    }
  })

  placeAutocomplete('#account_location')
  })
</script>
<%= f.text_block :name %>
<%= f.email_block :email %>
<%= f.text_block :location %>
<div class="g-recaptcha mb-3" data-sitekey="<%= ENV['RECAPTCHA_SITE_KEY'] %>"></div>
<%= f.submit_block button_text: 'Sign up' %>
<% end %>
