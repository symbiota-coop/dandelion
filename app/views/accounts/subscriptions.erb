<%= partial :'accounts/nav' %>

<div class="container">

  <%= @hide_alert = true; partial :flash %>
  <% form_for @account, '/accounts/subscriptions' do |f| %>
    <%= f.check_box_block :unsubscribed_messages %>
    <%= f.check_box_block :unsubscribed_feedback %>
    <%= f.check_box_block :unsubscribed_reminders %>
    <%= f.check_box_block :unsubscribed %>
    <%= f.submit_block button_text: 'Save preferences' %>
  <% end %>
  <style>
    #subscriptions li { margin-top: var(--space-xs) }
  </style>

  <div id="subscriptions">
    <% if @organisationships.any? %>
      <h2 class="my-3">Organisations</h2>
      <ul>
        <% @organisationships.each { |organisationship| organisation = organisationship.organisation %>
        <li>
          <a href="/o/<%= organisation.slug %>"><%= organisation.name %></a>
          <div class="d-inline-block" data-pagelet-url="/o/<%= organisation.slug %>/organisationship">
            <%= partial :'organisations/organisationship', locals: { organisation: organisation, organisationship: organisationship } %>
          </div>
          <ul>
            <% (@activityships_by_organisation_id[organisation.id] || []).each { |activityship| activity = activityship.activity %>
            <li>
              <a href="/o/<%= organisation.slug %>/a/<%= activity.slug %>"><%= activity.name %></a>
              <div class="d-inline-block" data-pagelet-url="/activities/<%= activity.id %>/activityship">
                <%= partial :'activities_and_local_groups/resourceship', locals: { resource: activity, resourceship: activityship, resourceship_name: 'activityship', resource_path: "/activities/#{activity.id}" } %>
              </div>
            </li>
            <% } %>
          </ul>
          <ul>
            <% (@local_groupships_by_organisation_id[organisation.id] || []).each { |local_groupship| local_group = local_groupship.local_group %>
            <li>
              <a href="/o/<%= organisation.slug %>/lg/<%= local_group.slug %>"><%= local_group.name %></a>
              <div class="d-inline-block" data-pagelet-url="/local_groups/<%= local_group.id %>/local_groupship">
                <%= partial :'activities_and_local_groups/resourceship', locals: { resource: local_group, resourceship: local_groupship, resourceship_name: 'local_groupship', resource_path: "/local_groups/#{local_group.id}" } %>
              </div>
            </li>
            <% } %>
          </ul>
        </li>
        <% } %>
      </ul>
    <% end %>
    <% if @memberships.any? %>
      <h2 class="my-3">Gatherings</h2>
      <ul>
        <% @memberships.each { |membership| gathering = membership.gathering %>
        <li>
          <a href="/g/<%= gathering.slug %>"><%= gathering.name %></a>
          <div class="d-inline-block" data-pagelet-url="/g/<%= gathering.slug %>/subscribe">
            <%= partial :'gatherings/subscribe', locals: { membership: membership } %>
          </div>
          <ul>
            <% (@teamships_by_gathering_id[gathering.id] || []).each { |teamship| team = teamship.team %>
            <li>
              <a href="/g/<%= gathering.slug %>/teams/<%= team.id %>"><%= team.name %></a>
              <div class="d-inline-block" data-pagelet-url="/teamships/<%= teamship.id %>/subscribe">
                <%= partial :'teams/subscribe', locals: { teamship: teamship } %>
              </div>
            </li>
            <% } %>
          </ul>
        </li>
        <% } %>
      </ul>
    <% end %>
  </div>

</div>
