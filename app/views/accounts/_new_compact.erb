<a href="javascript:;" onclick="$(this).hide().next().show().find('input[type=text]').first().focus()" class="btn btn-primary mb-3">Subscribe</a>
<div class="text-start card mb-3" style="display: none">
  <h3 class="card-header text-bg-primary">
    <% if (r = %w{organisation activity local_group event}.find { |name| instance_variable_get("@#{name}") }) %>
    Get email updates from <%= instance_variable_get("@#{r}").name %>
    <% if instance_variable_get("@#{r}").respond_to?(:organisation) %>
      and <%= instance_variable_get("@#{r}").organisation.name %>
    <% end %>
    <% end %>
  </h3>
  <script>
    $(function () {

      $('#new-account-form').submit(function () {
        if ($(this).find('.g-recaptcha').length && (!grecaptcha || grecaptcha.getResponse().length == 0)) {
          alert('Please confirm you are not a robot');
          return false
        }
      })

    $("[name='account[country]']").select2({
      theme: 'bootstrap-5',
      placeholder: 'Country',
      allowClear: true,
      width: '100%'
    })

    })
  </script>
  <div class="card-body">
    <% form_tag '/accounts/new', id: 'new-account-form' do |f| %>
      <% %w{organisation activity local_group event}.each { |r| %>
      <% if instance_variable_get("@#{r}") %>
        <%= hidden_field_tag :"#{r}_id", value: instance_variable_get("@#{r}").id %>
      <% end %>
      <% } %>
      <%= text_field_tag :'account[name]', class: 'form-control me-1 mb-1', required: true, placeholder: 'Name' %>
      <%= email_field_tag :'account[email]', class: 'form-control me-1 mb-1', required: true, placeholder: 'Email' %>
      <%= text_field_tag :'account[postcode]', class: 'form-control me-1 mb-1', placeholder: 'Postcode' %>
      <%= select_tag :'account[country]', class: 'form-select me-1', placeholder: 'Country', options: (['',''] + Account.countries), selected: visitor_country_name %>
      <% if ENV['RECAPTCHA_SITE_KEY'] %>
        <div class="g-recaptcha mb-1" data-sitekey="<%= ENV['RECAPTCHA_SITE_KEY'] %>"></div>
      <% end %>
      <%= submit_tag 'Subscribe', class: 'btn d-block d-lg-inline btn-primary mb-1' %>
    <% end %>
  </div>
</div>
