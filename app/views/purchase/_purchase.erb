<% if !can_purchase_event_tickets? %>
  <%= partial :'purchase/purchase_gate' %>
<% else %>
<%
discount_code, discount_code_problem = (@event.checkout_discount_code(params[:discount_code]) if params[:discount_code])
discount_code_used_up = discount_code_problem == :used_up

@concise_ticket_form = !@event.always_show_full_ticket_form? &&
  @event.ticket_types.count == 1 &&
  (free_ticket_type = @event.ticket_types.first) &&
  (!free_ticket_type.hidden || params[:ticket_type_id] == free_ticket_type.public_id) &&
  free_ticket_type.price &&
  free_ticket_type.price.zero? &&
  free_ticket_type.number_of_tickets_available_in_single_purchase > 0 &&
  !free_ticket_type.sales_ended? && !@event.sales_closed_due_to_event_end?
%>

<div class="card <% if @event.no_discounts %>no-discounts<% end %>" id="select-tickets">

  <% unless @concise_ticket_form %>
    <h3 class="card-header text-bg-primary"><%= @event.select_tickets_title || 'Select tickets' %></h3>
  <% end %>

  <div class="<% unless @concise_ticket_form %>card-body<% end %>">

    <% unless @concise_ticket_form %>
      <%= partial :'purchase/started' %>
      <% if @event.select_tickets_intro %>
        <table class="table table-borderless mb-0">
          <tr>
            <td>
              <%== md(@event.select_tickets_intro) %>
            </td>
          </tr>
        </table>
      <% end %>
    <% end %>

    <div id="ticket-types" <% if @concise_ticket_form %> style="display: none"<% end %>>
      <% form_tag '' do %>
        <%= hidden_field_tag :cohost, value: params[:cohost] %>
        <%= hidden_field_tag :affiliate_type, value: params[:affiliate_type] %>
        <%= hidden_field_tag :affiliate_id, value: params[:affiliate_id] %>
        <%= hidden_field_tag :ticket_type_id, value: params[:ticket_type_id] %>

        <% if @concise_ticket_form %>
          <%= hidden_field_tag :"quantities[#{free_ticket_type.id}]", value: 1, 'data-ticket-type-id': free_ticket_type.id %>
        <% else %>
          <table class="table">

            <% @no_ticket_groups = @event.ticket_types.all? { |ticket_type| !ticket_type.ticket_group } %>
            <% @previous_ticket_group = 'Other tickets' %>

            <% @event.ticket_types.order('order asc, price desc').each { |ticket_type| %>
            <% next if ticket_type.hidden && params[:ticket_type_id] != ticket_type.public_id; %>
            <% next if discount_code && !discount_code.applies_to_ticket_type?(ticket_type) %>
            <% ticket_type_availability = ticket_type.number_of_tickets_available_in_single_purchase %>
            <% ticket_type_sales_closed = ticket_type.sales_ended? || @event.sales_closed_due_to_event_end? %>
            <% ticket_type_waitlistable = @event.allow_ticket_type_waitlists? && ticket_type_availability <= 0 && !ticket_type_sales_closed %>
            <% next if @event.hide_unavailable_tickets? && !ticket_type_waitlistable && (ticket_type_availability <= 0 || ticket_type_sales_closed) %>
            <%= partial :'purchase/ticket_type', locals: { ticket_type: ticket_type } %>
            <% } %>

            <%# The last ticket type's description has no line under it, so this divides the ticket types from the totals %>
            <tr>
              <td class="p-0" colspan="3"></td>
            </tr>

            <%= partial :'purchase/discounts', locals: { discount_code: discount_code, discount_code_used_up: discount_code_used_up } %>

            <%= partial :'purchase/suggested_donation' %>

            <%== currency_input_row(label: 'Total', field_name: 'totalDisplay', field_id: 'totalDisplay', value: '0.00') %>

            <% if current_account && (organisationship = @event.organisation.organisationships.find_by(account: current_account)) && organisationship.credit_balance > 0 && FIAT_CURRENCIES.include?(@event.currency) %>
              <% show_balance = true %>
              <%== currency_input_row(label: 'Credit', field_name: 'credit', field_id: 'credit', value: format('%.2f', (organisationship.credit_balance.exchange_to(@event.currency).cents.to_f / 100))) %>
            <% end %>

            <% if discount_code && discount_code.fixed_discount %>
              <% show_balance = true %>
              <%== currency_input_row(label: 'Discount', field_name: 'fixed_discount', field_id: 'fixed-discount', value: format('%.2f', (discount_code.fixed_discount.exchange_to(@event.currency).cents.to_f / 100))) %>
            <% end %>

            <% if show_balance %>
              <%== currency_input_row(label: 'Balance', field_name: 'balance', field_id: 'balance') %>
            <% end %>

          </table>
        <% end %>
      <% end %>
    </div>

    <% unless @concise_ticket_form %>
      <% if @event.select_tickets_outro %>
        <table class="table table-borderless mb-0">
          <tr>
            <td>
              <%== md(@event.select_tickets_outro) %>
            </td>
          </tr>
        </table>
      <% end %>
    <% end %>

  </div>

  <h3 class="card-header text-bg-primary <% if @concise_ticket_form %>rounded-top<% end %>">
    <% if @concise_ticket_form %>
      Register for free
    <% else %>
      Your details
    <% end %>
  </h3>
  <div class="card-body" id="details">
    <%# The concise form has no ticket table above, so it says here when the event started %>
    <% if @concise_ticket_form %>
      <%= partial :'purchase/started' %>
    <% end %>
    <script>
      $(function () {
        $('#account_name').attr('required', 'required')
      })
    </script>
    <% form_for (@account = current_account || Account.new(country: visitor_country_name)), '' do |f| %>
      <% if current_account %>
        <p class="lead">Signed in as <%= current_account.name %> (<%= current_account.email %>)</p>
      <% end %>
      <%# Event#checkout_buyer_fields, which agents read too. Signed in, the account has its name, email and location, and
          a phone number unless it lacks its country code %>
      <% @event.checkout_buyer_fields.each do |field| %>
        <% case field[:name] %>
        <% when 'name' %>
          <%= current_account ? f.hidden_field(:name) : f.text_block(:name) %>
        <% when 'email' %>
          <%= current_account ? f.hidden_field(:email) : f.email_block(:email) %>
        <% when 'phone' %>
          <% if !current_account || !current_account.phone || !current_account.phone.starts_with?('+') %>
            <%= f.text_block :phone %>
          <% end %>
        <% when 'postcode' %>
          <%= f.text_block :postcode unless current_account %>
        <% when 'country' %>
          <%= f.select_block :country unless current_account %>
        <% when 'hear_about' %>
          <%= f.text_block :hear_about %>
        <% end %>
      <% end %>
      <%= f.hidden_field :http_referrer, value: request.referrer %>
      <%= f.hidden_field :via, value: params[:via] %>

      <%= partial :'questions/questions', locals: { questions: @event.questions } %>

      <%# Event#checkout_opt_ins, which agents read too %>
      <% @event.checkout_opt_ins.each do |opt_in| %>
        <%# Signed in and already getting updates from all of them, they keep getting them %>
        <% if opt_in[:name] == 'opt_in_organisation' && current_account && @event.organisation_and_cohosts.all? { |organisation| current_account.organisationships.find_by(organisation: organisation) } %>
          <%= f.hidden_field :opt_in_organisation, value: 1 %>
        <% else %>
          <div id="<%= opt_in[:name].tr('_', '-') %>">
            <div class="form-check">
              <%= f.check_box opt_in[:name].to_sym, class: 'form-check-input' %>
              <label for="account_<%= opt_in[:name] %>" class="form-check-label"><%= opt_in[:label] %></label>
            </div>
          </div>
        <% end %>
      <% end %>

      <%= partial :'purchase/terms_and_conditions' %>

      <%# Why the form's choices couldn't be priced (purchase.js), while the payment buttons wait for them to be %>
      <div id="quote-error" class="alert alert-danger mb-3" style="display: none" role="alert"></div>
      <div id="purchase-alert" class="alert alert-danger mb-3" style="display: none" role="alert"></div>
      <div id="payment-link" class="alert alert-primary mb-3" style="display: none" role="status">
        Payment continues in a new tab. If it didn't open, <a target="_blank" rel="noopener">continue to payment</a>.
      </div>

      <% EventPaymentMethod.all.each do |pm| %>
        <%== payment_button(method: pm.name, label: pm.button_label(@event), outline: pm.outline, visible: pm.visible, condition: pm.available?(@event)) %>
      <% end %>

      <%= hidden_field_tag :utm_source, value: params[:utm_source] %>
      <%= hidden_field_tag :utm_medium, value: params[:utm_medium] %>
      <%= hidden_field_tag :utm_campaign, value: params[:utm_campaign] %>
    <% end %>
  </div>
</div>

<%= partial :'purchase/ticket_type_waitlist_modal' if @event.allow_ticket_type_waitlists? %>

<div class="card" id="card-error" style="display: none">
  <h3 class="card-header text-bg-danger">There was an error processing the transaction</h3>
  <div class="card-body">
    <p>
      You have not be charged. Please refresh the page to try again.
    </p>
  </div>
</div>

<% EventPaymentMethod.all.select { |pm| pm.partial && pm.available?(@event) }.each do |pm| %>
  <%= partial pm.partial.to_sym %>
<% end %>

<%
  config = {
    eventSlug: @event.slug,
    eventUrl: "#{ENV['BASE_URI']}/e/#{@event.slug}",
    currency: @event.currency,
    currencySymbol: money_symbol(@event.currency),
    minimumApplicationFee: FiatCurrency.minimum_unit_amount(@event.currency),
    dandelionDonationHigherPriceOver: @event.dandelion_donation_higher_price_over,
    stripePk: (@event.organisation.stripe_connect_json ? ENV['STRIPE_PK'] : @event.organisation.stripe_pk),
    stripeAccount: @event.revenue_sharer_organisationship && @event.direct_charges ? @event.revenue_sharer_organisationship.stripe_user_id : @event.organisation.stripe_user_id,
    organisationOcSlug: @event.organisation.oc_slug,
    ocSlug: @event.oc_slug,
    evmAddress: @event.organisation.evm_address,
    contractAddress: (@event.currency == 'USD' ? Token.object('BREAD').contract_address : @event.token.try(:contract_address)),
    networkId: @event.chain.try(:network_id),
    networkName: @event.chain.try(:name),
    embedded: !!params[:ticket_form_only],
    donationsToDandelion: !!@event.donations_to_dandelion?,
    platformDonationMethods: EventPaymentMethod.platform_donation_names,
    cardMethods: EventPaymentMethod.all.select(&:card).map(&:name),
    recaptchaEnabled: !!ENV['RECAPTCHA_SITE_KEY']
  }
%>
<script type="application/json" id="purchase-config">
  <%== config.to_json %>
</script>
<% if @event.organisation.evm_address && @event.chain %>
  <script src="<%= cachebust('/javascripts/evm_payment.js') %>"></script>
<% end %>
<script src="<%= cachebust('/javascripts/event_payment_handlers.js') %>"></script>
<script src="<%= cachebust('/javascripts/purchase.js') %>"></script>
<% end %>
