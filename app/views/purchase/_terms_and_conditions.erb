<% terms = @event.terms_and_conditions_for_purchase %>
<% terms_url = @event.terms_and_conditions_url_for_purchase %>
<% require_check_box = @event.terms_and_conditions_check_box_for_purchase %>
<% if terms %>
  <p class="mb-1 font-weight-bold">Terms and conditions</p>
  <textarea class="form-control mb-2" style="height: 8em" readonly><%=terms%></textarea>
  <% if require_check_box %>
    <div class="checkbox-inline mb-1">
      <%= check_box_tag :accepted_terms, id: 'accepted-terms' %>
      <label for="accepted-terms">
        I agree to the terms and conditions
      </label>
    </div>
  <% end %>
  <p><small>
      By proceeding you also agree to Dandelion's <a target="_blank" href="/terms">terms and conditions</a>
      and understand this event is organised by <%= @event.responsible_name %>,
      who takes financial and legal responsibility for the event.
    </small>
  </p>
<% elsif terms_url %>
  <p><small>
      By proceeding you agree to the terms and conditions of <a target="_blank" href="/terms">Dandelion</a>
      and <a href="<%=terms_url%>" target="_blank"><%=@event.organisation.name%></a>
      and understand this event is organised by <%= @event.responsible_name %>,
      who takes financial and legal responsibility for the event.
    </small>
  </p>
  <% if require_check_box %>
    <div class="checkbox-inline mb-1">
      <%= check_box_tag :accepted_terms, id: 'accepted-terms' %>
      <label for="accepted-terms">
        I agree to the terms and conditions
      </label>
    </div>
  <% end %>
<% else %>
  <p><small>
      By proceeding you agree to Dandelion's <a target="_blank" href="/terms">terms and conditions</a>
      and understand this event is organised by <%= @event.responsible_name %>,
      who takes financial and legal responsibility for the event.
    </small>
  </p>
<% end %>
