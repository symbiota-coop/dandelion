<%
  availability = ticket_type.number_of_tickets_available_in_single_purchase
  ticket_group_name = ticket_type.ticket_group.try(:name)
  ticket_type_monthly_donor_required = ticket_type.minimum_monthly_donation && (
    !current_account ||
    !(organisationship = @event.organisation.organisationships.find_by(account: current_account)) ||
    !(organisationship.monthly_donation_amount) ||
    !(Money.new(organisationship.monthly_donation_amount * 100, organisationship.monthly_donation_currency) >= Money.new(ticket_type.minimum_monthly_donation * 100, @event.currency))
  )
%>
<% unless @no_ticket_groups %>
  <% tg = ticket_group_name || 'Other tickets'; if tg != @previous_ticket_group %>
  <tr>
    <td colspan="3" class="text-bg-primary text-center fw-bold header-font text-uppercase small"><%= tg %></td>
  </tr>
  <% @previous_ticket_group = ticket_group_name %>
<% end %>
<% end %>
<tr>
  <td class="pt-0 border-top" colspan="3">
  </td>
</tr>
<tr>
  <td class="border-top-0 align-middle">
    <span class="fw-bold fs-4">
      <%= ticket_type.name %>
    </span>
    <% if ticket_type.hidden %>
      <i data-bs-toggle="tooltip" title="Available to you as you used a secret link" class="bi bi-lock"></i>
    <% end %>
    <% if ticket_type.minimum_monthly_donation %>
      <i data-bs-toggle="tooltip" title="Available to those donating <%=m ticket_type.minimum_monthly_donation, @event.currency%>+/month" class="bi bi-lock"></i>
    <% end %>

    <% if ticket_type.sales_ended? || @event.sales_closed_due_to_event_end? %>
    <% elsif availability > 0 %>
      <% if !@event.organisation.hide_few_left && !@event.hide_few_left && (wiser_remaining = ticket_type.wiser_remaining) <= 3 %>
        <span class="badge text-bg-secondary align-text-bottom"><%= wiser_remaining %> left</span>
      <% end %>
    <% end %>

  </td>
  <td class="border-top-0 align-middle fs-4">
    <% if ticket_type.range %>
      <span><%= m ticket_type.range_min, @event.currency %> - <%= m ticket_type.range_max, @event.currency %></span>
      <%= range_field_tag :"prices[#{ticket_type.id}]",
              class: 'form-range',
              min: ticket_type.range_min,
              max: ticket_type.range_max,
              value: (params[:prices][ticket_type.id.to_s] if params[:prices]),
              data: { interacted: (params[:prices] && params[:prices][ticket_type.id.to_s] ? 'true' : 'false') },
              oninput: "$(this).attr('data-interacted', 'true'); $(this).prev().html('#{money_symbol(@event.currency)}' + this.value); $(this).next().find('.select-a-price-first').css('visibility','hidden'); var qty = $(this).parent().next().find('[name^=quantities]'); qty.attr('data-price',this.value); if (qty.prop('disabled')) { qty.val(1); }; qty.prop('disabled',false).change();" %>

      <% if params[:prices] && params[:prices][ticket_type.id.to_s] %>
        <script>
          $(function() {
            var $input = $('[name="prices[<%= ticket_type.id %>]"]');
            $input.attr('data-interacted', 'true');
            $input[0].oninput();
          });
        </script>
      <% end %>

      <div class="text-end small">
        <em class="select-a-price-first text-nowrap">Drag<span class="d-none d-sm-inline"> the slider</span></em>
      </div>

    <% elsif ticket_type.price %>
      <% unless ticket_type.price == 0 && @event.blank_price_for_free_tickets %>
        <%= m ticket_type.price, @event.currency %>
      <% end %>
    <% else %>
      <div class="position-relative">
        <div class="input-group">
          <span class="input-group-text"><%= money_symbol(@event.currency) %></span>
          <%= number_field_tag :"prices[#{ticket_type.id}]", min: 0, class: 'form-control', style: 'min-width: 3em',
              value: (params[:prices][ticket_type.id.to_s] if params[:prices]),
              oninput: "$(this).parent().next().find('.select-a-price-first').css('visibility','hidden'); var qty = $(this).parent().parent().parent().next().find('[name^=quantities]'); qty.attr('data-price',this.value); if (qty.prop('disabled')) { qty.val(1); }; qty.prop('disabled',false).change();" %>

          <% if params[:prices] && params[:prices][ticket_type.id.to_s] %>
            <script>
              $(function() {
                $('[name="prices[<%= ticket_type.id %>]"]')[0].oninput();
              });
            </script>
          <% end %>

        </div>
        <div class="text-end position-absolute end-0 small">
          <em class="select-a-price-first text-nowrap">Set a price first</em>
        </div>
      </div>
    <% end %>
  </td>
  <td class="border-top-0 align-middle">
    <% if ticket_type.sales_ended? || @event.sales_closed_due_to_event_end? %>
      <span class="badge text-bg-secondary">Sales closed</span>
    <% elsif availability > 0 %>
      <% if ticket_type_monthly_donor_required %>
      <% if current_account %>
        <% if @event.organisation.become_a_member_url %>
          <a href="<%= @event.organisation.become_a_member_url %>">Become a member</a>
        <% else %>
          Available to those donating <%=m ticket_type.minimum_monthly_donation, @event.currency%>+/month
        <% end %>
      <% else %>
        <a href="/accounts/sign_in">Sign in</a>
      <% end %>
    <% else %>
      <div class="quantity-select-container">
        <%= select_tag :"quantities[#{ticket_type.id}]", 'data-ticket-type-id': ticket_type.id, 'data-ticket-group-id': ticket_type.ticket_group_id, 'data-price': ticket_type.price, 'data-slots': ticket_type.slots, class: 'form-select w-100', options: (0..[99, availability].min).to_a, value: (params[:quantities][ticket_type.id.to_s] if params[:quantities]), disabled: !ticket_type.price %>
      </div>
    <% end %>
  <% else %>
    <% if @event.allow_ticket_type_waitlists? %>
      <div class="text-end">
        <button type="button"
        class="btn btn-sm btn-outline-primary join-ticket-type-waitlist"
        data-ticket-type-id="<%= ticket_type.id %>">
          Join waitlist
        </button>
      </div>
    <% else %>
      <span class="badge text-bg-danger">Sold out</span>
    <% end %>
  <% end %>
</td>
</tr>

<tr>
  <td class="text-body-secondary ticket-type-description border-0 pt-0" colspan="3">
    <div class="<% if !ticket_type.price && !ticket_type.range %>mt-3<% end %>">
      <% if ticket_type.public_description %>
        <%== Sanitize.fragment(Rinku.auto_link(md(ticket_type.public_description)), Sanitize::Config::DANDELION) %>
      <% end %>
    </div>
  </td>
</tr>

<% if ticket_type.photos.exists? %>
  <tr>
    <td class="border-0" colspan="3">
      <%= partial :'photos/photos', locals: { photoable: ticket_type, dimensions: '100x100#' } %>
    </td>
  </tr>
<% end %>
