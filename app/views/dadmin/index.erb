<div class="d-flex align-items-center gap-2 mb-3">
  <h1 class="mb-0"><%= @model.model_name.human.pluralize %></h1>
  <a href="<%= url(:dadmin, :new, model: @model.to_s) %>" class="btn btn-primary"><i class="bi bi-pencil"></i> New</a>
</div>

<%= partial :'dadmin/search' %>

<div class="d-flex flex-wrap align-items-center gap-2 my-3">
  <span class="text-body-secondary">
    <%== page_entries_info(@resources, model: @model.to_s) %>
    <a class="btn btn-sm btn-primary ms-2" target="_blank" href="<%= url(:dadmin, :index, params.merge(format: :csv)) %>"><i class="bi bi-download"></i> CSV</a>
  </span>
  <form class="d-flex ms-auto">
    <%= hidden_field_tag :o, value: @o %>
    <%= hidden_field_tag :d, value: @d %>
    <div class="input-group">
      <%= search_field_tag :q, class: 'form-control', value: @q, autocomplete: 'off' %>
      <button class="btn btn-secondary"><i class="bi bi-search"></i></button>
    </div>
  </form>
</div>

<% if @resources.selector.any? %>
  <div class="card mb-3">
    <div class="card-body overflow-auto">
      <code class="text-nowrap"><%= @resources.selector.inspect %></code>
    </div>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover table-sm">
    <thead>
      <tr>
        <th></th>
        <% @index_fields.each do |fieldname, _options| %>
          <th>
            <%= @model.human_attribute_name(fieldname) %>
            <% sort_url = url(:dadmin, :index, params.merge(o: fieldname, d: params[:d] == 'asc' ? 'desc' : 'asc')) %>
            <% if @o == fieldname.to_sym %>
              <a class="link-body-emphasis" title="Ordered by <%= fieldname %>; click to reverse" href="<%= sort_url %>"><i class="bi bi-caret-<%= @d == :asc ? 'down' : 'up' %>"></i></a>
            <% elsif dadmin_persisted_field?(@model, fieldname) %>
              <a class="text-body-tertiary" title="Order by <%= fieldname %>" href="<%= sort_url %>"><i class="bi bi-caret-right"></i></a>
            <% end %>
          </th>
        <% end %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @resources.each do |resource| %>
        <tr>
          <td>
            <a href="<%= url(:dadmin, :edit, model: @model.to_s, id: resource.id) %>" class="btn btn-secondary" title="View/Edit" aria-label="View/Edit"><i class="bi bi-pencil"></i></a>
          </td>
          <% @index_fields.each do |fieldname, options| %>
            <% value = resource.send(fieldname) %>
            <td>
              <% if options[:type] == :lookup && value %>
                <% if (record = dadmin_lookup_record(@model, fieldname, resource)) %>
                  <a href="<%= url(:dadmin, :edit, model: record.class.to_s, id: record.id) %>"><%= record.send(dadmin_lookup_method(record.class)) %></a>
                <% else %>
                  <%= value %>
                <% end %>
              <% elsif fieldname.to_s.end_with?('_url') && value.to_s.match?(%r{\Ahttps?://}i) %>
                <%# Only link web addresses: a javascript: URL here would run in the admin's session %>
                <a href="<%= value %>" target="_blank" rel="noopener"><%= value %></a>
              <% elsif value.is_a?(Time) || value.is_a?(Date) %>
                <%= value %>
              <% elsif options[:type] == :check_box %>
                <% if value == true %><i class="bi bi-check"></i><% elsif value == false %><i class="bi bi-x"></i><% end %>
              <% elsif options[:full] %>
                <%= strip_tags(value.to_s) %>
              <% else %>
                <%= truncate(strip_tags(value.to_s), length: 30) %>
              <% end %>
            </td>
          <% end %>
          <td>
            <a class="btn btn-danger" title="Delete" aria-label="Delete" data-method="post" data-confirm="Are you sure you want to delete this <%= @model_name %>?" href="<%= url(:dadmin, :destroy, model: @model.to_s, id: resource.id) %>"><i class="bi bi-trash"></i></a>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= will_paginate @resources, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
