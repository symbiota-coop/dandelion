<div class="d-flex align-items-center gap-2 mb-3">
  <h1 class="mb-0"><%= @resource.new_record? ? "New #{@model_name}" : "Edit #{@model_name}" %></h1>
  <% unless params[:popup] %><a href="<%= url(:dadmin, :index, model: @model.to_s) %>" class="btn btn-secondary"><i class="bi bi-list-ul"></i> All <%= @model_name.pluralize %></a><% end %>
</div>

<div class="col-sm-8 mx-auto">
  <% form_for @resource, (@resource.new_record? ? url(:dadmin, :new, model: @model.to_s) : url(:dadmin, :edit, model: @model.to_s, id: @resource.id)), multipart: true do |f| %>

    <%= hidden_field_tag :popup, value: true if params[:popup] %>

    <% tip_key, hint_key = @resource.new_record? ? %i[new_tip new_hint] : %i[edit_tip edit_hint] %>
    <% dadmin_fields(@model).each do |fieldname, options| %>
      <% next unless options[:edit] %>
      <% next if @resource.new_record? && options[:type] == :collection %>
      <% tip = options[tip_key]
         hint = options[hint_key] %>
      <% case options[:type] %>
      <% when :collection %>
        <%= f.block_layout(fieldname, partial(:'dadmin/collection', locals: { fieldname: fieldname }), tip: tip, hint: hint) %>
      <% when :lookup %>
        <% lookup_model = dadmin_assoc(@model, fieldname).class_name
           id = @resource.send(fieldname) %>
        <%= f.lookup_block(fieldname,
                           lookup_url: url(:dadmin, :index, model: lookup_model, format: :json),
                           placeholder: "Search #{fieldname.to_s.humanize.downcase.pluralize}",
                           selected_link: (%(<a class="popup" href="#{url(:dadmin, :edit, model: lookup_model, id: id, popup: true)}">View record</a>) if id),
                           tip: tip, hint: hint) %>
      <% else %>
        <%= f.send("#{options[:type]}_block", fieldname, tip: tip, hint: hint, disabled: options[:disabled]) %>
      <% end %>
    <% end %>

    <%= f.submit_block(destroy_url: (url(:dadmin, :destroy, popup: params[:popup], model: @model.to_s, id: @resource.id) if @resource.persisted?)) %>

  <% end %>
</div>

<script>
  // Related records open in a popup, which reloads this page when saved
  $(document).on('click', 'a.popup', function (e) {
    e.preventDefault()
    window.open(this.href, null, 'scrollbars=yes,width=575,height=575,left=150,top=150').focus()
  })
</script>
