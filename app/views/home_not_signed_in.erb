<style>
  #content { padding-left: 0; padding-right: 0; padding-top: 0; }

  .typewriter {
    background-size: 7.5em 100%;
    background-repeat: no-repeat;
  }
</style>

<div class="lavender-wash content-padding-x">
  <div class="row justify-content-center mx-0 py-5">
    <script src="https://cdn.jsdelivr.net/npm/typed.js@3.0.0/dist/typed.umd.js"></script>
    <script>
      $(function () {
        <% if ENV['CREATE_VIDEO'] %>
          $('.typewriter').text('regenerative')
        <% else %>
          var typed = new Typed('.typewriter', {
            strings: <%== ADJECTIVES.to_json %>,
            typeSpeed: 50,
            loop: true
          });
        <% end %>
      })
    </script>
    <div class="col-12 col-lg-7">
      <p id="strapline" class="mb-3 strapline">
        Find and host 
        <strong class="gradient-text typewriter"></strong>
        <br />
        events and co-created gatherings
      </p>
      <p class="text-lg-center readable">
        <a href="/docs/events#creating-an-event">Watch the 1-minute how-to video</a> or <a href="/docs/gatherings">learn more about Gatherings</a>
      </p>
      <div class="d-flex flex-wrap gap-2 justify-content-lg-center mb-3">
        <a class="btn btn-primary btn-lg" href="/events/new">List an event</a>
        <a class="btn btn-outline-primary btn-lg" href="/features">Features</a>
      </div>
    </div>
  </div>

  <div class="row justify-content-center mx-0 mb-5">
    <div class="col-12 col-xl-10">
      <%= partial :stats_band %>
    </div>
  </div>

  <div class="row justify-content-center mb-5 mx-0">
    <div class="col-lg-7">

      <div class="row justify-content-center">
        <div class="col-md-9 col-lg-10 col-xl-9">
          <div id="payment-methods" class="row align-items-center justify-content-center mb-5 px-0 px-lg-3 mb-lg-3">
            <%= partial :payment_methods %>
          </div>
        </div>
      </div>

      <div class="row justify-content-center py-5">
        <div class="col-lg-10">
          <%= partial :badges %>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="px-4">
  <div class="mt-lg-5">
    <%= partial :'events/search_form', locals: { path: '/events' } %>

    <div data-with-placeholder data-pagelet-url="/events?home=1&images=1&order=trending">
      <%= partial :'events/blocks_placeholder' %>
    </div>
  </div>

  <%= cp(:'event_feedbacks/home', expires: 1.day.from_now) %>

  <div id="homepage-map" data-lazy-map="/map/home">
    <div style="height: 50vh"></div>
  </div>
  <script>
    $(function () {
      var $mapContainer = $('#homepage-map');
      var mapLoaded = false;

      var observer = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting && !mapLoaded) {
          mapLoaded = true;
          observer.disconnect();
          // Hide the map if Google Maps can't load (e.g. it's blocked)
          google.maps.importLibrary('maps').then(function () {
            $mapContainer.load($mapContainer.data('lazy-map'));
          }).catch(function () {
            $mapContainer.hide();
          });
        }
      }, { rootMargin: '200px' });

      observer.observe($mapContainer[0]);
    });
  </script>
</div>
