<% form_for @option ||= Option.new, @option.new_record? ? "/g/#{@gathering.slug}/options/new" : "/g/#{@gathering.slug}/options/#{@option.id}/edit" do |f| %>
  <%= f.text_block :name %>
  <%= f.text_area_block :description, rows: 3, autosize: true %>
  <%= f.select_block :type %>
  <%= f.number_block :capacity %>
  <%= f.currency_block :cost, money_symbol: money_symbol(@gathering.currency), disabled: !gathering_admin?, hint: ('Only admins can add paid options' if !gathering_admin?) %>
  <%= f.check_box_block :split_cost, disabled: !gathering_admin? %>
  <%= f.check_box_block :by_invitation %>
  <%= f.check_box_block :hide_members %>
  <%= f.submit_block destroy_url: "/g/#{@gathering.slug}/options/#{@option.id}/destroy" %>
<% end %>
