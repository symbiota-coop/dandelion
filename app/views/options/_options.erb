<%= partial :'gatherings/owed' %>
<table class="table">
  <thead>
    <tr>
      <th>Option</th>
      <th>Cost</th>
      <th>Places</th>
      <th></th>
      <% if @membership&.confirmed? || gathering_admin? %>
        <th style="width: 33%" class="d-none d-lg-table-cell">People</th>
      <% end %>
    </tr>
  </thead>
  <% Option.types.each { |type| next unless (options = @gathering.options.includes(optionships: :account).and(type: type)).exists? %>
  <tr class="bg-white">
    <td colspan="5">
      <h3 class="mb-0"><i class="bi <%= Option.icon(type) %>"></i> <%= %w[Tier Extra].include?(type) ? type.pluralize : type %></h3>
    </td>
  </tr>
  <% options.order('order asc, cost asc, name asc').each { |option| %>
  <tr>
    <td>
      <strong>
        <% if gathering_admin? || option.cost == 0 %>
          <a href="/g/<%= @gathering.slug %>/options/<%= option.id %>/edit">
            <%= option.name %>
          </a>
        <% else %>
          <%= option.name %>
        <% end %>
      </strong>
      <% if option.description %>
        <br>
        <%== Sanitize.fragment(Rinku.auto_link(option.description.gsub("\n", '<br />')), Sanitize::Config::DANDELION) %>
      <% end %>
    </td>
    <td>
      <% if option.split_cost %>
        <%= m option.cost, @gathering.currency %> total
        <% if option.cost_per_person %>
          (currently <%= m option.cost_per_person, @gathering.currency %>/person)
        <% end %>
      <% else %>
        <%= m option.cost, @gathering.currency %>/person
      <% end %>
    </td>
    <td nowrap>
      <% if @membership&.confirmed? || gathering_admin? %>
        <% if !gathering_admin? && option.hide_members? %>
          <%= option.optionships.count %>/<%== (option.capacity || '&infin;').to_s %>
        <% else %>
          <a href="javascript:;" onclick="$('#modal .modal-content').load(<%= "/g/#{@gathering.slug}/options/#{option.id}".to_json %>, function () {
                    $('#modal').modal('show')
                  });">
            <%= option.optionships.count %>/<%== (option.capacity || '&infin;').to_s %>
          </a>
        <% end %>
      <% end %>
      <% if option.capacity %>
        <% if option.full? %>
          <span class="badge text-bg-danger">Full</span>
        <% else %>
          <span class="badge text-primary border border-primary">Available</span>
        <% end %>
      <% end %>
    </td>
    <td>
      <% if (optionship = @gathering.optionships.find_by(option: option, account: current_account)) %>
        <a data-method="post" class="pagelet-trigger btn btn-outline-primary" href="/optionships/<%= optionship.id %>/destroy">Leave</a>
      <% elsif !option.full? %>
        <% if option.by_invitation %>
          <span class="badge text-bg-secondary">By invitation</span>
        <% else %>
          <a class="pagelet-trigger btn btn-primary" data-method="post" onclick="window.scrollTo(0, 0)" href="/optionships/create?option_id=<%= option.id %>">Join</a>
        <% end %>
      <% end %>
    </td>
    <% if @membership&.confirmed? || gathering_admin? %>
      <td class="d-none d-lg-table-cell">
        <% if !gathering_admin? && option.hide_members? %>
          <%= pluralize option.optionships.count, 'person' %>
        <% else %>
          <% y = [] %>
          <% option.optionships.order('created_at asc').each { |optionship| account = optionship.account; %>
          <% if params[:view] == 'names' %>
            <% y << capture do %>
              <% if gathering_admin? %>
                <a href="/g/<%= @gathering.slug %>/optionships/<%= optionship.id %>/edit">
                  <%= account.name %>
                </a>
              <% else %>
                <%= partial :'accounts/square', locals: { account: account } %>
              <% end %>
            <% end %>
          <% else %>
            <% y << capture do %>
              <% if gathering_admin? %>
                <a class="me-1" href="/g/<%= @gathering.slug %>/optionships/<%= optionship.id %>/edit"><img alt="<%= account.name %>" data-bs-toggle="tooltip" class="avatar avatar-sm <%= account.avatar_class %>" title="<%= account.name %>" src="<%= u account.image_thumb_or_gravatar_url %>"></a>
              <% else %>
                <%= partial :'accounts/square', locals: { account: account } %>
              <% end %>
            <% end %>
          <% end %>
          <% } %>
          <% if params[:view] == 'names' %>
            <%== y.map(&:strip).join(' &middot; ') %>
          <% else %>
            <div class="image-wall">
              <%== y.map(&:strip).join('') %>
            </div>
          <% end %>
        <% end %>
      </td>
    <% end %>
  </tr>
  <% } %>
<% } %>
</table>
<% if params[:view] != 'names' %>
  <div class="d-none d-lg-block">
    <% names_url = "/g/#{@gathering.slug}/options?view=names" %>
    <a onclick="$(this).closest('[data-pagelet-url]').attr('data-pagelet-url', <%= names_url.to_json %>)" href="<%= names_url %>" class="pagelet-trigger">Show names instead of pictures</a>
  </div>
<% end %>
