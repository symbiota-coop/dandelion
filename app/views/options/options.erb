<%= partial :'gatherings/nav', locals: { gathering: @gathering, membership: @membership } %>
<div class="d-flex flex-wrap gap-2 mb-3">
  <a class="btn btn-sm btn-primary" href="javascript:;" data-bs-toggle="modal" data-bs-target="#add-option"><i class="bi bi-plus-lg"></i> Add an option</a>
  <% if gathering_admin? %>
    <a class="btn btn-sm btn-outline-primary" href="javascript:;" data-bs-toggle="modal" data-bs-target="#add-optionship"><i class="bi bi-person-fill-add"></i> Add someone to an option</a>
  <% end %>
  <%# The People column only shows from lg %>
  <%= partial :'gatherings/names_toggle', locals: { grid: 'options-grid', url: "/g/#{@gathering.slug}/options", klass: 'd-none d-lg-inline-block' } %>
</div>
<%= partial :'gatherings/form_modal', locals: { id: 'add-option', title: 'Add an option', form: :'options/build' } %>
<% if gathering_admin? %>
  <%= partial :'gatherings/form_modal', locals: { id: 'add-optionship', title: 'Add someone to an option', form: :'options/optionship' } %>
<% end %>
<div id="options-grid" data-pagelet-url="/g/<%= @gathering.slug %>/options">
  <%= partial :'options/options' %>
</div>
