<% if !current_account && @hide_right_nav %>
  <script>
    window.addEventListener('pagereveal', (e) => {
      if (e.viewTransition) e.viewTransition.skipTransition();
    });
  </script>
  <style>
    @media (max-width: 991px) {
      #header .navbar-nav {
        display: none;
      }
      #page-container {
        padding-top: 2.75rem;
      }
    }
  </style>
<% end %>

<%
  sabbat_date, sabbat = Almanac.next_sabbat
  sabbat_plain = sabbat_date == Date.today ? "Happy #{sabbat[:name]}!" : "#{distance_of_time_in_words(Date.today, sabbat_date)} until #{sabbat[:name]}"
  almanac_tooltip = "#{Almanac.moon_name} · #{sabbat_plain}"
%>
<style>
  #docs-li { display: none }
  @media(min-width: 992px) { #docs-li { display: list-item } }
  .almanac-moon { filter: grayscale(1); font-size: 1.3em; }
</style>
<ul class="navbar-nav ms-auto">
  <% if current_account %>
    <% if admin? && request.path == '/' && (contribution_data = MonthlyContributionsCalculator.contribution_data) %>
      <li class="nav-item d-none d-lg-inline">
        <a href="javascript:;" class="nav-link opacity-50" style="cursor: default">
          <%= contribution_data[:current].format(no_cents: true) %> (<%= m contribution_data[:projected], contribution_data[:currency] %>)
        </a>
      </li>
    <% end %>
  <% end %>
  <li class="nav-item d-none d-md-inline">
    <a href="/wheel-of-the-year.html" target="_blank" class="nav-link almanac-moon" title="<%= almanac_tooltip %>" data-bs-toggle="tooltip">
      <%= Almanac.moon_icon %>
    </a>
  </li>
  <% if current_account %>
    <li class="nav-item d-none d-md-inline">
      <a href="/referrals" class="nav-link" title="Rewards for getting organisations to start using Dandelion" data-bs-toggle="tooltip">
        <i class="bi bi-trophy"></i>
      </a>
    </li>
    <li class="nav-item">
      <a href="javascript:;" data-bs-toggle="offcanvas" data-bs-target="#header-search-bar" aria-controls="header-search-bar" aria-label="Search" class="nav-link navbar-icon">
        <i class="bi bi-search"></i>
      </a>
    </li>
    <li class="nav-item dropdown">
      <a id="notifications-a" href="javascript:;" data-bs-toggle="dropdown" data-mobile-modal="Notifications" data-check-url="/checked_notifications" class="nav-link navbar-icon">
        <i class="bi bi-bell"></i>
      </a>
      <%# The pagelet is the menu itself, so the element Bootstrap's Dropdown remembers survives each refresh %>
      <div id="notifications" class="dropdown-menu dropdown-lg p-0" data-pagelet-url="/notifications" data-pagelet-refresh="60"></div>
    </li>
    <li class="nav-item dropdown">
      <a id="messages-a" href="javascript:;" data-bs-toggle="dropdown" data-mobile-modal="Messages" data-check-url="/checked_messages" class="nav-link navbar-icon">
        <i class="bi bi-chat-left"></i>
      </a>
      <div id="messages" class="dropdown-menu dropdown-lg p-0" data-pagelet-url="/messages" data-pagelet-refresh="60">
        <%= cp(:'messages/dropdown', key: "/messages?account_id=#{current_account.id}", expires: 1.minute.from_now) %>
      </div>
    </li>
    <li class="nav-item d-none d-md-inline dropdown">
      <a href="javascript:;" class="nav-link" data-bs-toggle="dropdown">
        <span class="navbar-user-img online float-start">
          <img src="<%= u current_account.image_thumb_or_gravatar_url %>">
        </span>
        <span class="d-none d-md-inline"><%= current_account.name %> <i class="bi bi-chevron-down caret"></i></span>
      </a>
      <%= partial :nav_profile, locals: { ul_class: 'dropdown-menu', a_class: 'dropdown-item' } %>
    </li>
  <% else %>
    <li class="nav-item">
      <a href="javascript:;" data-bs-toggle="offcanvas" data-bs-target="#header-search-bar" aria-controls="header-search-bar" aria-label="Search" class="nav-link navbar-icon">
        <i class="bi bi-search"></i>
      </a>
    </li>
    <li class="nav-item">
      <a href="/accounts/new" class="nav-link">
        Sign up
      </a>
    </li>
    <li class="nav-item">
      <a href="/accounts/sign_in" class="nav-link">
        Sign in
      </a>
    </li>
  <% end %>
</ul>
