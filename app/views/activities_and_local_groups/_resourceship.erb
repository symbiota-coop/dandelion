<% if current_account %>
  <% resourceship ||= current_account.send(:"#{resourceship_name.pluralize}").find_by(:"#{resource.class.name.underscore}" => resource)
     state_options = {
       'not_following' => 'Follow',
       'follow_without_subscribing' => 'Following',
       'follow_and_subscribe' => 'Following with email updates <i class="bi bi-envelope-fill"></i>'
     }
     current_state = if resourceship
                       resourceship.unsubscribed ? 'follow_without_subscribing' : 'follow_and_subscribe'
                     else
                       'not_following'
                     end
     text = state_options[current_state]
     state_tooltips = {
       'follow_without_subscribing' => 'You follow this but don\'t get its emails. Click to change',
       'follow_and_subscribe' => 'You follow this and get its emails. Click to change'
     }
     action_options = {
       'not_following' => 'Unfollow',
       'follow_without_subscribing' => 'Follow',
       'follow_and_subscribe' => 'Follow with email updates <i class="bi bi-envelope-fill"></i>'
     }

     action_options.delete('not_following') if resourceship && resourceship.admin? %>
  <% if resourceship || !resource.respond_to?(:privacy) || resource.privacy == 'open' %>
    <% if current_state == 'not_following' %>
      <a class="pagelet-trigger btn btn-outline-primary <%= btn_class if defined?(btn_class) %>" data-method="post" href="<%= resource_path %>/<%= resourceship_name %>?f=follow_and_subscribe" data-bs-toggle="tooltip" title="Follow this and get its emails">Follow</a>
    <% else %>
      <div class="dropdown d-inline-block" data-bs-toggle="tooltip" title="<%= state_tooltips[current_state] %>">
        <button class="btn mb-1 <%= btn_class if defined?(btn_class) %> <%= current_state == 'not_following' ? 'btn-outline-primary' : 'btn-primary' %> dropdown-toggle" type="button" data-bs-toggle="dropdown">
          <%== text %>
        </button>
        <div class="dropdown-menu">
          <% action_options.invert.each { |text,value| %>
          <a class="pagelet-trigger dropdown-item" data-method="post" href="<%= resource_path %>/<%= resourceship_name %>?f=<%= value %>"><%== text %></a>
          <% } %>
        </div>
      </div>

      <% if resourceship.admin? %>
        <% if resourceship.receive_feedback? %>
          <a class="btn mb-1 btn-primary" data-method="post" href="<%= resource_path %>/receive_feedback/0" data-bs-toggle="tooltip" title="As an admin, you're emailed feedback and notifications. Click to stop">Receiving feedback</a>
        <% else %>
          <a class="btn mb-1 btn-outline-primary" data-method="post" href="<%= resource_path %>/receive_feedback/1" data-bs-toggle="tooltip" title="As an admin, you're not emailed feedback and notifications. Click to start">Not receiving feedback</a>
        <% end %>
      <% end %>

      <% if defined?(membership_toggle) && membership_toggle %>
        <% if !resourceship.hide_membership? %>
          <a class="btn mb-1 btn-primary" data-method="post" href="<%= resource_path %>/hide_membership" data-bs-toggle="tooltip" title="This shows on your public profile. Click to hide it">Showing on your profile</a>
        <% else %>
          <a class="btn mb-1 btn-outline-primary" data-method="post" href="<%= resource_path %>/show_membership" data-bs-toggle="tooltip" title="This doesn't show on your public profile. Click to show it">Not showing on your profile</a>
        <% end %>
      <% end %>

    <% end %>
  <% elsif resource.respond_to?(:privacy) && resource.privacy == 'closed'; activity = resource %>
    <% if (existing_application = activity.activity_applications.and(account: current_account).first) %>
      <a class="btn mb-1 btn-outline-primary" href="/activities/<%= activity.id %>/activity_applications/latest">View latest application</a>
    <% end %>
    <a class="btn mb-1 btn-primary" href="/activities/<%= activity.id %>/apply"><%= existing_application ? 'Apply again' : 'Apply' %></a>
  <% elsif resource.respond_to?(:privacy) && resource.privacy == 'secret' %>
    <span class="btn mb-1 btn-outline-primary">Invitation-only</span>
  <% end %>
<% end %>
