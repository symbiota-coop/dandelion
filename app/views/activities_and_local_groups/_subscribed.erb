<% form_tag "#{resource.path}/subscribed/#{resourceship.id}" do %>
  <div class="form-check form-switch">
    <%= check_box_tag :subscribed, id: "#{resource.subgroupship_name}-subscribed-#{resourceship.id}", class: 'form-check-input', 'aria-label': 'Subscribed', checked: !resourceship.unsubscribed, onclick: '$(this.form).submit()' %>
  </div>
<% end %>
