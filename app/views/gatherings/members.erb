<%= partial :'gatherings/nav', locals: { gathering: @gathering, membership: @membership } %>

<%= partial :'gatherings/joining_info' %>

<div class="mb-3">
  <% form_tag '', method: 'get', class: 'submitOnChange searchForm form-inline' do %>
    <div class="form-group">
      <label>Search members</label>
      <%= text_field_tag :q, class: 'form-control', value: params[:q] %>
    </div>
    <%= hidden_field_tag :display, value: params[:display] if params[:display] %>
    <%= submit_tag 'Search', class: 'btn btn-primary me-2' %>

    <style>
      @media (max-width: 575.98px) {
        .searchForm .form-check { margin-top: 0 }
      }
    </style>
    <div class="w-100 d-flex flex-wrap mt-3 mb-1">
      <% @gathering.check_box_scopes.each_with_index { |el,i| k,t,r = *el %>
      <div class="form-check form-check-inline ms-3 mb-2">
        <%= check_box_tag k, value: true, checked: params[k], onclick: 'this.form.submit()', id: k, class: 'form-check-input' %>
        <label class="form-check-label fw-medium" for="<%= k %>">
          <%= t %>&nbsp;<strong><%= r.count %></strong>
        </label>
      </div>
      <% } %>
    </div>
  <% end %>

  <% display = params[:display].presence_in(%w[pictures dietary_requirements map]) || 'details' %>
  <div class="mb-3">
    <%= partial :view_as, locals: { view_options: [
      { key: 'details', label: 'Details', icon: 'bi-list-task' },
      { key: 'pictures', label: 'Pictures', icon: 'bi-person-square' },
      { key: 'dietary_requirements', label: 'Dietary requirements', icon: 'bi-fork-knife' },
      { key: 'map', label: 'Map', icon: 'bi-geo-alt-fill' }
    ].map { |opt| opt.merge(active: opt[:key] == display) } } %>
  </div>

  <div class="row justify-content-between">
    <div class="col">
      <% if ((@membership && @membership.invitations_remaining > 0) || gathering_admin?) && (!@gathering.member_limit || @gathering.memberships.count < @gathering.member_limit) %>
        <%# One field, so shown in place rather than in a modal %>
        <a class="btn btn-sm btn-primary" href="javascript:;" onclick="$(this).hide().next().show().find('input[name=email]').focus()"><i class="bi bi-plus-lg"></i> Add member</a>
        <% if !gathering_admin? && @membership.invitations_remaining > 0 %>
          <%= pluralize(@membership.invitations_remaining <= 0 ? 0 : @membership.invitations_remaining, 'invitation') %> remaining
        <% end %>
        <div style="display:none" id="add-member">
          <% form_tag "/g/#{@gathering.slug}/add_member" do %>
            <div class="input-group d-inline-flex w-auto">
              <%= email_field_tag :email, class: 'form-control', placeholder: 'Email', 'aria-label': 'Email' %>
              <%= submit_tag 'Add member', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="col-auto">
      <% if gathering_admin? %>
        <a class="btn btn-sm btn-outline-primary" href="<%= request.path %>.csv?<%= request.query_string %>"><i class="bi bi-download"></i> CSV</a>
      <% end %>
    </div>
  </div>

</div>

<% if gathering_admin? %>
  <pre class="mt-3">
    <%== Account.and(:id.in => @memberships.pluck(:account_id)).map { |account| "#{Sanitize.fragment(account.name)} &lt;#{Sanitize.fragment(account.email)}&gt;" }.join(', ') %>
  </pre>
<% end %>

<% case display %>
<% when 'pictures' %>
  <% member_account_ids = @memberships.pluck(:account_id); all_member_accounts = Account.and(:id.in => member_account_ids) %>
  <div class="row mt-3">
    <% (all_member_accounts.and(:has_image => true).shuffle + all_member_accounts.and(image_uid: nil).shuffle).each { |account| %>
    <%= partial :'accounts/image', locals: { account: account } %>
    <% } %>
  </div>
<% when 'dietary_requirements' %>
  <% if (memberships = @memberships.and(:account_id.in => Account.and(:dietary_requirements.ne => nil).pluck(:id))).exists? %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th style="width: 1px">Name</th>
          <th>Dietary requirements</th>
        </tr>
      </thead>
      <% memberships.includes(:account, teamships: :team).each { |membership| account = membership.account %>
      <tr>
        <td>
          <%= partial :'accounts/account', object: account, locals: { membership: membership, show_email: viewable?(account, :email) } %>
          <div>
            <% membership.teamships.each { |teamship| %>
            <a href="/g/<%= @gathering.slug %>/teams">
              <span class="badge text-bg-primary mb-1"><%= teamship.team.name %></span>
            </a>
            <% } %>
          </div>
        </td>
        <td>
          <%== Sanitize.fragment(account.dietary_requirements) %>
        </td>
      </tr>
      <% } %>
    </table>
  <% else %>
    <span class="text-body-secondary">No dietary requirements</span>
  <% end %>
<% when 'map' %>
  <%= partial :'maps/map', locals: { points: Account.and(:id.in => @memberships.pluck(:account_id)).and(:coordinates.ne => nil) } %>
<% when 'details'; @memberships = @memberships.paginate(page: params[:page], per_page: 50); memberships = Membership.preload_rows(@gathering, @memberships, viewer: current_account) %>
  <table class="table table-striped table-sticky table-sticky-fit">
    <thead>
      <tr>
        <th style="width: 1px">Name</th>
        <th>Following</th>
        <th>Proposed by</th>
        <th>Accepted at</th>
        <% if @gathering.democratic_threshold %>
          <th>Suggested magic number</th>
        <% end %>
        <% if @gathering.any_events? %>
          <th>Tickets</th>
        <% end %>
        <% if @gathering.enable_contributions %>
          <th>Choices</th>
          <% if gathering_admin? || !@gathering.hide_paid %>
            <th>Requested contribution</th>
            <th>Paid</th>
          <% end %>
        <% end %>
        <% if @gathering.rotas_shown? %>
          <th>Shifts</th>
        <% end %>
        <% if gathering_admin? || !@gathering.hide_invitations %>
          <th>Invitations</th>
        <% end %>
        <% if gathering_admin? %>
          <th></th>
        <% end %>
      </tr>
    </thead>
    <% memberships.each { |membership| %>
    <tr data-pagelet-url="/g/<%= @gathering.slug %>/membership_row/<%= membership.id %>">
      <%= partial :'gatherings/membership_row', locals: { membership: membership } %>
    </tr>
    <% } %>
    <tr>
      <th style="width: 1px"></th>
      <th></th>
      <th></th>
      <th></th>
      <% if @gathering.democratic_threshold %>
        <th></th>
      <% end %>
      <% if @gathering.any_events? %>
        <th></th>
      <% end %>
      <% if @gathering.enable_contributions %>
        <th></th>
        <% if gathering_admin? || !@gathering.hide_paid %>
          <th></th>
          <th>
            <%= m @gathering.memberships.pluck(:paid).compact.sum, @gathering.currency %>
            (<%= m @gathering.processed_via_dandelion, @gathering.currency %> processed via Dandelion)
          </th>
        <% end %>
      <% end %>
      <% if @gathering.rotas_shown? %>
        <th></th>
      <% end %>
      <% if gathering_admin? || !@gathering.hide_invitations %>
        <th></th>
      <% end %>
      <% if gathering_admin? %>
        <th></th>
      <% end %>
    </tr>
  </table>
  <div class="text-center">
    <%= will_paginate @memberships, page_links: false, renderer: WillPaginate::ViewHelpers::BootstrapRenderer %>
  </div>
<% end %>
