<div class="mb-3">
  <h2 class="mt-0">
    Co-creators
    <span class="small">
      <% if @gathering.member_limit %>
        <span class="badge text-bg-primary d-inline-block mb-1"><%= @gathering.memberships.count %>/<%= @gathering.member_limit %></span>
      <% else %>
        <span class="badge text-bg-primary d-inline-block mb-1"><%= @gathering.memberships.count %></span>
      <% end %>
    </span>
  </h2>
  <div class="image-wall">
    <% (Account.and(:id.in => @gathering.memberships.pluck(:account_id)).and(:has_image => true).shuffle + Account.and(:id.in => @gathering.memberships.pluck(:account_id)).and(image_uid: nil).shuffle).each { |account| %>
    <%= partial :'accounts/square', locals: { account: account } %>
    <% } %>
  </div>
</div>
