<% if membership.unsubscribed %>
  <a href="/g/<%= membership.gathering.slug %>/set_subscribe" data-method="post" class="pagelet-trigger btn btn-sm btn-outline-primary mb-1">Email notifications off</a>
<% else %>
  <a href="/g/<%= membership.gathering.slug %>/unsubscribe" class="pagelet-trigger btn btn-sm btn-primary mb-1">Email notifications on</a>
<% end %>
