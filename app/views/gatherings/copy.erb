<%= partial :'gatherings/nav', locals: { gathering: @gathering, membership: @membership } %>

<p class="lead">
  Copy the timetables, rotas and options from one gathering to another.
</p>
<p>
  Select the gathering you would like to copy to:
</p>
<% form_tag '' do %>
  <div class="input-group d-inline-flex w-auto">
    <%= select_tag :gathering_id, options: @destination_memberships.map { |membership| [membership.gathering.name, membership.gathering.id] }, class: 'form-select', 'aria-label': 'Gathering' %>
    <%= submit_tag 'Copy', class: 'btn btn-primary' %>
  </div>
<% end %>
