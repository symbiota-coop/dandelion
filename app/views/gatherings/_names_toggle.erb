<%# A button for a gathering page's button row that switches its grid of people (grid: the pagelet's id, url: its
    address) between pictures and names, reloading it in place. klass: more classes, e.g. to hide it where the grid hides its people %>
<a class="btn btn-sm btn-outline-primary <%= klass if defined?(klass) %>" href="javascript:;" data-grid="<%= grid %>" data-base-url="<%= url %>" onclick="const grid = $('#' + $(this).attr('data-grid')); const names = !grid.attr('data-pagelet-url').includes('view=names'); grid.attr('data-pagelet-url', $(this).attr('data-base-url') + (names ? '?view=names' : '')); grid.load(grid.attr('data-pagelet-url')); $(this).find('span').text(names ? 'Show pictures' : 'Show names')"><i class="bi bi-person-vcard"></i> <span>Show names</span></a>
