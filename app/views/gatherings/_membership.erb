<% if membership.answers %>
  <div class="mb-5">
    <% membership.answers.each { |q,a| next unless q && a %>
    <p class="fs-5">
      <strong>
        <%== Sanitize.fragment(Rinku.auto_link(q), Sanitize::Config::DANDELION) %>
      </strong>
    </p>
    <p class="fs-5">
      <%= plain_text_html(a) %>
    </p>
  <% } %>
</div>
<% end %>
