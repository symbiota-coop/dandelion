<% if membership.answers %>
  <div class="mb-5">
    <% membership.answers.each { |q,a| if q && a %>
    <p class="fs-4">
      <strong>
        <%== Sanitize.fragment(Rinku.auto_link(q), Sanitize::Config::DANDELION) %>
      </strong>
    </p>
    <p class="fs-4">
      <%== Sanitize.fragment(Rinku.auto_link(a.gsub("\n", '<br />')), Sanitize::Config::DANDELION) %>
    </p>
  <% end } if membership.answers %>
</div>
<% end %>
