<% { error: 'alert-danger', warning: 'alert-warning', notice: 'alert-primary' }.each { |k,v| %>
<% if flash[k] %>
  <div class="alert fade show <%= v %><%= ' alert-dismissible' unless @hide_alert %>">
    <%== Sanitize.fragment(flash[k], Sanitize::Config::DANDELION) %>
    <% unless @hide_alert %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    <% end %>
  </div>
<% end %>
<% } %>
