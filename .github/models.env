# Models used by the AI workflows in .github/workflows. Loaded into $GITHUB_ENV by each job's "Load models" step.
#
# Auth:
# - Claude: CLAUDE_CODE_OAUTH_TOKEN secret (a Claude subscription token, from `claude setup-token`)
# - Codex: CODEX_AUTH_JSON secret, a copy of ~/.codex/auth.json from a ChatGPT login.
#   Only models offered to ChatGPT accounts work (see ~/.codex/models_cache.json).
#   Its refresh token is single-use, so the workflow saves the refreshed login back to the secret after each run,
#   using CODEX_AUTH_SECRET_WRITER (a fine-grained PAT for this repo with Secrets: read and write).
#   Give CI its own login, not the one you use locally, or each side's refresh kills the other's:
#   `CODEX_HOME=$(mktemp -d) sh -c 'codex login && gh secret set CODEX_AUTH_JSON < "$CODEX_HOME/auth.json"'`
# - Cursor: CURSOR_API_KEY secret

CLAUDE_MODEL=claude-opus-5-5
CODEX_MODEL=gpt-6.1-sol
CURSOR_MODEL=grok-4.7-xhigh
